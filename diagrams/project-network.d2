# Woodhouse authored technical plate. Reviewed 18 October 2026.
# Shape grammar: text = work; circle = responsibility; diamond = decision;
# labelled stop = evidence boundary; dashed line = return or conditional path.
# This is a method/relationship, not a claim that every project passed it.
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
style.fill: "#080D19"
direction: right
grid-columns: 1
vertical-gap: 22

plate_title: "One operator. Different finish lines." {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 58
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
  style.bold: true
}
plate_title.near: top-center
authority: "" {
  style.fill: transparent
  style.stroke-width: 0
  grid-rows: 1
  grid-columns: 3
  grid-gap: 35
human: "HUMAN" {
  label.near: center-center
  shape: circle
  style.font-color: "#E9FF49"
  style.font-size: 28
  style.fill: "transparent"
  style.stroke: "#E9FF49"
  style.stroke-width: 2
  width: 155
  height: 155
  style.bold: true
}
intent: "Direction and authority\nThe goal and its limits" {
  shape: text
  style.font-color: "#E9FF49"
  style.font-size: 33
  style.fill: "transparent"
  style.stroke: "#E9FF49"
  style.stroke-width: 0
}
agents: "CODING AGENTS\nBounded tasks, named owners" {
  shape: text
  style.font-color: "#79D8FF"
  style.font-size: 33
  style.fill: "transparent"
  style.stroke: "#79D8FF"
  style.stroke-width: 0
}
human -> intent: "" {style.stroke: "#E9FF49"; style.stroke-width: 2; style.font-color: "#E9FF49"; style.font-size: 22;}
intent -> agents: "" {style.stroke: "#79D8FF"; style.stroke-width: 2; style.font-color: "#79D8FF"; style.font-size: 22;}
}
portfolio: "" {
  style.fill: transparent
  style.stroke-width: 0
  grid-rows: 1
  grid-columns: 3
  grid-gap: 30
games: "PLAY / GAMES\nBB  Bubbles\nFT  Fighter\nSS  SHOALSHOT\nP11  Protocol 11" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 31
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
build: "BUILD / TOOLS\nAC  App Composer\nAH  Asset Hunter" {
  shape: text
  style.font-color: "#79D8FF"
  style.font-size: 31
  style.fill: "transparent"
  style.stroke: "#79D8FF"
  style.stroke-width: 0
}
explore: "EXPLORE / OTHER WORK\nFM  LoftwahFM · MX  MAX\nSC  Social Club · PR  Pirates" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 31
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
}
plate_note: "WOODHOUSE / PORTFOLIO RELATIONSHIP · 18 OCTOBER 2026 · The project markers identify\nwork, not activity or health. Each project owns its identity, source, data and release\ngates. Agents work across the portfolio within those boundaries." {
  shape: text
  style.font-color: "#A6B4CB"
  style.font-size: 23
  style.fill: "transparent"
  style.stroke: "#A6B4CB"
  style.stroke-width: 0
}
plate_note.near: bottom-center
