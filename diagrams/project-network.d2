# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/project-network.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: right
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "One operator. Independently owned products." {shape: text; near: top-center; style.font-size: 28; style.bold: true}
human: "HUMAN" {}
intent: "Direction and authority\nThe goal and its limits" {}
agents: "CODING AGENTS\nBounded tasks, named owners" {}
games: "PLAY / GAMES\nBB  Bubbles\nFT  Fighter\nSS  SHOALSHOT\nP11  Protocol 11" {}
build: "BUILD / TOOLS\nAC  App Composer\nAH  Asset Hunter" {}
explore: "EXPLORE / OTHER WORK\nFM  LoftwahFM · MX  MAX\nSC  Social Club · PR  Pirates" {}
human -> intent: ""
intent -> agents: ""
agents -> games: "Bounded work"
agents -> build: "Bounded work"
agents -> explore: "Bounded work"
note: "Project markers identify work, not activity or health. Each project owns its identity, source, data and release gates." {shape: text; near: bottom-center; style.font-size: 16}
