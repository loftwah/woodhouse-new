direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

intent: {
  direction: down
  human: "HUMAN\nIntent · authority" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
  agents: "AGENTS\nBounded work" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
  human -> agents
}

release: {
  direction: down
  qualification: "QUALIFY\nReview exact state" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
  production: "PRODUCTION\nLive version" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
  qualification -> production
}

reality: {
  direction: down
  use: "REAL USE\nPeople · devices" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
}

intent.agents -> release.qualification
release.production -> reality.use
reality.use -> intent.human {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7}
