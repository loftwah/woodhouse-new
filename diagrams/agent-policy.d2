# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/agent-policy.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: right
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "Act within the authority you have." {shape: text; near: top-center; style.font-size: 28; style.bold: true}
observe: "Observe\nEvent · schedule\nSafe production read" {}
propose: "Propose\nDraft · issue\nChangeset" {}
authority: "Check authority" {}
execute: "Yes / execute\nQualify the\nbounded result" {}
mp: "Reserved human decision\nAccounts · money · rights\nIrreversible actions and explicit gates" {}
stop: "Reject\nRecord and stop" {}
observe -> propose: ""
propose -> authority: ""
authority -> execute: "Ordinary authorised work"
authority -> mp: "Reserved decision or explicit gate"
mp -> execute: "Approve within scope"
mp -> propose: "Return for revision" {style.stroke-dash: 5}
mp -> stop: "Reject"
note: "MP is not the default decision engine for routine authorised work. Approval, return and rejection have different outcomes." {shape: text; near: bottom-center; style.font-size: 16}
