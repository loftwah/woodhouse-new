# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/pirates-parity-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "First reconstruct. Then earn expansion." {shape: text; near: top-center; style.font-size: 28; style.bold: true}
original: "PR / Source\nOriginal rules\nKeep provenance" {}
rebuild: "Reconstruction\nImplement\nevidenced rules" {}
parity: "PARITY" {}
gate: "GATE B\nLOCKED" {}
gap: "SOURCE GAP / STOP\nAn unknown stays unknown.\nPlausibility is not source evidence." {}
expansion: "EXPANSION / CONDITIONAL\nOnly after integrated parity\nand the owning gate’s acceptance." {}
original -> rebuild: "Source-backed rules"
rebuild -> parity: "Integrated comparison"
parity -> gate: "Owning gate remains locked"
original -> gap: "Missing source / stop"
note: "PR / Pirates: historical public account reviewed 18 October 2026. An unknown stays unknown. Expansion is conditional on integrated parity and owning-gate acceptance, not currently granted." {shape: text; near: bottom-center; style.font-size: 16}
