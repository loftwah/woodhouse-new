# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/publication-path-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "A public window. A private workshop." {shape: text; near: top-center; style.font-size: 28; style.bold: true}
site: "Project site metadata\nTitle, summary and original artwork URL" {}
record: "Reviewed public-safe record\nClaims and review date" {}
page: "Woodhouse page\nHuman and agent views" {}
browser: "Browser\nLoads original art\nfrom the project" {}
private: "PRIVATE\nBLOCKED" {}
denied: "NO PUBLICATION PATH\nRepository bodies · credentials\nWorking conversations" {}
fallback: "IF SOURCE ART FAILS\nWoodhouse illustration.\nIts text and credit change." {}
site -> page: "Metadata read at build"
record -> page: "Reviewed claims"
page -> browser: "Publishes source artwork URL"
site -> browser: "Original artwork loads from its producer"
private -> denied: "Blocked"
fallback -> browser: "Only if source artwork fails" {style.stroke-dash: 5}
note: "The private lane has no path to publication. Source artwork remains credited to its project. Fallback text and credit identify Woodhouse." {shape: text; near: bottom-center; style.font-size: 16}
