# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/failure-loop-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "The failure loop" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
belief: "Expectation\nState what\nshould happen" {}
work: "Attempt\nA reviewable\nchange" {}
observe: "REALITY" {}
failure: "Name the miss\nWhat escaped\nthe checks?" {}
control: "Change the control\nPrevent the same\nclass of failure" {}
recheck: "Recheck\nTry the same\nfailure again" {}
example: "FT / FIGHTER\nGeometry passed. Design missed.\nIndependent visual criticism\nbecame a separate check." {}
belief -> work: ""
work -> observe: ""
observe -> failure: ""
failure -> control: ""
control -> recheck: ""
recheck -> belief: "Return evidence to the expectation" {style.stroke-dash: 5}
note: "FT / Fighter: geometry passed while design missed. Public founding account 28 September 2026; reviewed 18 October 2026. The illustrative diagnostic is not a product screenshot." {shape: text; near: bottom-center; style.font-size: 16}
