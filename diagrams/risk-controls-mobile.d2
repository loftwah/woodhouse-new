direction: down
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

c00: "CLASS 00 · THROWAWAY\nExplore; discard cheaply" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
c01: "CLASS 01 · EXPERIMENT\nPreserve learning; useful checks" {style.fill: "#BEF05E"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
c02: "CLASS 02 · PROJECT\nProtect source and records" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
c03: "CLASS 03 · PRODUCT\nProve users and production" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
c04: "CLASS 04 · COMMERCIAL\nControl money and rollback" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
c05: "CLASS 05 · TREASURED\nNarrow authority; prove safety" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}

c00 -> c01 {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
c01 -> c02 {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
