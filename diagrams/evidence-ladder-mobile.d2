  label.near: center-center
  shape: circle
  style.font-color: "#080D19"
  style.font-size: 24
  style.fill: "#E9FF49"
  style.stroke: "#E9FF49"
  style.stroke-width: 2
  width: 42
  height: 42
  style.bold: true
}
