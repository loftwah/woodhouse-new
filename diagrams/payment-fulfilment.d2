direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

catalogue: "DEAN APPROVES\nArtwork · rights · price · spend caps" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 18; style.bold: true}
customer: "CUSTOMER\nPlaces an order" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 18; style.bold: true}
checkout: "CHECKOUT\nPayment provider" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 18; style.bold: true}
event: "PAYMENT EVENT\nProvider is authoritative" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 18; style.bold: true}
verify: "VERIFY AND DEDUPLICATE\nPayment · order · event ID" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 17; style.bold: true}
ledger: "ORDER LEDGER\nState · limits · evidence" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 18; style.bold: true}
fulfilment: "PRINTFUL ORDER\nOnly within approved policy" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 18; style.bold: true}
shipment: "SHIPMENT EVENT\nUpdate ledger · tell customer" {style.fill: "#BEF05E"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 18; style.bold: true}

catalogue -> ledger {style.stroke: "#835500"; style.stroke-width: 3; style.stroke-dash: 7}
customer -> checkout -> event -> verify -> ledger -> fulfilment -> shipment
fulfilment -> ledger {style.stroke: "#647DFF"; style.stroke-width: 2; style.stroke-dash: 6}
