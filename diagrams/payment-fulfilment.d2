# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/payment-fulfilment.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: right
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "Payment before fulfilment" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
checkout: "Checkout\nPayment\nprovider" {}
event: "Signed event\nPayment · order\nEvent ID" {}
verify: "VERIFY +\nDEDUPLICATE" {}
ledger: "ORDER\nLEDGER" {}
policy: "HUMAN / APPROVED POLICY\nArtwork · rights · price\nSpend and fulfilment limits" {}
fulfil: "Printful order\nOnly within\napproved limits" {}
shipment: "Shipment event\nUpdate the same ledger.\nNotify the customer." {}
redirect: "Browser redirect\nNot payment proof" {}
stop: "Reject as payment proof" {}
notify: "Notify the customer" {}
checkout -> event: ""
event -> verify: ""
verify -> ledger: "Verified event only"
ledger -> fulfil: "Only within approved policy"
policy -> fulfil: "Authority / rights / spend limits" {style.stroke-dash: 5}
fulfil -> shipment: ""
shipment -> ledger: "Update the same order"
shipment -> notify: ""
checkout -> redirect: "Browser return" {style.stroke-dash: 5}
redirect -> stop: ""
note: "Proposed commercial control model, not a live shop or sales claim. Signed events must be verified and deduplicated. Browser redirects have no route to the ledger." {shape: text; near: bottom-center; style.font-size: 16}
