direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

intent: {
  direction: down
  expectation: "01 · EXPECT\nSet the result" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 21; style.bold: true}
  change: "02 · CHANGE\nReviewable revision" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 21; style.bold: true}
  expectation -> change
}

inspect: {
  direction: down
  observe: "03 · OBSERVE\nSee actual result" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 21; style.bold: true}
  contain: "04 · CONTAIN\nStop unsupported work" {style.fill: "#FF746A"; style.stroke: "#FF746A"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 21; style.bold: true}
  observe -> contain
}

learn: {
  direction: down
  control: "05 · CONTROL\nFix the cause" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 21; style.bold: true}
  recheck: "06 · RECHECK\nRepeat same failure" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 21; style.bold: true}
  control -> recheck
}

intent.change -> inspect.observe
inspect.contain -> learn.control
learn.recheck -> intent.expectation {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7}
