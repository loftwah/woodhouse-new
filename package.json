{
  "name": "woodhouse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "leaderboards:collect": "node --experimental-strip-types scripts/collect-leaderboards.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build-emdash-plugins.mjs && CLOUDFLARE_ENV=production astro build && node scripts/clean-build-secrets.mjs && node scripts/check-build-privacy.mjs && node scripts/pin-default-wrangler-config.mjs",
    "build:preview": "node scripts/build-emdash-plugins.mjs && CLOUDFLARE_ENV=preview astro build && node scripts/clean-build-secrets.mjs && node scripts/check-build-privacy.mjs && node scripts/pin-default-wrangler-config.mjs",
    "format": "prettier --write astro.config.mjs eslint.config.mjs knip.json 'src/**/*.astro' 'src/**/*.ts' 'src/**/*.css' 'scripts/**/*.mjs' package.json tsconfig.json wrangler.jsonc",
    "format:check": "prettier --check astro.config.mjs eslint.config.mjs knip.json 'src/**/*.astro' 'src/**/*.ts' 'src/**/*.css' 'scripts/**/*.mjs' package.json tsconfig.json wrangler.jsonc",
    "lint": "eslint astro.config.mjs eslint.config.mjs 'src/**/*.{astro,ts}' 'scripts/**/*.mjs'",
    "deadcode": "knip",
    "audit": "node scripts/audit-dependencies.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "measure:visibility": "node scripts/measure-content-visibility.mjs",
    "loom:harness": "node scripts/loom-lifecycle-harness.mjs",
    "diagrams:sizes": "node scripts/diagram-sizes.mjs",
    "atlas:plate": "node --experimental-strip-types scripts/render-atlas-plate.mjs",
    "atlas:plate:check": "node --experimental-strip-types scripts/render-atlas-plate.mjs --check",
    "atlas:drift": "node --experimental-strip-types scripts/check-atlas-drift.mjs",
    "diagrams:sizes:check": "node scripts/diagram-sizes.mjs --check",
    "typecheck": "astro check && tsc --noEmit",
    "preview": "astro preview --host 0.0.0.0",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "release:status": "node scripts/release-status.mjs",
    "verify:build": "node scripts/verify-build-identity.mjs",
    "evidence:capture": "node scripts/capture-acceptance-evidence.mjs",
    "evidence:record": "node scripts/record-evidence.mjs",
    "secrets:production": "node scripts/set-production-secrets.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "backup:d1": "node scripts/backup-d1.mjs",
    "backup:d1:bookmark": "node scripts/backup-d1-bookmark.mjs",
    "backup:r2": "node scripts/backup-r2-manifest.mjs",
    "verify:r2": "node scripts/verify-r2-backup.mjs",
    "restore:r2": "node scripts/restore-r2.mjs",
    "test:r2": "node --test scripts/r2-recovery.test.mjs",
    "verify:content": "node scripts/check-deployment-content.mjs",
    "emdash:doctor": "node scripts/emdash-doctor.mjs",
    "emdash:seed:validate": "emdash seed seed/seed.json --validate",
    "emdash:seed:remote": "node scripts/apply-content-model.mjs",
    "emdash:types": "node scripts/emdash-types.mjs",
    "emdash:types:check": "node scripts/emdash-types.mjs --check",
    "emdash:migrate:status": "emdash migrate --status --wrangler-config wrangler.jsonc --wrangler-env preview --json",
    "emdash:migrate:check": "emdash migrate --check --wrangler-config wrangler.jsonc --wrangler-env preview --json",
    "emdash:site:export": "emdash site export --output .release/woodhouse-site.emdash",
    "test": "node --experimental-strip-types --test --test-concurrency=2 scripts/*.test.mjs \"src/**/*.test.ts\"",
    "acceptance:share": "node scripts/acceptance-share.mjs",
    "lab:artifacts": "node lab/artifacts-lifecycle/report.mjs",
    "lab:evidence": "node lab/evidence-replay/report.mjs",
    "test:host-reservation": "python3 -m unittest discover -s scripts -p host_validation_test.py",
    "verify": "node scripts/verify.mjs",
    "workspace:prune": "node scripts/prune-workspace.mjs",
    "social-cards": "python3 scripts/render-social-cards.py",
    "social-cards:record": "node scripts/social-cards.mjs",
    "social-cards:check": "node scripts/social-cards.mjs --check",
    "dossier-preview": "node scripts/render-dossier-preview.mjs",
    "edition-card": "node scripts/render-edition-card.mjs",
    "share-previews": "node --experimental-strip-types scripts/render-share-previews.mjs",
    "share-previews:check": "node --experimental-strip-types scripts/render-share-previews.mjs --check",
    "showcase:render": "node scripts/render-showcase-campaign.mjs",
    "storybook": "storybook dev -p 6007",
    "build:storybook": "storybook build -o storybook-static",
    "diagrams": "bash scripts/render-diagrams.sh",
    "figures": "node scripts/render-article-figures.mjs",
    "figures:check": "node scripts/render-article-figures.mjs --check",
    "deploy:publication": "node scripts/deploy-publication.mjs",
    "edition:rehearse": "node scripts/rehearse-edition.mjs",
    "showcase:delivery": "node scripts/showcase-delivery.mjs",
    "test:showcase": "node --test scripts/discord-showcase.test.mjs scripts/showcase-delivery.test.mjs scripts/showcase-publication.test.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:check": "node scripts/install-git-hooks.mjs --check"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@emdash-cms/plugin-audit-log": "^0.2.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "echarts": "6.1.0",
    "effect": "^3.22.2",
    "emdash": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@eslint/js": "^10.0.0",
    "@storybook-astro/framework": "^1.15.0",
    "@storybook/builder-vite": "^10.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "astro": "7.4.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "playwright-core": "1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "storybook": "^10.6.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "4.158.0"
  }
}
