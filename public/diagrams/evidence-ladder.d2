direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

work: {
  direction: down
  observed: "01 · OBSERVED\nSource examined" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 20; style.bold: true}
  implemented: "02 · IMPLEMENTED\nChange exists" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 20; style.bold: true}
  observed -> implemented
}

candidate: {
  direction: down
  merged: "03 · MERGED\nRevision integrated" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 20; style.bold: true}
  qualified: "04 · QUALIFIED\nGates pass" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 20; style.bold: true}
  merged -> qualified
}

realworld: {
  direction: down
  production: "05 · PRODUCTION\nLive version observed" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 20; style.bold: true}
  accepted: "OWNER ACCEPTED\nHuman signs off" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  physical: "PHYSICAL PROOF\nDevice · place · person" {style.fill: "#FF746A"; style.stroke: "#FF746A"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  production -> accepted
  production -> physical {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7}
}

work.implemented -> candidate.merged
candidate.qualified -> realworld.production
