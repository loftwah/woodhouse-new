direction: down
vars: {
  d2-config: {layout-engine: elk; theme-id: 201}
}

observed: "01 · OBSERVED\nSource or behavior inspected" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
implemented: "02 · IMPLEMENTED\nRequested change exists" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
merged: "03 · MERGED\nIntegrated revision identified" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
qualified: "04 · QUALIFIED\nNamed gates passed" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
production: "05 · PRODUCTION VERIFIED\nDeployed version observed" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
accepted: "OWNER ACCEPTED\nAccountable person confirms the bar" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
physical: "PHYSICAL PROOF · WHEN RELEVANT\nReal device · environment · human use" {style.fill: "#FF746A"; style.stroke: "#FF746A"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}

observed -> implemented {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
implemented -> merged {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
merged -> qualified {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
qualified -> production {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
production -> accepted {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 14}
production -> physical {style.stroke: "#FF746A"; style.stroke-width: 2; style.stroke-dash: 6; style.font-size: 14}
