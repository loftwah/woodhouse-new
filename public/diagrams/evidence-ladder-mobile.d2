# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/evidence-ladder-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "The evidence ladder" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
a: "01 / Observed\nSource\nexamined" {}
b: "02 / Implemented\nChange\nexists" {}
c: "03 / Merged\nRevision\nintegrated" {}
d: "04 / Qualified\nNamed\nchecks pass" {}
e: "05 / Verified\nLive production\nobserved" {}
accept: "Human acceptance\nDoes it meet the brief?" {}
physical: "Physical proof\nDoes it work on the real device?" {}
candidate: "One candidate revision" {}
candidate -> a: "Independent witness" {style.stroke-dash: 5}
candidate -> b: "Independent witness" {style.stroke-dash: 5}
candidate -> c: "Independent witness" {style.stroke-dash: 5}
candidate -> d: "Independent witness" {style.stroke-dash: 5}
candidate -> e: "Independent witness" {style.stroke-dash: 5}
note: "Five ordered claims, each independently observed. Human acceptance and physical proof are separate observations; no earlier claim establishes a later one." {shape: text; near: bottom-center; style.font-size: 16}
