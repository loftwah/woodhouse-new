plate_note: "HUMAN APPROVES THE POLICY\nArtwork, rights, prices\nand caps.\nBrowser redirects do not\nprove\npayment. Delivery updates\nreturn\nto the same order ledger.\n\nREFERENCE / NOT A LIVE\nSHOP\nReviewed 18 October 2026" {
  shape: text
  style.font-color: "#A6B4CB"
  style.font-size: 22
  style.fill: "transparent"
  style.stroke: "#A6B4CB"
  style.stroke-width: 0
}
plate_note.near: bottom-center
