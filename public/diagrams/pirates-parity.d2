direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

evidence: {
  label: "01 / ORIGINAL EVIDENCE"
  direction: down
  style.fill: "#141D32"
  style.stroke: "#B8B4A8"
  style.stroke-width: 1
  style.font-color: "#E9F0FF"
  style.font-size: 23
  style.bold: true
  source: "SOURCE\nOriginal game" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
  unknown: "SOURCE GAP\nUnknown stays open" {style.fill: "#FF746A"; style.stroke: "#FF746A"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 20; style.bold: true}
  source -> unknown {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7}
}

reconstruction: {
  label: "02 / REBUILD AND COMPARE"
  direction: down
  style.fill: "#141D32"
  style.stroke: "#B8B4A8"
  style.stroke-width: 1
  style.font-color: "#E9F0FF"
  style.font-size: 23
  style.bold: true
  rebuild: "REBUILD\nMatch the source" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
  parity: "INTEGRATED PARITY\nWhole game compared" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
  rebuild -> parity {style.stroke: "#6E819F"; style.stroke-width: 3}
}

gate: {
  label: "03 / GATE B"
  direction: down
  style.fill: "#141D32"
  style.stroke: "#B8B4A8"
  style.stroke-width: 1
  style.font-color: "#E9F0FF"
  style.font-size: 23
  style.bold: true
  gateb: "GATE B · LOCKED\nExpansion waits" {style.fill: "#111A2C"; style.stroke: "#FF746A"; style.stroke-width: 5; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
  expansion: "EXPANSION\nAfter parity" {style.fill: "#FFFFFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 21; style.bold: true}
  gateb -> expansion {style.stroke: "#6E819F"; style.stroke-width: 3}
}

evidence.source -> reconstruction.rebuild {style.stroke: "#6E819F"; style.stroke-width: 3}
evidence.unknown -> reconstruction.rebuild {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7}
reconstruction.parity -> gate.gateb {style.stroke: "#FF746A"; style.stroke-width: 3}
