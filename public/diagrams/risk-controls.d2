# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/risk-controls.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: right
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "Controls follow consequences" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
throw: "Throwaway\nDiscard cheaply; keep it reversible" {}
experiment: "Experiment\nRetain useful observations" {}
project: "Project\nProtect source and history" {}
product: "Product\nObserve real use" {}
commercial: "Commercial\nProtect money and commitments\nBound authority and fulfilment" {}
treasured: "Treasured\nRestrict access to what must stay private" {}
note: "Classes, not stages. Choose proportionate controls for the actual consequence; no maturity or progress is implied." {shape: text; near: bottom-center; style.font-size: 16}
