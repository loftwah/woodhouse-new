direction: right
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

practice: {
  direction: down
  c00: "00 · THROWAWAY\nDiscard cheaply" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  c01: "01 · EXPERIMENT\nKeep useful learning" {style.fill: "#BEF05E"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  c00 -> c01
}

product: {
  direction: down
  c02: "02 · PROJECT\nProtect work" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  c03: "03 · PRODUCT\nProve real use" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#111A2C"; style.font-size: 19; style.bold: true}
  c02 -> c03
}

stakes: {
  direction: down
  c04: "04 · COMMERCIAL\nProtect money" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 19; style.bold: true}
  c05: "05 · TREASURED\nRestrict access" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 3; style.font-color: "#FFFFFF"; style.font-size: 19; style.bold: true}
  c04 -> c05 {style.stroke: "#FF746A"; style.stroke-width: 3}
}

practice.c01 -> product.c02
product.c03 -> stakes.c04
