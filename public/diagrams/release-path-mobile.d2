# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/release-path-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "Qualify the candidate you actually ship." {shape: text; near: top-center; style.font-size: 28; style.bold: true}
candidate: "Exact candidate\nSource · scope\nIdentity" {}
gate: "CHECKS\nPASS?" {}
live: "Production\nDeploy; inspect\nlive identity" {}
use: "Real use\nPeople · devices\nSeparate evidence" {}
stop: "STOP / THE CANDIDATE CHANGED\nEarlier checks no longer qualify this state. Revise and repeat the affected checks." {}
candidate -> gate: ""
gate -> live: "Pass and owning release authority"
live -> use: "Separate observation"
candidate -> stop: "Candidate changed"
stop -> candidate: "Revise and repeat affected checks" {style.stroke-dash: 5}
note: "Check, production and real-use claims each need their own evidence. A changed candidate invalidates affected earlier checks." {shape: text; near: bottom-center; style.font-size: 16}
