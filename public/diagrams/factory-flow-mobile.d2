direction: down
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 201
  }
}

human: Human operator {
  label: "HUMAN OPERATOR\nIntent · authority"
  style.fill: "#E9FF49"
  style.stroke: "#6E819F"
  style.stroke-width: 2
  style.font-color: "#111A2C"
  style.font-size: 20
  style.bold: true
}
agents: Software agents {
  label: "SOFTWARE AGENTS\nBounded work"
  style.fill: "#647DFF"
  style.stroke: "#6E819F"
  style.stroke-width: 2
  style.font-color: "#FFFFFF"
  style.font-size: 20
  style.bold: true
}
qualification: Qualification {
  label: "QUALIFICATION\nChecks · review · exact state"
  style.fill: "#FF746A"
  style.stroke: "#6E819F"
  style.stroke-width: 2
  style.font-color: "#111A2C"
  style.font-size: 20
  style.bold: true
}
release: Production release {
  label: "PRODUCTION\nDeployed version · live behavior"
  style.fill: "#111A2C"
  style.stroke: "#6E819F"
  style.stroke-width: 2
  style.font-color: "#FFFFFF"
  style.font-size: 20
  style.bold: true
}
reality: Real use {
  label: "REAL USE\nPeople · devices · environment"
  style.fill: "#FFFFFF"
  style.stroke: "#6E819F"
  style.stroke-width: 2
  style.font-color: "#111A2C"
  style.font-size: 20
  style.bold: true
}

human -> agents {style.stroke: "#6E819F"; style.stroke-width: 3; style.font-size: 16}
agents -> qualification {style.stroke: "#6E819F"; style.stroke-width: 3; style.font-size: 16}
qualification -> release {style.stroke: "#6E819F"; style.stroke-width: 3; style.font-size: 16}
release -> reality {style.stroke: "#6E819F"; style.stroke-width: 3; style.font-size: 16}
reality -> human {style.stroke: "#FF746A"; style.stroke-width: 3; style.stroke-dash: 7; style.font-size: 16}
