direction: down
vars: {d2-config: {layout-engine: elk; theme-id: 201}}

belief: "01 · EXPECTATION\nState what should happen" {style.fill: "#E9FF49"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
attempt: "02 · CHANGE\nMake a reviewable revision" {style.fill: "#647DFF"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
observe: "03 · OBSERVE\nInspect the real outcome" {style.fill: "#FF746A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
contain: "04 · CONTAIN\nStop unsupported action" {style.fill: "#FF746A"; style.stroke: "#FF746A"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
control: "05 · CONTROL\nChange the gate or product" {style.fill: "#FFC95A"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#111A2C"; style.font-size: 22; style.bold: true}
recheck: "06 · RECHECK\nRepeat the failure class" {style.fill: "#111A2C"; style.stroke: "#6E819F"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}

belief -> attempt {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
attempt -> observe {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
observe -> contain {style.stroke: "#FF746A"; style.stroke-width: 2; style.font-size: 15}
contain -> control {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
control -> recheck {style.stroke: "#6E819F"; style.stroke-width: 2; style.font-size: 15}
recheck -> belief {style.stroke: "#FF746A"; style.stroke-width: 2; style.stroke-dash: 6; style.font-size: 15}
