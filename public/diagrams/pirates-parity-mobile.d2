# Woodhouse authored technical plate. Reviewed 18 October 2026.
# Shape grammar: text = work; circle = responsibility; diamond = decision;
# labelled stop = evidence boundary; dashed line = return or conditional path.
# This is a method/relationship, not a claim that every project passed it.
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
style.fill: "#080D19"
direction: down
grid-rows: 4
grid-columns: 2
horizontal-gap: 16
vertical-gap: 28

plate_title: "Reconstruct\nfirst.\nExpansion\nwaits." {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 44
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
  style.bold: true
}
plate_title.near: top-center
r0: "01" {
  label.near: center-center
  shape: circle
  style.font-color: "#080D19"
  style.font-size: 24
  style.fill: "#E9FF49"
  style.stroke: "#E9FF49"
  style.stroke-width: 2
  width: 42
  height: 42
  style.bold: true
}
t0: "Original source\nRecover rules and\nprovenance" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 26
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
r1: "02" {
  label.near: center-center
  shape: circle
  style.font-color: "#080D19"
  style.font-size: 24
  style.fill: "#EAF0FA"
  style.stroke: "#EAF0FA"
  style.stroke-width: 2
  width: 42
  height: 42
  style.bold: true
}
t1: "Reconstruction\nUse evidenced rules\nonly" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 26
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
r2: "03" {
  label.near: center-center
  shape: circle
  style.font-color: "#080D19"
  style.font-size: 24
  style.fill: "#79D8FF"
  style.stroke: "#79D8FF"
  style.stroke-width: 2
  width: 42
  height: 42
  style.bold: true
}
t2: "Integrated parity\nCompare the whole\ngame" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 26
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
r3: "04" {
  label.near: center-center
  shape: circle
  style.font-color: "#080D19"
  style.font-size: 24
  style.fill: "#FF746A"
  style.stroke: "#FF746A"
  style.stroke-width: 2
  width: 42
  height: 42
  style.bold: true
}
t3: "Gate B / locked\nExpansion requires\nparity" {
  shape: text
  style.font-color: "#EAF0FA"
  style.font-size: 26
  style.fill: "transparent"
  style.stroke: "#EAF0FA"
  style.stroke-width: 0
}
r0 -> r1: "" {style.stroke: "#79D8FF"; style.stroke-width: 2; style.font-color: "#79D8FF"; style.font-size: 22; target-arrowhead.shape: none;}
r1 -> r2: "" {style.stroke: "#79D8FF"; style.stroke-width: 2; style.font-color: "#79D8FF"; style.font-size: 22; target-arrowhead.shape: none;}
r2 -> r3: "" {style.stroke: "#79D8FF"; style.stroke-width: 2; style.font-color: "#79D8FF"; style.font-size: 22; target-arrowhead.shape: none;}
plate_note: "SOURCE GAP / STOP\nUnknown rules stay open.\nPlausibility is not\nevidence.\nExpansion follows only\nafter\nthe owning parity gate\nopens.\n\nPR / PIRATES\nReviewed 18 October 2026" {
  shape: text
  style.font-color: "#A6B4CB"
  style.font-size: 22
  style.fill: "transparent"
  style.stroke: "#A6B4CB"
  style.stroke-width: 0
}
plate_note.near: bottom-center
