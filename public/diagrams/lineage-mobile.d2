# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/lineage-mobile.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: down
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "How the working method changed" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
tools: "Compose tools\nPlugins · APIs\nServices" {}
pair: "Work in a pair\nOne human\nOne agent" {}
delegate: "Delegate work\nA bounded task\nA clear owner" {}
parallel: "Work in parallel\nCompeting changes\nIndependent review" {}
qualification: "Qualify the result\nExact revision\nNamed release gates" {}
operation: "Operate a factory\nIntent → work\n→ evidence" {}
tools -> pair: ""
pair -> delegate: ""
delegate -> parallel: ""
parallel -> qualification: ""
qualification -> operation: ""
note: "A sequence of working habits, not an invented dated roadmap. Founding public account: 28 September 2026." {shape: text; near: bottom-center; style.font-size: 16}
