direction: down
vars: {d2-config: {layout-engine: elk; theme-id: 0}}

c00: "CLASS 00 · THROWAWAY\nExplore; discard cheaply" {style.fill: "#E6F451"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#171812"; style.font-size: 22; style.bold: true}
c01: "CLASS 01 · EXPERIMENT\nPreserve learning; useful checks" {style.fill: "#D6EC6B"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#171812"; style.font-size: 22; style.bold: true}
c02: "CLASS 02 · PROJECT\nProtect source and records" {style.fill: "#F1BF54"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#171812"; style.font-size: 22; style.bold: true}
c03: "CLASS 03 · PRODUCT\nProve users and production" {style.fill: "#F2744A"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#171812"; style.font-size: 22; style.bold: true}
c04: "CLASS 04 · COMMERCIAL\nControl money and rollback" {style.fill: "#4665E8"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}
c05: "CLASS 05 · TREASURED\nNarrow authority; prove safety" {style.fill: "#171812"; style.stroke: "#171812"; style.stroke-width: 2; style.font-color: "#FFFFFF"; style.font-size: 22; style.bold: true}

