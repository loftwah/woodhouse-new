# Editable Woodhouse system model. Reviewed 18 October 2026.
# Published illustration and this editable topology are separate artifacts.
# Retained image master, exact prompts and paired provenance: scripts/assets/technical-plates/factory-flow.*
vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 16}}
direction: right
style.fill: "#080D19"
*.style.fill: "#0F182A"
*.style.stroke: "#79D8FF"
*.style.font-color: "#EAF0FA"
*.style.font-size: 18
title: "From intent to evidence" {shape: text; near: top-center; style.font-size: 28; style.bold: true}
human: "HUMAN" {}
intent: "Set intent\nGoal · limits\nOwner" {}
agent: "Coding agents\nBounded tasks\nReviewable changes" {}
review: "Independent review\nCheck the exact candidate" {}
production: "Production\nObserve the\nnamed live version" {}
real: "Real use\nPeople · devices\nA separate test" {}
return: "RETURN TO THE HUMAN\nEvidence changes the next decision" {}
qualification: "Qualification\nNamed checks on the same candidate" {}
revise: "Revise the work\nNo publication from a rejected review" {}
human -> intent: ""
intent -> agent: ""
agent -> review: ""
review -> qualification: "Accepted for qualification"
review -> revise: "Held / rejected"
revise -> agent: "Revise" {style.stroke-dash: 5}
qualification -> production: "Owning release gates apply"
production -> real: "Observe separately"
real -> return: ""
return -> human: "Evidence informs the next decision" {style.stroke-dash: 5}
note: "Method, not portfolio status. Review, production and real use are different observations." {shape: text; near: bottom-center; style.font-size: 16}
