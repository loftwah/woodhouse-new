                            <span class="discovery-name">{d.name}</span>
                            <span class="discovery-count">
                              {d.value === null ? "—" : d.value.toLocaleString("en-AU")}
                            </span>
                          </a>
                        ))}
                      </nav>
                      {!storyFocus && destinationStory && (
                        <DiscoveryStoryPanel
                          story={destinationStory}
                          variant="inline"
                          shareHref={storyScopeLink}
                        />
                      )}
                      {storyFocus && (
                        <p class="discovery-detail__jump">
                          The selected story is open at the top of the report.{" "}
                          <a href={`${pageLink({ view: "chart" })}#discovery-story`}>
                            Return to {destinationStory?.name}
                          </a>
                        </p>
                      )}
                    </div>
                  ) : (
                    <p class="overview-note">
                      No published project with a site address is in the measured destination
                      subset.
                    </p>
                  )}
                  <p class="overview-note">
                    Counts come from the same anonymous collection as Visits. Opt-out, blocked
                    measurement and QA exclusion make them partial, and they do not show whether the
                    visitor played, subscribed or came back.
                  </p>
                </section>
              </details>
            )}
            {modes.length > 0 && (
              <details class="notes-group">
                <summary>Local and online play</summary>
                <section class="activity-context" aria-labelledby="mode-split-heading">
                  <h2 id="mode-split-heading">Local vs online play</h2>
                  <p>
                    {rows[0]?.name} reports the play mode of every accepted gameplay event. Local
                    play is Classic plus Journey; online play is Private room plus Public
                    matchmaking. Each accepted event belongs to exactly one mode, so these subtotals
                    are additive with the overall measure above them, not a second measurement of
                    it. Every mode measure carries its own four-part definition in the source
                    register below.
                  </p>
                  <ul class="mode-split-list">
                    {modes.map((row) => (
                      <li>
                        <span class="discovery-name">{row.label}</span>
                        <span class="discovery-count">
                          {formatMetric({ value: row.total, unit: row.unit })}
                        </span>
                        <span class="mode-split-groups">
                          {row.groups.map((group) => (
                            <span class="mode-split-group">
                              <strong>{group.label}</strong>
                              <span class="mode-split-value">
                                {group.value === null
                                  ? "not measured"
                                  : formatMetric({ value: group.value, unit: row.unit })}
                              </span>
                              <span class="mode-split-modes">
                                {group.modes.map((mode) => (
                                  <a href={pageLink({ measure: mode.measure, view: "chart" })}>
                                    {mode.label}{" "}
                                    {mode.value === null
                                      ? "—"
                                      : formatMetric({ value: mode.value, unit: row.unit })}
                                  </a>
                                ))}
                              </span>
                            </span>
                          ))}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <p class="overview-note">{modeNote}</p>
                </section>
              </details>
            )}
            <details class="notes-group">
              <summary>Returning browsers</summary>
              <section class="activity-context" aria-labelledby="returns-heading">
                <h2 id="returns-heading">Have browsers come back?</h2>
                <p>
                  These are optional browser signals, kept separate for each project. They cannot
                  identify people or establish cohort retention. Daily browser counts do not add up
                  to a period total.
                </p>
                <ul class="return-signals">
                  {returnSignals.map((signal) => (
                    <li>
                      <details>
                        <summary>
                          <strong>{names.get(signal.project) ?? signal.project}</strong>
                          <span>
                            {signal.value === null
                              ? "Not measured for these dates"
                              : `${signal.value.toLocaleString("en-AU")} returning · ${signal.browsers === null ? "browser count unavailable" : `${signal.browsers.toLocaleString("en-AU")} reporting browsers`}`}
                          </span>
                        </summary>
                        {signal.value !== null ? (
                          <>
                            <p>{signal.definition}</p>
                            {signal.browsers === 0 && (
                              <p>
                                No opted-in browser was observed in this window. This zero cannot
                                show whether the wider audience returned.
                              </p>
                            )}
                            <a
                              href={pageLink({
                                view: "chart",
                                project: signal.project,
                                measure: "returning_browsers"
                              })}
                            >
                              Inspect {names.get(signal.project)} returns
                            </a>
                          </>
                        ) : (
                          <>
                            <p>{signal.gap}</p>
                          </>
                        )}
                      </details>
                    </li>
                  ))}
                </ul>
              </section>
            </details>
            <details class="notes-group">
              <summary>Release history</summary>
              <section class="activity-context" aria-labelledby="history-heading">
                <h2 id="history-heading">What changed around this activity?</h2>
                <p>
                  Dated release observations sit beside the collection and comparison boundaries
                  reported by each source. Nearby dates suggest questions to investigate; they do
                  not show that a release caused a change in use.
                </p>
                {report?.releases === undefined && (
                  <p class="overview-note">
                    This saved report has no frozen release notes. Its source collection dates
                    remain available below; later notes are never added to an old snapshot.
                  </p>
                )}
                <p class="overview-note">
                  This is a reviewed selection, not a complete release feed. Notes are frozen with
                  the report and may precede the selected dates; notes after its last selected day
                  are omitted.
                </p>
                {timeline.length > 0 ? (
                  <details class="history-disclosure">
                    <summary>Explore {timeline.length} dated release and collection notes</summary>
                    <ol class="activity-history">
                      {timeline.map((note) => (
                        <li>
                          <time datetime={note.date}>{note.date}</time>
                          <div>
                            <strong>
                              {names.get(note.project) ?? note.project} · {note.title}
                            </strong>
                            <p>{note.detail}</p>
                            {note.href && (
                              <a href={note.href}>
                                Read release evidence · reviewed {note.reviewedAt}
                              </a>
                            )}
                          </div>
                        </li>
                      ))}
                    </ol>
                  </details>
                ) : (
                  <p>No dated release or collection observations are available for this report.</p>
                )}
              </section>
            </details>
            <details class="notes-group">
              <summary>Sources & metric definitions</summary>
              <section class="source-register" aria-labelledby="sources-heading">
                <h2 id="sources-heading">Follow the numbers to their source</h2>
                <p>Every measure has a definition, a collection boundary and blind spots.</p>
                {rows.map((r) => (
                  <details id={`source-${r.project}`}>
                    <summary>
                      <span>
                        <i class="source-dot" style={`--source:${r.colour}`} aria-hidden="true"></i>
                        {r.name}
                      </span>
                      <span>
                        {r.data
                          ? `${registerMetrics(r.data.metrics).filter((m) => m.value !== null).length} measures available`
                          : "Source unavailable"}
                      </span>
                    </summary>
                    {r.data ? (
                      <div class="source-detail">
                        <p>
                          <a href={r.data.source.endpoint}>Live aggregate endpoint</a> · generated{" "}
                          <time datetime={r.data.generatedAt}>{r.data.generatedAt}</time>
                        </p>
                        <dl class="source-dates">
                          <div>
                            <dt>Collection began</dt>
                            <dd>{r.data.coverage.startedAt ?? "Not established"}</dd>
                          </div>
                          <div>
                            <dt>Comparable history from</dt>
                            <dd>{r.data.coverage.comparableFrom ?? "Not established"}</dd>
                          </div>
                          <div>
                            <dt>Report producer revision</dt>
                            <dd>{r.data.source.revision ?? "Not supplied in this report"}</dd>
                          </div>
                        </dl>
                        <p>
                          This revision identifies the code producing this aggregate, not the client
                          that emitted every event. Protocol 11 and SHOALSHOT use Woodhouse’s
                          aggregate producer. It cannot recover missing historical client identity.
                          Older saved reports keep their original provenance.
                        </p>
                        <p>
                          <a
                            href={
                              new URL(
                                r.project === "fighter"
                                  ? "/fighter-release.json"
                                  : r.project === "app-composer" || r.project === "bubbles"
                                    ? "/healthz"
                                    : r.project === "loftwahfm"
                                      ? "/api/portfolio-analytics"
                                      : "/build.json",
                                r.data.source.endpoint
                              ).href
                            }
                          >
                            Current producer identity
                          </a>{" "}
                          (may be newer than this saved report).
                        </p>
                        <ul>
                          {r.data.coverage.limitations.map((text) => (
                            <li>{text}</li>
                          ))}
                        </ul>
                        <dl class="definition-list">
                          {registerMetrics(r.data.metrics).map((m) => (
                            <div>
                              <dt>
                                {m.label} <strong>{formatMetric(m)}</strong>
                                <small>{qualityText(m)}</small>
                              </dt>
                              <dd>{m.definition}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    ) : (
                      <p>
                        This source did not supply a valid report for these dates. It may be
                        disconnected, not yet released, out of retained history or temporarily
                        unavailable. We cannot infer zero activity.
                      </p>
                    )}
                  </details>
                ))}
              </section>
            </details>
            <details class="notes-group">
              <summary>How to read this report</summary>{" "}
              <section class="interpretation" aria-label="Read this report">
                <section>
                  <h2>What am I looking at?</h2>
                  <p>{measure.meaning}</p>
                  <p class="context-muted">
                    {overview
                      ? "One row and one card per project, each on the measure its product view defines. The games, LoftwahFM, App Composer and Woodhouse report different units; the overview keeps them side by side without adding them together."
                      : "The chart uses one measure and one unit at a time. Each coloured line belongs to a project; the source totals cover the selected window."}
                  </p>
                </section>
                <section>
                  <h2>What does it tell us?</h2>
                  {selected === "app-composer" && (
                    <p>
                      App opens show recorded access. Guestbook contribution opens show content
                      being viewed. Completed Link Checks show a specific job finishing. These are
                      different stages of value, measured separately—not a shared conversion funnel.
                    </p>
                  )}
                  <p>
                    {overview
                      ? available > 0
                        ? `${available} of ${applicable.length} projects report their own measure for these dates. A project that reports nothing keeps its measure named and shows no value rather than a zero.`
                        : "No project reports its own measure for these dates. That is a collection result for this window, not evidence that nobody used the products."
                      : hasDaily
                        ? "We can see when recorded activity occurred and inspect how it is distributed across the selected dates."
                        : "This selection cannot currently establish a pattern of use."}
                  </p>
                  <p>
                    {report?.analysis?.findings.length
                      ? overview
                        ? "Complete-week movements across the portfolio. Each finding names its own project and measure; they are broader context and may describe a different measure from the chart."
                        : selected
                          ? `Complete-week movement for ${names.get(selected)}. Each finding names its own measure, which may differ from the chart above.`
                          : "Complete-week movements for the projects in this scope. Each finding names its own project and measure, which may differ from the chart above."
                      : weekly.highlights.length
                        ? "A valid complete-week comparison appears under Last complete week. The operational alert above reports only movements past its own thresholds, so it stays quiet for smaller real observations."
                        : "No clean growth comparison yet. New collection and legacy test traffic limit the history we can trust."}
                  </p>
                  {report?.analysis?.findings.map((f) => (
                    <p>
                      <strong>
                        {names.get(f.project)} · {f.label}: {f.changePercent > 0 ? "+" : ""}
                        {f.changePercent}%
                      </strong>{" "}
                      in the complete week {f.from}–{f.to}
                      {f.newBest ? `, a new best of ${f.comparedWeeks} comparable weeks` : ""}.{" "}
                      {f.nextAction}
                    </p>
                  ))}
                </section>
                {report && (
                  <section class="weekly" aria-labelledby="weekly-heading">
                    <h2 id="weekly-heading">Last complete week</h2>
                    <p class="context-muted">
                      The most recent complete Monday–Sunday UTC week for each project's own
                      headline measure, against the week before. A record needs exact daily history
                      for two adjacent complete weeks; this is a valid comparison, not only the
                      large movements that raise an operational alert.
                    </p>
                    {weekly.highlights.length > 0 ? (
                      <ul class="weekly-list">
                        {weekly.highlights.map((h) => (
                          <li class:list={["weekly-row", { "is-record": h.newBest }]}>
                            <span class="weekly-head">
                              <span class="weekly-project">{h.name}</span>
                              <span class="weekly-measure">{h.measure.label}</span>
                              {h.newBest && <span class="weekly-record">New best</span>}
                            </span>
                            <span class="weekly-figures">
                              <strong>{formatMetric({ value: h.value, unit: h.unit })}</strong>
                              <span class="weekly-movement">
                                {h.changePercent === null
                                  ? `no prior baseline (${formatMetric({ value: h.previous, unit: h.unit })} the week before)`
                                  : `${h.changePercent > 0 ? "Up" : h.changePercent < 0 ? "Down" : "Level"} ${Math.abs(h.changePercent)}% from ${formatMetric({ value: h.previous, unit: h.unit })}`}
                              </span>
                            </span>
                            <span class="weekly-context">
                              {h.from}–{h.to}
                              {h.newBest
                                ? ` · best of ${h.comparedWeeks} comparable weeks`
                                : ` · ${h.comparedWeeks} comparable weeks`}
                              {" · "}
                              <a
                                href={pageLink({
                                  view: "share",
                                  project: h.project,
                                  measure: h.measure.key,
                                  week: h.from
                                })}
                              >
                                Share this week
                              </a>
                            </span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p>
                        No project has two complete comparable weeks yet, so no week-on-week figure
                        is shown. Collection is too recent to compare honestly, and nothing is
                        inferred from it.
                      </p>
                    )}
                    {weekly.gaps.length > 0 && (
                      <details class="weekly-gaps">
                        <summary>Why some projects are not compared ({weekly.gaps.length})</summary>
                        <ul>
                          {weekly.gaps.map((gap) => (
                            <li>
                              <strong>{gap.name}</strong>: {gap.reason}.
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </section>
                )}
                {selected === "app-composer" && (
                  <section>
                    <h2>Is the app delivering value?</h2>
                    <p>
                      {guestReceipts
                        ? "Received guest postcards count contributions accepted as pending for moderation. This is an admission count, not the current queue size. Optional reporting can miss submissions; it does not establish approval, publication, unique people or a conversion rate."
                        : "This snapshot does not report guest postcard receipts. Opens and mixed actions cannot establish that someone successfully submitted a postcard."}
                    </p>
                    {guestReceipts?.value === null && (
                      <p>
                        No retained receipt measurement is available for these dates. History before
                        the first retained observation is unknown; receipt counts expire after 35
                        days.
                      </p>
                    )}
                    <p>
                      Creator activation, successful publications and outbound Linkarooie
                      interactions remain unmeasured in this public report.
                    </p>
                    <p>
                      Repeat use, task completion rates and value over time need app-specific
                      outcome definitions and matched observation. Dividing these totals would
                      invent a rate.
                    </p>
                  </section>
                )}
              </section>
            </details>
            <details class="notes-group">
              <summary>Snapshot details</summary>{" "}
              <section class="report-provenance">
                <h2>Report details</h2>
                <dl>
                  <div>
                    <dt>Snapshot</dt>
                    <dd>{report?.id ?? "Unavailable"}</dd>
                  </div>
                  <div>
                    <dt>Captured</dt>
                    <dd>{report?.createdAt.replace("T", " ").slice(0, 19) ?? "Unavailable"} UTC</dd>
                  </div>
                  <div>
                    <dt>Dates</dt>
                    <dd>
                      {window.from} – {window.to}
                    </dd>
                  </div>
                  <div>
                    <dt>Time zone</dt>
                    <dd>UTC; dates may differ from your local day</dd>
                  </div>
                </dl>
                <a href="/activity/measurement/">Tracking, retention & privacy choices</a>
              </section>
            </details>
          </div>
        )}
      </div>
      <footer class="workbench-close">
        <a href="/activity/measurement/">Measurement & privacy</a>
        <a href="/connections/">Explore product stories</a>
        <a href="/activity/listening/">Games × Radio</a>
      </footer>
    </div>
  </div>
  <script
    type="application/json"
    id="activity-chart-data"
    set:html={JSON.stringify(dataPayload).replace(/</g, "\\u003c")}
  />
  <script
    type="application/json"
    id="report-sharing"
    set:html={JSON.stringify({ image, caption }).replace(/</g, "\\u003c")}
  />
</BaseLayout>
<script>
  import "../scripts/analytics-workbench";
</script>
