---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Labelled overflow regions require keyboard scrolling. */
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/analytics-workbench.css";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { listProjectRecords } from "../content/repository";
import {
  analyticsProjects,
  parseReportingWindow,
  periodFor,
  formatMetric,
  type AnalyticsProject,
  type PortfolioReport
} from "../data/portfolio-analytics";
import {
  createPortfolioReport,
  readPortfolioReport,
  projectReport,
  reportLink
} from "../data/portfolio-reports";
import {
  projectColours,
  dateDays,
  dailyPoints,
  dailyStatus,
  qualityText,
  svgPlot,
  measuresFor,
  resolveMeasure,
  productView,
  reportMetric,
  measureForProjectSwitch
} from "../data/analytics-workbench";
export const prerender = false;
Astro.cache.set(false);
Astro.response.headers.set("cache-control", "private, no-store");
if (Astro.url.searchParams.has("snapshot"))
  return Astro.redirect(`/activity/listening/${Astro.url.search}`, 302);
const now = Date.now();
const requestedWindow = parseReportingWindow(Astro.url.searchParams, now, 30);
const period = requestedWindow ?? periodFor(30, now);
const invalidWindow = !requestedWindow;
if (invalidWindow) Astro.response.status = 400;
const requested = Astro.url.searchParams.get("project");
if (requested && !analyticsProjects.includes(requested as AnalyticsProject))
  return new Response("Project unavailable.", { status: 404 });
const identities = await listProjectRecords();
if (identities.error)
  return new Response("Public project identities are unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
const publicIds = new Set(["woodhouse", ...identities.projects.map((p) => p.slug)]);
const selected = requested && publicIds.has(requested) ? (requested as AnalyticsProject) : null;
if (requested && !selected) return new Response("Project unavailable.", { status: 404 });
const view = productView(selected);
const choices = measuresFor(selected);
const requestedMeasure = Astro.url.searchParams.get("measure");
const measure = resolveMeasure(selected, requestedMeasure);
if (requestedMeasure && requestedMeasure !== measure.key) {
  const corrected = new URL(Astro.url);
  corrected.searchParams.set("measure", measure.key);
  return Astro.redirect(corrected.pathname + corrected.search, 302);
}
const names = new Map([
  ...identities.projects.map((p) => [p.slug, p.name] as const),
  ["woodhouse", "Woodhouse"]
]);
const frozen = Astro.url.searchParams.has("report");
let snapshot: PortfolioReport | null = null;
try {
  snapshot = frozen
    ? await readPortfolioReport(
        (env as unknown as { DB: D1Database }).DB,
        Astro.url.searchParams.get("report")!
      )
    : await createPortfolioReport(
        (env as unknown as { DB: D1Database }).DB,
        period.days,
        publicIds,
        fetch,
        now,
        Astro.url.searchParams.has("from") ? period : undefined
      );
} catch {
  /* Sources remain explicitly unavailable. */
}
if (frozen && !snapshot)
  return new Response("This saved report is unavailable.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
const report = snapshot ? projectReport(snapshot, selected, publicIds) : null;
const window = report?.period ?? period;
const allRows = analyticsProjects
  .filter((p) => publicIds.has(p))
  .map((project) => ({
    project,
    name: names.get(project) ?? project,
    data: snapshot?.projects.find((p) => p.project === project)?.report ?? null,
    colour: projectColours[project]!
  }));
const rows = allRows.filter((r) => !selected || r.project === selected);
const guestReceipts = allRows
  .find((r) => r.project === "app-composer")
  ?.data?.metrics.find((m) => m.key === "guest_postcards_received");
const groups = [
  {
    label: "Gameplay",
    keys: ["game_starts", "game_completions", "active_seconds", "game_replays"]
  },
  {
    label: "Visits & returns",
    keys: ["visits", "engaged_sessions", "browsers", "returning_browsers", "project_opens"]
  },
  {
    label: "App usage",
    keys: [
      "app_opens",
      "guest_postcards_received",
      "photo_opens",
      "inspection_completed",
      "actions"
    ]
  },
  {
    label: "Listening",
    keys: [
      "listening_seconds",
      "listening_starts",
      "game_listening_seconds",
      "game_listening_starts"
    ]
  }
]
  .map((group) => ({
    ...group,
    keys: group.keys.filter((key) => choices.some((m) => m.key === key))
  }))
  .filter((group) => group.keys.length);
const metricRows = rows.map((r) => ({
  ...r,
  metric: reportMetric(r.project, r.data?.metrics, measure.key)
}));
const headlines =
  selected && view
    ? [...new Set([...view.headlines, measure.key])].map((key) => ({
        ...rows[0]!,
        name: choices.find((m) => m.key === key)!.label,
        metric: rows[0]?.data?.metrics.find((m) => m.key === key)
      }))
    : metricRows;
const chartRows = metricRows.filter((r) => r.metric);
function daysForStatus(
  data: (typeof metricRows)[number]["data"],
  metric: (typeof metricRows)[number]["metric"]
) {
  return dateDays(window).map((day) => dailyStatus(data, metric, day));
}
const chartSeries = chartRows.map((r) => ({
  name: r.name,
  colour: r.colour,
  values: dailyPoints(r.metric, window),
  statuses: daysForStatus(r.data, r.metric)
}));
const hasDaily = chartSeries.some((s) => s.values.some((v) => v !== null));
const unit = chartRows[0]?.metric?.unit ?? (measure.key.endsWith("_seconds") ? "seconds" : "count");
const days = dateDays(window);
const available = rows.filter((r) => r.data?.metrics.some((m) => m.value !== null)).length;
const cleanDays = metricRows.map(
  (r) => days.filter((day) => dailyStatus(r.data, r.metric, day) === "clean").length
);
const longestClean = Math.max(0, ...cleanDays);
const qaOff = Astro.url.searchParams.get("analytics") === "off";
function pageLink(
  changes: {
    project?: AnalyticsProject | null;
    measure?: string;
    days?: number;
    latest?: boolean;
  } = {}
) {
  const q = new URLSearchParams();
  if (frozen && snapshot && !changes.latest && changes.days === undefined)
    q.set("report", snapshot.id);
  else if (changes.days !== undefined) q.set("days", String(changes.days));
  else if (Astro.url.searchParams.has("from") || frozen) {
    q.set("from", window.from);
    q.set("to", window.to);
  } else q.set("days", String(window.days));
  const project = changes.project === undefined ? selected : changes.project;
  if (project) q.set("project", project);
  q.set(
    "measure",
    changes.project !== undefined
      ? measureForProjectSwitch(selected, project ?? null, changes.measure ?? measure.key).key
      : resolveMeasure(project ?? null, changes.measure ?? measure.key).key
  );
  if (qaOff) q.set("analytics", "off");
  return `/activity/?${q}`;
}
const title = selected ? `${names.get(selected)} analytics` : "Portfolio analytics";
const link = report
  ? `${reportLink(report.id, selected).replace("https://woodhouse.loftwah.com", Astro.url.origin)}&measure=${measure.key}`
  : `https://woodhouse.loftwah.com/activity/`;
const image = report
  ? `/api/portfolio-card.png?report=${report.id}${selected ? `&project=${selected}` : ""}&measure=${measure.key}`
  : "/og/woodhouse.jpg";
const dateLabel = (date: string) =>
  new Date(date).toLocaleDateString("en-AU", {
    timeZone: "UTC",
    day: "numeric",
    month: "short",
    year: "numeric"
  });
const caption = report
  ? `${title} · ${dateLabel(window.from)} – ${dateLabel(window.to)} (UTC)\n${metricRows
      .filter((r) => r.metric?.value !== null && r.metric)
      .map(
        (r) =>
          `${r.name}: ${formatMetric(r.metric!)} ${measure.label.toLowerCase()} · ${qualityText(r.metric)}`
      )
      .join(
        "\n"
      )}\nReported activity, not unique people. ${window.complete ? "Closed calendar window; source coverage varies." : "Current UTC day is partial."} Legacy/test and coverage limitations apply; see report.\n${link}`
  : "";
const dataPayload = {
  period: window,
  measure: measure.label,
  unit,
  series: chartSeries,
  createdAt: report?.createdAt ?? null
};
---

<BaseLayout
  title={title}
  description={
    view?.description ??
    "Explore recorded gameplay, mini-app actions and audible listening. Interactive charts, custom UTC dates and clear source coverage across the Loftwah portfolio."
  }
  path={frozen ? link.replace(Astro.url.origin, "") : "/activity/"}
  currentPath="/activity/"
  image={image}
  imageAlt={`${title}: dated ${measure.label.toLowerCase()} report`}
  analyticsWorkbench
>
  <div class="analytics-workbench">
    <div class="project-rail">
      <nav aria-label="Analytics projects">
        <a href={pageLink({ project: null })} aria-current={!selected ? "page" : undefined}>
          <span class="rail-all" aria-hidden="true"></span>All projects{" "}
          <small>{allRows.length}</small>
        </a>
        {allRows.map((r) => (
          <a
            href={pageLink({ project: r.project })}
            aria-current={selected === r.project ? "page" : undefined}
          >
            <span class="source-dot" style={`--source:${r.colour}`} aria-hidden="true"></span>
            {r.name}
            <span
              class:list={[
                "rail-state",
                { "is-connected": r.data?.metrics.some((m) => m.value !== null) }
              ]}
              aria-label={
                r.data?.metrics.some((m) => m.value !== null) ? "Reporting" : "Unavailable"
              }
            ></span>
          </a>
        ))}
      </nav>
      <div class="rail-foot">
        <a href="/activity/measurement/">Measurement & privacy</a>
        <a href="/activity/listening/">Games × Radio</a>
        <a href="/projects/">Explore the projects</a>
      </div>
    </div>
    <div class="workbench-body">
      <header class="workbench-heading">
        <div>
          <h1>{title}</h1>
          {view && <p class="product-view-label">{view.label}</p>}
        </div>
        <div class="date-toolbar">
          <nav aria-label="Reporting period">
            {[7, 30, 90].map((n) => (
              <a
                href={pageLink({ days: n })}
                aria-current={
                  !frozen && !Astro.url.searchParams.has("from") && window.days === n
                    ? "page"
                    : undefined
                }
              >
                {n}d
              </a>
            ))}
          </nav>
          <details class="custom-range">
            <summary>Custom dates</summary>
            <form method="get" action="/activity/" class="custom-dates" data-date-form>
              {selected && <input type="hidden" name="project" value={selected} />}
              <input type="hidden" name="measure" value={measure.key} />
              {qaOff && <input type="hidden" name="analytics" value="off" />}
              <label>
                From{" "}
                <input
                  type="date"
                  name="from"
                  value={window.from}
                  max={new Date(now).toISOString().slice(0, 10)}
                  required
                />
              </label>
              <label>
                To{" "}
                <input
                  type="date"
                  name="to"
                  value={window.to}
                  max={new Date(now).toISOString().slice(0, 10)}
                  required
                />
              </label>
              <button type="submit">Apply dates</button>
              <span>UTC · max 90 days</span>
            </form>
          </details>
        </div>
        <a class="share-jump" href="#share-report">
          Share report{" "}
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              d="M10 13V2m0 0L6 6m4-4 4 4M4 10v7h12v-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </a>
      </header>
      {invalidWindow && (
        <p class="workbench-alert" role="alert">
          Choose real UTC dates in order, ending no later than today, with a maximum 90-day window.
          Showing the last 30 days while you correct the range.
        </p>
      )}
      <div class="snapshot-line">
        <span>
          {dateLabel(window.from)} – {dateLabel(window.to)} · {window.days}{" "}
          {window.days === 1 ? "day" : "days"} ·{" "}
          {window.complete ? "Closed calendar dates" : "Today is partial"}
        </span>
        <span>
          {available}/{rows.length} sources reporting {frozen ? "· Saved snapshot" : ""}
        </span>
      </div>
      {frozen && (
        <p class="saved-report">
          This report is frozen at {report?.createdAt.replace("T", " ").slice(0, 16)} UTC.{" "}
          <a href={pageLink({ latest: true })}>Refresh these dates</a> ·{" "}
          <a href={pageLink({ days: 30 })}>Latest 30 days</a>
        </p>
      )}
      <div class="analysis-layout">
        <div class="chart-column">
          <nav class="measure-navigation" aria-label="Choose a measure">
            {(groups.length === 1
              ? choices.map((m) => ({ label: m.label, keys: [m.key] }))
              : groups
            ).map((group) => (
              <a
                href={pageLink({ measure: group.keys[0]! })}
                aria-current={group.keys.includes(measure.key) ? "page" : undefined}
              >
                {group.label}
              </a>
            ))}
          </nav>
          <section class="main-chart" aria-labelledby="trend-heading">
            <div class="chart-heading">
              <div>
                <h2 id="trend-heading">{measure.label}</h2>
                <p>
                  {unit === "seconds" ? "Seconds per UTC day" : "Count per UTC day"} · gaps mean
                  unavailable
                </p>
              </div>
              <form class="measure-picker" method="get" action="/activity/">
                {[...new URL(pageLink(), Astro.url.origin).searchParams.entries()]
                  .filter(([key]) => key !== "measure")
                  .map(([key, value]) => (
                    <input type="hidden" name={key} value={value} />
                  ))}
                <label for="measure-picker">Measure</label>
                <select id="measure-picker" name="measure">
                  {groups.map((group) => (
                    <optgroup label={group.label}>
                      {choices
                        .filter((m) => group.keys.includes(m.key))
                        .map((m) => (
                          <option value={m.key} selected={m.key === measure.key}>
                            {m.label}
                          </option>
                        ))}
                    </optgroup>
                  ))}
                </select>
                <button type="submit">Show</button>
              </form>
              <div class="chart-type" data-chart-controls hidden>
                <button type="button" data-chart-type="line" aria-pressed="true">
                  Line
                </button>
                <button type="button" data-chart-type="bar" aria-pressed="false">
                  Bars
                </button>
              </div>
            </div>
            <p class="mobile-measure-reading">{measure.meaning}</p>
            <dl class="metric-strip">
              {headlines
                .filter((r) => selected || r.metric)
                .map((r) => (
                  <div>
                    <dt>
                      <span
                        class="source-dot"
                        style={`--source:${r.colour}`}
                        aria-hidden="true"
                      ></span>
                      {r.name}
                    </dt>
                    <dd>{r.metric ? formatMetric(r.metric) : "—"}</dd>
                    <small>
                      {qualityText(r.metric)}
                      {days.some((day) => dailyStatus(r.data, r.metric, day) === "legacy")
                        ? " · legacy in range"
                        : ""}
                    </small>
                  </div>
                ))}
            </dl>
            {!hasDaily && (
              <div class="chart-empty">
                <strong>No daily measurements for this selection</strong>
                <p>
                  Choose another measure, project or date range. An unavailable source does not mean
                  nobody used the product.
                </p>
              </div>
            )}
            <div
              class:list={["interactive-plot", { "has-no-data": !hasDaily }]}
              data-activity-chart
              aria-label={`${measure.label} daily chart`}
            >
              <div class="plot-fallback" set:html={svgPlot(chartSeries, window)} />
            </div>
            <div class="chart-legend">
              {chartRows.map((r) => (
                <button type="button" data-series-toggle={r.name} aria-pressed="true" disabled>
                  <i style={`--source:${r.colour}`} aria-hidden="true"></i>
                  {r.name}
                </button>
              ))}
            </div>
            <div class="chart-instructions">
              <p data-chart-help>
                {hasDaily
                  ? "Inspect a date to see source values. The data table below works without interactive charts."
                  : "No line is drawn for missing data."}
              </p>
              <button type="button" data-reset-zoom hidden>
                Reset zoom
              </button>
            </div>
            <details class="chart-data">
              <summary>Chart data & export</summary>
              <div class="day-inspector" data-day-inspector hidden>
                <label>
                  Inspect UTC day{" "}
                  <input
                    type="range"
                    min="0"
                    max={window.days - 1}
                    value={window.days - 1}
                    aria-label="Inspect UTC day"
                    data-inspect-day
                  />
                </label>
                <output data-day-output aria-live="polite"></output>
              </div>
              <p>
                These are daily values for {measure.label.toLowerCase()}. A dash means unavailable.
                Daily distinct-browser counts must not be added to estimate period-level people.
              </p>
              <button type="button" data-csv-download hidden>
                Download chart CSV
              </button>
              <div class="table-scroll" tabindex="0" role="region" aria-label="Daily chart values">
                <table>
                  <caption>
                    {measure.label}· UTC dates ·{unit}
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Date</th>
                      {metricRows.map((r) => (
                        <th scope="col">{r.name}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {days.map((d, i) => (
                      <tr>
                        <th scope="row">{d}</th>
                        {metricRows.map((r) => (
                          <td>
                            {dailyPoints(r.metric, window)[i]?.toLocaleString("en-AU") ?? "—"}
                            <small class="cell-coverage">{dailyStatus(r.data, r.metric, d)}</small>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>
          <section class="coverage-calendar" aria-labelledby="coverage-heading">
            <div class="section-title">
              <div>
                <h2 id="coverage-heading">Can we compare these dates?</h2>
                <p>Coverage for the selected measure. Colour describes evidence, not popularity.</p>
              </div>
            </div>
            <div class="coverage-legend">
              <span>
                <i class="clean"></i>Comparable full day
              </span>
              <span>
                <i class="partial"></i>Partial day
              </span>
              <span>
                <i class="legacy"></i>Legacy / test risk
              </span>
              <span>
                <i class="bounded"></i>Bounded / sampled
              </span>
              <span>
                <i class="missing"></i>Not measured
              </span>
            </div>
            <div
              class="calendar-scroll"
              tabindex="0"
              role="region"
              aria-label="Daily source coverage"
            >
              <div class="coverage-grid" style={`--days:${window.days}`}>
                <span></span>
                <div class="calendar-dates">
                  <span>{dateLabel(window.from)}</span>
                  <span>{dateLabel(window.to)}</span>
                </div>
                {metricRows.map((r) => (
                  <>
                    <a href={pageLink({ project: r.project })}>{r.name}</a>
                    <div class="calendar-cells">
                      {days.map((day) => (
                        <span
                          class={dailyStatus(r.data, r.metric, day)}
                          title={`${r.name} · ${day}: ${dailyStatus(r.data, r.metric, day)}${r.metric?.daily.find((d) => d.date === day) ? ` · ${r.metric.daily.find((d) => d.date === day)!.value} ${unit}` : ""}`}
                        ></span>
                      ))}
                    </div>
                  </>
                ))}
              </div>
            </div>
            <p class="coverage-caption">
              {longestClean > 0
                ? `The longest available comparable history in this selection is ${longestClean} complete daily observations.`
                : "No clean full-day comparison is available for this measure in this snapshot."}{" "}
              First collection days and today remain partial. Legacy activity may include tests that
              cannot be separated.
            </p>
          </section>
          <section class="source-register" aria-labelledby="sources-heading">
            <h2 id="sources-heading">Follow the numbers to their source</h2>
            <p>Every measure has a definition, a collection boundary and blind spots.</p>
            {rows.map((r) => (
              <details id={`source-${r.project}`}>
                <summary>
                  <span>
                    <i class="source-dot" style={`--source:${r.colour}`} aria-hidden="true"></i>
                    {r.name}
                  </span>
                  <span>
                    {r.data
                      ? `${r.data.metrics.filter((m) => m.value !== null).length} measures available`
                      : "Source unavailable"}
                  </span>
                </summary>
                {r.data ? (
                  <div class="source-detail">
                    <p>
                      <a href={r.data.source.endpoint}>Live aggregate endpoint</a> · generated{" "}
                      <time datetime={r.data.generatedAt}>{r.data.generatedAt}</time>
                    </p>
                    <dl class="source-dates">
                      <div>
                        <dt>Collection began</dt>
                        <dd>{r.data.coverage.startedAt ?? "Not established"}</dd>
                      </div>
                      <div>
                        <dt>Comparable history from</dt>
                        <dd>{r.data.coverage.comparableFrom ?? "Not established"}</dd>
                      </div>
                      <div>
                        <dt>Source revision</dt>
                        <dd>{r.data.source.revision ?? "Not supplied"}</dd>
                      </div>
                    </dl>
                    <ul>
                      {r.data.coverage.limitations.map((text) => (
                        <li>{text}</li>
                      ))}
                    </ul>
                    <dl class="definition-list">
                      {r.data.metrics.map((m) => (
                        <div>
                          <dt>
                            {m.label} <strong>{formatMetric(m)}</strong>
                            <small>{qualityText(m)}</small>
                          </dt>
                          <dd>{m.definition}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ) : (
                  <p>
                    This source did not supply a valid report for these dates. It may be
                    disconnected, not yet released, out of retained history or temporarily
                    unavailable. We cannot infer zero activity.
                  </p>
                )}
              </details>
            ))}
          </section>
        </div>
        <section class="interpretation" aria-label="Read this report">
          <section>
            <h2>What am I looking at?</h2>
            <p>{measure.meaning}</p>
            <p class="context-muted">
              The chart uses one measure and one unit at a time. Each coloured line belongs to a
              project; the source totals cover the selected window.
            </p>
          </section>
          <section>
            <h2>What does it tell us?</h2>
            {selected === "app-composer" && (
              <p>
                App opens show recorded access. Guestbook contribution opens show content being
                viewed. Completed Link Checks show a specific job finishing. These are different
                stages of value, measured separately—not a shared conversion funnel.
              </p>
            )}
            <p>
              {hasDaily
                ? "We can see when recorded activity occurred and inspect how it is distributed across the selected dates."
                : "This selection cannot currently establish a pattern of use."}
            </p>
            <p>
              {report?.analysis?.findings.length
                ? "Comparable full-week movements are listed below. They describe recorded activity; their causes are unknown."
                : "No clean growth comparison yet. New collection and legacy test traffic limit the history we can trust."}
            </p>
            {report?.analysis?.findings.map((f) => (
              <p>
                <strong>
                  {names.get(f.project)} · {f.label}: {f.changePercent > 0 ? "+" : ""}
                  {f.changePercent}%
                </strong>{" "}
                in the complete week {f.from}–{f.to}. {f.nextAction}
              </p>
            ))}
          </section>
          {selected === "app-composer" && (
            <section>
              <h2>Is the app delivering value?</h2>
              <p>
                {guestReceipts
                  ? "Received guest postcards count contributions accepted as pending for moderation. This is an admission count, not the current queue size. Optional reporting can miss submissions; it does not establish approval, publication, unique people or a conversion rate."
                  : "This snapshot does not report guest postcard receipts. Opens and mixed actions cannot establish that someone successfully submitted a postcard."}
              </p>
              {guestReceipts?.value === null && (
                <p>
                  No retained receipt measurement is available for these dates. History before the
                  first retained observation is unknown; receipt counts expire after 35 days.
                </p>
              )}
              <p>
                Creator activation, successful publications and outbound Linkarooie interactions
                remain unmeasured in this public report.
              </p>
              <p>
                Repeat use, task completion rates and value over time need app-specific outcome
                definitions and matched observation. Dividing these totals would invent a rate.
              </p>
            </section>
          )}
          <section class="investor-readout">
            <h2>If you’re assessing the business</h2>
            <p>
              <strong>Early product instrumentation, with material evidence gaps.</strong>
            </p>
            <dl>
              <div>
                <dt>Usage</dt>
                <dd>
                  {selected === "app-composer"
                    ? "Bounded access and task counters. Guest postcard receipts, where reported, are pending contributions; these signals do not establish users, creator activation or successful publication."
                    : `${available}/${rows.length} sources provide some activity. Reports are not verified people.`}
                </dd>
              </div>
              <div>
                <dt>Retention</dt>
                <dd>
                  No portfolio cohort-retention evidence. Returning browsers, where available, are a
                  narrower signal.
                </dd>
              </div>
              <div>
                <dt>Commercial proof</dt>
                <dd>
                  Revenue, paying customers, acquisition cost and customer value are not measured
                  here.
                </dd>
              </div>
            </dl>
            <p>
              Use this to ask better product questions. It cannot establish product–market fit,
              market demand or an investment case.
            </p>
            <a href="/projects/">Read the product dossiers</a>
          </section>
          <section id="share-report">
            <h2>Take the evidence with you</h2>
            <p>
              A dated snapshot, with the same measures and coverage. Refreshing a saved link never
              changes its figures.
            </p>
            {report ? (
              <details class="share-panel" data-share-panel>
                <summary>
                  Share report{" "}
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path
                      d="M10 13V2m0 0L6 6m4-4 4 4M4 10v7h12v-7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                </summary>
                <div class="share-actions">
                  <a href={`${image}&download=1`} download>
                    Download landscape PNG
                  </a>
                  <a href={`${image}&format=square&download=1`} download>
                    Download square PNG
                  </a>
                  <a href={`${image}&format=portrait&download=1`} download>
                    Download portrait PNG
                  </a>
                  <button data-report-share type="button" hidden>
                    Share image
                  </button>
                  <button data-report-copy type="button">
                    Copy caption + link
                  </button>
                  <a href={link}>Open frozen permalink</a>
                  <a href={`/api/portfolio-report.json?report=${report.id}`}>
                    Download public JSON
                  </a>
                  <p data-report-status role="status"></p>
                </div>
              </details>
            ) : (
              <p>Sharing is unavailable until a source report can be saved.</p>
            )}
          </section>
          <section class="report-provenance">
            <h2>Report details</h2>
            <dl>
              <div>
                <dt>Snapshot</dt>
                <dd>{report?.id ?? "Unavailable"}</dd>
              </div>
              <div>
                <dt>Captured</dt>
                <dd>{report?.createdAt.replace("T", " ").slice(0, 19) ?? "Unavailable"} UTC</dd>
              </div>
              <div>
                <dt>Dates</dt>
                <dd>
                  {window.from} – {window.to}
                </dd>
              </div>
              <div>
                <dt>Time zone</dt>
                <dd>UTC; dates may differ from your local day</dd>
              </div>
            </dl>
            <a href="/activity/measurement/">Tracking, retention & privacy choices</a>
          </section>
        </section>
      </div>
      <footer class="workbench-close">
        <p>
          Activity is a signal. Understanding comes from the product, the people using it and the
          limits of the measurement.
        </p>
        <a href="/activity/measurement/">Read how this is measured</a>
        <a href="/activity/listening/">Explore Games × Radio</a>
      </footer>
    </div>
  </div>
  <script
    type="application/json"
    id="activity-chart-data"
    set:html={JSON.stringify(dataPayload).replace(/</g, "\\u003c")}
  />
  <script
    type="application/json"
    id="report-sharing"
    set:html={JSON.stringify({ image, caption }).replace(/</g, "\\u003c")}
  />
</BaseLayout>
<script>
  import "../scripts/analytics-workbench";
</script>
