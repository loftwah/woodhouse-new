            {timeline.length > 0 ? (
              <details class="history-disclosure">
                <summary>Explore {timeline.length} dated release and collection notes</summary>
                <ol class="activity-history">
                  {timeline.map((note) => (
                    <li>
                      <time datetime={note.date}>{note.date}</time>
                      <div>
                        <strong>
                          {names.get(note.project) ?? note.project} · {note.title}
                        </strong>
                        <p>{note.detail}</p>
                        {note.href && (
                          <a href={note.href}>Read release evidence · reviewed {note.reviewedAt}</a>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
              </details>
            ) : (
              <p>No dated release or collection observations are available for this report.</p>
            )}
          </section>
          <section class="source-register" aria-labelledby="sources-heading">
            <h2 id="sources-heading">Follow the numbers to their source</h2>
            <p>Every measure has a definition, a collection boundary and blind spots.</p>
            {rows.map((r) => (
              <details id={`source-${r.project}`}>
                <summary>
                  <span>
                    <i class="source-dot" style={`--source:${r.colour}`} aria-hidden="true"></i>
                    {r.name}
                  </span>
                  <span>
                    {r.data
                      ? `${registerMetrics(r.data.metrics).filter((m) => m.value !== null).length} measures available`
                      : "Source unavailable"}
                  </span>
                </summary>
                {r.data ? (
                  <div class="source-detail">
                    <p>
                      <a href={r.data.source.endpoint}>Live aggregate endpoint</a> · generated{" "}
                      <time datetime={r.data.generatedAt}>{r.data.generatedAt}</time>
                    </p>
                    <dl class="source-dates">
                      <div>
                        <dt>Collection began</dt>
                        <dd>{r.data.coverage.startedAt ?? "Not established"}</dd>
                      </div>
                      <div>
                        <dt>Comparable history from</dt>
                        <dd>{r.data.coverage.comparableFrom ?? "Not established"}</dd>
                      </div>
                      <div>
                        <dt>Source revision</dt>
                        <dd>{r.data.source.revision ?? "Not supplied"}</dd>
                      </div>
                    </dl>
                    <ul>
                      {r.data.coverage.limitations.map((text) => (
                        <li>{text}</li>
                      ))}
                    </ul>
                    <dl class="definition-list">
                      {registerMetrics(r.data.metrics).map((m) => (
                        <div>
                          <dt>
                            {m.label} <strong>{formatMetric(m)}</strong>
                            <small>{qualityText(m)}</small>
                          </dt>
                          <dd>{m.definition}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ) : (
                  <p>
                    This source did not supply a valid report for these dates. It may be
                    disconnected, not yet released, out of retained history or temporarily
                    unavailable. We cannot infer zero activity.
                  </p>
                )}
              </details>
            ))}
          </section>
        </div>
        <section class="interpretation" aria-label="Read this report">
          <section>
            <h2>What am I looking at?</h2>
            <p>{measure.meaning}</p>
            <p class="context-muted">
              {overview
                ? "One row and one card per project, each on the measure its product view defines. The games, LoftwahFM, App Composer and Woodhouse report different units; the overview keeps them side by side without adding them together."
                : "The chart uses one measure and one unit at a time. Each coloured line belongs to a project; the source totals cover the selected window."}
            </p>
          </section>
          <section>
            <h2>What does it tell us?</h2>
            {selected === "app-composer" && (
              <p>
                App opens show recorded access. Guestbook contribution opens show content being
                viewed. Completed Link Checks show a specific job finishing. These are different
                stages of value, measured separately—not a shared conversion funnel.
              </p>
            )}
            <p>
              {overview
                ? available > 0
                  ? `${available} of ${applicable.length} projects report their own measure for these dates. A project that reports nothing keeps its measure named and shows no value rather than a zero.`
                  : "No project reports its own measure for these dates. That is a collection result for this window, not evidence that nobody used the products."
                : hasDaily
                  ? "We can see when recorded activity occurred and inspect how it is distributed across the selected dates."
                  : "This selection cannot currently establish a pattern of use."}
            </p>
            <p>
              {report?.analysis?.findings.length
                ? overview
                  ? "Complete-week movements across the portfolio. Each finding names its own project and measure; they are broader context and may describe a different measure from the chart."
                  : selected
                    ? `Complete-week movement for ${names.get(selected)}. Each finding names its own measure, which may differ from the chart above.`
                    : "Complete-week movements for the projects in this scope. Each finding names its own project and measure, which may differ from the chart above."
                : weekly.highlights.length
                  ? "A valid complete-week comparison appears under Last complete week. The operational alert above reports only movements past its own thresholds, so it stays quiet for smaller real observations."
                  : "No clean growth comparison yet. New collection and legacy test traffic limit the history we can trust."}
            </p>
            {report?.analysis?.findings.map((f) => (
              <p>
                <strong>
                  {names.get(f.project)} · {f.label}: {f.changePercent > 0 ? "+" : ""}
                  {f.changePercent}%
                </strong>{" "}
                in the complete week {f.from}–{f.to}
                {f.newBest ? `, a new best of ${f.comparedWeeks} comparable weeks` : ""}.{" "}
                {f.nextAction}
              </p>
            ))}
          </section>
          {report && (
            <section class="weekly" aria-labelledby="weekly-heading">
              <h2 id="weekly-heading">Last complete week</h2>
              <p class="context-muted">
                The most recent complete Monday–Sunday UTC week for each project's own headline
                measure, against the week before. A record needs exact daily history for two
                adjacent complete weeks; this is a valid comparison, not only the large movements
                that raise an operational alert.
              </p>
              {weekly.highlights.length > 0 ? (
                <ul class="weekly-list">
                  {weekly.highlights.map((h) => (
                    <li class:list={["weekly-row", { "is-record": h.newBest }]}>
                      <span class="weekly-head">
                        <span class="weekly-project">{h.name}</span>
                        <span class="weekly-measure">{h.measure.label}</span>
                        {h.newBest && <span class="weekly-record">New best</span>}
                      </span>
                      <span class="weekly-figures">
                        <strong>{formatMetric({ value: h.value, unit: h.unit })}</strong>
                        <span class="weekly-movement">
                          {h.changePercent === null
                            ? `no prior baseline (${formatMetric({ value: h.previous, unit: h.unit })} the week before)`
                            : `${h.changePercent > 0 ? "Up" : h.changePercent < 0 ? "Down" : "Level"} ${Math.abs(h.changePercent)}% from ${formatMetric({ value: h.previous, unit: h.unit })}`}
                        </span>
                      </span>
                      <span class="weekly-context">
                        {h.from}–{h.to}
                        {h.newBest
                          ? ` · best of ${h.comparedWeeks} comparable weeks`
                          : ` · ${h.comparedWeeks} comparable weeks`}
                        {" · "}
                        <a
                          href={pageLink({
                            project: h.project,
                            measure: h.measure.key,
                            week: h.from
                          })}
                        >
                          Share this week
                        </a>
                      </span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p>
                  No project has two complete comparable weeks yet, so no week-on-week figure is
                  shown. Collection is too recent to compare honestly, and nothing is inferred from
                  it.
                </p>
              )}
              {weekly.gaps.length > 0 && (
                <details class="weekly-gaps">
                  <summary>Why some projects are not compared ({weekly.gaps.length})</summary>
                  <ul>
                    {weekly.gaps.map((gap) => (
                      <li>
                        <strong>{gap.name}</strong>: {gap.reason}.
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )}
          {selected === "app-composer" && (
            <section>
              <h2>Is the app delivering value?</h2>
              <p>
                {guestReceipts
                  ? "Received guest postcards count contributions accepted as pending for moderation. This is an admission count, not the current queue size. Optional reporting can miss submissions; it does not establish approval, publication, unique people or a conversion rate."
                  : "This snapshot does not report guest postcard receipts. Opens and mixed actions cannot establish that someone successfully submitted a postcard."}
              </p>
              {guestReceipts?.value === null && (
                <p>
                  No retained receipt measurement is available for these dates. History before the
                  first retained observation is unknown; receipt counts expire after 35 days.
                </p>
              )}
              <p>
                Creator activation, successful publications and outbound Linkarooie interactions
                remain unmeasured in this public report.
              </p>
              <p>
                Repeat use, task completion rates and value over time need app-specific outcome
                definitions and matched observation. Dividing these totals would invent a rate.
              </p>
            </section>
          )}
          <section class="investor-readout">
            <h2>If you’re assessing the business</h2>
            <p>
              <strong>Early product instrumentation, with material evidence gaps.</strong>
            </p>
            <dl>
              <div>
                <dt>Usage</dt>
                <dd>
                  {selected === "app-composer"
                    ? "Bounded access and task counters. Guest postcard receipts, where reported, count submissions accepted for moderation; these signals do not establish users, creator activation or successful publication."
                    : `${available}/${applicable.length} ${overview ? "projects report their own measure" : "projects reporting this measure"}. ${sourcesReporting}/${allRows.length} sources provide some activity. Reports are not verified people.`}
                </dd>
              </div>
              <div>
                <dt>Retention</dt>
                <dd>
                  No portfolio cohort-retention evidence. Returning browsers, where available, are a
                  narrower signal.
                </dd>
              </div>
              <div>
                <dt>Commercial proof</dt>
                <dd>
                  Revenue, paying customers, acquisition cost and customer value are not measured
                  here.
                </dd>
              </div>
            </dl>
            <p>
              Use this to ask better product questions. It cannot establish product–market fit,
              market demand or an investment case.
            </p>
            <a href="/projects/">Read the product dossiers</a>
          </section>
          {!(storyFocus && destinationStory && report) &&
            (report ? (
              <ReportShare
                image={image}
                caption={caption}
                link={shareLink}
                jsonHref={`/api/portfolio-report.json?report=${report.id}`}
                alt={`${title}: dated ${overview ? "mixed-measure project overview" : measure.label.toLowerCase()} report`}
              />
            ) : (
              <section id="share-report">
                <h2>Take the evidence with you</h2>
                <p>Sharing is unavailable until a source report can be saved.</p>
              </section>
            ))}
          <section class="report-provenance">
            <h2>Report details</h2>
            <dl>
              <div>
                <dt>Snapshot</dt>
                <dd>{report?.id ?? "Unavailable"}</dd>
              </div>
              <div>
                <dt>Captured</dt>
                <dd>{report?.createdAt.replace("T", " ").slice(0, 19) ?? "Unavailable"} UTC</dd>
              </div>
              <div>
                <dt>Dates</dt>
                <dd>
                  {window.from} – {window.to}
                </dd>
              </div>
              <div>
                <dt>Time zone</dt>
                <dd>UTC; dates may differ from your local day</dd>
              </div>
            </dl>
            <a href="/activity/measurement/">Tracking, retention & privacy choices</a>
          </section>
        </section>
      </div>
      <footer class="workbench-close">
        <p>
          Activity is a signal. Understanding comes from the product, the people using it and the
          limits of the measurement.
        </p>
        <a href="/activity/measurement/">Read how this is measured</a>
        <a href="/activity/listening/">Explore Games × Radio</a>
      </footer>
    </div>
  </div>
  <script
    type="application/json"
    id="activity-chart-data"
    set:html={JSON.stringify(dataPayload).replace(/</g, "\\u003c")}
  />
  <script
    type="application/json"
    id="report-sharing"
    set:html={JSON.stringify({ image, caption }).replace(/</g, "\\u003c")}
  />
</BaseLayout>
<script>
  import "../scripts/analytics-workbench";
</script>
