---
import { getArtworkFallback } from "../data/site-metadata";
import BaseLayout from "../layouts/BaseLayout.astro";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { listProjectRecords } from "../content/repository";
import {
  analyticsProjects,
  parseDays,
  formatMetric,
  weeklyRecord,
  type AnalyticsProject,
  type Metric,
  type PortfolioReport
} from "../data/portfolio-analytics";
import {
  createPortfolioReport,
  readPortfolioReport,
  projectReport,
  reportLink
} from "../data/portfolio-reports";
export const prerender = false;
Astro.cache.set(false);
Astro.response.headers.set("cache-control", "private, no-store");
if (Astro.url.searchParams.has("snapshot"))
  return Astro.redirect(`/activity/listening/${Astro.url.search}`, 302);
const days = parseDays(Astro.url.searchParams.get("days"));
const requested = Astro.url.searchParams.get("project");
if (days === null || (requested && !analyticsProjects.includes(requested as AnalyticsProject)))
  return new Response("Invalid reporting period or project.", { status: 400 });
const result = await listProjectRecords();
if (result.error)
  return new Response("Public project identities are unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
const publicIds = new Set(["woodhouse", ...result.projects.map((p) => p.slug)]);
const selected = requested && publicIds.has(requested) ? (requested as AnalyticsProject) : null;
if (requested && !selected) return new Response("Project unavailable.", { status: 404 });
const db = (env as unknown as { DB: D1Database }).DB;
let snapshot: PortfolioReport | null = null;
try {
  snapshot = Astro.url.searchParams.has("report")
    ? await readPortfolioReport(db, Astro.url.searchParams.get("report")!)
    : await createPortfolioReport(db, days, publicIds);
} catch {
  /* Source unavailable remains an explicit reader state. */
}
if (Astro.url.searchParams.has("report") && !snapshot)
  return new Response("This report is unavailable.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
const report = snapshot ? projectReport(snapshot, selected, publicIds) : null;
const reportDays = report?.days ?? days;
const rows = analyticsProjects
  .filter((p) => publicIds.has(p) && (!selected || p === selected))
  .map((project) => ({
    project,
    identity: result.projects.find((p) => p.slug === project),
    data: report?.projects.find((p) => p.project === project)?.report ?? null
  }));
rows.sort(
  (a, b) =>
    Number(!!b.data?.metrics.some((m) => m.value !== null)) -
    Number(!!a.data?.metrics.some((m) => m.value !== null))
);
const highlights = rows
  .flatMap((r) => {
    const keys = selected
      ? ["game_starts", "game_completions", "app_opens", "actions", "listening_seconds", "visits"]
      : ["game_starts", "app_opens", "listening_seconds"];
    const metric = keys.flatMap(
      (k) => r.data?.metrics.filter((m) => m.key === k && m.value !== null) ?? []
    )[0];
    return metric ? [{ name: r.identity?.name ?? "Woodhouse", metric }] : [];
  })
  .slice(0, 2);
const names = new Map(rows.map((r) => [r.project, r.identity?.name ?? "Woodhouse"]));
const title = selected ? `${names.get(selected)} · Activity` : "Portfolio activity";
const link = report
  ? reportLink(report.id, selected).replace("https://woodhouse.loftwah.com", Astro.url.origin)
  : `${Astro.url.origin}/activity/`;
const image = report
  ? `/api/portfolio-card.png?report=${report.id}${selected ? `&project=${selected}` : ""}`
  : "/og/woodhouse.jpg";
const available = rows.filter((r) => r.data && r.data.metrics.some((m) => m.value !== null)).length;
const featuredKeys = [
  "game_starts",
  "game_completions",
  "active_seconds",
  "returning_browsers",
  "browsers",
  "engaged_sessions",
  "app_opens",
  "actions",
  "listening_seconds",
  "listening_starts",
  "visits",
  "project_opens"
];
function featured(metrics: Metric[]) {
  return [...metrics]
    .sort((a, b) => featuredKeys.indexOf(a.key) - featuredKeys.indexOf(b.key))
    .filter((m) => featuredKeys.includes(m.key))
    .slice(0, 6);
}
const caption = report
  ? `${selected ? names.get(selected) : "The Loftwah portfolio"} · ${report.days}-day report\n${rows
      .flatMap((r) => {
        const values = featured(r.data?.metrics ?? [])
          .filter((m) => m.value !== null)
          .slice(0, 2)
          .map((m) => `${formatMetric(m)} ${m.label.toLowerCase()}`);
        return values.length ? [`${r.identity?.name ?? "Woodhouse"}: ${values.join(" · ")}`] : [];
      })
      .join("\n")}\nUTC window includes a partial current day. Coverage varies by project.\n${link}`
  : "";
const stale = !!report && Date.now() - Date.parse(report.createdAt) > 86400000;
---

<BaseLayout
  title={title}
  description="Real play, useful actions and measured listening across the Loftwah portfolio. Explore dated public reports with clear coverage and images ready to share."
  path={
    report && Astro.url.searchParams.has("report")
      ? link.replace(Astro.url.origin, "")
      : `/activity/${selected ? `?project=${selected}` : ""}`
  }
  currentPath="/activity/"
  image={image}
  imageAlt={`${title}: ${reportDays}-day dated analytics report`}
>
  <div class="container observatory">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Woodhouse</a>
      <span>/</span>
      <a href="/activity/">Activity</a>
      {selected && (
        <>
          <span>/</span>
          <span>{names.get(selected)}</span>
        </>
      )}
    </nav>
    <header class="activity-header">
      <h1>
        {selected ? (
          names.get(selected)
        ) : (
          <>
            The work.
            <br />
            <em>The response.</em>
          </>
        )}
      </h1>
      <div class="activity-intro">
        {highlights.length > 0 && (
          <dl class="headline-readings">
            {highlights.map((h) => (
              <div>
                <dt>
                  {h.name} · {h.metric.label}
                </dt>
                <dd>{formatMetric(h.metric)}</dd>
                <small>
                  {h.metric.quality === "bounded" ? "Bounded count" : "Reported"} · {reportDays}{" "}
                  days
                </small>
              </div>
            ))}
          </dl>
        )}
        <p>
          {selected
            ? "A closer look at the play, actions and attention this project receives."
            : "Seven projects. Real play, useful actions and time well spent. Follow the numbers back to what people actually do."}
        </p>
        <a href="/activity/listening/">Games × Radio listening report</a>
        <span aria-hidden="true"> · </span>
        <a href="/share/">Share desk</a>
      </div>
    </header>
    <div class="report-toolbar">
      <nav aria-label="Reporting period">
        {[7, 30, 90].map((n) => (
          <a
            aria-current={n === reportDays ? "page" : undefined}
            href={`/activity/?days=${n}${selected ? `&project=${selected}` : ""}`}
          >
            {n} days
          </a>
        ))}
      </nav>
      <p>
        {report ? (
          <>
            <time datetime={report.createdAt}>
              {new Date(report.createdAt).toLocaleString("en-AU", {
                timeZone: "UTC",
                dateStyle: "medium",
                timeStyle: "short"
              })}{" "}
              UTC
            </time>
            <span>
              {available} of {rows.length} projects reporting
            </span>
          </>
        ) : (
          "Reporting is temporarily unavailable"
        )}
      </p>
    </div>
    {Astro.url.searchParams.has("report") && (
      <p class="pinned-note">
        Saved report · These figures belong to this snapshot. {stale && "This is an older report."}{" "}
        <a href={`/activity/?days=${reportDays}${selected ? `&project=${selected}` : ""}`}>
          See the latest
        </a>
      </p>
    )}
    {report && (
      <section class="report-share" aria-label="Share this report">
        <div>
          <h2>Your numbers. Ready to post.</h2>
          <p>Save an image or copy a caption with this report’s permanent link.</p>
        </div>
        <div class="share-actions">
          <a class="image-download" href={`${image}&download=1`} download>
            Download image
          </a>
          <button data-report-share type="button" hidden>
            Share image
          </button>
          <button data-report-copy type="button">
            Copy caption + link
          </button>
          <a href={link}>Report permalink</a>
          <span data-report-status role="status"></span>
        </div>
        <details class="report-preview">
          <summary>Preview report & choose a shape</summary>
          <nav aria-label="Image format">
            {["landscape", "square", "portrait"].map((shape) => (
              <a href={`${image}&format=${shape}&download=1`} download>
                {shape[0]!.toUpperCase() + shape.slice(1)} image
              </a>
            ))}
          </nav>
          <img
            src={image}
            width="1200"
            height="630"
            alt={`${title} report showing the same figures and coverage as this page`}
            loading="lazy"
          />
        </details>
      </section>
    )}
    <section class="project-ledger" aria-labelledby="projects-heading">
      <div class="ledger-heading">
        <h2 id="projects-heading">{selected ? "The latest window" : "Across the portfolio"}</h2>
        <p>{reportDays} days · UTC · Current day is partial</p>
      </div>
      {rows.map(({ project, identity, data }) => {
        const metrics = featured(data?.metrics ?? []);
        const trend = data?.metrics.find(
          (m) =>
            m.daily.length > 1 && m.value !== null && m.value > 0 && featuredKeys.includes(m.key)
        );
        const maximum = trend ? Math.max(...trend.daily.map((d) => d.value), 1) : 1;
        const record =
          trend && data
            ? weeklyRecord(
                trend,
                data.coverage,
                Date.parse(report?.createdAt ?? new Date().toISOString())
              )
            : null;
        return (
          <article class="project-row" id={project}>
            <div class="project-identity" data-project-artwork>
              {identity?.previewImage && (
                <a href={identity.siteUrl} aria-label={`Open the ${identity.name} site`}>
                  <img
                    src={identity.previewImage}
                    data-fallback-src={getArtworkFallback(identity).image}
                    data-fallback-alt={getArtworkFallback(identity).alt}
                    data-fallback-credit={getArtworkFallback(identity).credit}
                    width="1200"
                    height="630"
                    alt=""
                    loading="lazy"
                  />
                </a>
              )}
              <div>
                <h3>
                  <a href={`/activity/?project=${project}&days=${reportDays}`}>
                    {identity?.name ?? "Woodhouse"}
                  </a>
                </h3>
                {identity?.previewImage && (
                  <small class="artwork-credit" data-artwork-status>
                    Artwork from {identity.name}
                  </small>
                )}
                <p>
                  {project === "loftwahfm"
                    ? "Music & radio"
                    : project === "app-composer"
                      ? "Mini-apps"
                      : project === "woodhouse"
                        ? "Portfolio & publishing"
                        : "Gameplay"}
                </p>
              </div>
            </div>
            <div class="project-measurements">
              {metrics.length ? (
                <dl class="metrics">
                  {metrics.map((m) => (
                    <div>
                      <dt>{m.label}</dt>
                      <dd>{formatMetric(m)}</dd>
                      <small>
                        {m.value === null
                          ? "Not measured"
                          : m.quality === "bounded"
                            ? "Bounded count"
                            : m.quality === "sampled"
                              ? "Estimated"
                              : "Reported"}
                      </small>
                    </div>
                  ))}
                </dl>
              ) : (
                <div class="awaiting">
                  <strong>Awaiting a connected source</strong>
                  <p>This project’s measurements are unavailable in this snapshot.</p>
                </div>
              )}
              {trend && (
                <details class="trend">
                  <summary>
                    {trend.label} by day
                    <span>
                      {trend.daily[0]?.date} — {trend.daily.at(-1)?.date}
                    </span>
                  </summary>
                  <div class="bar-chart" aria-hidden="true">
                    {trend.daily.map((d) => (
                      <span
                        style={`--bar:${Math.max(0, (d.value / maximum) * 100)}%`}
                        title={`${d.date}: ${d.value}`}
                      ></span>
                    ))}
                  </div>
                  <table>
                    <caption>
                      {trend.label} · daily reported {trend.unit}
                    </caption>
                    <thead>
                      <tr>
                        <th scope="col">UTC date</th>
                        <th scope="col">{trend.label}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {trend.daily.map((d) => (
                        <tr>
                          <th scope="row">{d.date}</th>
                          <td>{d.value.toLocaleString("en-AU")}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </details>
              )}
              {record && (
                <p class="record">
                  {record.newBest ? (
                    <strong>New best in this report’s history</strong>
                  ) : (
                    <strong>Last complete week</strong>
                  )}{" "}
                  {record.value.toLocaleString("en-AU")} {trend?.label.toLowerCase()} ·{" "}
                  {record.from}–{record.to}
                  {record.comparison !== null &&
                    ` · ${record.comparison > 0 ? "+" : ""}${record.comparison}% against the preceding week`}
                  . Compared with {record.comparedWeeks - 1} complete weeks.
                </p>
              )}
              <p class="project-coverage">
                {data?.coverage.startedAt ? (
                  <>
                    Collection from {data.coverage.startedAt.slice(0, 10)} · {data.period.from}–
                    {data.period.to}
                    {Date.now() - Date.parse(data.generatedAt) > 86400000 &&
                      " · Source is more than a day old"}
                  </>
                ) : (
                  "Collection coverage has not been established."
                )}
              </p>
              <details class="metric-definitions">
                <summary>Sources & metric definitions</summary>
                {data ? (
                  <>
                    <p>
                      <a href={data.source.endpoint}>Public source</a> · Updated{" "}
                      <time datetime={data.generatedAt}>{data.generatedAt}</time>
                    </p>
                    {data.coverage.limitations.map((text) => (
                      <p>{text}</p>
                    ))}
                    <dl>
                      {data.metrics.map((m) => (
                        <div>
                          <dt>
                            {m.label}
                            {m.value === null ? " · unavailable" : ""}
                          </dt>
                          <dd>{m.definition}</dd>
                        </div>
                      ))}
                    </dl>
                  </>
                ) : (
                  <p>
                    The source has not supplied a valid report. Missing measurements do not mean
                    zero use.
                  </p>
                )}
              </details>
            </div>
          </article>
        );
      })}
    </section>
    {report?.analysis && report.analysis.findings.length > 0 && (
      <section class="measurement-note" aria-labelledby="weekly-findings-heading">
        <h2 id="weekly-findings-heading">What changed last week.</h2>
        {report.analysis.findings.map((finding) => (
          <p>
            <strong>
              {names.get(finding.project)} · {finding.label}
            </strong>
            : {formatMetric({ value: finding.value, unit: finding.unit })} against{" "}
            {formatMetric({ value: finding.previous, unit: finding.unit })} in the preceding week (
            {finding.changePercent > 0 ? "+" : ""}
            {finding.changePercent}%). {finding.from}–{finding.to} · complete UTC weeks.{" "}
            {finding.nextAction}
          </p>
        ))}
        <p>These are changes in reported activity. No cause has been established.</p>
      </section>
    )}
    <section class="measurement-note">
      <h2>Attention has more than one shape.</h2>
      <p>
        A visit is not a player. An app open is not a completed action. Music time is not gameplay
        time. Each project reports the actions it can actually observe, with its own coverage and
        counting rules.
      </p>
      <p>
        Browser events describe reported activity, not verified people or competitive scores.
        Offline play, privacy choices and blocked requests affect collection. Returning audiences
        and retention stay unavailable until a source can measure them defensibly. Records require
        comparable complete UTC weeks; short or partial history earns no badge.
      </p>
      {report && (
        <p>
          <a href={`/api/portfolio-report.json?report=${report.id}`}>
            Read this snapshot’s public data
          </a>
        </p>
      )}
      <p>
        <a href="/activity/measurement/">Measurement & privacy choices</a>
      </p>
    </section>
  </div>
  <script
    type="application/json"
    id="report-sharing"
    set:html={JSON.stringify({ image, caption }).replace(/</g, "\\u003c")}
  />
</BaseLayout>
<script>
  const payload = document.querySelector<HTMLScriptElement>("#report-sharing");
  if (payload) {
    const { image, caption } = JSON.parse(payload.textContent ?? "{}");
    const status = document.querySelector<HTMLElement>("[data-report-status]");
    document.querySelector("[data-report-copy]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(caption);
        if (status) status.textContent = "Caption and report link copied.";
      } catch {
        if (status)
          status.textContent = "Copy unavailable. Open the report permalink to share its address.";
      }
    });
    const button = document.querySelector<HTMLButtonElement>("[data-report-share]");
    let file: File | null = null;
    if (button && navigator.canShare && navigator.share) {
      fetch(image)
        .then(async (response) => {
          if (!response.ok) return;
          file = new File([await response.blob()], "woodhouse-report.png", { type: "image/png" });
          if (navigator.canShare({ files: [file] })) button.hidden = false;
        })
        .catch(() => {});
      button.addEventListener("click", async () => {
        if (!file) return;
        try {
          await navigator.share({ files: [file], text: caption });
        } catch (error) {
          if (error instanceof Error && error.name !== "AbortError" && status)
            status.textContent = "Image sharing unavailable. Use Download image.";
        }
      });
    }
  }
</script>
<style>
  .observatory {
    padding-block: 2rem 5rem;
  }
  .activity-header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: end;
    padding-block: 2rem 3rem;
  }
  .activity-header h1 {
    font-size: clamp(3.3rem, 6.7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }
  .activity-header h1 em {
    font-style: normal;
    color: var(--acid);
  }
  .headline-readings {
    display: flex;
    gap: 2rem;
    margin: 0 0 1.25rem;
  }
  .headline-readings dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .headline-readings dd {
    font-family: var(--display);
    font-size: 3rem;
    line-height: 1.1;
    margin: 0.25rem 0;
  }
  .headline-readings small {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .artwork-credit {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    margin: 0.3rem 0;
  }
  .activity-intro {
    max-width: 44ch;
  }
  .activity-intro p {
    font-size: 1.22rem;
    margin-top: 0;
  }
  .activity-intro a {
    font-size: 0.93rem;
  }
  .report-toolbar {
    border-block: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
    align-items: center;
  }
  .report-toolbar nav {
    display: flex;
    gap: 0.5rem;
  }
  .report-toolbar nav a {
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .report-toolbar [aria-current="page"] {
    background: var(--acid);
    color: var(--ink);
    font-weight: 700;
  }
  .report-toolbar p {
    font-size: 0.86rem;
    margin: 0;
    text-align: right;
    color: var(--muted);
  }
  .report-toolbar p span {
    display: block;
  }
  .pinned-note {
    padding: 1rem;
    background: var(--ink-raised);
  }
  .report-share {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 3rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .report-share h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }
  .report-share p {
    color: var(--muted);
    margin: 0;
    max-width: 43ch;
  }
  .share-actions {
    display: flex;
    gap: 0.6rem 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .share-actions a,
  .share-actions button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.94rem;
  }
  .share-actions .image-download {
    background: var(--acid);
    color: var(--ink);
    padding: 0.6rem 1rem;
    font-weight: 700;
    text-decoration: none;
  }
  .share-actions button {
    background: transparent;
    color: var(--paper);
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .share-actions span {
    width: 100%;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .report-preview {
    grid-column: 1/-1;
    max-width: 50rem;
  }
  .report-preview summary,
  .trend summary,
  .metric-definitions summary {
    cursor: pointer;
    padding-block: 0.75rem;
    min-height: 44px;
  }
  .report-preview nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: 1rem;
  }
  .report-preview nav a {
    min-height: 44px;
  }
  .report-preview img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .ledger-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding-block: 3rem 1rem;
  }
  .ledger-heading h2 {
    font-size: 2rem;
    margin: 0;
  }
  .ledger-heading p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }
  .project-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  .project-identity img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1200/630;
    object-fit: cover;
  }
  .project-identity h3 {
    font-size: 1.45rem;
    margin: 1rem 0 0.2rem;
  }
  .project-identity h3 a {
    text-decoration: none;
  }
  .project-identity p {
    color: var(--muted);
    margin: 0;
    font-size: 0.9rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 1.2rem;
  }
  .metrics dt {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .metrics dd {
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 2.25rem;
    line-height: 1.2;
    margin: 0.4rem 0;
    font-variant-numeric: tabular-nums;
  }
  .metrics small {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .awaiting {
    padding-block: 0.5rem 1rem;
  }
  .awaiting strong {
    font-size: 1.3rem;
  }
  .awaiting p {
    color: var(--muted);
    margin: 0.4rem 0;
