---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- Labelled overflow regions require keyboard scrolling. */
import EditionInvitation from "../components/EditionInvitation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/analytics-workbench.css";
import { env } from "cloudflare:workers";
import type { D1Database } from "@cloudflare/workers-types";
import { listProjectRecords, listPublicEvidence } from "../content/repository";
import {
  analyticsProjects,
  discoveryProjects,
  parseReportingWindow,
  periodFor,
  formatMetric,
  type AnalyticsProject,
  type PortfolioReport
} from "../data/portfolio-analytics";
import {
  createPortfolioReport,
  readPortfolioReport,
  projectReport,
  reportLink
} from "../data/portfolio-reports";
import {
  projectColours,
  dateDays,
  dailyPoints,
  dailyStatus,
  qualityText,
  reportQualifier,
  svgPlot,
  measuresFor,
  resolveMeasure,
  isOverviewMeasure,
  overviewMetric,
  overviewOrder,
  productView,
  reportCaption,
  reportMetric,
  measureScope,
  measureForProjectSwitch,
  weeklyHighlights,
  discoveryReferrals,
  modeMeasureGroups,
  modeBreakdowns,
  modeSplitNote
} from "../data/analytics-workbench";
import {
  releaseNotesFromEvidence,
  activityTimeline,
  browserReturnSignals
} from "../data/analytics-context";
import { analyticsObservations } from "../data/analytics-observations";
import { discoveryCaption, discoveryStory } from "../data/analytics-story";
import DiscoveryStoryPanel from "../components/DiscoveryStoryPanel.astro";
import ReportShare from "../components/ReportShare.astro";
import OutcomeFindings from "../components/OutcomeFindings.astro";
export const prerender = false;
Astro.cache.set(false);
Astro.response.headers.set("cache-control", "private, no-store");
if (Astro.url.searchParams.has("snapshot"))
  return Astro.redirect(`/activity/listening/${Astro.url.search}`, 302);
const now = Date.now();
const requestedWindow = parseReportingWindow(Astro.url.searchParams, now, 30);
const period = requestedWindow ?? periodFor(30, now);
const invalidWindow = !requestedWindow;
if (invalidWindow) Astro.response.status = 400;
const requested = Astro.url.searchParams.get("project");
if (requested && !analyticsProjects.includes(requested as AnalyticsProject))
  return new Response("Project unavailable.", { status: 404 });
const identities = await listProjectRecords();
if (identities.error)
  return new Response("Public project identities are unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
const publicIds = new Set(["woodhouse", ...identities.projects.map((p) => p.slug)]);
const selected = requested && publicIds.has(requested) ? (requested as AnalyticsProject) : null;
if (requested && !selected) return new Response("Project unavailable.", { status: 404 });
const view = productView(selected);
const choices = measuresFor(selected);
const requestedMeasure = Astro.url.searchParams.get("measure");
const measure = resolveMeasure(selected, requestedMeasure);
const overview = isOverviewMeasure(measure);
if (requestedMeasure && requestedMeasure !== measure.key) {
  const corrected = new URL(Astro.url);
  corrected.searchParams.set("measure", measure.key);
  return Astro.redirect(corrected.pathname + corrected.search, 302);
}
const names = new Map([
  ...identities.projects.map((p) => [p.slug, p.name] as const),
  ["woodhouse", "Woodhouse"]
]);
const frozen = Astro.url.searchParams.has("report");
const releaseEvidence = frozen ? null : await listPublicEvidence();
const releaseNotes =
  releaseEvidence && !releaseEvidence.error
    ? releaseNotesFromEvidence(releaseEvidence.evidence, publicIds, now)
    : undefined;
let snapshot: PortfolioReport | null = null;
try {
  snapshot = frozen
    ? await readPortfolioReport(
        (env as unknown as { DB: D1Database }).DB,
        Astro.url.searchParams.get("report")!
      )
    : await createPortfolioReport(
        (env as unknown as { DB: D1Database }).DB,
        period.days,
        publicIds,
        fetch,
        now,
        Astro.url.searchParams.has("from") ? period : undefined,
        releaseNotes
      );
} catch {
  /* Sources remain explicitly unavailable. */
}
if (frozen && !snapshot)
  return new Response("This saved report is unavailable.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
const report = snapshot ? projectReport(snapshot, selected, publicIds) : null;
const window = report?.period ?? period;
const timeline = report ? activityTimeline(report) : [];
const returnSignals = report ? browserReturnSignals(report) : [];
const measuredDestinations = identities.projects.filter(
  (p) => p.siteUrl && discoveryProjects.some((slug) => slug === p.slug)
);
const unmeasuredDestinations = identities.projects.filter(
  (p) => p.siteUrl && !discoveryProjects.some((slug) => slug === p.slug)
);
const allRows = analyticsProjects
  .filter((p) => publicIds.has(p))
  .map((project) => ({
    project,
    name: names.get(project) ?? project,
    data: snapshot?.projects.find((p) => p.project === project)?.report ?? null,
    colour: projectColours[project]!
  }));
const rows = allRows.filter((r) => !selected || r.project === selected);
const overviewRows = overview
  ? overviewOrder
      .filter((project) => publicIds.has(project))
      .map((project) => {
        const data = snapshot?.projects.find((p) => p.project === project)?.report ?? null;
        return {
          project,
          name: names.get(project) ?? project,
          colour: projectColours[project]!,
          data,
          // A project stays in the overview when its source is unavailable; the
          // measure is still named so a real reporting failure stays visible.
          overviewMeasure: measuresFor(project).find(
            (m) => m.key === productView(project)!.defaultMeasure
          )!,
          metric: overviewMetric(data, project)
        };
      })
  : [];
const scopedProjects = new Set(
  measureScope(
    rows.map((r) => r.project),
    measure.key
  )
);
const metricRows = overview
  ? overviewRows
  : rows
      .map((r) => ({
        ...r,
        overviewMeasure: null,
        metric: reportMetric(r.project, r.data?.metrics, measure.key)
      }))
      // Applicability comes from the product view, not from whether the source
      // returned a metric object: a game whose whole report is missing, or whose
      // report omits the measure, must stay in the scope and the denominator as
      // "Not measured" rather than disappear and flatter the coverage figure.
      .filter((r) => scopedProjects.has(r.project));
const guestReceipts = allRows
  .find((r) => r.project === "app-composer")
  ?.data?.metrics.find((m) => m.key === "guest_postcards_received");
const groups = [
  {
    label: "Gameplay",
    keys: ["game_starts", "game_completions", "active_seconds", "game_replays"]
  },
  // Local play and online play are the mode grouping, not a separate measurement:
  // each group is the sum of the mode measures it names, and both groups together
  // equal the gameplay measure above them. The groups only survive the filter
  // below for a project whose client reports more than one mode.
  ...modeMeasureGroups.map((group) => ({ label: group.label, keys: [...group.keys] })),
  {
    label: "Visits & returns",
    keys: ["visits", "engaged_sessions", "browsers", "returning_browsers", "project_opens"]
  },
  {
    label: "App usage",
    keys: [
      "app_opens",
      "guest_postcards_received",
      "photo_opens",
      "inspection_completed",
      "actions"
    ]
  },
  {
    label: "Listening",
    keys: [
      "listening_seconds",
      "listening_starts",
      "game_listening_seconds",
      "game_listening_starts"
    ]
  }
]
  .map((group) => ({
    ...group,
    keys: group.keys.filter((key) => choices.some((m) => m.key === key))
  }))
  .filter((group) => group.keys.length);
const headlines =
  selected && view
    ? [...new Set([...view.headlines, measure.key])].map((key) => ({
        ...rows[0]!,
        name: choices.find((m) => m.key === key)!.label,
        metric: rows[0]?.data?.metrics.find((m) => m.key === key)
      }))
    : metricRows;
// The chart, its legend and the exported CSV describe the same applicable scope
// as the daily table and the coverage calendar. An in-scope project with no
// observation keeps its column and legend entry as an all-gap series rather than
// vanishing from one representation while the others still count it.
const chartRows = metricRows;
function daysForStatus(
  data: (typeof metricRows)[number]["data"],
  metric: (typeof metricRows)[number]["metric"]
) {
  return dateDays(window).map((day) => dailyStatus(data, metric, day));
}
const chartSeries = chartRows.map((r) => ({
  name: r.name,
  colour: r.colour,
  values: dailyPoints(r.metric, window),
  statuses: daysForStatus(r.data, r.metric)
}));
const hasDaily = chartSeries.some((s) => s.values.some((v) => v !== null));
const unit =
  chartRows.find((r) => r.metric)?.metric?.unit ??
  (measure.key.endsWith("_seconds") ? "seconds" : "count");
const days = dateDays(window);
// Applicable scope, never a truthy-value count: a project that should report this
// measure but did not stays in the denominator as "not measured".
const applicable = overview ? overviewRows : metricRows;
const available = applicable.filter((r) => r.metric?.value !== null && r.metric).length;
const cleanDays = metricRows.map(
  (r) => days.filter((day) => dailyStatus(r.data, r.metric, day) === "clean").length
);
const longestClean = Math.max(0, ...cleanDays);
const sourcesReporting = allRows.filter((r) =>
  r.data?.metrics.some((m) => m.value !== null)
).length;
// The last complete week is evaluated against the frozen report's own capture
// time, so a saved snapshot keeps describing the same weeks after it is reopened.
// Retained lookback history is preferred, so a seven-day report can still show
// the comparison it was created from.
const weekly = report
  ? weeklyHighlights(report.projects, names, Date.parse(report.createdAt), report.history)
  : { highlights: [], gaps: [] };
// `?week=<monday>` names the highlighted week a shared link was created from. An
// unknown, malformed or non-matching value is dropped rather than rendered as a
// different week than the link promised.
const requestedWeek = /^\d{4}-\d{2}-\d{2}$/.test(Astro.url.searchParams.get("week") ?? "")
  ? Astro.url.searchParams.get("week")
  : null;
const week = requestedWeek
  ? (weekly.highlights.find(
      (highlight) =>
        highlight.from === requestedWeek &&
        (!selected || highlight.project === selected) &&
        // The same gate the shared PNG applies, so a page, its caption and its
        // image can never name different projects or measures for one week.
        (overview || highlight.measure.key === measure.key)
    ) ?? null)
  : null;
// Woodhouse discovery referrals. The collector stores one counter per
// destination; the page keeps only destinations that are still published and
// links them, because a withdrawn project must not stay linked from here.
const discoveryTotal =
  allRows
    .find((r) => r.project === "woodhouse")
    ?.data?.metrics.find((m) => m.key === "project_opens")?.value ?? null;
const destinationParams = Astro.url.searchParams.getAll("destination");
const requestedDestination = destinationParams[0] ?? null;
// A duplicated parameter is the exact legacy shape the old rail produced. Keep
// the first value and drop the rest so the address cannot carry two selections.
if (destinationParams.length > 1) {
  const corrected = new URL(Astro.url);
  corrected.searchParams.delete("destination");
  if (requestedDestination) corrected.searchParams.set("destination", requestedDestination);
  return Astro.redirect(corrected.pathname + corrected.search, 302);
}
// One predicate for the measured destination subset: a public discovery project
// with a site address. The opening finding, destination rail, story ranking and
// image API all read this same set instead of inferring it from a display map.
const publishedDestinations = identities.projects.filter(
  (p) => p.siteUrl && discoveryProjects.includes(p.slug as (typeof discoveryProjects)[number])
);
const publishedDestinationSlugs = new Set(publishedDestinations.map((p) => p.slug));
const discovery = discoveryReferrals(
  allRows.find((r) => r.project === "woodhouse")?.data?.metrics,
  publishedDestinationSlugs,
  names,
  new Map(identities.projects.map((p) => [p.slug, p.siteUrl ?? null] as const)),
  window
);
// The discovery journey keeps its selected destination in the URL so a shared
// or reloaded link describes the same hand-off. Selection is resolved here, once:
// a published destination keeps its own story even when this report retained no
// clicks for it; an unknown slug falls back to the busiest measured destination.
const requestedDestinationEntry = requestedDestination
  ? publishedDestinations.find((p) => p.slug === requestedDestination)
  : undefined;
const topDestination = discovery[0]
  ? publishedDestinations.find((p) => p.slug === discovery[0]!.slug)
  : undefined;
const destinationEntry = requestedDestinationEntry ?? topDestination ?? publishedDestinations[0];
const destinationStory = destinationEntry
  ? discoveryStory({
      report,
      slug: destinationEntry.slug as AnalyticsProject,
      name: destinationEntry.name,
      siteUrl: destinationEntry.siteUrl ?? null,
      period: window,
      published: publishedDestinationSlugs
    })
  : null;
const destinationSlug = destinationStory?.slug ?? null;
// The destination rail stays complete for the measured subset: a project with
// no retained counter is part of the honest list and can be inspected, rather
// than disappearing as if it were never measured.
const referralMetrics = new Map(
  (
    allRows
      .find((r) => r.project === "woodhouse")
      ?.data?.metrics.filter((m) => m.key.startsWith("referral_")) ?? []
  ).map((m) => [m.key.slice("referral_".length).replaceAll("_", "-"), m] as const)
);
const destinationChoices = publishedDestinations
  .map((p) => ({
    slug: p.slug,
    name: p.name,
    siteUrl: p.siteUrl,
    colour: projectColours[p.slug] ?? "#b4c0d2",
    // A retained zero is a measured zero; an absent counter is missing history.
    value: referralMetrics.get(p.slug)?.value ?? null
  }))
  .sort((a, b) => (b.value ?? -1) - (a.value ?? -1) || a.name.localeCompare(b.name));
const explicitDestination = Boolean(
  requestedDestination && publishedDestinations.some((p) => p.slug === requestedDestination)
);
// The fallback story is displayed inline, but it is not a selection the URL
// should claim. Only an explicit, published destination becomes share scope.
const selectedDestinationSlug = explicitDestination ? destinationSlug : null;
// The destination belongs to the discovery view only. An old or hand-edited
// link that carries it onto another measure would leave the URL claiming a
// selection the page never shows, so it is normalised once at the route.
const discoveryView = overview || selected === "woodhouse";
if (requestedDestination && (!discoveryView || !explicitDestination)) {
  const corrected = new URL(Astro.url);
  corrected.searchParams.delete("destination");
  return Astro.redirect(corrected.pathname + corrected.search, 302);
}
// The local-versus-online split of the selected project's additive gameplay
// counters. It comes from the payload, not from the project name: a source that
// publishes no mode subtotal shows no breakdown, and nothing is inferred from the
// overall counter alone. `rows[0]` is the selected project's row (or the first
// public project under the mixed overview), and only a real split produces rows.
const modes = overview ? [] : modeBreakdowns(rows[0]?.data?.metrics, window);
const modeNote = modeSplitNote(modes);
// Destination referral counters are surfaced in their own section, not repeated
// as generic source definitions.
const registerMetrics = (metrics: NonNullable<(typeof allRows)[number]["data"]>["metrics"]) =>
  metrics.filter((m) => !m.key.startsWith("referral_"));
const qaOff = Astro.url.searchParams.get("analytics") === "off";
// `?qa` (any value) is the other documented measurement exclusion. It must
// survive every control so a QA pass cannot silently start reporting.
const qaValue = Astro.url.searchParams.get("qa");
function pageLink(
  changes: {
    project?: AnalyticsProject | null;
    measure?: string;
    days?: number;
    latest?: boolean;
    from?: string;
    to?: string;
    week?: string;
    destination?: string | null;
    /** Freeze this exact report instead of recomputing a window. */
    report?: string | null;
  } = {}
) {
  const q = new URLSearchParams();
  if (changes.report) {
    q.set("report", changes.report);
  } else if (changes.from && changes.to) {
    q.set("from", changes.from);
    q.set("to", changes.to);
  } else if (
    snapshot &&
    !changes.latest &&
    changes.days === undefined &&
    (frozen || Boolean(changes.week))
  )
    // A highlighted week must carry the report it was read from, so reopening the
    // link later still shows the same week, the same previous period and the same
    // record basis instead of a freshly recomputed window.
    q.set("report", snapshot.id);
  else if (changes.days !== undefined) q.set("days", String(changes.days));
  else if (Astro.url.searchParams.has("from") || frozen) {
    q.set("from", window.from);
    q.set("to", window.to);
  } else q.set("days", String(window.days));
  const project = changes.project === undefined ? selected : changes.project;
  if (project) q.set("project", project);
  const measureKey =
    changes.project !== undefined
      ? measureForProjectSwitch(selected, project ?? null, measure.key, changes.measure).key
      : resolveMeasure(project ?? null, changes.measure ?? measure.key).key;
  q.set("measure", measureKey);
  if (changes.week !== undefined) {
    if (changes.week) q.set("week", changes.week);
  } else if (week) q.set("week", week.from);
  // A destination only describes the discovery view. Carrying it onto a project
  // or measure that does not render that view would make the URL claim a scope
  // the page does not show, so it is dropped at this one boundary.
  const discoveryVisible =
    project === "woodhouse" || (project === null && isOverviewMeasure({ key: measureKey }));
  const keepDestination =
    changes.destination === undefined
      ? discoveryVisible
        ? selectedDestinationSlug
        : null
      : changes.destination;
  if (keepDestination) q.set("destination", keepDestination);
  if (qaOff) q.set("analytics", "off");
  if (qaValue !== null) q.set("qa", qaValue || "1");
  return `/activity/?${q}`;
}
// Only the discovery scope earns the destination story in the shared link,
// image and caption. A visits page can still show the discovery section, but its
// saved report describes the visits selection rather than a different story.
const storyShare = Boolean(
  explicitDestination && destinationStory && (overview || measure.key === "project_opens")
);
// A destination click lands on the focus panel when this scope supports it;
// otherwise it lands on the inline story in the discovery section.
const destinationAnchor =
  overview || measure.key === "project_opens"
    ? "discovery-story"
    : "discovery-story-inline-heading";
const storyFocus = Boolean(explicitDestination && storyShare);
const storyScopeLink =
  destinationStory && report
    ? `${pageLink({
        project: "woodhouse",
        measure: "project_opens",
        destination: destinationStory.slug,
        report: report.id
      })}#discovery-story`
    : undefined;
const title =
  storyShare && destinationStory
    ? `Woodhouse → ${destinationStory.name}: project discovery`
    : selected
      ? `${names.get(selected)} analytics`
      : "Portfolio analytics";
const shareDestination = storyShare ? selectedDestinationSlug : null;
const link = report
  ? storyShare
    ? `${reportLink(report.id, "woodhouse").replace("https://woodhouse.loftwah.com", Astro.url.origin)}&measure=project_opens${week ? `&week=${week.from}` : ""}${shareDestination ? `&destination=${shareDestination}` : ""}`
    : `${reportLink(report.id, selected).replace("https://woodhouse.loftwah.com", Astro.url.origin)}&measure=${measure.key}${week ? `&week=${week.from}` : ""}`
  : `https://woodhouse.loftwah.com/activity/`;
// The visible permalink keeps a measurement exclusion; the canonical `link`
// published in page metadata and the shared caption must not carry a QA
// parameter, so only this navigable copy is augmented.
const shareLink = (() => {
  try {
    const url = new URL(link);
    if (qaOff) url.searchParams.set("analytics", "off");
    if (qaValue !== null) url.searchParams.set("qa", qaValue || "1");
    return url.href;
  } catch {
    return link;
  }
})();
const image = report
  ? storyShare
    ? `/api/portfolio-card.png?report=${report.id}&project=woodhouse&measure=project_opens${week ? `&week=${week.from}` : ""}&destination=${shareDestination}`
    : `/api/portfolio-card.png?report=${report.id}${selected ? `&project=${selected}` : ""}${overview ? "" : `&measure=${measure.key}`}${week ? `&week=${week.from}` : ""}`
  : "/og/woodhouse-workshop-20261018.jpg";
const dateLabel = (date: string) =>
  new Date(date).toLocaleDateString("en-AU", {
    timeZone: "UTC",
    day: "numeric",
    month: "short",
    year: "numeric"
  });
const caption = report
  ? storyShare && destinationStory
    ? discoveryCaption(destinationStory, link, dateLabel)
    : reportCaption(
        metricRows.map((r) => ({
          name: r.name,
          metric: r.metric,
          overviewMeasure: r.overviewMeasure,
          report: r.data
        })),
        measure,
        window,
        link,
        dateLabel,
        week
          ? {
              name: week.name,
              project: week.project,
              from: week.from,
              to: week.to,
              value: week.value,
              previous: week.previous,
              unit: week.unit,
              changePercent: week.changePercent,
              newBest: week.newBest,
              comparedWeeks: week.comparedWeeks
            }
          : undefined
      )
  : "";
/**
 * The opening board. It reads only what this report already established and
 * names its own limits, so a finding cannot appear here that the rest of the
 * page contradicts.
 */
const opening = analyticsObservations({
  window,
  colours: projectColours,
  weekly: weekly.highlights,
  discovery,
  discoveryTotal,
  rows: allRows.map((row) => ({
    project: row.project,
    name: row.name,
    data: row.data,
    defaultMeasure: productView(row.project)!.defaultMeasure
  })),
  links: {
    week: (project, weekMeasure, from) =>
      `${pageLink({ project, measure: weekMeasure, week: from })}#week-focus`,
    project: (project, projectMeasure) => pageLink({ project, measure: projectMeasure }),
    discovery: () =>
      `${pageLink({
        project: "woodhouse",
        measure: "project_opens",
        destination: discovery[0]?.slug ?? null,
        report: report?.id ?? null
      })}#discovery-story`
  },
  dateLabel
});
const dataPayload = {
  period: window,
  measure: measure.label,
  unit,
  overview,
  series: chartSeries.map((s) => {
    const row = metricRows.find((r) => r.name === s.name);
    return overview && row?.overviewMeasure
      ? { ...s, measure: row.overviewMeasure.label, unit: row.metric?.unit ?? unit }
      : s;
  }),
  createdAt: report?.createdAt ?? null
};
---

<BaseLayout
  title={title}
  description={
    storyShare && destinationStory
      ? destinationStory.headline
      : (view?.description ??
        "How the portfolio is being used: each project's own measure, with dated charts, custom UTC dates and clear source coverage.")
  }
  path={frozen ? link.replace(Astro.url.origin, "") : "/activity/"}
  currentPath="/activity/"
  image={image}
  imageAlt={
    storyShare && destinationStory
      ? destinationStory.value === null
        ? destinationStory.headline
        : `Woodhouse to ${destinationStory.name}: ${destinationStory.valueLabel} recorded project opens, ${window.from} to ${window.to} UTC`
      : `${title}: dated ${overview ? "mixed-measure project overview" : measure.label.toLowerCase()} report`
  }
  analyticsWorkbench
>
  <div class="analytics-workbench">
    <div class="project-rail">
      <nav aria-label="Analytics projects">
        <a href={pageLink({ project: null })} aria-current={!selected ? "page" : undefined}>
          <span class="rail-all" aria-hidden="true"></span>All projects{" "}
          <small>{allRows.length}</small>
        </a>
        {allRows.map((r) => (
          <a
            href={pageLink({ project: r.project })}
            aria-current={selected === r.project ? "page" : undefined}
          >
            <span class="source-dot" style={`--source:${r.colour}`} aria-hidden="true"></span>
            {r.name}
            <span
              class:list={[
                "rail-state",
                { "is-connected": r.data?.metrics.some((m) => m.value !== null) }
              ]}
              aria-label={
                r.data?.metrics.some((m) => m.value !== null) ? "Reporting" : "Unavailable"
              }
            ></span>
          </a>
        ))}
      </nav>
      <div class="rail-foot">
        <a href="/activity/measurement/">Measurement & privacy</a>
        <a href="/activity/listening/">Games × Radio</a>
        <a href="/connections/">Explore connected products</a>
        <a href="/editions/one-more-round/#distribution">Edition discovery</a>
        <a href="/projects/">Explore the projects</a>
      </div>
    </div>
    <div class="workbench-body">
      <EditionInvitation />
      <header class="workbench-heading">
        <div>
          <h1>{selected ? `${names.get(selected)} analytics` : "Analytics"}</h1>
          <p class="product-view-label">
            {view ? view.label : "Each project on its own relevant measure"}
          </p>
        </div>
        <div class="date-toolbar">
          <nav aria-label="Reporting period">
            {[7, 30, 90].map((n) => (
              <a
                href={pageLink({ days: n })}
                aria-current={
                  !frozen && !Astro.url.searchParams.has("from") && window.days === n
                    ? "page"
                    : undefined
                }
              >
                {n}d
              </a>
            ))}
          </nav>
