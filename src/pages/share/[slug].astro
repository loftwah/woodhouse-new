---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_ORIGIN } from "../../data/site-origin.ts";
import ShowcaseGallery from "../../components/ShowcaseGallery.astro";
import ShareActions from "../../components/ShareActions.astro";
import CampaignFormats from "../../components/CampaignFormats.astro";
import { listProjectRecords } from "../../content/repository";
import {
  publicCampaignItems,
  campaignCollectionPath,
  campaignSocial
} from "../../data/showcase-public";
import { toJsonLd } from "../../data/safe-json";
import { getArtworkFallback, socialCardFor, getSiteMetadata } from "../../data/site-metadata";
import { projectActionHref, projectActionLabel } from "../../data/project-actions";
import { defaultProjectType } from "../../data/share-browser";
import { projectCaption } from "../../data/share-desk";
import { liveProjectArtwork } from "../../data/live-project-artwork";

export const prerender = false;
const result = await listProjectRecords();
if (result.error)
  return new Response("The gallery is temporarily unavailable.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const slug = Astro.params.slug ?? "";
const recordedProject = result.projects.find((entry) => entry.slug === slug);
const project = recordedProject ? await liveProjectArtwork(recordedProject) : undefined;
const items = publicCampaignItems(result.projects.map((entry) => entry.slug)).filter(
  (item) => item.project === slug
);
if (!project && (slug !== "woodhouse" || !items.length))
  return new Response("Gallery not found.", { status: 404 });
if (Astro.cache?.enabled) for (const hint of result.cacheHints) Astro.cache.set(hint);
const name = project?.name ?? "Woodhouse";
const projectHref = project ? projectActionHref(project) : "/";
const dossierHref = project ? `/projects/${slug}/` : null;
const archiveHref = project
  ? `/share/?${new URLSearchParams({ project: slug, type: defaultProjectType(slug) })}`
  : "/share/?type=factory";
const currentItems = items.filter((item) => !item.archived);
const archivedItems = items.filter((item) => item.archived);
const socialPack =
  items.find((item) => !item.archived && item.socialPack)?.socialPack ??
  (items.some((item) => item.formats && !item.archived)
    ? `/campaign/20261112/${slug}-social-pack.zip`
    : undefined);
const collectionLabel = items.length ? "Artwork & screenshots" : "Link card";
const title = `${name} — ${collectionLabel.toLowerCase()}`;
const description = project
  ? items.length
    ? `${project.summary} Explore ${name} promotional artwork and current product captures, with original downloads and a direct link to the product.`
    : `${project.summary} Download the link card and copy a caption to share ${name}.`
  : "Games, software and music from the Loftwah software factory. Explore the Woodhouse campaign, open the real products and download the original artwork.";
const social = campaignSocial(items)!;
// The product owns its identity. Campaign pieces stay in the gallery.
const productSocial = project ? socialCardFor(project) : null;
const artworkFallback = project ? getArtworkFallback(project) : null;
const path = campaignCollectionPath(slug);
const origin = Astro.site?.origin ?? SITE_ORIGIN;
// The ready-to-post caption ends with its destination. On the page that
// destination is a real link a few pixels away, so the displayed caption drops
// the bare address while the copyable text keeps it.
const captionText = (caption: string) =>
  caption
    .split("\n")
    .filter((line) => !/^https?:\/\/\S+$/.test(line.trim()))
    .join("\n")
    .trim();
const hostOf = (href: string) => {
  try {
    return new URL(href).hostname;
  } catch {
    return new URL(href, origin).hostname;
  }
};
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  currentPath="/share/"
  image={productSocial?.image ?? social?.original}
  imageAlt={productSocial?.alt ?? social?.alt}
  imageWidth={productSocial?.width ?? social?.width}
  imageHeight={productSocial?.height ?? social?.height}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: title,
      description,
      url: `${origin}${path}`,
      hasPart: items.map((item) => ({
        "@type": "ImageObject",
        name: item.title,
        description: item.alt,
        contentUrl: new URL(item.original, origin).href,
        thumbnailUrl: new URL(item.image, origin).href,
        caption: item.caption,
        creditText: item.credit,
        dateCreated: item.reviewedAt
      }))
    })}
  />
  <div class="container collection">
    <nav aria-label="Breadcrumb">
      <a href="/share/">Share gallery</a>
      <span aria-hidden="true"> / </span>
      <span>{name}</span>
    </nav>
    <header>
      <h1>
        {name}
        <span>{collectionLabel}</span>
      </h1>
      <p>{project?.title ?? "Games, software and music. A selection from the things we make."}</p>
      <div class="collection__links">
        <a href={projectHref}>
          {items[0]?.action
            ? `${items[0].action} ${name}`
            : project
              ? projectActionLabel(project)
              : "Explore Woodhouse"}{" "}
          ↗
        </a>
        {dossierHref && dossierHref !== projectHref && <a href={dossierHref}>About {name}</a>}
        {slug === "liferaft" && (
          <a href="https://liferaft.loftwah.com/media/">Current icon and screenshot</a>
        )}
        {socialPack && (
          <a href={socialPack} download>
            Download social pack
          </a>
        )}
        {items.some((item) => item.id.startsWith("making-of-")) && (
          <a href={`/share/originals/?project=${encodeURIComponent(slug)}`}>
            Original art &amp; drawings
          </a>
        )}
        {items.length > 0 && <a href={archiveHref}>Earlier images & downloads</a>}
      </div>
    </header>
    {!items.length && project && productSocial && artworkFallback ? (
      <section class="work-card" aria-label={`Share ${name}`}>
        <figure class="work-card__art">
          <a href={productSocial.image} aria-label={`View ${name} link card full size`}>
            <img
              src={productSocial.image}
              width={productSocial.width}
              height={productSocial.height}
              alt={productSocial.alt}
              decoding="async"
            />
          </a>
          <figcaption>
            {productSocial.fromProduct ? `Artwork from ${name}` : artworkFallback.credit}
          </figcaption>
        </figure>
        <div class="work-card__body">
          <p class="work-card__caption">{captionText(projectCaption(project))}</p>
          <ShareActions
            caption={projectCaption(project)}
            image={
              productSocial.fromProduct ? `/api/share-image?project=${slug}` : productSocial.image
            }
            fallbackImage={artworkFallback.image}
            filename={`${slug}-social.jpg`}
            link={projectActionHref(project)}
          />
        </div>
      </section>
    ) : items.length === 1 ? (
      // One reviewed work is a share card, not a gallery grid: the artwork, the
      // caption a person would actually post and the actions belong in one view.
      <section id={items[0]!.id} class="work-card" aria-labelledby="work-card-title">
        <figure class="work-card__art">
          <a
            href={items[0]!.original}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${items[0]!.title} full size`}
          >
            <img
              src={items[0]!.image}
              width={items[0]!.width}
              height={items[0]!.height}
              alt={items[0]!.alt}
              loading="eager"
              decoding="async"
            />
            <span class="work-card__view" aria-hidden="true">
              View full size ↗
            </span>
          </a>
          <figcaption>
            <span class="work-card__kind">{items[0]!.kind}</span>
            {items[0]!.credit} · reviewed {items[0]!.reviewedAt}
          </figcaption>
        </figure>
        <div class="work-card__body">
          <p class="work-card__eyebrow">Share card</p>
          <h2 id="work-card-title">{items[0]!.title}</h2>
          <p class="work-card__caption">{captionText(items[0]!.caption)}</p>
          <ShareActions
            caption={items[0]!.caption}
            image={items[0]!.original}
            shareSource={items[0]!.formats ? items[0]!.original : items[0]!.image}
            filename={items[0]!.original.split("/").pop() ?? `${items[0]!.id}.jpg`}
            link={items[0]!.href}
          />
          {items[0]!.formats && (
            <CampaignFormats formats={items[0]!.formats} source={items[0]!.source} />
          )}
          {items[0]!.landscapeImage && (
            <a class="work-card__poster" href={items[0]!.landscapeImage} download>
              Download the landscape poster
            </a>
          )}
        </div>
      </section>
    ) : (
      <>
        <ShowcaseGallery items={currentItems} />
        {archivedItems.length > 0 && (
          <section class="earlier-artwork" aria-labelledby="earlier-artwork-title">
            <h2 id="earlier-artwork-title">Earlier artwork</h2>
            <ShowcaseGallery items={archivedItems} eager={false} />
          </section>
        )}
      </>
    )}
    {items.length > 0 && productSocial?.fromProduct && (
      // The page's own social metadata is the product's declared image, so
      // the reader can see exactly what the link will look like before it
      // is posted. A Woodhouse-drawn card is not previewed as a product's.
      <div class="work-card__preview">
        <p>Link preview</p>
        <a class="work-card__unfurl" href={projectHref}>
          <img
            src={productSocial.image}
            width={productSocial.width}
            height={productSocial.height}
            alt=""
            loading="lazy"
            decoding="async"
            data-unfurl-image
          />
          <span>
            <strong>{getSiteMetadata(project!).title}</strong>
            <small>{hostOf(projectHref)}</small>
          </span>
        </a>
      </div>
    )}
    {items.length > 0 && (
      <p class="collection__note">
        Promotional compositions and product captures are labelled individually. The caption is
        ready to post; the original file is the full-size download.
      </p>
    )}
  </div>
</BaseLayout>

<script>
  // A product can move or withdraw the image its own page declares. The preview
  // keeps its title and address and drops the thumbnail, rather than showing a
  // broken image under a label that promised a picture.
  for (const image of document.querySelectorAll<HTMLImageElement>("[data-unfurl-image]")) {
    const missing = () => image.closest(".work-card__unfurl")?.classList.add("unfurl-missing");
    image.addEventListener("error", missing);
    // A cached image can fail before this module runs; check the settled state
    // once so the broken frame cannot survive without an error event.
    if (image.complete && image.naturalWidth === 0) missing();
  }
</script>

<style>
  .collection {
    padding-block: 1.5rem 4rem;
  }
  nav {
    color: var(--copy-soft);
    font-size: 0.875rem;
  }
  header {
    padding-block: 1.5rem 2rem;
  }
  h1 {
    font: 700 clamp(2.5rem, 6vw, 5rem)/1 var(--display);
    margin: 0 0 1rem;
  }
  h1 span {
    display: block;
    font-size: 0.35em;
    line-height: 1.5;
    color: var(--copy-soft);
    font-weight: 500;
  }
  header p {
    max-width: 68ch;
    line-height: 1.6;
  }
  .work-card {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .work-card__art {
    margin: 0;
    min-width: 0;
  }
  .work-card__art a {
    display: block;
    position: relative;
    background: var(--surface);
  }
  .work-card__art img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(64dvh, 620px);
    object-fit: contain;
  }
  .work-card__view {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.25rem 0.7rem;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
  }
  .work-card__art figcaption {
    padding-top: 0.6rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .work-card__kind {
    display: block;
    font-family: var(--mono, inherit);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copy-soft);
  }
  .work-card__body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }
  .work-card__eyebrow {
    margin: 0;
    color: var(--acid);
    font-family: var(--mono, inherit);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .work-card__body h2 {
    font: 600 clamp(1.6rem, 2.6vw, 2.35rem)/1.1 var(--display);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .work-card__caption {
    margin: 0;
    max-width: 46ch;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .work-card__poster {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    text-underline-offset: 0.25em;
  }
  .work-card__preview {
    margin-top: 0.35rem;
  }
  .work-card__preview > p {
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .work-card__unfurl {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    padding: 0.6rem;
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
  }
  .work-card__unfurl img {
    display: block;
    width: 132px;
    height: auto;
  }
  .work-card__unfurl.unfurl-missing {
    grid-template-columns: minmax(0, 1fr);
  }
  .work-card__unfurl.unfurl-missing img {
    display: none;
  }
  .work-card__unfurl span {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .work-card__unfurl strong {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .work-card__unfurl small {
    color: var(--muted);
    font-family: var(--mono, inherit);
    font-size: 0.7rem;
  }
  .collection__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .collection__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.25em;
  }
  .collection__links a:first-child {
    color: var(--acid);
  }
  .earlier-artwork {
    margin-block: 3rem;
  }
  .collection__note {
    color: var(--copy-soft);
    max-width: 70ch;
    font-size: 0.875rem;
    line-height: 1.6;
    margin-block: 2rem;
  }
  @media (max-width: 860px) {
    .work-card {
      grid-template-columns: 1fr;
    }
    .work-card__art img {
      max-height: none;
    }
  }
</style>
