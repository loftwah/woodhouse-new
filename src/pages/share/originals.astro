---
import ShareLayout from "../../layouts/ShareLayout.astro";
import ShowcaseGallery from "../../components/ShowcaseGallery.astro";
import { listProjectRecords } from "../../content/repository";
import { originals, publicOriginalArtwork } from "../../data/showcase-originals";
import { foilburyNativeArtwork } from "../../data/showcase-foilbury-native";

export const prerender = false;
const result = await listProjectRecords();
if (result.error) {
  return new Response("Artwork is temporarily unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
}
const publicProjects = new Set(result.projects.map(({ slug }) => slug));
const requested = Astro.url.searchParams.get("project");
const projectNames = new Map(result.projects.map(({ slug, name }) => [slug, name]));
projectNames.set("woodhouse", "Woodhouse");
const scope = requested && projectNames.has(requested) ? requested : null;
const works = publicOriginalArtwork(publicProjects).filter(
  ({ item }) => !scope || item.project === scope
);
const drawings = works.filter(({ drawing }) => drawing).map(({ item }) => item);
const illustrations = works.filter(({ drawing }) => !drawing).map(({ item }) => item);
const currentCards =
  scope === "foilbury" && publicProjects.has("foilbury") ? foilburyNativeArtwork : [];
const lead = currentCards[0] ?? drawings[0] ?? illustrations[0];
if (scope) {
  Astro.response.headers.set("cache-control", "private, no-store");
  Astro.cache?.set(false);
} else if (Astro.cache?.enabled) {
  for (const hint of result.cacheHints) Astro.cache.set(hint);
}
---

<ShareLayout
  title="Original art and drawings"
  description="Download the clean Woodhouse process drawings and original illustrations used in the project campaigns."
  path="/share/originals/"
  heading={scope ? `${projectNames.get(scope)} originals` : "Originals"}
  section="originals"
  {...(lead && {
    image: lead.original,
    imageAlt: lead.alt,
    imageWidth: lead.width,
    imageHeight: lead.height
  })}
>
  <div class="container originals">
    <form class="original-project" method="get" action="/share/originals/">
      <label for="original-project">Project</label>
      <select name="project" id="original-project">
        <option value="">All projects</option>
        {[...new Set([...originals.map(({ project }) => project), "foilbury"])]
          .filter((project) => projectNames.has(project))
          .map((project) => (
            <option value={project} selected={scope === project}>
              {projectNames.get(project)}
            </option>
          ))}
      </select>
      <button>Apply</button>
    </form>
    {currentCards.length > 0 && (
      <section id="current-card-art" aria-labelledby="current-card-art-title">
        <h2 id="current-card-art-title">Current Foilbury cabinet art</h2>
        <ShowcaseGallery items={currentCards} compact staggered />
      </section>
    )}
    {drawings.length > 0 && (
      <section id="drawings" aria-labelledby="drawings-title">
        <h2 id="drawings-title">Clean drawings</h2>
        <ShowcaseGallery items={drawings} compact staggered />
      </section>
    )}
    {illustrations.length > 0 && (
      <section id="illustrations" aria-labelledby="illustrations-title">
        <h2 id="illustrations-title">Illustration sources</h2>
        <ShowcaseGallery items={illustrations} compact staggered eager={false} />
      </section>
    )}
    {!lead && <p>No original artwork is available yet.</p>}
  </div>
</ShareLayout>

<style>
  .original-project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .original-project :is(select, button) {
    font: inherit;
    min-height: 44px;
    padding: 0.35rem 0.65rem;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--line);
  }
  .originals {
    padding-block: 0 2rem;
  }
  h1 {
    margin: 0;
    font: 650 clamp(2.25rem, 5vw, 4.75rem)/1.02 var(--display);
    letter-spacing: -0.04em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-block: 0.85rem 1.75rem;
  }
  nav[aria-label="Original artwork by project"] {
    overflow-x: auto;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  nav a[aria-current="page"] {
    color: var(--acid);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  section + section {
    margin-block-start: clamp(2.25rem, 5vw, 4rem);
  }
  section {
    scroll-margin-top: 1.25rem;
  }
  h2 {
    margin-block: 0 1.25rem;
  }
</style>
