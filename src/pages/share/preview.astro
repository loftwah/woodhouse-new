---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareActions from "../../components/ShareActions.astro";
import { listProjectRecords } from "../../content/repository";
import { campaignCollectionPath, publicCampaignItems } from "../../data/showcase-public";
import { socialPlacements } from "../../data/social-placements";
import { shareNavigation } from "../../data/share-browser";

export const prerender = false;
const path = "/share/preview/";
const query = Astro.url.searchParams;
if (query.size) {
  Astro.response.headers.set("cache-control", "private, no-store");
  Astro.cache?.set(false);
}
const result = await listProjectRecords();
if (result.error) {
  Astro.response.status = 503;
  Astro.response.headers.set("cache-control", "private, no-store");
  Astro.cache?.set(false);
}
const preset =
  socialPlacements.find(({ id }) => id === query.get("platform")) ?? socialPlacements[0];
const names = new Map(result.projects.map(({ slug, name }) => [slug, name]));
const works = result.error ? [] : publicCampaignItems([...names.keys()]);
const choices = works.flatMap((work) => {
  if (work.archived) return [];
  const file = work.formats?.find(({ label }) => label === preset.format);
  return file ? [{ work, file }] : [];
});
const selected =
  choices.find(({ work }) => work.id === query.get("art")) ??
  choices.find(({ work }) => work.id === preset.example) ??
  choices[0];
const presetHref = (id: string) => {
  const search = new URLSearchParams({ platform: id });
  if (selected) search.set("art", selected.work.id);
  return shareNavigation(`${path}?${search}`, query);
};
const frameWidth = selected
  ? Math.min(760, (460 * selected.file.width) / selected.file.height)
  : 760;
const imageAlt = !selected
  ? ""
  : selected.file.image === selected.work.original
    ? selected.work.alt
    : (selected.file.title ?? `${selected.work.title} · ${selected.file.label}`);
---

<BaseLayout
  title="Social preview"
  description="Preview campaign artwork in social placements and download the exact file."
  path={path}
  currentPath="/share/"
>
  <div class="container preview">
    <header>
      <a href={shareNavigation("/share/", query)}>Share gallery</a>
      <h1>Social preview</h1>
      <p>Pick a platform. Check the framing. Take the exact file.</p>
    </header>

    <nav aria-label="Social platforms" class="platforms">
      {socialPlacements.map(({ id, platform }) => (
        <a href={presetHref(id)} aria-current={id === preset.id ? "page" : undefined}>
          {platform}
        </a>
      ))}
    </nav>

    {selected ? (
      <div class="desk">
        <figure
          class="preview-stage"
          style={`--frame-width:${frameWidth}px`}
          data-platform={preset.id}
        >
          <figcaption>
            <span>{preset.placement}</span>
            <span>
              {selected.file.width} × {selected.file.height}
            </span>
          </figcaption>
          <div class="preview-tools">
            <label>
              <input type="checkbox" data-small-preview /> Small preview
            </label>
            {"guide" in preset && (
              <label>
                <input type="checkbox" data-preview-guide /> {preset.guide}
              </label>
            )}
          </div>
          <div class="image-stage">
            <a class="image-frame" href={selected.file.image} aria-label="Open full-size image">
              <img
                src={selected.file.image}
                width={selected.file.width}
                height={selected.file.height}
                alt={imageAlt}
                decoding="async"
                fetchpriority="high"
              />
              {"guide" in preset && <span class="edge-guide" aria-hidden="true"></span>}
            </a>
          </div>
        </figure>

        <section class="artwork-controls" aria-label="Artwork and download">
          <form method="get" action={path}>
            <input type="hidden" name="platform" value={preset.id} />
            {["analytics", "qa"].map(
              (name) =>
                query.has(name) && <input type="hidden" name={name} value={query.get(name) ?? ""} />
            )}
            <label for="preview-art">Artwork</label>
            <div class="picker">
              <select id="preview-art" name="art">
                {choices.map(({ work }) => (
                  <option value={work.id} selected={work.id === selected.work.id}>
                    {names.get(work.project) ?? "Woodhouse"} · {work.title}
                  </option>
                ))}
              </select>
              <button type="submit">Preview</button>
            </div>
          </form>

          <h2>{selected.work.title}</h2>
          <p class="format">
            {preset.platform} · {selected.file.width} × {selected.file.height} ·{" "}
            {selected.file.image.endsWith(".png") ? "PNG" : "JPEG"}
          </p>
          <ShareActions
            image={selected.file.image}
            filename={selected.file.image.split("/").pop() ?? "woodhouse.jpg"}
            caption={selected.work.caption}
            link={selected.work.href}
          />
          <p class="placement-note">{preset.note}</p>
          <nav class="source-links" aria-label="Artwork sources">
            <a
              href={shareNavigation(
                `${campaignCollectionPath(selected.work.project)}#${selected.work.id}`,
                query
              )}
            >
              Project gallery
            </a>
            {"source" in preset && <a href={preset.source}>Placement guidance</a>}
          </nav>
        </section>
      </div>
    ) : (
      <p>
        {result.error
          ? "The artwork library is temporarily unavailable."
          : "There are no published files for this placement yet."}{" "}
        <a href="/share/">Browse the gallery.</a>
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .preview {
    padding-block: clamp(2rem, 5vw, 4.5rem);
  }
  header > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  h1 {
    font: 650 clamp(2.7rem, 6vw, 5rem)/1 var(--display);
    letter-spacing: -0.035em;
    margin: 0.2rem 0 0.55rem;
  }
  header p {
    margin: 0;
    color: var(--muted);
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.55rem;
    margin: 1.6rem 0;
    border-block: 1px solid var(--line);
  }
  .platforms a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0.25rem 0.55rem;
    text-decoration: none;
  }
  .platforms a[aria-current] {
    box-shadow: inset 0 -2px var(--acid);
    color: var(--acid);
    font-weight: 700;
  }
  .platforms a:hover {
    text-decoration: underline;
  }
  .desk {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
  }
  .preview-stage {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--surface);
    min-width: 0;
  }
  figcaption,
  .preview-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.8rem;
    padding: 0.55rem 0.8rem;
    font-size: 0.875rem;
  }
  figcaption {
    border-bottom: 1px solid var(--line);
  }
  figcaption span:last-child,
  .format {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .preview-tools {
    justify-content: flex-start;
    padding-block: 0;
  }
  .preview-tools label {
    display: flex;
    gap: 0.45rem;
    min-height: 44px;
    align-items: center;
  }
  input[type="checkbox"] {
    accent-color: var(--acid);
  }
  .image-stage {
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: clamp(0.5rem, 2vw, 1.5rem);
  }
  .image-frame {
    position: relative;
    display: block;
    width: min(100%, var(--frame-width));
  }
  .image-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .preview-stage:has([data-small-preview]:checked) .image-frame {
    width: min(50%, 210px, calc(var(--frame-width) * 0.55));
  }
  .edge-guide {
    display: none;
    position: absolute;
    pointer-events: none;
    inset: 0;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .preview-stage:has([data-preview-guide]:checked) .edge-guide {
    display: block;
  }
  [data-platform="youtube-banner"] .edge-guide {
    inset: 35.3% 19.85%;
    border: 2px dashed white;
  }
  [data-platform="avatars"] .edge-guide {
    border: 2px dashed white;
    border-radius: 50%;
  }
  [data-platform="x"] .edge-guide {
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 68%) 12%,
      transparent 12% 88%,
      rgb(0 0 0 / 68%) 88%
    );
  }
  [data-platform="discord"] .edge-guide {
    background: linear-gradient(to bottom, rgb(0 0 0 / 68%) 8.89%, transparent 8.89%);
  }
  [data-platform="tiktok"] .edge-guide {
    background:
      linear-gradient(to right, transparent 86%, rgb(0 0 0 / 64%) 86%),
      linear-gradient(to top, rgb(0 0 0 / 64%) 21%, transparent 21% 94%, rgb(0 0 0 / 64%) 94%);
  }
  .artwork-controls {
    min-width: 0;
  }
  form > label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.875rem;
    font-weight: 650;
  }
  .picker {
    display: flex;
    gap: 0.35rem;
  }
  select,
  button {
    min-height: 44px;
    border: 1px solid var(--line);
    color: var(--paper);
    background: var(--surface);
    font: inherit;
    padding: 0.35rem 0.55rem;
  }
  select {
    flex: 1;
    min-width: 0;
  }
  button {
    cursor: pointer;
  }
  button:hover {
    border-color: var(--acid);
  }
  h2 {
    margin: 1.5rem 0 0.25rem;
    font: 650 1.5rem/1.15 var(--display);
  }
  .format {
    margin: 0 0 0.8rem;
    font-size: 0.875rem;
  }
  .placement-note {
    font-size: 0.9rem;
    color: var(--muted);
    max-width: 55ch;
  }
  .source-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
  .source-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
  }
  @media (max-width: 760px) {
    .desk {
      grid-template-columns: minmax(0, 1fr);
    }
    .image-frame {
      max-width: min(100%, calc(var(--frame-width) * 0.75));
    }
  }
</style>
