---
import PortfolioEdition from "../../components/PortfolioEdition.astro";
import { getEditorialDispatch, listProjectRecords } from "../../content/repository";
import { readPortfolioEdition } from "../../data/what-we-built";
export const prerender = false;
const slug = Astro.params.slug === "what-we-built" ? "what-we-built-2026-10-25" : Astro.params.slug;
const [result, records] = await Promise.all([
  getEditorialDispatch(slug ?? ""),
  listProjectRecords()
]);
if (result.error || records.error)
  return new Response("The edition is unavailable. Please retry.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const edition = readPortfolioEdition(result.dispatch);
if (!edition)
  return new Response("Edition not found.", {
    status: 404,
    headers: { "cache-control": "private, no-store" }
  });
if (result.isPreview) {
  Astro.cache?.set(false);
  Astro.response.headers.set("cache-control", "private, no-store");
  Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
}
---

<PortfolioEdition edition={edition} projects={records.projects} isPreview={result.isPreview} />
