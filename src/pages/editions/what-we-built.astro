---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listProjectRecords } from "../../content/repository";
import { projectActionLabel } from "../../data/share-browser";
import {
  editionEntries,
  editionLearning,
  editionMethod,
  editionReviewDate,
  editionSections,
  type EditionEntry,
  type EditionSectionKey
} from "../../data/what-we-built";
import "../../styles/what-we-built.css";

export const prerender = false;

const records = await listProjectRecords();
if (records.error) {
  return new Response("The edition is unavailable. Please retry.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
}

const published = new Map(records.projects.map((project) => [project.slug, project]));
// An unpublished project silently leaves the edition rather than leaving a dead
// action behind. The count is reported honestly at the foot of the page.
const present = editionEntries.filter((entry) => published.has(entry.slug));
const withheld = editionEntries.length - present.length;
const bySection = (key: EditionSectionKey) => present.filter((entry) => entry.section === key);

const lead =
  bySection("shipped").find((entry) => published.get(entry.slug)?.previewImage) ?? present[0]!;
const leadProject = published.get(lead.slug)!;
const heroImage = leadProject.previewImage;
const actionLabel = (entry: EditionEntry) => {
  const label = projectActionLabel(entry.slug);
  return label === "Open project"
    ? `Open ${published.get(entry.slug)?.name ?? entry.slug}`
    : `${label} ${published.get(entry.slug)?.name ?? entry.slug}`;
};
const dossier = (entry: EditionEntry) => `/projects/${entry.slug}/`;
const site = (entry: EditionEntry) => published.get(entry.slug)?.siteUrl ?? null;
const artworkAlt = (entry: EditionEntry) => {
  const project = published.get(entry.slug);
  return project?.previewAlt ?? `${project?.name ?? entry.slug} artwork from its own site.`;
};

const counts = {
  published: present.length
};
const title = "What we built — a Woodhouse portfolio edition";
const description =
  "Ten projects, one dated edit: what shipped, what is getting better, and what is still being built. Games, music, a studio and a field guide, with honest states and something to open.";
const path = "/editions/what-we-built/";
const caption = `What we built · Woodhouse portfolio edition, ${editionReviewDate}\nGames, music, a studio and a field guide, with the state each one is actually in. https://woodhouse.loftwah.com${path}`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  currentPath="/dispatches/"
  type="article"
  image="/og/what-we-built-20261025.jpg"
  imageAlt="What we built: the Woodhouse portfolio edition, set over the site's own drawn lens of tensioned fibres."
  publishedAt="2026-10-25T00:00:00.000Z"
  modifiedAt="2026-10-25T00:00:00.000Z"
>
  <article class="wwb">
    <nav class="wwb-breadcrumb" aria-label="Breadcrumb">
      <a href="/">WOODHOUSE</a>
      <span aria-hidden="true">/</span>
      <a href="/dispatches/">Stories</a>
      <span aria-hidden="true">/</span>
      <span>What we built</span>
    </nav>

    <header class="wwb-cover">
      <p class="wwb-kicker">Portfolio edition · {editionReviewDate}</p>
      <h1>
        What we <em>built</em>
      </h1>
      <p class="wwb-deck">
        Ten projects, one dated edit. Four you can open right now, three that shipped something real
        this month, and three where the honest answer is “not finished”.
      </p>
      <ul class="wwb-jump">
        {editionSections.map((section) => (
          <li>
            <a href={`#${section.key}`}>
              <span>{section.title}</span>
              <small>{bySection(section.key).length}</small>
            </a>
          </li>
        ))}
      </ul>
    </header>

    {heroImage && (
      <figure class="wwb-lead">
        <img
          src={heroImage}
          alt={artworkAlt(lead)}
          width="1200"
          height="630"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span class="wwb-lead__project">
            <strong>{leadProject.name}.</strong> <a href={dossier(lead)}>The full record</a>
          </span>
          <span class="wwb-credit">
            <a href={site(lead) ?? dossier(lead)}>{leadProject.name}</a>
            {leadProject.previewCaption
              ? ` · ${leadProject.previewCaption}`
              : " · artwork reviewed for this edition"}
          </span>
        </figcaption>
      </figure>
    )}

    {editionSections.map((section) => {
      const entries = bySection(section.key);
      if (!entries.length) return null;
      return (
        <section class={`wwb-section wwb-section--${section.key}`} id={section.key}>
          <header class="wwb-section__head">
            <h2>{section.title}</h2>
            <p>{section.deck}</p>
          </header>
          <ol class="wwb-entries">
            {entries.map((entry) => {
              const project = published.get(entry.slug)!;
              const href = site(entry);
              return (
                <li class="wwb-entry">
                  <div class="wwb-entry__media">
                    {project.previewImage ? (
                      <img
                        src={project.previewImage}
                        alt={artworkAlt(entry)}
                        width="1200"
                        height="630"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="wwb-entry__plate" aria-hidden="true">
                        <span>{project.name}</span>
                      </div>
                    )}
                  </div>
                  <div class="wwb-entry__body">
                    <p class="wwb-entry__kicker">
                      <span class={`wwb-state wwb-state--${section.key}`}>{section.state}</span>
                      <span>{project.discipline}</span>
                    </p>
                    <h3>
                      <span class="wwb-entry__name">{project.name}.</span> {entry.headline}
                    </h3>
                    <p>{entry.body}</p>
                    <p class="wwb-entry__basis">
                      <strong>Where that stands:</strong> {entry.basis}
                    </p>
                    <div class="wwb-entry__actions">
                      {href && (
                        <a class="wwb-action" href={href} target="_blank" rel="noopener noreferrer">
                          {actionLabel(entry)}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      )}
                      <a class="wwb-record" href={dossier(entry)}>
                        See the full record
                      </a>
                      {entry.readMore && (
                        <a class="wwb-record" href={entry.readMore.href}>
                          {entry.readMore.label}
                        </a>
                      )}
                    </div>
                    <p class="wwb-entry__invitation">{entry.invitation}</p>
                    <p class="wwb-entry__caption">
                      {project.previewImage ? (
                        <>
                          {href ? (
                            <a href={href} target="_blank" rel="noopener noreferrer">
                              {project.name}
                            </a>
                          ) : (
                            <span>{project.name}</span>
                          )}
                          {project.previewCaption
                            ? ` · ${project.previewCaption}`
                            : " · artwork reviewed for this edition"}
                        </>
                      ) : (
                        <>
                          No artwork published by {project.name} yet. The plate names the project.
                        </>
                      )}
                    </p>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}

    <section class="wwb-learning" aria-labelledby="learning-heading">
      <h2 id="learning-heading">{editionLearning.title}</h2>
      <p>{editionLearning.body}</p>
      <p class="wwb-learning__close">{editionLearning.closing}</p>
    </section>

    <section class="wwb-method" aria-labelledby="method-heading">
      <h2 id="method-heading">How this edition was made</h2>
      <ul>
        {editionMethod.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
      <p class="wwb-count">
        {counts.published} of ten projects are published in this edition.
        {withheld > 0 && ` ${withheld} entry was withheld because its project is not public.`}
      </p>
    </section>

    <section
      class="wwb-share"
      aria-labelledby="share-heading"
      data-edition-share
      data-caption={caption.replace(/\n/g, " ")}
    >
      <h2 id="share-heading">Send it to someone</h2>
      <p>
        Copy the link, copy a short post, or hand it to your device's share sheet. Nothing is posted
        on your behalf.
      </p>
      <div class="wwb-share__actions">
        <button type="button" class="wwb-share__native" data-share-native hidden>
          Share this edition
        </button>
        <button type="button" data-share-link>
          Copy link
        </button>
        <button type="button" data-share-caption>
          Copy post
        </button>
      </div>
      <p class="wwb-share__status" role="status" aria-live="polite" data-share-status></p>
      <p class="wwb-share__more">
        Want the picture?
        <a href="/og/what-we-built-20261025.jpg" download>
          Download the edition card
        </a>{" "}
        (1200×630), or browse <a href="/share/">the share desk</a> for every approved project
        format.
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  const path = "/editions/what-we-built/";

  const root = document.querySelector<HTMLElement>("[data-edition-share]");
  if (root) {
    const caption =
      root.dataset.caption ?? "What we built · Woodhouse portfolio edition, 25 October 2026.";
    const status = root.querySelector<HTMLElement>("[data-share-status]");
    const native = root.querySelector<HTMLButtonElement>("[data-share-native]");
    const link = `${location.origin}${path}`;
    let timer: number | undefined;
    const say = (message: string) => {
      if (!status) return;
      status.textContent = message;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        status.textContent = "";
      }, 6000);
    };

    if (native && typeof navigator.share === "function") native.hidden = false;
    native?.addEventListener("click", async () => {
      try {
        await navigator.share({ title: "What we built", url: link });
        say("Handed to your device's share options.");
      } catch (error) {
        say(
          (error as DOMException)?.name === "AbortError"
            ? "Share cancelled. The link is still here."
            : "Your device could not share this. Use Copy link instead."
        );
      }
    });

    root.querySelector("[data-share-link]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(link);
        say("Edition link copied.");
      } catch {
        say(`Copy failed. The link is ${link}`);
      }
    });

    root.querySelector("[data-share-caption]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(`${caption}\n${link}`);
        say("Post copied, with the link.");
      } catch {
        say("Copy failed. Your browser may be blocking clipboard access.");
      }
    });
  }
</script>
