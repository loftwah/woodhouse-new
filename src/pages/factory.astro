---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import StatusStamp from "../components/StatusStamp.astro";
import FactoryPlate from "../components/FactoryPlate.astro";
import { projects, reviewDateLabel, snapshotSource } from "../data/projects";
---
<BaseLayout
  title="The factory floor"
  description="An operator-reviewed snapshot of eight software projects, their current work and the proof each one still needs."
  path="/factory/"
  currentPath="/factory/"
  image="/og/factory.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">WOODHOUSE</a><span>/</span><span>Factory</span></nav>
        <h1 class="page-title">Eight projects.<br /><em>Eight kinds</em> of proof.</h1>
      </div>
      <aside class="page-intro__aside">
        <strong>Portfolio readout · {reviewDateLabel}</strong>
        {snapshotSource} Each state is a reviewed summary, not a live GitHub feed.
      </aside>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Where attention is going.</h2>
        </div>
        <p>A practical ordering, not a percentage chart. The report finds active product work in Bubbles and Protocol 11; other projects face their own quality, qualification, parity, business or physical-proof boundary.</p>
      </div>
      <p class="body-copy">This is the operating model, not live telemetry.</p>
      <FactoryPlate />
      <div class="project-ledger">
        {projects.map((project) => <ProjectRow project={project} />)}
      </div>
      <div class="snapshot-band" style="margin-top:2.5rem">
        <div class="snapshot-band__label">
          <span>Qualification boundary</span>
          <span>Each project has its own test</span>
        </div>
        <div class="snapshot-band__text">
          “Done” is a project-specific claim.
          <small>Bubbles has whole-product browser and owner acceptance ahead. MAX still needs physical walker evidence. Pirates cannot expand until parity is established. The rest carry their own release and quality gates.</small>
        </div>
      </div>
      <p class="source-note"><strong>Data policy:</strong> repository issues and pull requests are not reproduced here. This is an edited public-safe summary; each state retains its review date and proof boundary.</p>
    </div>
  </section>
</BaseLayout>
