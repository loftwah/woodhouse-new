---
import CapabilityRecord from "../components/CapabilityRecord.astro";
import { listPublicCapabilities } from "../content/repository";
import BaseLayout from "../layouts/BaseLayout.astro";
import BuildExamples from "../components/BuildExamples.astro";
import FactoryPlate from "../components/FactoryPlate.astro";
import { listProjectRecords } from "../content/repository";
import PatchBench from "../components/exhibits/PatchBench.astro";
const result = await listProjectRecords();
if (result.error)
  return new Response("Unable to load the reviewed factory snapshot.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = result.projects;
if (Astro.cache?.enabled) for (const hint of result.cacheHints) Astro.cache.set(hint);
export const prerender = false;
const capabilityResult = await listPublicCapabilities();
if (capabilityResult.error)
  return new Response("Unable to load public capability evidence.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
if (Astro.cache?.enabled) for (const hint of capabilityResult.cacheHints) Astro.cache.set(hint);
---

<BaseLayout
  title="The factory floor"
  description="Try the connections between Loftwah’s games, music and independently owned apps. Working examples show what you can reuse and how the projects fit together."
  path="/factory/"
  currentPath="/factory/"
  image="/og/factory-workshop-20261018.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Factory</span>
        </nav>
        <h1 class="page-title">
          Good ideas.
          <br />
          <em>Shared parts.</em>
        </h1>
      </div>
      <div class="page-intro__aside">
        <strong>Make something with this.</strong>
        Try a working connection, then take the useful part into your own game or app.
        <p>
          <a class="home-action" href="/exhibits/patch-bench/">
            Open the patch bench ↗
          </a>
        </p>
        <p>
          <a class="text-link" href="/connections/">
            Explore the connected portfolio ↗
          </a>
        </p>
      </div>
    </div>
  </section>
  <section class="container section" aria-labelledby="bench-heading">
    <div class="section-heading">
      <h2 id="bench-heading">One working system, taken apart.</h2>
      <p>
        The first working example on this site is not a screenshot. Open the bench and you get the
        game, its sound effects and a real LoftwahFM station, wired the way a game actually wires
        them — then separated so you can see who owns what.
      </p>
    </div>
    <PatchBench
      variant="entry"
      recipeHref="/exhibits/patch-bench/"
      recipeLabel="Open the full bench"
    />
    <p class="factory-bench-links">
      <a class="home-action" href="/exhibits/patch-bench/">
        Open the full bench <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/dispatches/your-game-its-own-soundtrack/">
        Read the story behind it <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/exhibits/">
        See both exhibits <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://fm.loftwah.com/game-music">
        Get the integration recipe <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>
  <section class="container section">
    <p class="body-copy">
      A soundtrack can travel from a music service into a game. A photo can travel from a guestbook
      into a creator’s collection. Woodhouse brings those connections together so you can try them,
      understand them and use the useful parts in your own work.
    </p>
    <BuildExamples projects={projects} />
  </section>
  <section class="section paper-section">
    <div class="container">
      <div class="section-heading">
        <h2>One human directs the work.</h2>
        <p>
          Dean chooses what to make and checks the result. Coding agents carry out bounded work
          across the projects. Each product keeps its own identity, source and releases.
        </p>
      </div>
      <FactoryPlate />
      {capabilityResult.capabilities.length > 0 && (
        <details>
          <summary>Music integration versions and game adoption records</summary>
          {capabilityResult.capabilities.map((capability) => (
            <CapabilityRecord capability={capability} compact={true} />
          ))}
        </details>
      )}
      <p class="body-copy">
        Looking for something to play, hear or try?{" "}
        <a href="/projects/">Explore all {projects.length} projects</a>. For the implementation,
        follow the <a href="/architecture/">architecture</a> or the
        <a href="/dispatches/">stories behind the work</a>.
      </p>
      <p class="source-note">
        Public examples checked 18 October 2026. Detailed product states keep their own review
        dates. Private repositories and conversations are not reproduced here.
      </p>
    </div>
  </section>
</BaseLayout>
