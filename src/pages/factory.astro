---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatReviewDate } from "../data/review-date";
import { portfolioReadout } from "../data/portfolio";
import ProjectRow from "../components/ProjectRow.astro";
import FactoryPlate from "../components/FactoryPlate.astro";
import { listProjectRecords } from "../content/repository";
const result = await listProjectRecords();
if (result.error)
  return new Response("Unable to load the reviewed factory snapshot.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = result.projects;
if (Astro.cache?.enabled) for (const hint of result.cacheHints) Astro.cache.set(hint);
// The portfolio is reviewed project by project, so the readout reports the
// newest review and says how many projects predate it. Reading one project's
// date would present an older review as the current state of the whole floor.
const readout = portfolioReadout(projects);
const reviewDateLabel = formatReviewDate(readout.reviewDate) ?? "Review date unavailable";
const snapshotSource = readout.snapshotSource ?? "No public snapshot is available.";
export const prerender = false;
---

<BaseLayout
  title="The factory floor"
  description="An operator-reviewed snapshot of nine software projects, their current work and the proof each one still needs."
  path="/factory/"
  currentPath="/factory/"
  image="/og/factory.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Factory</span>
        </nav>
        <h1 class="page-title">
          {projects.length} projects.
          <br />
          <em>{projects.length} kinds</em> of proof.
        </h1>
      </div>
      <div class="page-intro__aside">
        <strong>Portfolio readout · {reviewDateLabel}</strong>
        {snapshotSource} Each state is a reviewed summary, not a live GitHub feed.
        {readout.olderCount > 0 && (
          <>
            {" "}
            {readout.olderCount} of {projects.length} projects were last reviewed on an earlier
            date; every row states its own.
          </>
        )}
        {readout.snapshotId && (
          <>
            {" "}
            <a href={`/snapshots/${readout.snapshotId}/`}>
              Read the dated snapshot archive <span aria-hidden="true">↗</span>
            </a>
          </>
        )}
      </div>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Where attention is going.</h2>
        </div>
        <p>
          A practical ordering, not a percentage chart. Bubbles is nearest its current finish line;
          other work is held by quality, qualification, source parity or the physical world.
        </p>
      </div>
      <p class="body-copy">This is the operating model, not live telemetry.</p>
      <FactoryPlate />
      <div class="project-ledger">
        {projects.map((project) => (
          <ProjectRow project={project} total={projects.length} />
        ))}
      </div>
      <div class="snapshot-band" style="margin-top:2.5rem">
        <div class="snapshot-band__label">
          <span>Qualification boundary</span>
          <span>Each project has its own test</span>
        </div>
        <div class="snapshot-band__text">
          “Done” is a project-specific claim.
          <small>
            Bubbles has whole-product browser and owner acceptance ahead. MAX still needs physical
            walker evidence. Pirates cannot expand until parity is established. The rest carry their
            own release and quality gates.
          </small>
        </div>
      </div>
      <p class="source-note">
        <strong>Data policy:</strong> most project repositories are private, so their issues and
        pull requests are not exposed here. The public record uses the shareable project readout
        provided for Woodhouse, plus the public repository and published site of any project whose
        repository is public.
      </p>
    </div>
  </section>
</BaseLayout>
