---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialBlocks from "../../components/EditorialBlocks.astro";
import { Image } from "emdash/ui";
import { decodeEditorialSlug, getEditorialDispatch } from "../../content/repository";
import { dispatchSocialCard } from "../../data/social-cards";

export const prerender = false;

const slug = decodeEditorialSlug(Astro.params.slug);
const path = `/dispatches/${slug ?? "not-found"}/`;
if (!slug) Astro.response.status = 404;
const result = slug ? await getEditorialDispatch(slug) : null;
if (result?.error) {
  console.error("Failed to load published EmDash dispatch:", result.error);
  return new Response("Unable to load this dispatch right now.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
}
const editorial = result?.dispatch ?? null;
const entry = result?.entry;
const isPreview = result?.isPreview === true;
// Each dispatch has its own rendered social card where one exists; a dispatch
// without one falls back to the shared factory card rather than advertising a
// path that was never rendered.
const socialCard = dispatchSocialCard(slug);
if (slug && !editorial) Astro.response.status = 404;
if (isPreview) {
  Astro.cache?.set(false);
  Astro.response.headers.set("cache-control", "private, no-store, max-age=0");
  Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
} else if (Astro.cache?.enabled && result?.cacheHint) Astro.cache.set(result.cacheHint);
---

{editorial ? (
  <BaseLayout
    title={editorial.title}
    description={editorial.deck}
    path={path}
    currentPath="/dispatches/"
    type="article"
    pageType="article"
    publishedAt={editorial.publishedAt ?? undefined}
    modifiedAt={editorial.updatedAt ?? undefined}
    authorName={entry?.data.bylines?.[0]?.byline.displayName ?? "Dean Lofts"}
    contentRef={{ collection: "dispatches", id: entry?.id ?? editorial.slug, slug: editorial.slug }}
    contentSeo={entry ? { data: entry.data } : undefined}
    image={socialCard}
    noindex={isPreview}
  >
    {isPreview && (
      <p class="container source-note">
        <strong>Unpublished preview.</strong> This draft is visible through its authenticated EmDash
        preview and is not part of the public dispatch list.
      </p>
    )}
    <section class="container dossier-hero">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <a href="/dispatches/">Dispatches</a>
          <span>/</span>
          <span>{editorial.kind}</span>
        </nav>
        <h1 {...entry?.edit.title}>{editorial.title}</h1>
        <p class="article-meta">
          {editorial.kind} · Reviewed {editorial.reviewDate}
          {editorial.publishedAt
            ? ` · Published ${new Date(editorial.publishedAt).toLocaleDateString("en-AU", { dateStyle: "long", timeZone: "Australia/Melbourne" })}`
            : ""}
        </p>
        <p class="dossier-hero__summary" {...entry?.edit.deck}>
          {editorial.deck}
        </p>
      </div>
      <div class="dossier-hero__side">
        <span class="micro-label">Evidence reviewed {editorial.reviewDate}</span>
        <dl>
          <dt>Filed under</dt>
          <dd>{editorial.kind}</dd>
          <dt>Source state</dt>
          <dd>Editor-reviewed public summary</dd>
        </dl>
      </div>
    </section>
    <section class="container dossier-grid">
      <article class="prose" {...entry?.edit}>
        <p {...entry?.edit.lead}>
          <strong>{editorial.lead}</strong>
        </p>
        {editorial.featuredImage && (
          <figure {...entry?.edit.featured_image}>
            <Image image={editorial.featuredImage} priority />
          </figure>
        )}
        <div {...entry?.edit.content}>
          <EditorialBlocks value={editorial.content} />
        </div>
        <div class="callout" {...entry?.edit.source_reference}>
          <p class="callout__title">Source and review</p>
          <p>
            {editorial.sourceReference} The publication does not reproduce private repository bodies
            or conversation transcripts.
          </p>
        </div>
        <p>
          <a href="/dispatches/">Back to the dispatches</a>
        </p>
      </article>
      <section class="margin-rail" aria-label="Article notes">
        <div class="margin-note" {...entry?.edit.lesson}>
          <span class="margin-note__label">What changed</span>
          <p>
            <strong>{editorial.lesson}</strong>
          </p>
        </div>
        <div class="margin-note">
          <span class="margin-note__label">Proof boundary</span>
          <p>
            Reviewed {editorial.reviewDate}. This is an edited public record, not a private source
            transcript.
          </p>
        </div>
      </section>
    </section>
  </BaseLayout>
) : (
  <BaseLayout
    title="Dispatch not found"
    description="This dispatch is not available in the public record."
    path={path}
    noindex
  >
    <section class="container page-intro">
      <h1 class="page-title">Dispatch not found.</h1>
      <p>
        <a href="/dispatches/">Return to dispatches.</a>
      </p>
    </section>
  </BaseLayout>
)}
