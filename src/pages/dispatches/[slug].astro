---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialBlocks from "../../components/EditorialBlocks.astro";
import PatchBench from "../../components/exhibits/PatchBench.astro";
import { Image } from "emdash/ui";
import { decodeEditorialSlug, getEditorialDispatch } from "../../content/repository";
import { validReviewDay } from "../../data/dispatch-dates";
import { formatReviewDate } from "../../data/review-date";
import { dispatchSocialCard } from "../../data/social-cards";
export const prerender = false;

const slug = decodeEditorialSlug(Astro.params.slug);
const path = `/dispatches/${slug ?? "not-found"}/`;
if (!slug) Astro.response.status = 404;
const result = slug ? await getEditorialDispatch(slug) : null;
if (result?.error) {
  console.error("Failed to load published EmDash dispatch:", result.error);
  return new Response("Unable to load this dispatch right now.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
}
const editorial = result?.dispatch ?? null;
const entry = result?.entry;
const isPreview = result?.isPreview === true;
// Each dispatch has its own rendered social card where one exists; a dispatch
// without one falls back to the shared factory card rather than advertising a
// path that was never rendered.
const socialCard = dispatchSocialCard(slug);
const isFoundingEssay = slug === "i-didnt-mean-to-build-a-software-factory";
const hasFeatureArt = isFoundingEssay && editorial?.content[0]?._type === "image_plate";
// The game-music story carries the working bench, so a reader can stop at the
// decisive moment instead of taking the claim on trust.
const hasBench =
  slug === "your-game-its-own-soundtrack" || slug === "shared-music-independent-games";
if (slug && !editorial) Astro.response.status = 404;
if (isPreview) {
  Astro.cache?.set(false);
  Astro.response.headers.set("cache-control", "private, no-store, max-age=0");
  Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
} else if (Astro.cache?.enabled && result?.cacheHint) Astro.cache.set(result.cacheHint);
---

{editorial ? (
  <BaseLayout
    title={editorial.title}
    description={editorial.deck}
    path={path}
    currentPath="/dispatches/"
    type="article"
    pageType="article"
    // `datePublished` is the review date. `publishedAt` is EmDash's install
    // timestamp for a SQL-replayed record, and emitting it as an article
    // publication date would tell every reader and crawler the dispatch is
    // days younger than the evidence it reports.
    publishedAt={validReviewDay(editorial.reviewDate) ?? undefined}
    modifiedAt={editorial.updatedAt ?? undefined}
    authorName={entry?.data.bylines?.[0]?.byline.displayName ?? "Dean Lofts"}
    contentRef={{ collection: "dispatches", id: entry?.id ?? editorial.slug, slug: editorial.slug }}
    contentSeo={entry ? { data: entry.data } : undefined}
    image={socialCard}
    noindex={isPreview}
  >
    {isPreview && (
      <p class="container source-note">
        <strong>Unpublished preview.</strong> This draft is visible through its authenticated EmDash
        preview and is not part of the public dispatch list.
      </p>
    )}
    <section class:list={["container dossier-hero", isFoundingEssay && "founding-hero"]}>
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <a href="/dispatches/">Stories</a>
          <span>/</span>
          <span>{editorial.kind}</span>
        </nav>
        <h1 {...entry?.edit.title}>{editorial.title}</h1>
        <p class="article-meta">
          {/* The explicit space matters: JSX drops a line break between two text
              nodes, which rendered "Reviewed28 September 2026". */}
          {editorial.kind} · Reviewed{" "}
          {formatReviewDate(editorial.reviewDate) ?? editorial.reviewDate}
        </p>
        <p class="dossier-hero__summary" {...entry?.edit.deck}>
          {editorial.deck}
        </p>
      </div>
      {!isFoundingEssay && (
        <div class="dossier-hero__side">
          <span class="micro-label">Evidence reviewed {editorial.reviewDate}</span>
          <dl>
            <dt>Filed under</dt>
            <dd>{editorial.kind}</dd>
            <dt>Source state</dt>
            <dd>Editor-reviewed public summary</dd>
          </dl>
        </div>
      )}
    </section>
    <section class:list={["container dossier-grid", isFoundingEssay && "founding-feature"]}>
      <article class="prose" {...entry?.edit}>
        {hasFeatureArt && <EditorialBlocks value={editorial.content.slice(0, 1)} />}
        <p {...entry?.edit.lead}>
          <strong>{editorial.lead}</strong>
        </p>
        {editorial.featuredImage && (
          <figure {...entry?.edit.featured_image}>
            <Image image={editorial.featuredImage} priority />
          </figure>
        )}
        <div {...entry?.edit.content}>
          <EditorialBlocks value={hasFeatureArt ? editorial.content.slice(1) : editorial.content} />
        </div>
        <div class="callout" {...entry?.edit.source_reference}>
          <p class="callout__title">Source and review</p>
          <p>
            {editorial.sourceReference} The publication does not reproduce private repository bodies
            or conversation transcripts.
          </p>
        </div>
        <p>
          <a href="/dispatches/">Back to the stories</a>
        </p>
      </article>
      <section class="margin-rail" aria-label="Article notes">
        <div class="margin-note" {...entry?.edit.lesson}>
          <span class="margin-note__label">What changed</span>
          <p>
            <strong>{editorial.lesson}</strong>
          </p>
        </div>
        <div class="margin-note">
          <span class="margin-note__label">Proof boundary</span>
          <p>
            Reviewed {editorial.reviewDate}. This is an edited public record, not a private source
            transcript.
          </p>
        </div>
      </section>
    </section>
    {hasBench && (
      <section class="container dispatch-bench" aria-labelledby="dispatch-bench-title">
        <div class="dispatch-bench__head">
          <p class="micro-label">Show me</p>
          <h2 id="dispatch-bench-title">
            {slug === "shared-music-independent-games"
              ? "What independent actually means here"
              : "Pull the claim apart"}
          </h2>
          <p>
            This is the working bench, not an illustration of it. Choose a state and the bench shows
            it; change the controls and it shows you something else.
          </p>
        </div>
        <div class="dispatch-bench__controls" role="group" aria-label="Show a state of the bench">
          <button type="button" data-bench-show='{"open":true,"separation":1}'>
            The three layers apart
          </button>
          <button type="button" data-bench-show='{"open":true,"layer":"music","music":false}'>
            The music disconnected
          </button>
          <button type="button" data-bench-show='{"open":true,"layer":"effects"}'>
            The effects bus on its own
          </button>
          <button type="button" data-bench-show='{"open":true,"layer":"run"}'>
            The run on its own
          </button>
        </div>
        <PatchBench
          variant="full"
          recipeHref="/exhibits/patch-bench/"
          recipeLabel="Open the full bench"
        />
      </section>
    )}
  </BaseLayout>
) : (
  <BaseLayout
    title="Story not found"
    description="This dispatch is not available in the public record."
    path={path}
    noindex
  >
    <section class="container page-intro">
      <h1 class="page-title">Story not found.</h1>
      <p>
        <a href="/dispatches/">Return to dispatches.</a>
      </p>
    </section>
  </BaseLayout>
)}

{hasBench && <script>
  // The "Show me" controls ask the bench for a state. The bench owns the
  // change; this only names it.
  const bench = document.querySelector<HTMLElement>("[data-patch-bench]");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-bench-show]")) {
    button.addEventListener("click", () => {
      if (!bench) return;
      let request: Record<string, unknown>;
      try {
        request = JSON.parse(button.dataset.benchShow ?? "{}") as Record<string, unknown>;
      } catch {
        return;
      }
      bench.dispatchEvent(new CustomEvent("woodhouse:bench", { detail: request }));
      bench.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  }
</script>}

<style>
  .dispatch-bench {
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--line);
  }
  .dispatch-bench__head {
    max-width: 62ch;
    margin-bottom: 1.25rem;
  }
  .dispatch-bench__head h2 {
    margin: 0.5rem 0 0.6rem;
    font: 750 clamp(1.7rem, 3vw, 2.4rem)/1.1 var(--display);
    letter-spacing: -0.03em;
  }
  .dispatch-bench__head p:last-child {
    margin: 0;
    color: var(--copy);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .dispatch-bench__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1.5rem;
  }
  .dispatch-bench__controls button {
    font: inherit;
    font-size: 0.82rem;
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--line);
    padding: 0.5rem 0.85rem;
    min-height: 44px;
    cursor: pointer;
    transition:
      border-color 140ms ease-out,
      color 140ms ease-out,
      filter 120ms ease-out;
  }
  .dispatch-bench__controls button:hover {
    border-color: var(--acid);
    color: var(--acid);
  }
  .dispatch-bench__controls button:focus-visible {
    outline: 3px solid var(--acid);
    outline-offset: 2px;
  }
</style>
