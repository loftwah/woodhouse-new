---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublishedDispatches } from "../../content/repository";
import { formatReviewDate } from "../../data/review-date";

const result = await listPublishedDispatches();
if (result.error) console.error("Failed to load published EmDash dispatches:", result.error);
const editorialDispatches = result.dispatches;
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);

export const prerender = false;
---

<BaseLayout
  title="Dispatches"
  description="Factory dispatches, field notes and incidents about software agents, quality gates, production evidence and physical proof."
  path="/dispatches/"
  currentPath="/dispatches/"
  image="/og/factory.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Dispatches</span>
        </nav>
        <h1 class="page-title">What the work taught us.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>Dispatches · field notes · incidents</strong>Writing follows real project work.
        Failures stay in the story because the resulting factory change is the useful part.
      </div>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      {editorialDispatches.map((dispatch, index) => (
        <article class="ledger-note">
          <span class="ledger-note__index">DISPATCH / {String(index + 1).padStart(2, "0")}</span>
          <div class="ledger-note__main">
            <a href={"/dispatches/" + dispatch.slug + "/"}>
              <h2 class="ledger-note__title">{dispatch.title}</h2>
            </a>
            <p class="ledger-note__deck">{dispatch.deck}</p>
          </div>
          <div class="ledger-note__side">
            <strong>{dispatch.kind}</strong>
            {formatReviewDate(dispatch.reviewDate) ?? dispatch.reviewDate}
            <br />
            Evidence reviewed {dispatch.reviewDate}
          </div>
        </article>
      ))}
      {result.error ? (
        <p class="source-note">
          <strong>Some recent dispatches may be missing.</strong> The published archive remains
          available. Private conversations are never published automatically.
        </p>
      ) : (
        <p class="source-note">
          <strong>Editorial policy:</strong> every public note is reviewed for private project
          details. Private conversations remain private unless Dean publishes an edited article.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
