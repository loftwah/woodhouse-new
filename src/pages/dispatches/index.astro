---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublishedDispatches } from "../../content/repository";
import { formatReviewDate } from "../../data/review-date";

const result = await listPublishedDispatches();
if (result.error) console.error("Failed to load published EmDash dispatches:", result.error);
const editorialDispatches = result.dispatches;
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);

export const prerender = false;
---

<BaseLayout
  title="Stories"
  description="Factory dispatches, field notes and incidents about software agents, quality gates, production evidence and physical proof."
  path="/dispatches/"
  currentPath="/dispatches/"
  image="/og/factory-workshop-20261018.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Stories</span>
        </nav>
        <h1 class="page-title">What the work taught us.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>Stories · field notes · incidents</strong>Writing follows real project work.
        Failures stay in the story because the resulting factory change is the useful part.
      </div>
    </div>
  </section>
  <section class="section edition-callout" aria-labelledby="current-edition">
    <div class="container">
      <p class="edition-callout__label">Current edition · 25 October 2026</p>
      <div class="edition-callout__row">
        <div>
          <h2 id="current-edition">
            <a href="/editions/what-we-built/">What we built</a>
          </h2>
          <p>
            Ten projects in one dated edit: what shipped, what is getting better, and what is still
            being built. Four of them you can open right now.
          </p>
        </div>
        <a class="edition-callout__action" href="/editions/what-we-built/">
          Read the edition
          <span aria-hidden="true"> ↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      {editorialDispatches.map((dispatch, index) => (
        <article class="ledger-note">
          <span class="ledger-note__index">DISPATCH / {String(index + 1).padStart(2, "0")}</span>
          <div class="ledger-note__main">
            <a href={"/dispatches/" + dispatch.slug + "/"}>
              <h2 class="ledger-note__title">{dispatch.title}</h2>
            </a>
            <p class="ledger-note__deck">{dispatch.deck}</p>
          </div>
          <div class="ledger-note__side">
            <strong>{dispatch.kind}</strong>
            {formatReviewDate(dispatch.reviewDate) ?? dispatch.reviewDate}
            <br />
            Evidence reviewed {dispatch.reviewDate}
          </div>
        </article>
      ))}
      {result.error ? (
        <p class="source-note">
          <strong>Some recent dispatches may be missing.</strong> The published archive remains
          available. Private conversations are never published automatically.
        </p>
      ) : (
        <p class="source-note">
          <strong>Editorial policy:</strong> every public note is reviewed for private project
          details. Private conversations remain private unless Dean publishes an edited article.
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .edition-callout {
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
  }
  .edition-callout__label {
    margin: 0 0 0.8rem;
    font: 0.7rem/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acid);
  }
  .edition-callout__row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2.5rem;
  }
  .edition-callout h2 {
    margin: 0 0 0.4rem;
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .edition-callout h2 a {
    color: var(--paper);
  }
  .edition-callout h2 a:hover {
    color: var(--acid);
  }
  .edition-callout p {
    max-width: 62ch;
    margin: 0;
    color: var(--copy-soft);
  }
  .edition-callout__action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0;
    color: var(--acid);
    font-family: var(--display);
    font-weight: 600;
    border-bottom: 2px solid var(--acid);
  }
</style>
