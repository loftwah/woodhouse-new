---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fieldNotes } from "../../data/field-notes";
---
<BaseLayout title="Dispatches" description="Factory dispatches, field notes and incidents about software agents, quality gates, production evidence and physical proof." path="/dispatches/" currentPath="/dispatches/" image="/og/factory.jpg">
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">WOODHOUSE</a><span>/</span><span>Dispatches</span></nav>
        <h1 class="page-title">What the work taught us.</h1>
      </div>
      <aside class="page-intro__aside"><strong>Dispatches · field notes · incidents</strong>Writing follows real project work. Failures stay in the story because the resulting factory change is the useful part.</aside>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      {fieldNotes.map((note, index) => (
        <article class="ledger-note">
          <span class="ledger-note__index">NOTE / 0{index + 1}</span>
          <div class="ledger-note__main">
            <a href={"/dispatches/" + note.slug + "/"}><h2 class="ledger-note__title">{note.title}</h2></a>
            <p class="ledger-note__deck">{note.deck}</p>
          </div>
          <div class="ledger-note__side"><strong>{note.kind}</strong>{note.date}<br />{note.readingTime}</div>
        </article>
      ))}
      <p class="source-note"><strong>Editorial policy:</strong> every public note is reviewed for private project details. This is a small, curated journal; it does not imply an automatic private-conversation publisher.</p>
    </div>
  </section>
</BaseLayout>
