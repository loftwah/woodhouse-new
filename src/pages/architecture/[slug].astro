---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectRecord } from "../../content/repository";
import { formatReviewDate } from "../../data/review-date";
import { lifecycleLabel } from "../../data/project-lifecycle";
import {
  atlasGroups,
  atlasProfile,
  atlasProfiles,
  atlasRelationships,
  atlasReview
} from "../../data/architecture-atlas";
import "../../styles/architecture-atlas.css";

export const prerender = false;
const slug = Astro.params.slug;
const profile = slug ? atlasProfile(slug) : undefined;
if (!profile)
  return new Response("Architecture profile not found.", {
    status: 404,
    headers: { "cache-control": "public, max-age=60" }
  });

const current = await getProjectRecord(profile.slug);
if (current.error)
  return new Response("Unable to load the reviewed project record.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const project = current.project;
if (!project)
  return new Response("Project not found.", {
    status: 404,
    headers: { "cache-control": "public, max-age=60" }
  });
if (Astro.cache?.enabled) for (const hint of current.cacheHints) if (hint) Astro.cache.set(hint);

const group = atlasGroups.find((item) => item.key === profile.group);
const lane = atlasProfiles.filter(
  (item) => item.group === profile.group && item.slug !== "woodhouse"
);
const position = lane.findIndex((item) => item.slug === profile.slug);
const previous = position > 0 ? lane[position - 1] : undefined;
const next = position >= 0 && position < lane.length - 1 ? lane[position + 1] : undefined;
const outgoing = atlasRelationships.filter((item) => item.from === profile.slug);
const incoming = atlasRelationships.filter((item) => item.to === profile.slug);
const reviewLabel = formatReviewDate(profile.reviewDate) ?? atlasReview.display;
const catalogueReview = formatReviewDate(project.reviewDate);
const statusLabel = profile.status === "live" ? "Live" : profile.status;
const nameOf = (value: string) => atlasProfile(value)?.name ?? value;
const linked = (value: string) =>
  value === "woodhouse" ? "/architecture/woodhouse/" : `/architecture/${value}/`;
---

<BaseLayout
  title={`${project.name} architecture · How it is built`}
  description={`How ${project.name} is built: verified stack, runtime, storage, identity and delivery route from its own source, plus the unknowns and the projects it connects to.`}
  path={`/architecture/${project.slug}/`}
  image="/og/factory-workshop-20261018.jpg"
>
  <section class="container profile-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">WOODHOUSE</a>
      <span>/</span>
      <a href="/architecture/">Architecture</a>
      <span>/</span>
      <span>{project.name}</span>
    </nav>
    <p class="eyebrow">{group?.label ?? "Project"} · architecture profile</p>
    <h1 class="profile-head__title">{project.name}</h1>
    <p class="profile-head__role">
      {profile.role}. {profile.shape}
    </p>
    <div class="profile-head__meta">
      <span class={`atlas-status atlas-status--${profile.status}`}>{statusLabel}</span>
      {lifecycleLabel(project.lifecycle) && (
        <span class="atlas-row__lifecycle">{lifecycleLabel(project.lifecycle)}</span>
      )}
      <span>Architecture reviewed {reviewLabel}</span>
      {catalogueReview && <span>Dossier reviewed {catalogueReview}</span>}
    </div>
    <div class="profile-head__actions">
      <a href={`/projects/${project.slug}/`}>
        The product dossier <span aria-hidden="true">→</span>
      </a>
      {project.siteUrl && (
        <a href={project.siteUrl}>
          Open {project.name} <span aria-hidden="true">↗</span>
        </a>
      )}
      <a href="/architecture/">All project architectures</a>
    </div>
  </section>

  <section class="container profile-grid">
    <div class="profile-body">
      <section aria-labelledby="built-heading">
        <h2 id="built-heading">How it is built.</h2>
        <p>{profile.summary}</p>
        <dl class="profile-facts">
          {profile.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>
                {fact.value}
                {fact.evidence && <small>Evidence: {fact.evidence}</small>}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="shape-heading">
        <h2 id="shape-heading">The shape of the system.</h2>
        <ol class="system-stack">
          {profile.parts.map((part) => (
            <li class="system-stack__part">
              <div>
                <strong>{part.label}</strong>
                <span>{part.detail}</span>
                {part.evidence && <small>Evidence: {part.evidence}</small>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {profile.deepDive && (
        <section aria-labelledby="deep-heading">
          <h2 id="deep-heading">{profile.deepDiveTitle}</h2>
          {profile.deepDive.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      )}

      {profile.decisions.length > 0 && (
        <section aria-labelledby="decisions-heading">
          <h2 id="decisions-heading">Engineering decisions worth knowing.</h2>
          <ul class="decisions">
            {profile.decisions.map((decision) => (
              <li>
                <strong>{decision.title}</strong>
                <p>{decision.detail}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section aria-labelledby="connect-heading">
        <h2 id="connect-heading">What it connects to.</h2>
        {outgoing.length === 0 && incoming.length === 0 ? (
          <p>
            No verified cross-project runtime relationship. {project.name} is reachable from
            Woodhouse as a published record, and its product links are ordinary navigable links.
          </p>
        ) : (
          <ul class="atlas-ledger">
            {outgoing.map((relationship) => (
              <li class="atlas-ledger__item">
                <p class="atlas-ledger__route">
                  <span>{project.name}</span>
                  <span class="atlas-ledger__arrow" aria-hidden="true">
                    →
                  </span>
                  <a href={linked(relationship.to)}>{nameOf(relationship.to)}</a>
                  <span>{relationship.short}</span>
                  {relationship.pair && <span class="atlas-ledger__pair">two-way</span>}
                </p>
                <p class="atlas-ledger__detail">{relationship.detail}</p>
                <p class="atlas-ledger__evidence">
                  <strong>Evidence:</strong> {relationship.evidence}
                </p>
              </li>
            ))}
            {incoming.map((relationship) => (
              <li class="atlas-ledger__item">
                <p class="atlas-ledger__route">
                  <a href={linked(relationship.from)}>{nameOf(relationship.from)}</a>
                  <span class="atlas-ledger__arrow" aria-hidden="true">
                    →
                  </span>
                  <span>{project.name}</span>
                  <span>{relationship.short}</span>
                  {relationship.pair && <span class="atlas-ledger__pair">two-way</span>}
                </p>
                <p class="atlas-ledger__detail">{relationship.detail}</p>
                <p class="atlas-ledger__evidence">
                  <strong>Evidence:</strong> {relationship.evidence}
                </p>
              </li>
            ))}
          </ul>
        )}
        {profile.publicSources.length > 0 && (
          <>
            <h3>Authoritative public sources</h3>
            <ul class="rail-links">
              {profile.publicSources.map((source) => (
                <li>
                  <a href={source.href}>{source.label} ↗</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      <section class="unknowns" aria-labelledby="unknown-heading">
        <h2 id="unknown-heading">What this review does not know.</h2>
        <ul>
          {profile.unknowns.map((unknown) => (
            <li>{unknown}</li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="profile-rail">
      <div class="rail-card">
        <h2>Reviewed facts</h2>
        <p>
          Status: {statusLabel}. {profile.statusNote}
        </p>
        <p>
          Evidence comes from the project's own source tree and public deployment, read on{" "}
          {reviewLabel}. Private repositories are summarised, not republished.
        </p>
        <p>
          Source revision: <code>{profile.reference}</code>.
        </p>
      </div>
      <div class="rail-card">
        <h2>Same lane</h2>
        <ul class="rail-links">
          {lane
            .filter((item) => item.slug !== profile.slug)
            .map((item) => (
              <li>
                <a href={`/architecture/${item.slug}/`}>{item.name} architecture →</a>
              </li>
            ))}
        </ul>
      </div>
      <div class="rail-card">
        <h2>Read with</h2>
        <ul class="rail-links">
          <li>
            <a href={`/projects/${project.slug}/`}>{project.name} product dossier →</a>
          </li>
          <li>
            <a href="/architecture/woodhouse/">How Woodhouse publishes this record →</a>
          </li>
          <li>
            <a href="/factory/">Try a working connection →</a>
          </li>
        </ul>
      </div>
    </aside>
  </section>

  <nav class="container atlas-pager" aria-label="Architecture profiles">
    {previous ? <a href={`/architecture/${previous.slug}/`}>← {previous.name}</a> : <span />}
    <a href="/architecture/">All project architectures</a>
    {next ? <a href={`/architecture/${next.slug}/`}>{next.name} →</a> : <span />}
  </nav>
</BaseLayout>
