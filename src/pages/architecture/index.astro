---
import BaseLayout from "../../layouts/BaseLayout.astro";
import D2Diagram from "../../components/D2Diagram.astro";
import { listProjectRecords } from "../../content/repository";
import { formatReviewDate } from "../../data/review-date";
import { lifecycleLabel } from "../../data/project-lifecycle";
import {
  atlasGroups,
  atlasProfiles,
  atlasRelationships,
  atlasReview,
  atlasProfile
} from "../../data/architecture-atlas";
import "../../styles/architecture-atlas.css";

export const prerender = false;
const result = await listProjectRecords();
if (result.error)
  return new Response("Unable to load the reviewed project catalogue.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const catalogue = result.projects;
if (Astro.cache?.enabled) for (const hint of result.cacheHints) Astro.cache.set(hint);

// The catalogue is authoritative for identity and lifecycle. The atlas adds
// reviewed architecture facts; a catalogue project without a profile must stay
// visible as unassessed rather than disappear from the coverage claim.
const lanes = atlasGroups
  .map((group) => ({
    group,
    projects: catalogue
      .filter((project) => atlasProfile(project.slug)?.group === group.key)
      .sort((a, b) => a.index.localeCompare(b.index))
      .map((project) => ({ project, profile: atlasProfile(project.slug) }))
  }))
  .filter((lane) => lane.projects.length > 0);
const assessed = catalogue.filter((project) => atlasProfile(project.slug)).length;
const unassessed = catalogue.filter((project) => !atlasProfile(project.slug));
const relationships = atlasRelationships.filter(
  (relationship) => atlasProfile(relationship.from) && atlasProfile(relationship.to)
);
const deepDives = atlasProfiles.filter((profile) => profile.deepDive);
const groupParam = Astro.url.searchParams.get("group");
const statusParam = Astro.url.searchParams.get("status");
const activeGroup = atlasGroups.find((group) => group.key === groupParam)?.key ?? null;
const activeStatus = ["live", "demo", "planned", "unknown"].includes(statusParam ?? "")
  ? statusParam
  : null;
const visibleLanes = lanes
  .filter((lane) => !activeGroup || lane.group.key === activeGroup)
  .map((lane) => ({
    ...lane,
    projects: lane.projects.filter(
      ({ profile }) => !activeStatus || profile?.status === activeStatus
    )
  }))
  .filter((lane) => lane.projects.length > 0);
const shownCount = visibleLanes.reduce((total, lane) => total + lane.projects.length, 0);
function filterHref(group: string | null, status: string | null) {
  const query = new URLSearchParams();
  if (group) query.set("group", group);
  if (status) query.set("status", status);
  return `/architecture/${query.size ? `?${query}#projects` : "#projects"}`;
}
const reviewLabel = formatReviewDate(atlasReview.date) ?? atlasReview.display;
const statusLabel = (status: string) =>
  status === "live" ? "Live" : status.charAt(0).toUpperCase() + status.slice(1);
const nameOf = (slug: string) => atlasProfile(slug)?.name ?? slug;
const linked = (slug: string) =>
  slug === "woodhouse" ? "/architecture/woodhouse/" : `/architecture/${slug}/`;
---

<BaseLayout
  title="Portfolio architecture · How every Loftwah project is built"
  description="How every Loftwah project is built and connected: the verified stack, runtime, storage, identity and delivery behind twelve independent products, with the unknowns stated."
  path="/architecture/"
  image="/og/factory-workshop-20261018.jpg"
>
  <section class="container atlas-intro">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">WOODHOUSE</a>
      <span>/</span>
      <span>Architecture</span>
    </nav>
    <p class="eyebrow">Portfolio architecture</p>
    <h1 class="page-title">
      Twelve products.
      <br />
      <em>Separate systems.</em>
    </h1>
    <p class="lead">
      Woodhouse publishes the record, not the machine room. This atlas explains how each project is
      actually built, which ones share a capability, and what nobody has verified yet.
    </p>
    <div class="atlas-intro__aside">
      <p>
        <strong>Reviewed {reviewLabel}.</strong> Project identity and lifecycle come from the
        reviewed Woodhouse catalogue. Architecture facts come from each project's own source tree
        and public deployment. This is a dated projection of that review, not a live code scanner.
      </p>
      <p>
        Looking for something to use? <a href="/projects/">The project dossiers</a> are the product
        record. Want to try a working connection? <a href="/factory/">The Factory</a> is the bench.
        This page is the engineering underneath both.
      </p>
    </div>
    <ul class="atlas-legend" aria-label="Status legend">
      <li>
        <span class="atlas-key atlas-key--live" aria-hidden="true"></span>Live: a public route
        answered at review
      </li>
      <li>
        <span class="atlas-key atlas-key--demo" aria-hidden="true"></span>Demo or prototype
      </li>
      <li>
        <span class="atlas-key atlas-key--planned" aria-hidden="true"></span>Planned, not serving
      </li>
      <li>
        <span class="atlas-key atlas-key--unknown" aria-hidden="true"></span>Unknown or withheld
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="atlas-plate-heading">
    <div class="container">
      <div class="atlas-section__heading">
        <h2 id="atlas-plate-heading">The whole portfolio on one plate.</h2>
        <p>
          Every project in the current catalogue, grouped by what it does, plus the publisher. The
          plate draws the shared capability the source proves; the ledger below carries every
          verified relationship, including measurement and contract reads.
        </p>
      </div>
      <D2Diagram
        title="Twelve product boundaries and the publisher"
        description="Twelve Loftwah projects plus Woodhouse, grouped as play, listen, build, collect, everyday tools and publish. Each node carries a live, demo, planned or unknown label. Four games use one LoftwahFM radio client; the text transcript repeats the whole picture."
        desktop="/images/diagrams/portfolio-atlas.svg"
        mobile="/images/diagrams/portfolio-atlas-mobile.svg"
        caption="A product boundary is not a deployment boundary: each profile names its own runtime and data. Reviewed 7 November 2026."
        className="atlas-plate"
        priority={true}
        mobileBreakpoint={900}
      >
        {lanes.map((lane) => (
          <div>
            <p>
              <strong>{lane.group.label}</strong> — {lane.group.note}
            </p>
            <ul>
              {lane.projects.map(({ project, profile }) => (
                <li>
                  {project.name}: {profile?.role} Status: {profile?.status ?? "unassessed"}.
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <p>
            <strong>Verified capability relationships</strong>
          </p>
          <ul>
            {relationships
              .filter((relationship) => relationship.plate !== false)
              .map((relationship) => (
                <li>
                  {nameOf(relationship.from)} {relationship.verb} {nameOf(relationship.to)}:{" "}
                  {relationship.short}.
                </li>
              ))}
          </ul>
        </div>
      </D2Diagram>
    </div>
  </section>

  <section class="section paper-section" id="projects" aria-labelledby="register-heading">
    <div class="container">
      <div class="atlas-section__heading">
        <h2 id="register-heading">Every project, by what it does.</h2>
        <p>
          Each row opens a profile with the stack, runtime, storage, identity, delivery route and
          the unknowns. {assessed} of {catalogue.length} catalogue projects are assessed in this
          review.
        </p>
      </div>
      <nav class="atlas-filters" aria-label="Filter the project register">
        <p class="atlas-filters__label">Group</p>
        <ul>
          <li>
            <a
              href={filterHref(null, activeStatus)}
              aria-current={!activeGroup ? "true" : undefined}
            >
              All
            </a>
          </li>
          {atlasGroups
            .filter((group) => lanes.some((lane) => lane.group.key === group.key))
            .map((group) => (
              <li>
                <a
                  href={filterHref(group.key, activeStatus)}
                  aria-current={activeGroup === group.key ? "true" : undefined}
                >
                  {group.label}
                </a>
              </li>
            ))}
        </ul>
        <p class="atlas-filters__label">Status</p>
        <ul>
          <li>
            <a
              href={filterHref(activeGroup, null)}
              aria-current={!activeStatus ? "true" : undefined}
            >
              Any
            </a>
          </li>
          {["live", "demo", "planned", "unknown"].map((status) => (
            <li>
              <a
                href={filterHref(activeGroup, status)}
                aria-current={activeStatus === status ? "true" : undefined}
              >
                {statusLabel(status)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="atlas-filter-count" role="status">
        Showing {shownCount} of {catalogue.length} catalogue projects
        {activeGroup ? ` in ${atlasGroups.find((group) => group.key === activeGroup)?.label}` : ""}
        {activeStatus ? ` with status ${statusLabel(activeStatus)}` : ""}.
      </p>
      {visibleLanes.length === 0 && (
        <p class="atlas-empty">
          No project in the current catalogue matches that filter.{" "}
          <a href="/architecture/#projects">Clear the filter</a> to see the whole register.
        </p>
      )}
      {visibleLanes.map((lane) => (
        <section class="atlas-lane" aria-labelledby={`lane-${lane.group.key}`}>
          <div class="atlas-lane__heading">
            <h3 id={`lane-${lane.group.key}`}>{lane.group.label}</h3>
            <p>{lane.group.note}</p>
          </div>
          <ul class="atlas-rows">
            {lane.projects.map(({ project, profile }) => (
              <li class="atlas-row">
                <div class="atlas-row__identity">
                  <a class="atlas-row__name" href={`/architecture/${project.slug}/`}>
                    {project.name}
                  </a>
                  <p class="atlas-row__role">
                    {profile?.role ?? "Architecture not yet assessed in this review."}
                  </p>
                  {profile && (
                    <ul class="atlas-row__stack" aria-label="Verified stack summary">
                      {profile.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class="atlas-row__meta">
                  {profile ? (
                    <span class={`atlas-status atlas-status--${profile.status}`}>
                      {statusLabel(profile.status)}
                    </span>
                  ) : (
                    <span class="atlas-status atlas-status--unknown">Unassessed</span>
                  )}
                  {lifecycleLabel(project.lifecycle) && (
                    <span class="atlas-row__lifecycle">{lifecycleLabel(project.lifecycle)}</span>
                  )}
                  <span class="atlas-row__review">
                    Reviewed{" "}
                    {formatReviewDate(profile?.reviewDate ?? atlasReview.date) ?? reviewLabel}
                  </span>
                </div>
                <a class="atlas-row__link" href={`/architecture/${project.slug}/`}>
                  Architecture <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {unassessed.length > 0 && (
        <p>
          <strong>Not yet assessed:</strong> {unassessed.map((project) => project.name).join(", ")}.
          These stay in the catalogue record and make no architecture claim.
        </p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="connections-heading">
    <div class="container">
      <div class="atlas-section__heading">
        <h2 id="connections-heading">Where the projects actually connect.</h2>
        <p>
          Most of this portfolio is independent by design. These are the relationships the source
          proves. Everything else is a link between pages, not a runtime dependency.
        </p>
      </div>
      <ol class="atlas-ledger">
        {relationships.map((relationship) => (
          <li class="atlas-ledger__item">
            <p class="atlas-ledger__route">
              <a href={linked(relationship.from)}>{nameOf(relationship.from)}</a>
              <span>{relationship.verb}</span>
              <a href={linked(relationship.to)}>{nameOf(relationship.to)}</a>
              {relationship.pair && <span class="atlas-ledger__pair">two-way</span>}
            </p>
            <p class="atlas-ledger__detail">{relationship.detail}</p>
            <p class="atlas-ledger__evidence">
              <strong>Evidence:</strong> {relationship.evidence}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="deep-dives-heading">
    <div class="container">
      <div class="atlas-section__heading">
        <h2 id="deep-dives-heading">Four systems, taken apart.</h2>
        <p>
          The profiles are not one checklist copied twelve times. These four carry a longer
          explanation because their engineering is materially different from the rest.
        </p>
      </div>
      <ul class="atlas-rows">
        {deepDives.map((profile) => (
          <li class="atlas-row">
            <div class="atlas-row__identity">
              <a class="atlas-row__name" href={`/architecture/${profile.slug}/`}>
                {profile.name}
              </a>
              <p class="atlas-row__role">{profile.deepDiveReason}</p>
            </div>
            <div class="atlas-row__meta">
              <span class={`atlas-status atlas-status--${profile.status}`}>
                {statusLabel(profile.status)}
              </span>
            </div>
            <a class="atlas-row__link" href={`/architecture/${profile.slug}/`}>
              Read the deep dive <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section paper-section" aria-labelledby="reading-heading">
    <div class="container atlas-notes">
      <div>
        <h2 id="reading-heading">What this atlas can tell you.</h2>
        <p>
          A verified value was read from that project's own configuration or source at the review
          date, or observed from its public deployment. Each profile names the evidence beside the
          claim.
        </p>
        <p>
          A relationship is drawn only when the consumer's source or a published consumer contract
          proves it. A shared colour, a link in a footer or a product idea is not a relationship.
        </p>
      </div>
      <div>
        <h2>What it cannot tell you.</h2>
        <p>
          This is not a live inventory. It does not read private repositories at request time, prove
          production health, or turn a README ambition into a shipped node. Unknown means nobody has
          verified it for this review.
        </p>
        <p>
          Deployment status and product lifecycle are separate: a retired product can still serve a
          page, and a live page is not evidence of current development.{" "}
          <a href="/architecture/woodhouse/">Woodhouse's own architecture</a> explains how this
          published record is produced.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
