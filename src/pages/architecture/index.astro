---
import BaseLayout from "../../layouts/BaseLayout.astro";
import D2Diagram from "../../components/D2Diagram.astro";
export const prerender = false;
---

<BaseLayout
  title="Architecture"
  description="How Woodhouse keeps its reviewed project snapshot separate from EmDash editorial publishing on Cloudflare Workers."
  path="/architecture/"
  image="/og/factory.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Architecture</span>
        </nav>
        <h1 class="page-title">
          A public record.
          <br />
          <em>Private inputs stay private.</em>
        </h1>
      </div>
      <div class="page-intro__aside">
        <strong>Astro · EmDash · Cloudflare Workers</strong>Woodhouse keeps its authored
        presentation; EmDash supplies reviewed content at request time.
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <D2Diagram
        title="Artwork keeps its source"
        description="Each product site has its own title, icon, description and main image. Woodhouse credits and links to the project behind each image. Illustrations made for project dossiers are credited to Woodhouse."
        desktop="/images/diagrams/publication-path.svg"
        mobile="/images/diagrams/publication-path-mobile.svg"
        caption="Project artwork links to its source. Woodhouse illustrations carry a clear credit."
        className="publication-plate"
      >
        <ol class="diagram-transcript">
          <li>
            <strong>Project site</strong>
            <span>
              Owns and serves its page title, search and sharing details, icon, description and main
              image.
            </span>
          </li>
          <li>
            <strong>Woodhouse build</strong>
            <span>
              Records public details and preserves the source of each project's own image.
            </span>
          </li>
          <li>
            <strong>Visitor's browser</strong>
            <span>Shows the credited artwork and links to that project's own site.</span>
          </li>
          <li>
            <strong>Woodhouse illustration</strong>
            <span>Project-dossier illustrations are credited to Woodhouse.</span>
          </li>
          <li>
            <strong>Private data</strong>
            <span>Issues, transcripts and credentials stay outside the public build.</span>
          </li>
        </ol>
      </D2Diagram>
    </div>
  </section>
  <section class="section paper-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>The browser gets a finished page.</h2>
        </div>
        <p>
          GitHub remains authoritative. The current edition publishes a reviewed snapshot because
          most project repositories are private.
        </p>
      </div>
      <div class="two-column-list">
        <article class="method-step">
          <span class="method-step__n">01</span>
          <div>
            <h3>Review the source</h3>
            <p>
              A human-readable, public-safe project report is the input. Private issue and pull
              request bodies stay in their repositories.
            </p>
          </div>
        </article>
        <article class="method-step">
          <span class="method-step__n">02</span>
          <div>
            <h3>Record the date</h3>
            <p>
              Every state belongs to the 28 September 2026 snapshot. A later report must be reviewed
              before the date is moved.
            </p>
          </div>
        </article>
        <article class="method-step">
          <span class="method-step__n">03</span>
          <div>
            <h3>Review and publish</h3>
            <p>
              EmDash holds structured project states, evidence, dispatches, drafts, revisions,
              approved media and publishing schedules. Astro renders each public page with the
              existing Woodhouse components.
            </p>
          </div>
        </article>
        <article class="method-step">
          <span class="method-step__n">04</span>
          <div>
            <h3>Serve from the edge</h3>
            <p>
              The Cloudflare Worker renders the public read model from published EmDash records and
              serves static assets at the edge. Readers need no account; editors use the
              authenticated EmDash office.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split-section">
      <div class="split-section__copy">
        <h2>Visitors can read the report. They cannot change it.</h2>
        <p>
          The public JSON contains project names, reviewed state, summary, next proof and review
          date. It cannot query private GitHub repositories or run a tool. If a collector is added
          later, a person will review each proposed update before it is published.
        </p>
        <p>
          EmDash uses D1 for editorial records and R2 for approved media. Woodhouse has no D1 event
          store, R2 evidence archive, public chat or private project office. Editorial storage does
          not receive repository credentials or private project data.
        </p>
      </div>
      <div class="factory-plate">
        <div class="factory-plate__heading">
          <span>DATA BOUNDARY</span>
          <span>PUBLIC READ MODEL</span>
        </div>
        <div
          class="agent-entry"
          style="grid-template-columns:1fr;gap:1.1rem;margin-top:1rem;padding:1.2rem"
        >
          <div>
            <span class="agent-entry__label">Approved for publication</span>
            <p>Reviewed summary · state · next proof · review date · edited dispatches</p>
          </div>
          <div>
            <span class="agent-entry__label">Stays outside public content</span>
            <p>
              Issue bodies · private transcripts · repository credentials · unreviewed agent
              interpretation
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
