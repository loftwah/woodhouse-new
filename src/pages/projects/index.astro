---
import { projectAction } from "../../data/project-actions";
import EditionInvitation from "../../components/EditionInvitation.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatReviewDate } from "../../data/review-date";
import { portfolioReadout } from "../../data/portfolio";
import ProjectRow from "../../components/ProjectRow.astro";
import { listProjectRecords } from "../../content/repository";
const result = await listProjectRecords();
if (result.error)
  return new Response("Unable to load public project records.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = result.projects;
// Native query views must not share the path-only route cache.
Astro.cache.set(false);
Astro.response.headers.set("cache-control", "private, no-store");
const choices = [
  { key: "all", label: "Everything", actions: [] },
  { key: "play", label: "Play a game", actions: ["Play"] },
  { key: "listen", label: "Listen", actions: ["Listen"] },
  { key: "build", label: "Build something", actions: ["Try"] },
  { key: "explore", label: "Explore experiments", actions: ["Open", "See"] }
];
const choice = choices.find((item) => item.key === Astro.url.searchParams.get("do")) ?? choices[0]!;
const shown = projects.filter(
  (project) => choice.key === "all" || choice.actions.includes(projectAction(project).action)
);
function choiceLink(key: string) {
  const query = new URLSearchParams();
  if (key !== "all") query.set("do", key);
  if (Astro.url.searchParams.get("analytics") === "off") query.set("analytics", "off");
  if (Astro.url.searchParams.has("qa")) query.set("qa", "");
  return `/projects/${query.size ? `?${query}` : ""}#project-choices`;
}
// The newest review across the portfolio, not the first row's: projects[0] is
// Bubbles and would misreport the whole index as reviewed on its own date.
const reviewDate = portfolioReadout(projects).reviewDate;
const reviewDateLabel = formatReviewDate(reviewDate) ?? "Review date unavailable";
export const prerender = false;
---

<BaseLayout
  title="Projects"
  description="Games you can play now, music you can listen to, tools you can try and experiments with their evidence attached. Every project from the Loftwah Software Factory."
  path="/projects/"
  image="/og/factory-workshop-20261018.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Projects</span>
        </nav>
        <h1 class="page-title">Explore the projects.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>
          {projects.length} projects · newest review {reviewDateLabel}
        </strong>
        Each row starts with what the product is and how you can use it today. The dated status, the
        artwork source and the limits of each claim sit further in, on the project's own page.
      </div>
    </div>
  </section>
  <div class="container">
    <EditionInvitation />
  </div>
  <section class="section paper-section">
    <div class="container">
      <nav class="project-choices" id="project-choices" aria-label="Find something to do">
        {choices.map((item) => (
          <a
            href={choiceLink(item.key)}
            aria-current={item.key === choice.key ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <p class="project-choice-count" role="status">
        {choice.key === "all"
          ? `All ${projects.length} projects`
          : `${shown.length} of ${projects.length} projects · ${choice.label}`}
      </p>
      <div class="project-ledger">
        {shown.map((project) => (
          <ProjectRow project={project} headingLevel="h2" />
        ))}
      </div>
      <p class="source-note">
        <strong>Source:</strong> operator-reviewed public summary. Private repository material
        remains private.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .project-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    border-block: 1px solid var(--line);
    padding-block: 0.75rem;
    scroll-margin-top: 6rem;
  }
  .project-choices a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--copy);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .project-choices a[aria-current="page"] {
    color: var(--acid);
    border-color: var(--acid);
  }
  .project-choices a:hover {
    color: var(--acid);
  }
  .project-choice-count {
    color: var(--muted);
    margin-block: 1rem 2rem;
  }
</style>
