---
import BuildExamples from "../../components/BuildExamples.astro";
import CapabilityRecord from "../../components/CapabilityRecord.astro";
import { listPublicCapabilities } from "../../content/repository";
import { dispatchPath } from "../../data/what-we-built";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatusStamp from "../../components/StatusStamp.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import D2Diagram from "../../components/D2Diagram.astro";
import GameMedia from "../../components/GameMedia.astro";
import { featuredMediaFor } from "../../data/featured-media";
import { leaderboardProjects } from "../../data/github-leaderboards";
import {
  listProjectRecords,
  getProjectRecord,
  getEditorialDispatch
} from "../../content/repository";
import {
  getArtworkFallback,
  getSiteMetadata,
  socialCardFor,
  WOODHOUSE_SOCIAL_CARD,
  WOODHOUSE_SOCIAL_CARD_ALT
} from "../../data/site-metadata";
import { projectAction, projectActionHref, projectActionLabel } from "../../data/project-actions";
import { formatReviewDate } from "../../data/review-date";
import { toJsonLd } from "../../data/safe-json";
import {
  analyticsProjects,
  discoveryProjects,
  type AnalyticsProject
} from "../../data/portfolio-analytics";
import { productView } from "../../data/analytics-workbench";
import { publicCampaignItems, campaignCollectionPath } from "../../data/showcase-public";
import { liveProjectArtwork } from "../../data/live-project-artwork";

export const prerender = false;
const slug = Astro.params.slug;
const current = slug ? await getProjectRecord(slug) : null;
if (current?.error)
  return new Response("Unable to load this public project dossier.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const project = current?.project ? await liveProjectArtwork(current.project) : undefined;
const isPreview = current?.isPreview === true;
const projectEntry = current?.projectEntry;
const statusEntry = current?.status;
if (!project)
  return new Response("Project not found.", {
    status: 404,
    headers: { "cache-control": "public, max-age=60" }
  });
if (isPreview) {
  Astro.cache?.set(false);
  Astro.response.headers.set("cache-control", "private, no-store, max-age=0");
  Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
} else if (Astro.cache?.enabled)
  for (const hint of current?.cacheHints ?? []) if (hint) Astro.cache.set(hint);
const allProjects = await listProjectRecords();
if (allProjects.error)
  return new Response("Unable to load public project records.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
if (Astro.cache?.enabled) for (const hint of allProjects.cacheHints) Astro.cache.set(hint);
const nextProjects = allProjects.projects.filter((item) => item.slug !== project?.slug).slice(0, 3);
const campaign = publicCampaignItems(allProjects.projects.map((item) => item.slug)).filter(
  (item) => item.project === project.slug
);
const reviewDateLabel = formatReviewDate(project?.reviewDate) ?? "Review date unavailable";
const snapshotSource = project?.snapshotSource ?? "No public snapshot is available.";
const siteMeta = project.siteUrl ? getSiteMetadata(project) : null;
const artworkFallback = getArtworkFallback(project);
// The per-project SVG names the project, which is what an image needs to do when
// a product's own artwork fails to load. It is not what should greet a visitor on
// a project with no artwork at all: the page already says which project this is,
// and a drawn index-and-status card reads as a generated form. Show the site's
// owned card instead and keep the SVG for error recovery.
const placeholder = artworkFallback.image;
// Display and social metadata are decided separately. A product that publishes
// only an SVG still renders it here — a browser draws SVG perfectly well — while
// its social tag switches to a raster, because unfurlers do not.
const artworkSource = siteMeta ? siteMeta.image : WOODHOUSE_SOCIAL_CARD;
const artworkAlt = siteMeta
  ? (project.previewAlt ?? `Artwork from the ${project.name} site.`)
  : WOODHOUSE_SOCIAL_CARD_ALT;
const studioFilm = featuredMediaFor(project.slug);
// These are individual editorial features in the existing article series.
const featureSlug =
  project.slug === "bubbles"
    ? "a-better-second-attempt"
    : project.slug === "app-composer"
      ? "your-apps-should-get-along"
      : project.slug === "loftwahfm"
        ? "your-game-its-own-soundtrack"
        : null;
const featureResult = featureSlug ? await getEditorialDispatch(featureSlug) : null;
const feature = featureResult?.dispatch;
if (!isPreview && Astro.cache?.enabled && featureResult?.cacheHint)
  Astro.cache.set(featureResult.cacheHint);
const action = projectAction(project);
const actionHref = projectActionHref(project);
const actionLabel = projectActionLabel(project);
const actionExternal = Boolean(project.siteUrl);
const social = socialCardFor(project);
const siteOrigin = Astro.site?.origin ?? "https://woodhouse.loftwah.com";
const capabilityResult = await listPublicCapabilities();
if (capabilityResult.error)
  return new Response("Unable to load public capability evidence.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
if (Astro.cache?.enabled) for (const hint of capabilityResult.cacheHints) Astro.cache.set(hint);
---

<BaseLayout
  title={project.name}
  description={project.summary}
  path={"/projects/" + project.slug + "/"}
  currentPath="/projects/"
  image={social.image}
  imageAlt={social.alt}
  imageWidth={social.width}
  imageHeight={social.height}
  type="website"
  contentRef={{ collection: "projects", id: projectEntry?.id ?? project.slug, slug: project.slug }}
  contentSeo={projectEntry ? { data: projectEntry.data } : undefined}
  noindex={isPreview}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: project.name,
      applicationCategory: project.discipline,
      description: project.summary,
      url: `${siteOrigin}/projects/${project.slug}/`,
      author: { "@type": "Person", name: "Dean Lofts", url: `${siteOrigin}/dean/` },
      dateModified: project.reviewDate
    })}
  />
  {isPreview && (
    <p class="container source-note">
      <strong>Unpublished preview.</strong> This project draft is shown only through authenticated
      EmDash preview.
    </p>
  )}
  <section class="container dossier-hero" {...projectEntry?.edit}>
    <div>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">WOODHOUSE</a>
        <span>/</span>
        <a href="/projects/">Projects</a>
        <span>/</span>
        <span>{project.name}</span>
      </nav>
      <p class="article-meta">{project.discipline}</p>
      <h1 {...projectEntry?.edit.name}>{project.name}</h1>
      <p class="dossier-hero__hook" {...projectEntry?.edit.title}>
        {project.title}
      </p>
      <p class="dossier-hero__summary" {...projectEntry?.edit.summary}>
        {project.summary}
      </p>
      <div class="dossier-hero__actions">
        <a
          class="dossier-hero__action"
          href={actionHref}
          target={actionExternal ? "_blank" : undefined}
          rel={actionExternal ? "noopener noreferrer" : undefined}
        >
          {actionLabel} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#where-the-work-stands">
          See how it works <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="dossier-hero__availability">{action.availability}</p>
    </div>
    <div class="dossier-hero__side">
      <StatusStamp tone={project.stateTone} label={project.state} />
      <dl>
        <dt>Reviewed</dt>
        <dd>{reviewDateLabel}</dd>
        <dt>Public build</dt>
        <dd>{siteMeta ? "A site you can open today" : "No public build yet"}</dd>
        <dt>Evidence</dt>
        <dd>Operator-reviewed snapshot</dd>
        <dt>Record</dt>
        <dd>
          {project.index} / {allProjects.projects.length}
        </dd>
      </dl>
      {leaderboardProjects.some((entry) => entry.slug === project.slug) && (
        <p class="dossier-hero__analytics">
          <a class="text-link" href={`/activity/leaderboards/?project=${project.slug}`}>
            See where {project.name} ranks <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
      {analyticsProjects.includes(project.slug as AnalyticsProject) && (
        <p class="dossier-hero__analytics">
          <a
            class="text-link"
            href={`/activity/?project=${project.slug}&measure=${productView(project.slug as AnalyticsProject)!.defaultMeasure}`}
          >
            See what {project.name} records <span aria-hidden="true">↗</span>
          </a>
        </p>
      )}
      {project.siteUrl &&
        discoveryProjects.includes(project.slug as (typeof discoveryProjects)[number]) && (
          <p class="dossier-hero__analytics">
            <a
              class="text-link"
              href={`/activity/?project=woodhouse&measure=project_opens&destination=${project.slug}#discovery-story`}
            >
              See how Woodhouse readers find {project.name} <span aria-hidden="true">↗</span>
            </a>
          </p>
        )}
    </div>
  </section>
  <figure
    class="container dossier-preview"
    aria-label={`Source artwork for ${project.name}`}
    data-project-artwork
    {...projectEntry?.edit.site_og_image}
  >
    <img
      src={artworkSource}
      width={project.previewWidth ?? 1200}
      height={project.previewHeight ?? 630}
      alt={artworkAlt}
      loading="eager"
      decoding="async"
      data-fallback-src={siteMeta ? placeholder : undefined}
      data-fallback-alt={siteMeta ? artworkFallback.alt : undefined}
      data-fallback-credit={siteMeta ? artworkFallback.credit : undefined}
    />
    <figcaption>
      <span>
        <strong data-artwork-status>
          {siteMeta ? "ARTWORK FROM THE PRODUCT'S OWN SITE" : "WOODHOUSE"}
        </strong>
        {siteMeta ? (
          <>
            <span class="dossier-preview__title" data-artwork-source-metadata>
              {siteMeta.title}
            </span>
            <span class="dossier-preview__description" data-artwork-source-metadata>
              {siteMeta.description}
            </span>
            <span class="dossier-preview__caption" data-artwork-source-metadata>
              {project.previewCaption ?? "Artwork displayed directly from the project site."}
            </span>
          </>
        ) : (
          <span class="dossier-preview__description">
            This project publishes no artwork of its own. The plate is Woodhouse's, drawn from the
            signature the homepage renders live.
          </span>
        )}
      </span>
      {project.siteUrl && (
        <a href={project.siteUrl} target="_blank" rel="noopener noreferrer">
          Open {project.name} <span aria-hidden="true">↗</span>
        </a>
      )}
    </figcaption>
  </figure>
  {campaign.length > 0 && (
    <section class="container project-campaign" aria-labelledby="campaign-title">
      <div>
        <h2 id="campaign-title">Take a closer look.</h2>
        <p>New artwork and current product captures, with original downloads.</p>
        <a class="text-link" href={campaignCollectionPath(project.slug)}>
          Explore the {project.name} gallery ↗
        </a>
      </div>
      <a
        href={campaignCollectionPath(project.slug)}
        aria-label={`Explore ${project.name} artwork and screenshots`}
      >
        <img
          src={campaign[0]!.image}
          width={campaign[0]!.width}
          height={campaign[0]!.height}
          alt={campaign[0]!.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
    </section>
  )}
  {studioFilm && (
    <section class="container dossier-film" aria-label={`${project.name} product film`}>
      <h2 class="dossier-media__heading">Watch {project.name}</h2>
      <GameMedia asset={studioFilm} destination={project.siteUrl ?? `/projects/${project.slug}/`} />
      <p class="film-links">
        {project.siteUrl && (
          <a href={project.siteUrl} target="_blank" rel="noopener noreferrer">
            Open {project.name} <span aria-hidden="true">↗</span>
          </a>
        )}
        <a href={`/share/?project=${project.slug}&type=clips`}>More sharing options</a>
        <a href={studioFilm.file.replace(/\.mp4$/, ".credits.txt")}>Film credits</a>
      </p>
    </section>
  )}
  {project.slug === "pirates" && (
    <section class="container project-visual" aria-label="Pirates reconstruction path">
      <D2Diagram
        title="Parity before expansion"
        description="Original game evidence informs reconstruction; the reconstructed game must reach integrated parity before Gate B can open. Unresolved source details stay unknown rather than being invented."
        desktop="/images/diagrams/pirates-parity.svg"
        mobile="/images/diagrams/pirates-parity-mobile.svg"
        caption="Gate B stays locked until integrated parity is supported by the original game's evidence."
        className="project-parity"
      >
        <ol class="diagram-transcript">
          <li>
            <strong>Original game evidence</strong>
            <span>Keep source claims tied to what is available.</span>
          </li>
          <li>
            <strong>Reconstruction</strong>
            <span>Rebuild the original game's behavior before adding new systems.</span>
          </li>
          <li>
            <strong>Integrated parity</strong>
            <span>Compare the reconstructed game against its source.</span>
          </li>
          <li>
            <strong>Gate B</strong>
            <span>Expansion stays locked while parity remains unresolved.</span>
          </li>
        </ol>
      </D2Diagram>
    </section>
  )}
  {["loftwahfm", "app-composer"].includes(project.slug) && (
    <section class="container" aria-label="Try a working connection">
      {["app-composer", "loftwahfm"].includes(project.slug) && (
        <p class="container">
          <a
            class="text-link"
            href={`/connections/?story=${project.slug === "app-composer" ? "link-check" : "music"}`}
          >
            Explore this product’s connected story ↗
          </a>
        </p>
      )}
      <BuildExamples projects={[project]} only={project.slug} />
    </section>
  )}
  {feature && (
    <section class="container project-feature" aria-labelledby="project-feature-title">
      <h2 id="project-feature-title">{feature.title}</h2>
      <p>{feature.deck}</p>
      <a class="home-action" href={dispatchPath(feature)}>
        Read the feature ↗
      </a>
    </section>
  )}
  <section class="container dossier-grid" id="where-the-work-stands">
    <article class="prose">
      <h2>Why you might care</h2>
      <p {...projectEntry?.edit.why}>{project.why}</p>
      <div class="pullquote" {...projectEntry?.edit.teaches}>
        {project.teaches}
        <cite>What the factory is learning</cite>
      </div>
      <h2>Where the work stands</h2>
      <p {...statusEntry?.edit.current}>{project.current}</p>
      <div class="callout">
        <p class="callout__title">What comes next</p>
        <p {...statusEntry?.edit.next_proof}>{project.remaining}</p>
      </div>
      {capabilityResult.capabilities
        .filter(
          (c) =>
            c.provider.slug === project.slug ||
            c.consumers.some((row) => row.project.slug === project.slug)
        )
        .map((capability) => (
          <CapabilityRecord capability={capability} compact={true} projectKey={project.slug} />
        ))}
      <h2>How we checked it</h2>
      <p {...statusEntry?.edit.proof_boundary}>{project.proofBoundary}</p>
      <p class="source-note">
        Reviewed {reviewDateLabel}.{" "}
        <a href="/architecture/">
          How Woodhouse separates implementation, release and physical proof
        </a>
        .
      </p>
    </article>
    <section class="margin-rail" aria-label="Development notes">
      <h2 class="margin-rail__heading">Development notes</h2>
      <div class="margin-note">
        <span class="margin-note__label">House record</span>
        <p>
          <strong>{project.name}</strong>
          <br />
          {snapshotSource}
        </p>
      </div>
      <div class="margin-note" {...statusEntry?.edit.state}>
        <span class="margin-note__label">State</span>
        <p>{project.state}. Read with the review date, not as a live status promise.</p>
        {(project.statusId || project.snapshotId) && (
          <p>
            {project.statusId && (
              <>
                <a href={`/statuses/${project.statusId}/`}>Status record</a>
                {" · "}
              </>
            )}
            {project.snapshotId && (
              <a href={`/snapshots/${project.snapshotId}/`}>Reviewed snapshot</a>
            )}
          </p>
        )}
      </div>
      <div class="margin-note">
        <span class="margin-note__label">Public source policy</span>
        <p>
          Private issue and pull request bodies are not copied onto this site. Ask Dean for access
          to project-specific material.
        </p>
      </div>
      <div class="margin-note">
        <span class="margin-note__label">Related work</span>
        <p>
          {analyticsProjects.includes(project.slug as AnalyticsProject) && (
            <>
              <a href={`/activity/?project=${project.slug}`}>Public activity</a>
              <br />
            </>
          )}
          <a href="/incidents/">Incidents</a>
          <br />
          <a href="/doctrine/">Factory doctrine</a>
        </p>
      </div>
    </section>
  </section>
  <section class="section paper-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Other work in view.</h2>
        </div>
        <a class="text-link section-heading__action" href="/projects/">
          See all {allProjects.projects.length} projects <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="project-ledger">
        {nextProjects.map((item) => (
          <ProjectRow project={item} compact={true} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-campaign {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2rem;
    align-items: center;
    margin-block: 1rem 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .project-campaign h2 {
    font: 600 clamp(1.7rem, 3vw, 2.5rem)/1.15 var(--display);
    margin: 0 0 1rem;
  }
  .project-campaign p {
    color: var(--copy-soft);
    line-height: 1.6;
  }
  .project-campaign img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 430px;
    object-fit: contain;
  }
  @media (max-width: 650px) {
    .project-campaign {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
  .project-feature {
    border-top: 1px solid var(--line);
    padding-block: 2rem 3rem;
  }
  .project-feature h2 {
    font: 600 clamp(1.7rem, 3vw, 2.5rem)/1.15 var(--display);
    margin-block: 0 1rem;
  }
  .project-feature p {
    max-width: 65ch;
    color: var(--copy-soft);
    line-height: 1.65;
  }

  .dossier-film {
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }
  .film-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }
  .film-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.3em;
  }
  .dossier-grid > .prose {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
