---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = false;
---

<BaseLayout
  title="Exhibits"
  description="Working exhibits from the Loftwah software factory: real connections you can play, pull apart and read the reasoning behind."
  path="/exhibits/"
  currentPath="/exhibits/"
  image="/og/woodhouse-workshop-20261018.jpg"
>
  <section class="container exhibit-intro">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">WOODHOUSE</a>
      <span>/</span>
      <span>Exhibits</span>
    </nav>
    <div class="exhibit-intro__grid">
      <div>
        <p class="micro-label">Working exhibits</p>
        <h1 class="page-title">
          Things you can
          <br />
          <em>take apart.</em>
        </h1>
      </div>
      <div class="exhibit-intro__aside">
        <p>
          An exhibit here is a working piece of the factory, hosted on this site, with the parts
          left visible. You can play it, break it, put it back and read what it was built to show.
        </p>
        <p>
          None of them are films, and none of them are screenshots of something else. The links
          below are the real thing.
        </p>
      </div>
    </div>
  </section>

  <section class="container exhibit-index">
    <article class="exhibit-card">
      <p class="exhibit-card__index">Exhibit 01</p>
      <h2>
        <a href="/exhibits/patch-bench/">The patch bench</a>
      </h2>
      <p class="exhibit-card__hook">Your game. Its own soundtrack.</p>
      <p>
        A small game, the sound effects it owns, and a real LoftwahFM station, wired the way a game
        actually wires them. Play the run, then pull the music link out and hear exactly what stops.
      </p>
      <p class="exhibit-card__actions">
        <a class="home-action" href="/exhibits/patch-bench/">
          Open the bench <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/dispatches/your-game-its-own-soundtrack/">
          Read the story <span aria-hidden="true">↗</span>
        </a>
      </p>
    </article>

    <article class="exhibit-card">
      <p class="exhibit-card__index">Exhibit 02</p>
      <h2>
        <a href="/exhibits/source-plate/">The source plate</a>
      </h2>
      <p class="exhibit-card__hook">One photo. Two apps. One owner.</p>
      <p>
        A contribution collected by one independently owned app and the card composed from it by
        another. Separate the plates, change the source, hide it, and watch the composition follow
        the contract rather than a copy.
      </p>
      <p class="exhibit-card__actions">
        <a class="home-action" href="/exhibits/source-plate/">
          Open the plates <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/dispatches/your-apps-should-get-along/">
          Read the story <span aria-hidden="true">↗</span>
        </a>
      </p>
    </article>
  </section>

  <section class="container exhibit-index-note">
    <p class="source-note">
      Exhibits are reviewed working artifacts, not marketing. Each one states what it does not
      claim. Reviewed 23 October 2026.
    </p>
  </section>
</BaseLayout>

<style>
  .exhibit-intro {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .exhibit-intro__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem 4rem;
    align-items: end;
    padding-block: 1.5rem 2.5rem;
  }
  .exhibit-intro .page-title {
    margin: 0.5rem 0 0;
  }
  .exhibit-intro__aside p {
    margin: 0 0 1rem;
    max-width: 46ch;
    color: var(--copy);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .exhibit-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 3.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .exhibit-card {
    border-top: 2px solid var(--acid);
    padding-top: 1rem;
  }
  .exhibit-card__index {
    margin: 0;
    font: 600 0.64rem/1 var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--copy-soft);
  }
  .exhibit-card h2 {
    margin: 0.6rem 0 0;
    font: 750 clamp(1.7rem, 2.6vw, 2.3rem)/1.1 var(--display);
    letter-spacing: -0.03em;
  }
  .exhibit-card h2 a {
    text-decoration: none;
  }
  .exhibit-card h2 a:hover {
    color: var(--acid);
  }
  .exhibit-card__hook {
    margin: 0.4rem 0 0;
    color: var(--acid);
    font: 650 1.05rem/1.25 var(--display);
    letter-spacing: -0.02em;
  }
  .exhibit-card > p:not([class]) {
    max-width: 56ch;
    color: var(--copy);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .exhibit-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }
  .exhibit-card__actions .home-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--acid);
    background: var(--acid);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .exhibit-card__actions .home-action:hover {
    background: transparent;
    color: var(--acid);
  }
  .exhibit-index-note {
    padding-block: 2rem 4rem;
  }
  @media (max-width: 820px) {
    .exhibit-intro__grid,
    .exhibit-index {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
