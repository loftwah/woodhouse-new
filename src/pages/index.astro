---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatReviewDate } from "../data/review-date";
import { portfolioReadout } from "../data/portfolio";
import ProjectNetwork from "../components/ProjectNetwork.astro";
import { toJsonLd } from "../data/safe-json";
import {
  listProjectRecords,
  listPublishedDispatches,
  listPublicCapabilities
} from "../content/repository";
import { getArtworkFallback, getSiteMetadata } from "../data/site-metadata";
import { projectAction, projectActionHref, projectActionLabel } from "../data/project-actions";
import FMListening from "../components/FMListening.astro";
import SignaturePlate from "../components/SignaturePlate.astro";

const [projectResult, dispatchResult, capabilityResult] = await Promise.all([
  listProjectRecords(),
  listPublishedDispatches(),
  listPublicCapabilities()
]);
if (projectResult.error || dispatchResult.error || capabilityResult.error)
  return new Response("Unable to load the public Woodhouse record.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = projectResult.projects;
const latestReport = dispatchResult.dispatches.find((note) => note.kind === "Portfolio report");
const recentNotes = dispatchResult.dispatches.filter((note) => note !== latestReport).slice(0, 3);
if (Astro.cache?.enabled) {
  for (const hint of projectResult.cacheHints) Astro.cache.set(hint);
  Astro.cache.set(dispatchResult.cacheHint);
  for (const hint of capabilityResult.cacheHints) Astro.cache.set(hint);
}
const readout = portfolioReadout(projects);
const reviewDateLabel = formatReviewDate(readout.reviewDate) ?? "Review date unavailable";
const fm = projects.find((project) => project.slug === "loftwahfm");
const fmMetadata = fm ? getSiteMetadata(fm) : null;
const fmCapability = capabilityResult.capabilities.find(
  (capability) => capability.key === "loftwahfm-radio"
);
/**
 * A deliberate selection, not the whole catalogue: a game you can play, the
 * music you can listen to and the builder product. The projects index carries
 * the full inventory.
 */
const picks = ["bubbles", "loftwahfm", "app-composer"]
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project))
  .map((project) => ({
    project,
    meta: getSiteMetadata(project),
    fallback: getArtworkFallback(project),
    action: projectAction(project),
    href: projectActionHref(project),
    label: projectActionLabel(project),
    external: Boolean(project.siteUrl)
  }));
const siteOrigin = Astro.site?.origin ?? "https://woodhouse.loftwah.com";
export const prerender = false;
---

<BaseLayout
  title="WOODHOUSE"
  description="A small software factory run by Dean Lofts. Play a game, listen to the music, try a builder tool, and read the evidence behind each one."
  path="/"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "WOODHOUSE",
      alternateName: "The Loftwah Software Factory",
      url: `${siteOrigin}/`,
      author: { "@type": "Person", name: "Dean Lofts", url: `${siteOrigin}/dean/` },
      description: "The public journal of the Loftwah software factory."
    })}
  />
  <div class="container publication">
    <section class="signature-hero" data-signature aria-labelledby="home-title">
      <div class="signature-hero__copy">
        <p class="signature-hero__eyebrow">The Loftwah software factory</p>
        <h1 id="home-title">
          A software factory.
          <br />
          <em>Judged by what ships.</em>
        </h1>
        <p class="signature-hero__intro">
          I’m Dean. I run a small software factory with the coding agents I direct:{" "}
          {projects.length} real projects, brought together here. There are games you can play right
          now, a music service you can listen to, a couple of tools and a few experiments.
        </p>
        <p class="signature-hero__actions">
          <a class="home-action" href="/projects/">
            Play, listen or try something <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/dean/">
            About Dean <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
      <div class="signature-hero__plate">
        <SignaturePlate />
      </div>
    </section>
    <div class="publication-dateline">
      <span>
        Newest portfolio review{" "}
        <time datetime={readout.reviewDate ?? undefined}>{reviewDateLabel}</time>
      </span>
      <span>A public journal of work and evidence</span>
    </div>

    <section class="start-here" aria-labelledby="start-title">
      <div class="publication-heading">
        <h2 id="start-title">
          Start here.
          <br />
          Three things you can use now.
        </h2>
        <p>
          A game, the music behind the games, and a studio for assembling your own apps. Each one
          opens on its own site, so you can decide for yourself before reading any of the
          development notes.
        </p>
      </div>
      <div class="start-here__grid">
        {picks.map(({ project, meta, fallback, action, href, label, external }) => (
          <article class="start-card" data-project-artwork>
            <a
              class="start-card__image"
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              aria-label={`${label} — open the ${project.name} site in a new tab`}
            >
              <img
                src={meta.image}
                width="1200"
                height="630"
                alt={project.previewAlt ?? `Artwork from the ${project.name} site.`}
                loading="lazy"
                decoding="async"
                data-fallback-src={fallback.image}
                data-fallback-alt={fallback.alt}
                data-fallback-credit={fallback.credit}
              />
            </a>
            <div class="start-card__body">
              <h3>
                <a href={"/projects/" + project.slug + "/"}>{project.name}</a>
              </h3>
              <p class="start-card__hook">{project.title}</p>
              <p class="start-card__summary">{project.summary}</p>
              <p class="start-card__availability">{action.availability}</p>
              <p class="start-card__links">
                <a
                  class="start-card__action"
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  {label} <span aria-hidden="true">↗</span>
                  {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
                <a class="text-link" href={"/projects/" + project.slug + "/"}>
                  How it works <span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="exhibits-band" aria-labelledby="exhibits-band-title">
      <div class="publication-heading">
        <h2 id="exhibits-band-title">
          Two things to pull apart.
          <br />
          Every part visible.
        </h2>
        <p>
          Working exhibits, not screenshots of them. Open a playable run with its own sound effects
          and a real radio station wired the way a game wires one, or compose a card from a
          contribution through a published contract.
        </p>
      </div>
      <p class="exhibits-band__links">
        <a class="home-action" href="/exhibits/patch-bench/">
          Open the patch bench <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/exhibits/source-plate/">
          Open the source plate <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/dispatches/your-game-its-own-soundtrack/">
          Read the story behind it <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/exhibits/">
          See both exhibits <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    {fmCapability?.listening && fm && fmMetadata && (
      <section
        id="loftwahfm-listening"
        class="home-fm"
        aria-label="LoftwahFM listening and shared music"
      >
        <FMListening capability={fmCapability} />
        <figure data-project-artwork>
          <a href={fmCapability.listening.href} aria-label="Listen to LoftwahFM">
            <img
              src={fmMetadata.image}
              width="1200"
              height="630"
              alt={fm.previewAlt ?? "Artwork from LoftwahFM."}
              loading="lazy"
              decoding="async"
              data-fallback-src="/og/projects/loftwahfm.svg"
              data-fallback-alt="Woodhouse illustration for LoftwahFM."
            />
          </a>
          <figcaption>
            <span data-artwork-status>Artwork from LoftwahFM</span>
          </figcaption>
        </figure>
      </section>
    )}

    {latestReport && (
      <section class="report-feature" aria-labelledby="report-title">
        <div class="report-feature__meta">
          <span>{latestReport.kind}</span>
          <time datetime={latestReport.reviewDate}>
            {formatReviewDate(latestReport.reviewDate) ?? latestReport.reviewDate}
          </time>
        </div>
        <div class="report-feature__body">
          <h2 id="report-title">
            <a href={`/dispatches/${latestReport.slug}/`}>{latestReport.title}</a>
          </h2>
          <p>{latestReport.deck}</p>
          <a class="text-link" href={`/dispatches/${latestReport.slug}/`}>
            Read the portfolio report <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )}

    <section class="portfolio-register" aria-labelledby="register-title">
      <div class="publication-heading">
        <h2 id="register-title">
          Everything else.
          <br />
          Different finish lines.
        </h2>
        <p>
          Games, music, discovery and assistive technology. Each project has a review date and a
          record of what is finished; open one to see both.
        </p>
      </div>
      <div class="portfolio-register__rows">
        {projects.map((project) => (
          <a class="portfolio-register__row" href={`/projects/${project.slug}/`}>
            <span class="portfolio-register__identity">
              <strong>{project.name}</strong>
              <span>{project.title}</span>
            </span>
            <span class="portfolio-register__action">{projectActionLabel(project)}</span>
            <time datetime={project.reviewDate}>
              {formatReviewDate(project.reviewDate) ?? project.reviewDate}
            </time>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        ))}
      </div>
      <p class="publication-source">
        Reviewed summaries from the supplied portfolio report. Production observations are
        attributed to their source; physical proof and outside use are separate questions.{" "}
        <a href="/projects/">See every project with its action</a>.
      </p>
    </section>

    <section class="publication-notes" aria-labelledby="notes-title">
      <div class="publication-heading">
        <h2 id="notes-title">Notes from the work.</h2>
        <a class="text-link" href="/dispatches/">
          All stories <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="publication-notes__grid">
        {recentNotes.map((note) => (
          <article>
            <h3>
              <a href={`/dispatches/${note.slug}/`}>{note.title}</a>
            </h3>
            <p class="publication-notes__meta">
              {note.kind} · {formatReviewDate(note.reviewDate) ?? note.reviewDate}
            </p>
            <p>{note.deck}</p>
            <a class="text-link" href={`/dispatches/${note.slug}/`}>
              Read the story <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="publication-system" aria-labelledby="system-title">
      <div class="publication-heading">
        <h2 id="system-title">
          One operator.
          <br />A workforce of agents.
        </h2>
        <p>
          Agents own routine reasoning and execution. I supply the direction, the human judgement
          and the things software cannot do. The factory floor explains how the work connects.
        </p>
      </div>
      <ProjectNetwork />
      <div class="publication-system__links">
        <a class="text-link" href="/factory/">
          The factory floor <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/architecture/">
          How Woodhouse is built <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/doctrine/">
          How decisions get made <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/agents/">
          Agent Reception <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="publication-close" aria-labelledby="close-title">
      <h2 id="close-title">I didn’t mean to build a software factory.</h2>
      <div>
        <p>
          It started with knowing which tools belonged together. Then the tools learned to do more
          of the work, and the work spread across products.
        </p>
        <a class="text-link" href="/dispatches/i-didnt-mean-to-build-a-software-factory/">
          Read the founding essay <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <p class="publication-source publication-agent">
      For a machine-readable version of the public record, visit{" "}
      <a href="/agents/">Agent Reception</a> or read{" "}
      <a href="/agents/facts.json">the project facts</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .home-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--acid);
    background: var(--acid);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .home-action:hover {
    background: transparent;
    color: var(--acid);
  }
  .home-fm {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: start;
    gap: 3rem;
    margin-block: 3rem;
  }
  .home-fm figure {
    margin: 2rem 0;
  }
  .home-fm img {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-fm figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }
  @media (max-width: 760px) {
    .home-fm {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .home-fm figure {
      margin-top: 0;
    }
  }
  .publication {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .signature-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    align-items: center;
    padding-bottom: 2.5rem;
  }
  .signature-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 36rem;
  }
  .signature-hero__eyebrow {
    margin: 0;
    font: 600 0.72rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copy-soft);
  }
  .signature-hero h1 {
    margin: 0;
    font: 800 clamp(2.7rem, 4.4vw, 4.5rem)/1.02 var(--display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .signature-hero h1 em {
    color: var(--acid);
    font-style: normal;
  }
  .signature-hero__intro {
    margin: 0;
    max-width: 38ch;
    color: var(--copy);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .signature-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 0.35rem 0 0;
  }
  .signature-hero__plate {
    position: relative;
    min-width: 0;
  }
  .signature-hero__plate::before {
    content: "";
    position: absolute;
    inset: -12% -18% -12% -6%;
    background: radial-gradient(60% 55% at 55% 55%, rgba(80, 150, 255, 0.09), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .publication-dateline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--copy-soft);
  }
  .publication-dateline time {
    color: var(--paper);
    margin-left: 0.35rem;
  }
  .start-here {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .start-here__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }
  .start-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 2px solid var(--acid);
    padding-top: 1rem;
  }
  .start-card__image {
    display: block;
    border: 1px solid var(--line);
    background: var(--surface-soft);
  }
  .start-card__image img {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .start-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }
  .start-card h3 {
    margin: 0;
    font: 750 clamp(1.6rem, 2.2vw, 2rem)/1.1 var(--display);
    letter-spacing: -0.03em;
  }
  .start-card h3 a {
    text-decoration: none;
  }
  .start-card__hook {
    margin: 0;
    color: var(--acid);
    font: 650 1.05rem/1.25 var(--display);
    letter-spacing: -0.02em;
  }
  .start-card__summary {
    margin: 0;
    color: var(--copy);
    font-size: 0.9rem;
  }
  .start-card__availability {
    margin: 0;
    color: var(--copy-soft);
    font-size: 0.78rem;
  }
  .start-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin: auto 0 0;
    padding-top: 0.75rem;
  }
  .start-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--acid);
    background: var(--acid);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
  }
  .start-card__action:hover {
    background: transparent;
    color: var(--acid);
  }
  .report-feature {
    display: grid;
    grid-template-columns: 1fr 2.3fr;
    gap: 3rem;
    border-block: 1px solid var(--acid);
    padding: 2.25rem 0;
  }
  .report-feature__meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--copy-soft);
  }
  .report-feature__meta span {
    color: var(--acid);
    font-weight: 700;
  }
  .report-feature h2 {
    margin: 0;
    max-width: 24ch;
    font: 750 clamp(1.8rem, 3vw, 2.8rem)/1.12 var(--display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .report-feature__body > p {
    color: var(--copy);
    max-width: 65ch;
    margin: 1rem 0;
  }
  .report-feature__body > a {
    font-size: 0.9rem;
  }
  .portfolio-register,
  .publication-notes,
  .publication-system {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .publication-heading {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .publication-heading h2 {
    margin: 0;
    font: 750 clamp(2rem, 3.5vw, 3.2rem)/1.1 var(--display);
    letter-spacing: -0.035em;
  }
  .publication-heading > p {
    margin: 0;
    max-width: 43ch;
    color: var(--copy-soft);
    font-size: 0.95rem;
  }
  .portfolio-register__rows {
    border-top: 1px solid var(--line-dark);
  }
  .portfolio-register__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto 22px;
    gap: 1.5rem;
    align-items: center;
    min-height: 5.5rem;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }
  .portfolio-register__row:hover {
    background: var(--hover-surface);
    color: var(--paper);
  }
  .portfolio-register__identity {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .portfolio-register__identity strong {
    font: 750 1.35rem/1.2 var(--display);
    letter-spacing: -0.025em;
  }
  .portfolio-register__identity > span {
    color: var(--copy-soft);
    font-size: 0.8rem;
  }
  .portfolio-register__action {
    color: var(--acid);
    font-size: 0.82rem;
    font-weight: 650;
  }
  .portfolio-register__row time {
    color: var(--copy-soft);
    font-size: 0.74rem;
  }
  .portfolio-register__row svg {
    color: var(--acid);
  }
  .publication-source {
    max-width: 80ch;
    margin: 1.25rem 0 0;
    color: var(--copy-soft);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .publication-notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .exhibits-band {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .exhibits-band__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 1.25rem 0 0;
  }
  .exhibits-band__links .home-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--acid);
    background: var(--acid);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .exhibits-band__links .home-action:hover {
    background: transparent;
    color: var(--acid);
  }
  .exhibits-band__links .text-link {
    font-size: 0.88rem;
  }
  .publication-notes__meta {
    font-size: 0.75rem;
    color: var(--copy-soft);
    margin: 0.85rem 0;
  }
  .publication-notes h3 {
    margin: 0;
    font: 700 1.6rem/1.2 var(--display);
    letter-spacing: -0.025em;
  }
  .publication-notes article > p:not(:first-child) {
    color: var(--copy);
    font-size: 0.9rem;
  }
  .publication-notes article > a {
    font-size: 0.83rem;
  }
  .publication-system__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
  .publication-close {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
