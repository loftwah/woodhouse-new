---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatReviewDate } from "../data/review-date";
import { portfolioReadout } from "../data/portfolio";
import ProjectNetwork from "../components/ProjectNetwork.astro";
import { toJsonLd } from "../data/safe-json";
import { listProjectRecords, listPublishedDispatches } from "../content/repository";
import { getSiteMetadata } from "../data/site-metadata";

const [projectResult, dispatchResult] = await Promise.all([
  listProjectRecords(),
  listPublishedDispatches()
]);
if (projectResult.error || dispatchResult.error)
  return new Response("Unable to load the public Woodhouse record.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = projectResult.projects;
const latestReport = dispatchResult.dispatches.find((note) => note.kind === "Portfolio report");
const recentNotes = dispatchResult.dispatches.filter((note) => note !== latestReport).slice(0, 3);
if (Astro.cache?.enabled) {
  for (const hint of projectResult.cacheHints) Astro.cache.set(hint);
  Astro.cache.set(dispatchResult.cacheHint);
}
const readout = portfolioReadout(projects);
const reviewDateLabel = formatReviewDate(readout.reviewDate) ?? "Review date unavailable";
const protocol = projects.find((project) => project.slug === "protocol-11");
const protocolMetadata = protocol ? getSiteMetadata(protocol) : null;
const siteOrigin = Astro.site?.origin ?? "https://woodhouse.loftwah.com";
export const prerender = false;
---

<BaseLayout
  title="WOODHOUSE"
  description="One human operator, nine software projects, and coding agents doing the work. A public journal of real products, release evidence and the proof still to come."
  path="/"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "WOODHOUSE",
      alternateName: "The Loftwah Software Factory",
      url: `${siteOrigin}/`,
      author: { "@type": "Person", name: "Dean Lofts", url: `${siteOrigin}/dean/` },
      description: "The public journal of the Loftwah software factory."
    })}
  />
  <div class="container publication">
    <section class="publication-intro" aria-labelledby="home-title">
      <h1 id="home-title">
        A software factory.
        <br />
        <em>Judged by what ships.</em>
      </h1>
      <div class="publication-intro__copy">
        <p>
          I’m Dean. Coding agents work across {projects.length} real projects. I set the direction;
          they build, play, investigate and carry the work through release.
        </p>
        <a class="text-link" href="/factory/">
          Explore the factory <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <div class="publication-dateline">
      <span>
        Newest portfolio review{" "}
        <time datetime={readout.reviewDate ?? undefined}>{reviewDateLabel}</time>
      </span>
      <span>A public journal of work and evidence</span>
    </div>

    {protocol && protocolMetadata && (
      <section class="lead-story" aria-labelledby="lead-title">
        <div class="lead-story__copy">
          <h2 id="lead-title">
            <a href="/projects/protocol-11/">A card game finding its character.</a>
          </h2>
          <p class="lead-story__deck">
            Protocol 11 leads the latest review: a twelve-stage Journey, solo recovery, distinct
            rooms and cast, and a reported production release that matches the work.
          </p>
          <p class="lead-story__boundary">
            {protocol.state}. Physical-device acceptance and final visual judgement remain open.
          </p>
          <div class="lead-story__links">
            <a class="text-link" href="/projects/protocol-11/">
              Inside Protocol 11 <span aria-hidden="true">↗</span>
            </a>
            {protocol.siteUrl && (
              <a
                class="text-link"
                href={protocol.siteUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Play the game <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
          <p class="lead-story__date">
            Dossier reviewed {formatReviewDate(protocol.reviewDate) ?? protocol.reviewDate}
          </p>
        </div>
        <figure class="lead-story__art" data-project-artwork>
          <a
            href={protocol.siteUrl}
            aria-label="Visit the Protocol 11 site to view its artwork"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={protocolMetadata.image}
              width="1200"
              height="630"
              alt={protocol.previewAlt ?? "Artwork from Protocol 11."}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-fallback-src="/og/projects/protocol-11.svg"
              data-fallback-alt="Woodhouse illustration for Protocol 11."
            />
          </a>
          <figcaption>
            <span data-artwork-status>Artwork from Protocol 11</span>
            <a href={protocol.siteUrl}>
              View the project site <span aria-hidden="true">↗</span>
            </a>
          </figcaption>
        </figure>
      </section>
    )}

    {latestReport && (
      <section class="report-feature" aria-labelledby="report-title">
        <div class="report-feature__meta">
          <span>{latestReport.kind}</span>
          <time datetime={latestReport.reviewDate}>
            {formatReviewDate(latestReport.reviewDate) ?? latestReport.reviewDate}
          </time>
        </div>
        <div class="report-feature__body">
          <h2 id="report-title">
            <a href={`/dispatches/${latestReport.slug}/`}>{latestReport.title}</a>
          </h2>
          <p>{latestReport.deck}</p>
          <a class="text-link" href={`/dispatches/${latestReport.slug}/`}>
            Read the portfolio report <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )}

    <section class="portfolio-register" aria-labelledby="register-title">
      <div class="publication-heading">
        <h2 id="register-title">
          Different work.
          <br />
          Different finish lines.
        </h2>
        <p>
          Games, music, discovery and assistive technology. Every project has a review date and a
          next proof. Open a dossier to see both.
        </p>
      </div>
      <div class="portfolio-register__rows">
        {projects.map((project) => (
          <a class="portfolio-register__row" href={`/projects/${project.slug}/`}>
            <span class="portfolio-register__identity">
              <strong>{project.name}</strong>
              <span>{project.discipline}</span>
            </span>
            <span class="portfolio-register__state">{project.state}</span>
            <time datetime={project.reviewDate}>
              {formatReviewDate(project.reviewDate) ?? project.reviewDate}
            </time>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        ))}
      </div>
      <p class="publication-source">
        Reviewed summaries from the supplied portfolio report. Production observations are
        attributed to their source; physical proof and outside use are separate questions.
      </p>
    </section>

    <section class="publication-notes" aria-labelledby="notes-title">
      <div class="publication-heading">
        <h2 id="notes-title">Notes from the work.</h2>
        <a class="text-link" href="/dispatches/">
          All dispatches <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="publication-notes__grid">
        {recentNotes.map((note) => (
          <article>
            <h3>
              <a href={`/dispatches/${note.slug}/`}>{note.title}</a>
            </h3>
            <p class="publication-notes__meta">
              {note.kind} · {formatReviewDate(note.reviewDate) ?? note.reviewDate}
            </p>
            <p>{note.deck}</p>
            <a class="text-link" href={`/dispatches/${note.slug}/`}>
              Read the note <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="publication-system" aria-labelledby="system-title">
      <div class="publication-heading">
        <h2 id="system-title">
          One operator.
          <br />A workforce of agents.
        </h2>
        <p>
          Agents own routine reasoning and execution. The operator supplies direction, human
          judgement and capabilities the software cannot provide.
        </p>
      </div>
      <ProjectNetwork />
      <div class="publication-system__links">
        <a class="text-link" href="/doctrine/">
          The operating doctrine <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/architecture/">
          How Woodhouse is built <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="publication-close" aria-labelledby="close-title">
      <h2 id="close-title">I didn’t mean to build a software factory.</h2>
      <div>
        <p>
          It started with knowing which tools belonged together. Then the tools learned to do more
          of the work, and the work spread across products.
        </p>
        <a class="text-link" href="/dispatches/i-didnt-mean-to-build-a-software-factory/">
          Read the founding essay <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <p class="publication-source publication-agent">
      For a machine-readable version of the public record, visit{" "}
      <a href="/agents/">Agent Reception</a> or read{" "}
      <a href="/agents/facts.json">the project facts</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .publication {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .publication-intro {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 2.5rem;
  }
  .publication-intro h1 {
    margin: 0;
    font: 800 clamp(2.8rem, 4.6vw, 4.6rem)/1.02 var(--display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .publication-intro h1 em {
    color: var(--acid);
    font-style: normal;
  }
  .publication-intro__copy p {
    margin: 0 0 1rem;
    max-width: 39ch;
    color: var(--copy);
    font-size: 1rem;
    line-height: 1.65;
  }
  .publication-dateline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--copy-soft);
  }
  .publication-dateline time {
    color: var(--paper);
    margin-left: 0.35rem;
  }
  .lead-story {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: 3rem;
    align-items: center;
  }
  .lead-story h2 {
    margin: 0 0 1.3rem;
    max-width: 13ch;
    font: 800 clamp(2.7rem, 4vw, 4rem)/1.02 var(--display);
    letter-spacing: -0.035em;
  }
  .lead-story h2 a,
  .report-feature h2 a,
  .publication-notes h3 a {
    text-decoration: none;
  }
  .lead-story__deck {
    margin: 0;
    max-width: 44ch;
    font-size: 1.03rem;
    color: var(--copy);
  }
  .lead-story__boundary {
    color: var(--copy-soft);
    font-size: 0.87rem;
    margin-top: 1.2rem;
  }
  .lead-story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.25rem;
    font-size: 0.88rem;
  }
  .lead-story__date {
    color: var(--copy-soft);
    font-size: 0.72rem;
    margin: 1.6rem 0 0;
  }
  .lead-story__art {
    margin: 0;
    min-width: 0;
  }
  .lead-story__art > a {
    display: block;
  }
  .lead-story__art img {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .lead-story__art figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.7rem;
    color: var(--copy-soft);
    font-size: 0.7rem;
  }
  .lead-story__art figcaption a {
    color: var(--paper);
  }
  .report-feature {
    display: grid;
    grid-template-columns: 1fr 2.3fr;
    gap: 3rem;
    border-block: 1px solid var(--acid);
    padding: 2.25rem 0;
  }
  .report-feature__meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--copy-soft);
  }
  .report-feature__meta span {
    color: var(--acid);
    font-weight: 700;
  }
  .report-feature h2 {
    margin: 0;
    max-width: 24ch;
    font: 750 clamp(1.8rem, 3vw, 2.8rem)/1.12 var(--display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .report-feature__body > p {
    color: var(--copy);
    max-width: 65ch;
    margin: 1rem 0;
  }
  .report-feature__body > a {
    font-size: 0.9rem;
  }
  .portfolio-register,
  .publication-notes,
  .publication-system {
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }
  .publication-heading {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }
  .publication-heading h2 {
    margin: 0;
    font: 750 clamp(2rem, 3.5vw, 3.2rem)/1.1 var(--display);
    letter-spacing: -0.035em;
  }
  .publication-heading > p {
    margin: 0;
    max-width: 43ch;
    color: var(--copy-soft);
    font-size: 0.95rem;
  }
  .portfolio-register__rows {
    border-top: 1px solid var(--line-dark);
  }
  .portfolio-register__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto 22px;
    gap: 1.5rem;
    align-items: center;
    min-height: 6rem;
    padding: 1.15rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }
  .portfolio-register__row:hover {
    background: var(--hover-surface);
    color: var(--paper);
  }
  .portfolio-register__identity {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .portfolio-register__identity strong {
    font: 750 1.4rem/1.2 var(--display);
    letter-spacing: -0.025em;
  }
  .portfolio-register__identity > span {
    color: var(--copy-soft);
    font-size: 0.76rem;
  }
  .portfolio-register__state {
    font-size: 0.85rem;
    color: var(--copy);
  }
  .portfolio-register__row time {
    color: var(--copy-soft);
    font-size: 0.74rem;
  }
  .portfolio-register__row svg {
    color: var(--acid);
  }
  .publication-source {
    max-width: 80ch;
    margin: 1.25rem 0 0;
    color: var(--copy-soft);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .publication-notes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .publication-notes__meta {
    font-size: 0.75rem;
    color: var(--copy-soft);
    margin: 0.85rem 0;
  }
  .publication-notes h3 {
    margin: 0;
    font: 700 1.6rem/1.2 var(--display);
    letter-spacing: -0.025em;
  }
  .publication-notes article > p:not(:first-child) {
    color: var(--copy);
    font-size: 0.9rem;
  }
  .publication-notes article > a {
    font-size: 0.83rem;
  }
  .publication-system__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
  .publication-close {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    border-top: 1px solid var(--line-dark);
    margin-top: 5rem;
    padding-top: 3rem;
  }
  .publication-close h2 {
    margin: 0;
    max-width: 18ch;
    font: 750 clamp(2rem, 3vw, 3rem)/1.15 var(--display);
    letter-spacing: -0.03em;
  }
  .publication-close p {
    color: var(--copy);
    margin-top: 0;
  }
  .publication-agent {
    margin-block: 3rem 4rem;
  }
  @media (max-width: 1000px) {
    .publication-intro {
      grid-template-columns: 1.3fr 1fr;
      gap: 2rem;
    }
    .lead-story {
      gap: 2rem;
    }
    .portfolio-register__row {
      grid-template-columns: 1.1fr 1fr 22px;
    }
    .portfolio-register__row time {
      grid-column: 1;
      font-size: 0.7rem;
    }
    .portfolio-register__row svg {
      grid-column: 3;
      grid-row: 1 / 3;
    }
    .portfolio-register__state {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
  @media (max-width: 760px) {
    .publication {
      padding-top: 2rem;
    }
    .publication-intro,
    .lead-story,
    .report-feature,
    .publication-close {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .publication-intro {
      padding-bottom: 1.75rem;
    }
    .publication-intro h1 {
      font-size: clamp(2.8rem, 7.8vw, 3.5rem);
    }
    .publication-intro__copy p {
      max-width: 55ch;
    }
    .publication-dateline {
      flex-direction: column;
      gap: 0.3rem;
      font-size: 0.69rem;
    }
    .publication-dateline > span:last-child {
      display: none;
    }
    .lead-story {
      padding-block: 2rem;
    }
    .lead-story h2 {
      max-width: 16ch;
      font-size: 2.65rem;
    }
    .lead-story__date {
      margin-top: 1rem;
    }
    .lead-story__art {
      grid-row: 1;
    }
    .lead-story__art figcaption {
      font-size: 0.63rem;
    }
    .report-feature {
      padding-block: 1.75rem;
    }
    .report-feature__meta {
      grid-row: 2;
      flex-direction: row;
      justify-content: space-between;
      font-size: 0.75rem;
    }
    .publication-heading {
      flex-direction: column;
      align-items: start;
      gap: 1rem;
    }
    .publication-heading > p {
      max-width: 55ch;
    }
    .portfolio-register__row {
      grid-template-columns: minmax(0, 1fr) 22px;
      gap: 0.35rem 1rem;
      padding-block: 1.1rem;
    }
    .portfolio-register__identity strong {
      font-size: 1.25rem;
    }
    .portfolio-register__state {
      grid-column: 1;
      grid-row: 2;
      font-size: 0.8rem;
    }
    .portfolio-register__row time {
      grid-row: 3;
    }
    .portfolio-register__row svg {
      grid-column: 2;
      grid-row: 1 / 4;
    }
    .publication-notes__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .publication-notes article + article {
      border-top: 1px solid var(--line);
      padding-top: 1.5rem;
    }
    .publication-notes h3 {
      max-width: 25ch;
      font-size: 1.75rem;
    }
    .publication-close {
      margin-top: 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-register__row {
      transition: none;
    }
  }
</style>
