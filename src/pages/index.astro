---
import { portfolioEdition } from "../data/portfolio-edition";
import { SITE_ORIGIN } from "../data/site-origin.ts";
import EditionInvitation from "../components/EditionInvitation.astro";
import { dispatchPath } from "../data/what-we-built";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatReviewDate } from "../data/review-date";
import { portfolioReadout } from "../data/portfolio";
import ProjectNetwork from "../components/ProjectNetwork.astro";
import { toJsonLd } from "../data/safe-json";
import {
  listProjectRecords,
  listPublishedDispatches,
  listPublicCapabilities
} from "../content/repository";
import { getArtworkFallback, getSiteMetadata } from "../data/site-metadata";
import { liveProjectArtwork } from "../data/live-project-artwork";
import { projectAction, projectActionHref, projectActionLabel } from "../data/project-actions";
import { activeProjects, lifecycleLabel } from "../data/project-lifecycle";
import FMListening from "../components/FMListening.astro";
import SignaturePlate from "../components/SignaturePlate.astro";
import {
  publicCampaignItems,
  campaignSocial,
  campaignResponsiveImage,
  campaignCollectionPath
} from "../data/showcase-public";

const [projectResult, dispatchResult, capabilityResult] = await Promise.all([
  listProjectRecords(),
  listPublishedDispatches(),
  listPublicCapabilities()
]);
if (projectResult.error || dispatchResult.error || capabilityResult.error)
  return new Response("Unable to load the public Woodhouse record.", {
    status: 503,
    headers: { "cache-control": "private, no-store" }
  });
const projects = await Promise.all(projectResult.projects.map(liveProjectArtwork));
const edition = portfolioEdition(dispatchResult.dispatches);
const latestReport = dispatchResult.dispatches.find((note) => note.kind === "Portfolio report");
const recentNotes = dispatchResult.dispatches.filter((note) => note !== latestReport).slice(0, 3);
if (Astro.cache?.enabled) {
  for (const hint of projectResult.cacheHints) Astro.cache.set(hint);
  Astro.cache.set(dispatchResult.cacheHint);
  for (const hint of capabilityResult.cacheHints) Astro.cache.set(hint);
}
const readout = portfolioReadout(projects);
const active = activeProjects(projects);
const reviewDateLabel = formatReviewDate(readout.reviewDate) ?? "Review date unavailable";
const fm = projects.find((project) => project.slug === "loftwahfm");
const fmMetadata = fm ? getSiteMetadata(fm) : null;
const fmCapability = capabilityResult.capabilities.find(
  (capability) => capability.key === "loftwahfm-radio"
);
const currentCampaign = publicCampaignItems(projects.map((project) => project.slug));
/**
 * A deliberate selection, not the whole catalogue: a game you can play, the
 * music you can listen to and the builder product. The projects index carries
 * the full inventory.
 */
const picks = ["bubbles", "loftwahfm", "app-composer"]
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project))
  .map((project) => ({
    project,
    meta: getSiteMetadata(project),
    fallback: getArtworkFallback(project),
    campaign: campaignSocial(currentCampaign.filter((item) => item.project === project.slug)),
    action: projectAction(project),
    href: projectActionHref(project),
    label: projectActionLabel(project),
    external: Boolean(project.siteUrl)
  }));
const heroNotes = [
  "build-note-bubbles-bank-cartoon",
  "build-note-foilbury-rhea-bench",
  "build-note-woodhouse-plate-bench"
].flatMap((id) => {
  const item = currentCampaign.find((work) => work.id === id);
  return item ? [item] : [];
});
const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
export const prerender = false;
---

<BaseLayout
  title="WOODHOUSE"
  description="A small software factory run by Dean Lofts. Play a game, listen to the music, try a builder tool, and read the evidence behind each one."
  path="/"
  homeExperience
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={toJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "WOODHOUSE",
      alternateName: "The Loftwah Software Factory",
      url: `${siteOrigin}/`,
      author: { "@type": "Person", name: "Dean Lofts", url: `${siteOrigin}/dean/` },
      description: "The public journal of the Loftwah software factory."
    })}
  />
  <section class="signature-hero" data-signature aria-labelledby="home-title">
    <div class="signature-hero__shade" aria-hidden="true"></div>
    <div class="container signature-hero__inner">
      <div class="signature-hero__copy">
        <p class="signature-hero__eyebrow">
          <span aria-hidden="true"></span>The Loftwah software factory
        </p>
        <h1 id="home-title">
          One human.
          <br />
          <em>Many worlds.</em>
        </h1>
        <p class="signature-hero__intro">
          I’m Dean. I run a small software factory with the coding agents I direct. Explore the
          games, music, tools and experiments we’ve put into the world.
        </p>
        <div class="signature-hero__actions">
          <a class="home-action" href="#start-here">
            Explore the work <span aria-hidden="true">↗</span>
          </a>
          <a class="signature-hero__story" href="/dean/">
            Meet the human
          </a>
        </div>
      </div>
      <div class="signature-hero__foot">
        {heroNotes.length > 0 && (
          <a href="/share/?artType=build-notes" class="hero-notes">
            <span class="hero-notes__images" aria-hidden="true">
              {heroNotes.map((item) => (
                <img
                  src={campaignResponsiveImage(item).thumbnail}
                  width="88"
                  height="56"
                  alt=""
                  decoding="async"
                />
              ))}
            </span>
            <span>
              Build Notes <span aria-hidden="true">↗</span>
            </span>
          </a>
        )}
        <a href="/share/" class="signature-hero__art-link">
          Artwork & downloads <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="signature-hero__plate">
      <SignaturePlate immersive sliced />
    </div>
  </section>
  <div class="container publication">
    <div class="publication-dateline">
      <span>
        Newest project review{" "}
        <time datetime={readout.reviewDate ?? undefined}>{reviewDateLabel}</time>
        {readout.olderCount > 0 && (
          <span class="publication-dateline__note">
            {readout.olderCount} of {projects.length} reviewed earlier
          </span>
        )}
      </span>
      <span class="publication-dateline__links">
        <a class="text-link" href="/connections/">
          Explore the connected products <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/activity/leaderboards/">
          See the latest project leaderboards <span aria-hidden="true">→</span>
        </a>
      </span>
    </div>

    <section id="start-here" class="start-here" aria-labelledby="start-title">
      <p class="section-index">
        <span>01 / The work</span>
        <span>Play. Listen. Make.</span>
      </p>
      <div class="publication-heading">
        <h2 id="start-title">
          Find your
          <br />
          <em>next thing.</em>
        </h2>
        <p>
          A game for one more round, music for the ride, or a tool for an idea of your own. These
          are real products. Open one and see where it takes you.
        </p>
      </div>
      <div class="start-here__grid">
        {picks.map(({ project, meta, fallback, campaign, action, href, label, external }) => (
          <article class:list={["start-card", `start-card--${project.slug}`]} data-project-artwork>
            <a
              class="start-card__image"
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              aria-label={`${label} — open the ${project.name} site in a new tab`}
            >
              <img
                src={meta.image}
                width={project.previewWidth ?? 1200}
                height={project.previewHeight ?? 630}
                alt={project.previewAlt ?? `Artwork from the ${project.name} site.`}
                loading="lazy"
                decoding="async"
                data-fallback-src={fallback.image}
                data-fallback-alt={fallback.alt}
                data-fallback-credit={fallback.credit}
              />
            </a>
            <div class="start-card__body">
              <h3>
                <a href={"/projects/" + project.slug + "/"}>{project.name}</a>
              </h3>
              <p class="start-card__hook">{project.title}</p>
              <p class="start-card__summary">{project.summary}</p>
              <p class="start-card__availability">{action.availability}</p>
              <p class="start-card__links">
                <a
                  class="start-card__action"
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  {label} <span aria-hidden="true">↗</span>
                  {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
                <a class="text-link" href={"/projects/" + project.slug + "/"}>
                  How it works <span aria-hidden="true">↗</span>
                </a>
                {campaign && (
                  <a class="text-link" href={campaignCollectionPath(project.slug)}>
                    Artwork & downloads ↗
                  </a>
                )}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="home-edition">
      <EditionInvitation />
    </div>

    <section class="exhibits-band" aria-labelledby="exhibits-band-title">
      <p class="section-index">
        <span>02 / Inside the work</span>
        <span>Made in the browser</span>
      </p>
      <div class="publication-heading">
        <h2 id="exhibits-band-title">
          Go on.
          <br />
          <em>Pull it apart.</em>
        </h2>
        <p>
          Working exhibits, not screenshots of them. Open a playable run with its own sound effects
          and a real radio station wired the way a game wires one, or compose a card from a
          contribution through a published contract.
        </p>
      </div>
      <p class="exhibits-band__links">
        <a class="home-action" href="/exhibits/patch-bench/">
          Open the patch bench <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/exhibits/source-plate/">
          Open the source plate <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/dispatches/your-game-its-own-soundtrack/">
          Read the story behind it <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/exhibits/">
          See both exhibits <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    {fmCapability?.listening && fm && fmMetadata && (
      <section
        id="loftwahfm-listening"
        class="home-fm"
        aria-label="LoftwahFM listening and shared music"
      >
        <p class="section-index">
          <span>03 / The sound</span>
          <span>Stations, shows, player</span>
        </p>
        <div class="home-fm__grid">
          <FMListening capability={fmCapability} />
          <figure data-project-artwork>
            <a href={fmCapability.listening.href} aria-label="Listen to LoftwahFM">
              <img
                src={fmMetadata.image}
                width="1200"
                height="630"
                alt={fm.previewAlt ?? "Artwork from LoftwahFM."}
                loading="lazy"
                decoding="async"
                data-fallback-src="/og/projects/loftwahfm.svg"
                data-fallback-alt="Woodhouse illustration for LoftwahFM."
              />
            </a>
            <figcaption>
              <span data-artwork-status>Artwork from LoftwahFM</span>
            </figcaption>
          </figure>
        </div>
      </section>
    )}

    {latestReport && (
      <section class="report-feature" aria-labelledby="report-title">
        <div class="report-feature__meta">
          <span>{latestReport.kind}</span>
          <time datetime={latestReport.reviewDate}>
            {formatReviewDate(latestReport.reviewDate) ?? latestReport.reviewDate}
          </time>
        </div>
        <div class="report-feature__body">
          <h2 id="report-title">
            <a
              href={
                edition && latestReport.slug === edition.slug
                  ? edition.href
                  : dispatchPath(latestReport)
              }
            >
              {latestReport.title}
            </a>
          </h2>
          <p>{latestReport.deck}</p>
          <a class="text-link" href={dispatchPath(latestReport)}>
            Read the portfolio report <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )}

    <section class="portfolio-register" aria-labelledby="register-title">
      <p class="section-index">
        <span>04 / The collection</span>
        <span>
          {active.length} active · {projects.length} in the record
        </span>
      </p>
      <div class="publication-heading">
        <h2 id="register-title">
          A world
          <br />
          <em>of its own.</em>
        </h2>
        <p>
          Games, music, discovery and assistive technology. Each project has a review date and a
          record of what is finished; open one to see both.
        </p>
      </div>
      <div class="portfolio-register__rows">
        {projects.map((project) => (
          <a class="portfolio-register__row" href={`/projects/${project.slug}/`}>
            <span class="portfolio-register__identity">
              <strong>{project.name}</strong>
              <span>
                {lifecycleLabel(project.lifecycle)
                  ? `${lifecycleLabel(project.lifecycle)} · ${project.title}`
                  : project.title}
              </span>
            </span>
            <span class="portfolio-register__action">{projectActionLabel(project)}</span>
            <time datetime={project.reviewDate}>
              {formatReviewDate(project.reviewDate) ?? project.reviewDate}
            </time>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        ))}
      </div>
      <p class="publication-source">
        Reviewed summaries from the supplied portfolio report. Production observations are
        attributed to their source; physical proof and outside use are separate questions.{" "}
        <a href="/projects/">See every project with its action</a>.
      </p>
    </section>

    <section class="publication-notes" aria-labelledby="notes-title">
      <p class="section-index">
        <span>05 / From the workshop</span>
        <span>The story behind the screen</span>
      </p>
      <div class="publication-heading">
        <h2 id="notes-title">Notes from the work.</h2>
        <a class="text-link" href="/dispatches/">
          All stories <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="publication-notes__grid">
        {recentNotes.map((note) => (
          <article>
            <h3>
              <a href={dispatchPath(note)}>{note.title}</a>
            </h3>
            <p class="publication-notes__meta">
              {note.kind} · {formatReviewDate(note.reviewDate) ?? note.reviewDate}
            </p>
            <p>{note.deck}</p>
            <a class="text-link" href={dispatchPath(note)}>
              Read the story <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="publication-system" aria-labelledby="system-title">
      <p class="section-index">
        <span>06 / How it connects</span>
        <span>One factory, independent products</span>
      </p>
      <div class="publication-heading">
        <h2 id="system-title">
          One operator.
          <br />A workforce of agents.
        </h2>
        <p>
          Agents own routine reasoning and execution. I supply the direction, the human judgement
          and the things software cannot do. The factory floor explains how the work connects.
        </p>
      </div>
      <ProjectNetwork />
      <div class="publication-system__links">
        <a class="text-link" href="/factory/">
          The factory floor <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/architecture/">
          How Woodhouse is built <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/doctrine/">
          How decisions get made <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/agents/">
          Agent Reception <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="publication-close" aria-labelledby="close-title">
      <h2 id="close-title">I didn’t mean to build a software factory.</h2>
      <div>
        <p>
          It started with knowing which tools belonged together. Then the tools learned to do more
          of the work, and the work spread across products.
        </p>
        <a class="text-link" href="/dispatches/i-didnt-mean-to-build-a-software-factory/">
          Read the founding essay <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <p class="publication-source publication-agent">
      For a machine-readable version of the public record, visit{" "}
      <a href="/agents/">Agent Reception</a> or read{" "}
      <a href="/agents/facts.json">the project facts</a>.
    </p>
  </div>
</BaseLayout>

<style>
  :global(.woodhouse-home .site-header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid rgba(218, 231, 255, 0.16);
    background: transparent;
  }
  :global(.woodhouse-home .site-header__inner) {
    min-height: 6rem;
  }
  :global(.woodhouse-home .brand__descriptor) {
    color: var(--copy-soft);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .signature-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: min(64rem, max(48rem, 100svh));
    background: var(--ink);
  }
  .signature-hero__plate {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .signature-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--ink) 0%,
      rgba(8, 13, 25, 0.94) 15%,
      rgba(8, 13, 25, 0.76) 34%,
      rgba(8, 13, 25, 0.2) 64%,
      transparent 88%
    );
  }
  .signature-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: inherit;
    padding-top: 10rem;
    padding-bottom: 10rem;
    pointer-events: none;
  }
  .signature-hero__copy {
    width: min(100%, 54rem);
    pointer-events: auto;
  }
  .signature-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 2.1rem;
    color: var(--copy);
    font: 500 0.7rem/1.4 var(--mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .signature-hero__eyebrow > span {
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--acid);
    transform: rotate(45deg);
  }
  .signature-hero h1 {
    margin: 0;
    color: var(--paper);
    font: 600 clamp(4.8rem, 8.7vw, 9.5rem)/0.98 var(--display);
    letter-spacing: -0.065em;
  }
  .signature-hero h1 em {
    color: var(--acid);
    font-style: normal;
  }
  .signature-hero__intro {
    max-width: 37ch;
    margin: 2rem 0 0;
    color: var(--copy);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.75;
  }
  .signature-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  .signature-hero a {
    pointer-events: auto;
  }
  .home-action,
  .start-card__action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.2rem;
    border: 1px solid var(--acid);
    color: var(--ink);
    background: var(--acid);
    font-size: 0.86rem;
    font-weight: 650;
    line-height: 1.3;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }
  .home-action:hover,
  .start-card__action:hover {
    color: var(--acid);
    background: var(--ink);
  }
  .home-action > span,
  .start-card__action > span[aria-hidden] {
    font-size: 1.2rem;
  }
  .signature-hero__story {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    font-size: 0.85rem;
    text-underline-offset: 0.4rem;
    text-decoration-color: var(--line-dark);
  }
  .signature-hero__foot {
    position: absolute;
    inset: auto 0 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .signature-hero__art-link,
  .hero-notes {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.85rem;
    color: var(--copy-soft);
    font: 500 0.65rem/1.5 var(--mono);
    text-underline-offset: 0.3rem;
  }
  .hero-notes__images {
    display: flex;
    gap: 0.25rem;
  }
  .hero-notes img {
    display: block;
    width: clamp(2.75rem, 6vw, 5.5rem);
    height: clamp(2rem, 4vw, 3.5rem);
    object-fit: cover;
    object-position: center 35%;
  }
  .publication {
    padding-top: 0;
  }
  .publication-dateline {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.3rem;
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line);
    color: var(--copy-soft);
    font-size: 0.72rem;
  }
  .publication-dateline time {
    margin-left: 0.3rem;
    color: var(--paper);
  }
  .publication-dateline__note {
    display: block;
    margin-top: 0.25rem;
  }
  .publication-dateline__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: start;
    gap: 0.35rem 1.5rem;
  }
  .section-index {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0 0 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-dark);
    color: var(--copy-soft);
    font: 500 0.65rem/1.5 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .section-index > span:first-child {
    color: var(--acid);
  }
  .start-here,
  .portfolio-register,
  .publication-notes,
  .publication-system {
    padding-top: clamp(5rem, 10vw, 9rem);
    scroll-margin-top: 2rem;
  }
  .publication-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 4rem;
    margin-bottom: 3.5rem;
  }
  .publication-heading h2 {
    margin: 0;
    font: 500 clamp(3rem, 5.8vw, 6rem)/1.02 var(--display);
    letter-spacing: -0.055em;
  }
  .publication-heading h2 em {
    color: var(--copy-soft);
    font-style: normal;
  }
  .publication-heading > p {
    max-width: 38ch;
    margin: 0 0 0.15rem;
    color: var(--copy-soft);
    font-size: 0.98rem;
    line-height: 1.8;
  }
  .start-here__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3.5rem clamp(2rem, 5vw, 5rem);
  }
  .start-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .start-card:first-child {
    grid-column: 1 / -1;
