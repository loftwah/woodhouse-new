---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asText, listPublicConversations } from "../../content/repository";

const result = await listPublicConversations();
if (result.error) console.error("Failed to load EmDash conversation dispatches:", result.error);
const editorialConversations = result.conversations;
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
export const prerender = false;
---

<BaseLayout
  title="Conversations"
  description="How Woodhouse treats private conversations, public project facts and edited dispatches."
  path="/conversations/"
  image="/og/factory.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Conversations</span>
        </nav>
        <h1 class="page-title">Private by default. Published after review.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>An edited publication, not a transcript</strong>Woodhouse shares reviewed project
        facts and essays. Private working conversations stay private.
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container container--reading">
      <article class="prose">
        <p>
          Woodhouse is a public record of reviewed work. Its project summaries describe an
          explicitly dated report; its dispatches explain lessons in their own words.
        </p>
        <h2>What appears here</h2>
        <p>
          Public project summaries, architecture, operating principles and edited engineering
          articles. Every project status carries a review date and a boundary describing what the
          source does not prove.
        </p>
        <h2>What stays private</h2>
        <p>
          Working conversation transcripts, private repository text, credentials and personal
          information. A useful idea from a private discussion can inform an article, but the
          discussion itself is not published by default.
        </p>
        <h2>How a source becomes a post</h2>
        <ol>
          <li>A human chooses the subject and the facts suitable for public use.</li>
          <li>
            Claims are checked against the selected source; missing or uncertain evidence stays
            visible.
          </li>
          <li>
            The edited result is reviewed before publication, with the source date and limits kept
            in view.
          </li>
        </ol>
        <div class="callout">
          <p class="callout__title">Publication boundary</p>
          <p>
            Private conversations are never published verbatim. Every public article is edited and
            reviewed first. Project and factory records remain reviewed snapshots.
          </p>
        </div>
        <a class="text-link" href="/dispatches/">
          Read the edited dispatches <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
  </section>
  <section class="section paper-section" aria-labelledby="published-conversations-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="published-conversations-title">Published conversation pieces.</h2>
        </div>
        <p>
          Edited articles can grow from a useful discussion. The source conversation itself remains
          private.
        </p>
      </div>
      {editorialConversations.map((dispatch, index) => (
        <article class="ledger-note">
          <span class="ledger-note__index">
            CONVERSATION / {String(index + 1).padStart(2, "0")}
          </span>
          <div class="ledger-note__main">
            <h3 class="ledger-note__title">
              <a href={`/conversations/${dispatch.id}/`}>{asText(dispatch.data, "title")}</a>
            </h3>
            <p class="ledger-note__deck">{asText(dispatch.data, "edited_summary")}</p>
          </div>
          <div class="ledger-note__side">
            <strong>Reviewed {asText(dispatch.data, "reviewed_at")}</strong>Human reviewed
          </div>
        </article>
      ))}
      {result.error ? (
        <p class="source-note">
          <strong>Recent conversation pieces are unavailable right now.</strong> Browse the dispatch
          archive for published work.
        </p>
      ) : editorialConversations.length === 0 ? (
        <p class="source-note">No edited conversation pieces have been published.</p>
      ) : null}
    </div>
  </section>
</BaseLayout>
