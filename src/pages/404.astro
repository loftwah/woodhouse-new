---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="This page is not in the Woodhouse record." path="/404/" image="/og/woodhouse.jpg">
  <section class="container error-404">
    <div>
      <p class="eyebrow">The index has been checked</p>
      <h1>Not in the record.</h1>
      <p>This address does not resolve to a Woodhouse page.</p>
      <a class="text-link" href="/">Return to the front door <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
