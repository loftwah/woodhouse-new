---
import BaseLayout from "../layouts/BaseLayout.astro";

const destinations = [
  {
    label: "Projects",
    detail:
      "Games you can play now, music to listen to, tools to try and experiments with the evidence attached.",
    href: "/projects/"
  },
  {
    label: "Stories",
    detail: "Field notes, incidents and the engineering journal behind the work.",
    href: "/dispatches/"
  },
  {
    label: "Share",
    detail: "The image desk: current artwork, playable captures and ready captions.",
    href: "/share/"
  },
  {
    label: "Analytics",
    detail: "What people play, hear and use, with the limits of each number visible.",
    href: "/activity/"
  }
];
export const prerender = false;
---

<BaseLayout
  title="Page not found"
  description="This page is not in the Woodhouse record. Search the index or start with the projects, stories, share desk or analytics."
  path="/404/"
  image="/og/woodhouse-workshop-20261018.jpg"
  noindex
>
  <section class="container not-found">
    <div class="not-found__copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">WOODHOUSE</a>
        <span>/</span>
        <span>NOT FOUND</span>
      </nav>
      <p class="kicker">404 · the address does not resolve</p>
      <h1>Not in the record.</h1>
      <p class="not-found__lede">
        This address has no Woodhouse page. It may have moved, or the link may have been mistyped.
        Nothing has been lost: the published record is still here.
      </p>
      <div class="not-found__actions">
        <a class="not-found__primary" href="/">
          Return to the front door <span aria-hidden="true">↗</span>
        </a>
        <button class="not-found__search" type="button" data-site-search-open>
          Search Woodhouse <kbd>⌘ K</kbd>
        </button>
      </div>
      <p class="not-found__note">
        Looking for a project? The <a href="/projects/">project ledger</a> lists every published
        product. The <a href="/agents/">project facts</a> are the machine-readable version.
      </p>
    </div>

    <nav class="not-found__destinations" aria-label="Where to go instead">
      <p class="micro-label">Where to go instead</p>
      {destinations.map((destination) => (
        <a href={destination.href}>
          <span>
            <strong>{destination.label}</strong>
            <span>{destination.detail}</span>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.62fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(4rem, 9vw, 8rem);
  }
  .not-found__copy h1 {
    max-width: 10ch;
    margin: 0.9rem 0 1.2rem;
    font-family: var(--display);
    font-size: clamp(3rem, 6.4vw, 6rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }
  .not-found__lede {
    max-width: 42rem;
    color: var(--copy-soft);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
  }
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.2rem;
    margin-top: 2rem;
  }
  .not-found__primary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.7rem 1.1rem;
    color: var(--ink);
    background: var(--acid);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--acid);
  }
  .not-found__primary:hover {
    color: var(--acid);
    background: transparent;
  }
  .not-found__search {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    color: var(--paper);
    background: transparent;
    border: 1px solid var(--line-dark);
    cursor: pointer;
  }
  .not-found__search:hover {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--acid);
  }
  .not-found__search kbd {
    color: inherit;
    font: 600 0.62rem/1 var(--mono);
    opacity: 0.7;
  }
  .not-found__note {
    max-width: 38rem;
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .not-found__note a {
    color: var(--accent-link);
  }
  .not-found__destinations {
    border-top: 1px solid var(--line);
  }
  .not-found__destinations > p {
    margin: 0;
    padding: 0.8rem 0;
    color: var(--brass);
    border-bottom: 1px solid var(--line);
  }
  .not-found__destinations a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    min-height: 44px;
    padding: 1rem 0;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .not-found__destinations a:hover {
    color: var(--brass);
  }
  .not-found__destinations a > span:first-child {
    display: grid;
    gap: 0.25rem;
  }
  .not-found__destinations strong {
    font-family: var(--display);
    font-size: 1.22rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .not-found__destinations a > span:first-child > span {
    color: var(--copy-soft);
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .not-found__destinations a > span:last-child {
    color: var(--brass);
  }
  @media (max-width: 820px) {
    .not-found {
      grid-template-columns: 1fr;
    }
  }
</style>
