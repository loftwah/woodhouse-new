---
import ShareArtworkWall from "../components/ShareArtworkWall.astro";
import { foilburyNativeArtwork } from "../data/showcase-foilbury-native";
import { publicOriginalArtwork } from "../data/showcase-originals";
import { SITE_ORIGIN } from "../data/site-origin.ts";
import { projectActionHref, projectActionLabel } from "../data/project-actions.ts";
import {
  publicCampaignItems,
  campaignSocial,
  campaignCollectionPath
} from "../data/showcase-public";
import EditionShareKit from "../components/EditionShareKit.astro";
import EditionShareAssets from "../components/EditionShareAssets.astro";
import { editionShareAssets } from "../data/edition-share-kit";
import { portfolioEdition } from "../data/portfolio-edition";
import { dispatchPath } from "../data/what-we-built";
import ShareLayout from "../layouts/ShareLayout.astro";
import ShowcaseGallery from "../components/ShowcaseGallery.astro";
import { galleryWork } from "../data/share-gallery-work";
import GalleryPagination from "../components/GalleryPagination.astro";
import ShareActions from "../components/ShareActions.astro";
import {
  getPublicMenu,
  listProjectRecords,
  listPublishedDispatches,
  listPublicEvidence
} from "../content/repository";
import { dispatchSocialCard } from "../data/social-cards";
import { getArtworkFallback, getSiteMetadata, socialCardFor } from "../data/site-metadata";
import { liveProjectArtwork } from "../data/live-project-artwork";
import { orderShareProjects, projectCaption, shareCaption, gameMedia } from "../data/share-desk";
import { sharePreviews } from "../data/share-previews";
import { loadListeningReport, projectListeningReport } from "../data/activity";
import {
  activityLink,
  compositeIsPublic,
  cardFormats,
  type CardFormat
} from "../data/activity-sharing";
import {
  galleryTypes,
  galleryURL as canonicalGalleryURL,
  shareNavigation,
  galleryMedia,
  galleryPage,
  availableProjectTypes,
  projectViewRedirect,
  kitURL,
  type GalleryType
} from "../data/share-browser";
export const prerender = false;
const requested = Astro.url.searchParams.get("project");
const requestedType = Astro.url.searchParams.get("type") ?? "images";
const [result, footer, listening, dispatches, evidence] = await Promise.all([
  listProjectRecords(),
  getPublicMenu("footer"),
  !requested && requestedType === "radio" ? loadListeningReport() : null,
  listPublishedDispatches(),
  listPublicEvidence()
]);
if (result.error)
  return new Response("Share images are unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
const projects = orderShareProjects(result.projects);
const galleryURL = (...args: Parameters<typeof canonicalGalleryURL>) => {
  const url = new URL(canonicalGalleryURL(...args), Astro.url.origin);
  // The new editorial wall owns the bare route; archive image links explicitly
  // name their category so returning to archive page one keeps its context.
  if (!url.searchParams.has("type")) url.searchParams.set("type", "images");
  return shareNavigation(url.pathname + url.search, Astro.url.searchParams);
};
const explicitType = Astro.url.searchParams.has("type");
if (!galleryTypes.some(([key]) => key === requestedType))
  return new Response("Gallery view not found.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
const globalTypes = ["radio", "factory", "logos", "social"];
const view = (
  requested && globalTypes.includes(requestedType) ? "images" : requestedType
) as GalleryType;
const requestedPage = Number(Astro.url.searchParams.get("page") ?? 1);
Astro.response.headers.set("cache-control", "private, no-store");
const requestedProject = projects.find((project) => project.slug === requested);
const selected = requestedProject ? await liveProjectArtwork(requestedProject) : undefined;
const admittedCampaign = publicCampaignItems(projects.map((project) => project.slug));
const campaignProjects = new Set(admittedCampaign.map((item) => item.project));
const showcase =
  !explicitType &&
  !Astro.url.searchParams.has("page") &&
  (!selected || campaignProjects.has(selected.slug));
if (requested && !requestedProject)
  return new Response("Project not found.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
// Entering a project without an explicit category opens the first category it
// actually has. An explicitly chosen empty category keeps its address and shows a
// clear empty state instead, so a deliberate link is never silently rewritten.
const projectRedirect = selected ? projectViewRedirect(selected.slug, view, explicitType) : null;
if (!showcase && selected && projectRedirect)
  return Astro.redirect(galleryURL(selected.slug, projectRedirect), 302);
if (Astro.cache?.enabled) {
  for (const hint of result.cacheHints) Astro.cache.set(hint);
  Astro.cache.set(footer.cacheHint);
  Astro.cache.set(dispatches.cacheHint);
  Astro.cache.set(evidence.cacheHint);
  if (listening) Astro.cache.set({ lastModified: new Date(listening.asOf) });
}
const publicIds = new Set(projects.map((project) => project.slug));
const radio =
  listening && compositeIsPublic(publicIds) ? projectListeningReport(listening, publicIds) : null;
const radioImage = (format: CardFormat, download = false) =>
  `/api/activity-card.png?snapshot=${radio?.snapshot}&format=${format}${download ? "&download=1" : ""}`;
const nativeSharing =
  !evidence.error &&
  evidence.evidence.find(
    (entry) =>
      entry.id === "shoalshot-native-result-sharing-2026-10-12" &&
      entry.data.project_key === "shoalshot" &&
      entry.data.evidence_kind === "production verification" &&
      entry.data.evidence_state === "reviewed"
  );
const profiles = (footer.menu?.items ?? []).filter((item) => item.url.startsWith("https://"));
// The ready-post caption names the current portfolio rather than a fixed list, so
// adding a project cannot leave the desk advertising a stale roster.
const featuredNames = projects.slice(0, 5).map((project) => project.name);
const remainingProjects = Math.max(0, projects.length - featuredNames.length);
const houseCaption = `Games, music, apps and a software factory. ${featuredNames.join(", ")}${
  remainingProjects ? ` and ${remainingProjects} more` : ""
} — made by Loftwah.\n${SITE_ORIGIN}/share/`;
const stories = dispatches.dispatches.filter((story) =>
  dispatchSocialCard(story.slug).startsWith("/og/dispatches/")
);
const houseImages = [
  {
    name: "Woodhouse",
    image: "/og/woodhouse-workshop-20261018.jpg",
    link: "/",
    caption: houseCaption
  },
  {
    name: "The factory",
    image: "/og/factory-workshop-20261018.jpg",
    link: "/factory/",
    caption: `Independent projects. One software factory.\n${SITE_ORIGIN}/factory/`
  },
  {
    name: "Dean Lofts",
    image: "/og/dean.jpg",
    link: "/dean/",
    caption: `Meet the human behind the Loftwah software factory.\n${SITE_ORIGIN}/dean/`
  }
];
const smallAssets = [
  ...(
    [
      ["Project network", "project-network"],
      ["Release path", "release-path"],
      ["Evidence ladder", "evidence-ladder"],
      ["Factory flow", "factory-flow"],
      ["How the work changed", "lineage"],
      ["The failure loop", "failure-loop"],
      ["Parity before expansion", "pirates-parity"],
      ["Risk controls", "risk-controls"],
      ["Agent authority", "agent-policy"],
      ["Publication path", "publication-path"],
      ["Payment before fulfilment", "payment-fulfilment"]
    ] as const
  ).flatMap(([name, slug]) => [
    { name, image: `/images/diagrams/${slug}.svg`, credit: "Woodhouse" },
    { name: `${name} (phone)`, image: `/images/diagrams/${slug}-mobile.svg`, credit: "Woodhouse" }
  ]),
  { name: "Woodhouse mark", image: "/favicon.svg", credit: "Woodhouse" },
  ...(publicIds.has("shoalshot")
    ? [
        {
          name: "SHOALSHOT wordmark",
          download: "/api/share-image?project=shoalshot&asset=wordmark",
          image: "https://shoalshot.loftwah.com/ui/brand/shoalshot-wordmark-20261012.webp",
          width: 1998,
          height: 424,
          credit: "A Loftwah Game"
        },
        {
          name: "SHOALSHOT emblem",
          download: "/api/share-image?project=shoalshot&asset=emblem",
          image: "https://shoalshot.loftwah.com/ui/brand/shoalshot-emblem-20261012.webp",
          width: 1161,
          height: 1161,
          credit: "A Loftwah Game"
        }
      ]
    : [])
];
const media = galleryMedia(
  projects.map((p) => p.slug),
  selected?.slug,
  view
);
const cardProjects = selected ? [selected] : projects;
const factoryItems = [
  ...houseImages.map((item) => ({ id: item.name })),
  ...stories.map((story) => ({ id: story.slug }))
];
const edition = dispatches.error ? null : portfolioEdition(dispatches.dispatches);
const editionCompositePublic = [
  "protocol-11",
  "shoalshot",
  "bubbles",
  "fighter",
  "loftwahfm",
  "app-composer"
].every((slug) => publicIds.has(slug));
const editionMedia = editionShareAssets.filter(
  (asset) =>
    (asset.project ? publicIds.has(asset.project) : editionCompositePublic) &&
    (!selected || asset.project === selected.slug)
);
const collection =
  view === "edition"
    ? galleryPage(edition ? editionMedia : [], requestedPage)
    : view === "cards"
      ? galleryPage(cardProjects, requestedPage)
      : view === "factory"
        ? galleryPage(factoryItems, requestedPage)
        : view === "logos"
          ? galleryPage(smallAssets, requestedPage)
          : galleryPage(media, requestedPage);
const visibleMedia = galleryPage(media, requestedPage).items;
const visibleProjects =
  view === "cards"
    ? selected
      ? galleryPage([selected], requestedPage).items
      : await Promise.all(galleryPage(cardProjects, requestedPage).items.map(liveProjectArtwork))
    : [];
const imagePacks = new Set([
  "/share/bubbles/gameplay-images.zip",
  "/share/fighter/gameplay-images.zip",
  "/share/loftwahfm/art-images.zip",
  "/share/loftwahfm/gameplay-images.zip",
  "/share/protocol-11/art-images.zip",
  "/share/protocol-11/gameplay-images.zip",
  "/share/shoalshot/art-images.zip",
  "/share/shoalshot/gameplay-images.zip"
]);
const imagePack =
  selected && (view === "images" || view === "artwork")
    ? `/share/${selected.slug}/${view === "artwork" ? "art" : "gameplay"}-images.zip`
    : null;
const visibleFactoryIds = new Set(
  galleryPage(factoryItems, requestedPage).items.map((item) => item.id)
);
const viewLabel = galleryTypes.find(([key]) => key === view)![1];
const typeLabel = (key: GalleryType) => galleryTypes.find(([k]) => k === key)![1];
const selectedTypes = selected ? availableProjectTypes(selected.slug) : [];
const previewSet = new Set(sharePreviews);
const pagePath = canonicalGalleryURL(selected?.slug, view, collection.page);
// Every published project has at least its link card, so the archive's project
// filter and rail list the whole portfolio. Before this, a project whose only
// reviewed kit was that card — Foilbury, then Liferaft — could be reached from
// the link-card page but not selected from the archive.
const featuredCampaign = admittedCampaign.filter(
  (item) => !selected || item.project === selected.slug
);
const originalArtwork = publicOriginalArtwork(publicIds).filter(
  ({ item }) => !selected || item.project === selected.slug
);
const reviewedMedia = projects.flatMap((project) =>
  gameMedia
    .filter(
      (asset) => asset.project === project.slug && (!selected || selected.slug === project.slug)
    )
    .map((asset) => galleryWork(asset, project, previewSet.has(asset.id)))
);
const artwork = [
  ...featuredCampaign.filter((item) => !item.archived),
  ...(publicIds.has("foilbury") && (!selected || selected.slug === "foilbury")
    ? foilburyNativeArtwork
    : []),
  ...originalArtwork.map(({ item }) => item),
  ...featuredCampaign.filter((item) => item.archived),
  ...reviewedMedia.filter(
    (item) =>
      !featuredCampaign.some(
        (work) => work.original === item.original || work.image === item.original
      )
  )
];
const featuredSocial = campaignSocial(featuredCampaign);
const effectivePath = showcase
  ? selected
    ? campaignCollectionPath(selected.slug)
    : "/share/"
  : view === "images"
    ? `${pagePath}${pagePath.includes("?") ? "&" : "?"}type=images`
    : pagePath;
const selectedSocial = selected ? socialCardFor(selected) : null;
---

<ShareLayout
  title={
    showcase
      ? `${selected?.name ?? "Games, music & things we made"} · Share gallery`
      : `${selected?.name ?? "All projects"} · ${viewLabel}${collection.page > 1 ? ` · Page ${collection.page}` : ""} · Share gallery`
  }
  description="Game screenshots, playable promo clips, result cards, character art and social artwork. Download an image or copy a ready post directly from the gallery."
  path={effectivePath}
  heading={selected?.name ?? (showcase ? "Share" : viewLabel)}
  image={
    selectedSocial?.image ??
    (showcase && featuredSocial ? featuredSocial.original : "/og/woodhouse-workshop-20261018.jpg")
  }
  imageAlt={selectedSocial?.alt ?? (showcase && featuredSocial ? featuredSocial.alt : undefined)}
  imageWidth={selectedSocial?.width ?? (showcase && featuredSocial ? featuredSocial.width : 1200)}
  imageHeight={selectedSocial?.height ?? (showcase && featuredSocial ? featuredSocial.height : 630)}
>
  <div class="container share-gallery">
    {showcase ? (
      <ShareArtworkWall
        works={artwork}
        projects={[...projects, { slug: "woodhouse", name: "Woodhouse" }]}
      />
    ) : (
      <div id="archive">
        <div class="gallery-controls">
          <form method="get" action="/share/" class="mobile-filters" data-gallery-filters>
            {Astro.url.searchParams.get("analytics") === "off" && (
              <input type="hidden" name="analytics" value="off" />
            )}
            {Astro.url.searchParams.has("qa") && (
              <input type="hidden" name="qa" value={Astro.url.searchParams.get("qa")!} />
            )}
            <label>
              Project
              <select name="project">
                <option value="">All projects</option>
                {projects.map((p) => (
                  <option value={p.slug} selected={selected?.slug === p.slug}>
                    {p.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              Asset type
              <select name="type">
                {galleryTypes
                  .filter(([key]) => !selected || !globalTypes.includes(key))
                  .map(([key, label]) => (
                    <option value={key} selected={view === key}>
                      {label}
                    </option>
                  ))}
              </select>
            </label>
            <button type="submit" data-filter-submit>
              Show assets
            </button>
          </form>
        </div>
        {collection.pages > 1 && (
          <GalleryPagination
            project={selected?.slug}
            type={view}
            page={collection.page}
            pages={collection.pages}
          />
        )}
        {view === "edition" && (
          <section aria-labelledby="edition-kit-title">
            {edition ? (
              <>
                <EditionShareKit compact availablePack={editionCompositePublic} />
                <p class="result-count">
                  {collection.total
                    ? `${collection.start + 1}–${Math.min(collection.start + 6, collection.total)} of ${collection.total} · ${selected?.name ?? "Edition assets"}`
                    : "No edition assets for this project."}
                </p>
                <EditionShareAssets assets={galleryPage(editionMedia, requestedPage).items} />
              </>
            ) : (
              <p>The edition kit is unavailable right now.</p>
            )}
          </section>
        )}
        {["images", "clips", "artwork"].includes(view) && (
          <section aria-label={`${selected?.name ?? "All projects"} ${viewLabel}`}>
            {selected && (
              <div class="section-heading">
                {imagePack && collection.total > 0 && imagePacks.has(imagePack) && (
                  <a href={imagePack} download={`${selected.slug}-${view}.zip`}>
                    Download image pack
                  </a>
                )}
                {selected && (
                  <a href={projectActionHref(selected)}>{projectActionLabel(selected)}</a>
                )}
              </div>
            )}
            {collection.total ? (
              <p class="result-count">
                {`${collection.start + 1}–${Math.min(collection.start + 6, collection.total)} of ${collection.total} · ${viewLabel}`}
              </p>
            ) : selected ? (
              <p class="result-count">
                No {viewLabel.toLowerCase()} for {selected.name} in this project's reviewed media.
                {selectedTypes.length > 1 && (
                  <>
                    {" Available here: "}
                    {selectedTypes
                      .filter((key) => key !== view)
                      .map((key) => (
                        <a href={galleryURL(selected.slug, key)}>{typeLabel(key)}</a>
                      ))}
                  </>
                )}
              </p>
            ) : (
              <p class="result-count">No {viewLabel.toLowerCase()} in this collection.</p>
            )}
            <ShowcaseGallery
              items={visibleMedia.flatMap(({ id }) =>
                reviewedMedia.filter((work) => work.id === id)
              )}
              compact
              staggered
            />
          </section>
        )}
        {view === "cards" && (
          <section aria-labelledby="link-cards-title">
            <div class="section-heading">
              <h2 id="link-cards-title">Link cards</h2>
            </div>
            <section id="projects" aria-label="Project images" class="gallery">
              {visibleProjects.map((project, index) => {
                const metadata = getSiteMetadata(project);
                const fallback = getArtworkFallback(project);
                const destination = projectActionHref(project);
                return (
                  <figure id={`project-${project.slug}`}>
                    <a
                      class="image-link"
                      href={metadata.image}
                      data-fallback-href={fallback.image}
                      data-fallback-label={`View ${project.name} artwork full size`}
                      aria-label={`View ${project.name} image full size`}
                    >
                      <img
                        src={metadata.image}
                        width="1200"
                        height="630"
                        alt={project.previewAlt ?? `Woodhouse illustration for ${project.name}`}
                        loading={index < 3 ? "eager" : "lazy"}
                        data-gallery-image
                        data-fallback-image={fallback.image}
                        data-fallback-alt={fallback.alt}
                        data-fallback-credit={fallback.credit}
                      />
                    </a>
                    <figcaption>
                      <div class="asset-title">
                        <h2>{project.name}</h2>
                        <span data-image-size>Original image</span>
                      </div>
                      <p class="credit" data-image-credit>
                        {project.previewImage
                          ? `Artwork from ${project.name}`
                          : "Illustration by Woodhouse"}
                      </p>
                    </figcaption>
                    <ShareActions
                      caption={projectCaption(project)}
                      image={
                        project.previewImage
                          ? `/api/share-image?project=${project.slug}`
                          : metadata.image
                      }
                      fallbackImage={fallback.image}
                      filename={`${project.slug}-social.jpg`}
                      link={destination}
                    />
                    <div class="asset-links">
                      <a href={destination}>{projectActionLabel(project)}</a>
                      <a href={kitURL(project.slug, view)}>Link to this kit</a>
                      {project.slug === "shoalshot" && nativeSharing && (
                        <a href={destination}>Play & share a dive</a>
                      )}
                    </div>
                  </figure>
                );
              })}
            </section>
          </section>
        )}
        {view === "radio" && (
          <section id="radio" aria-labelledby="radio-title">
            <div class="section-heading">
              <h2 id="radio-title">Games × Radio</h2>
              <a href="/activity/">Analytics</a>
            </div>
            {radio ? (
              <div class="gallery radio-gallery">
                {(Object.keys(cardFormats) as CardFormat[]).map((format) => (
                  <figure>
                    <a
                      class="image-link radio-preview"
                      href={radioImage(format)}
                      aria-label={`View ${format} radio card full size`}
                    >
                      <img
                        src={radioImage(format)}
                        width={cardFormats[format].width}
                        height={cardFormats[format].height}
                        alt={`Games × Radio ${format} artwork and dated listening snapshot from LoftwahFM`}
                        loading="lazy"
                      />
                    </a>
                    <figcaption>
                      <div class="asset-title">
                        <h3>{format[0]!.toUpperCase() + format.slice(1)}</h3>
                        <span>
                          {cardFormats[format].width} × {cardFormats[format].height} PNG
                        </span>
                      </div>
                      <p class="credit">Official game artwork · LoftwahFM composition</p>
                    </figcaption>
                    <ShareActions
                      caption={`The next round has a soundtrack. Fighter, SHOALSHOT, Protocol 11 and Bubbles meet LoftwahFM.\n${SITE_ORIGIN}/share/\nhttps://fm.loftwah.com/analytics/?source=games&days=30&snapshot=${radio.snapshot}`}
                      image={radioImage(format, true)}
                      filename={`loftwahfm-games-${format}.png`}
                      link={activityLink("", radio.snapshot)}
                    />
                  </figure>
                ))}
              </div>
            ) : (
              <p>Radio cards are unavailable right now.</p>
            )}
            {radio && (
              <p class="credit">
                Snapshot {radio.asOf.slice(0, 16).replace("T", " ")} UTC · Listening, not project
                popularity.
              </p>
            )}
          </section>
        )}
        {view === "factory" && (
          <section id="stories" aria-labelledby="stories-title">
            <div class="section-heading">
              <h2 id="stories-title">Factory & stories</h2>
            </div>
            <div class="gallery">
              {houseImages
                .filter((item) => visibleFactoryIds.has(item.name))
                .map((item) => (
                  <figure>
                    <a
                      class="image-link"
                      href={item.image}
                      aria-label={`View ${item.name} artwork full size`}
                    >
                      <img
                        src={item.image}
                        width="1200"
                        height="630"
                        alt={`${item.name} artwork by Woodhouse`}
                        loading="lazy"
                      />
                    </a>
                    <figcaption>
                      <div class="asset-title">
                        <h3>{item.name}</h3>
                        <span>1200 × 630 JPG</span>
                      </div>
                      <p class="credit">Woodhouse</p>
                    </figcaption>
                    <ShareActions
                      caption={item.caption}
                      image={item.image}
                      filename={`${item.name.toLowerCase().replaceAll(" ", "-")}.jpg`}
                      link={`${SITE_ORIGIN}${item.link}`}
                    />
                    <a class="story-link" href={item.link}>
                      Read the story
                    </a>
                  </figure>
                ))}
              {stories
                .filter((story) => visibleFactoryIds.has(story.slug))
                .map((story) => (
                  <figure>
                    <a
                      class="image-link"
                      href={dispatchSocialCard(story.slug)}
                      aria-label={`View ${story.title} artwork full size`}
                    >
                      <img
                        src={dispatchSocialCard(story.slug)}
                        width="1200"
                        height="630"
                        alt={`Woodhouse artwork for ${story.title}`}
                        loading="lazy"
                      />
                    </a>
                    <figcaption>
                      <div class="asset-title">
                        <h3>{story.title}</h3>
                        <span>1200 × 630 JPG</span>
                      </div>
                      <p class="credit">Woodhouse</p>
                    </figcaption>
                    <ShareActions
                      caption={shareCaption(
                        story.title,
                        story.deck,
                        `${SITE_ORIGIN}${dispatchPath(story)}`
                      )}
                      image={dispatchSocialCard(story.slug)}
                      filename={`${story.slug}.jpg`}
                      link={`${SITE_ORIGIN}${dispatchPath(story)}`}
                    />
                    <a class="story-link" href={dispatchPath(story)}>
                      Read the story
                    </a>
                  </figure>
                ))}
            </div>
          </section>
        )}
        {view === "logos" && (
          <section id="assets" aria-labelledby="assets-title">
            <div class="section-heading">
              <h2 id="assets-title">Logos & SVGs</h2>
            </div>
            <div class="gallery small-assets">
              {galleryPage(smallAssets, requestedPage).items.map((item) => (
                <figure>
                  <a
                    class="image-link svg-preview"
                    href={item.image}
                    aria-label={`View ${item.name} full size`}
                  >
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </a>
                  <figcaption>
                    <div class="asset-title">
                      <h3>{item.name}</h3>
                      <span>{"width" in item ? `${item.width} × ${item.height} WebP` : "SVG"}</span>
                    </div>
                    <p class="credit">{item.credit}</p>
                  </figcaption>
                  <ShareActions
                    caption={`${item.name} · ${item.credit}\n${SITE_ORIGIN}/share/`}
                    image={
                      "download" in item && typeof item.download === "string"
                        ? item.download
                        : item.image
                    }
                    filename={`${item.name.toLowerCase().replaceAll(" ", "-")}.${item.image.endsWith(".webp") ? "webp" : "svg"}`}
                    link={`${SITE_ORIGIN}/share/`}
                  />
                </figure>
              ))}
            </div>
          </section>
        )}
        {collection.pages > 1 && (
          <GalleryPagination
            project={selected?.slug}
            type={view}
            page={collection.page}
            pages={collection.pages}
            end
          />
        )}
        <section id="social" class="social-links" aria-label="Official social profiles">
          <h2>Post it.</h2>
          <nav>
            {profiles.map((item) => (
              <a href={item.url}>{item.label}</a>
            ))}
          </nav>
        </section>
      </div>
    )}
  </div>
</ShareLayout>
<script>
  for (const image of document.querySelectorAll<HTMLImageElement>("[data-gallery-image]")) {
    const label = image.closest("figure")?.querySelector("[data-image-size]");
    const describe = () => {
      if (label && image.naturalWidth)
        label.textContent = `${image.naturalWidth} × ${image.naturalHeight}`;
    };
    image.addEventListener("load", describe);
    const unavailable = () => {
      // A project's published artwork can move or disappear. Fall back once to the
      // reviewed artwork and its credit, rather than leaving a broken
      // image with the project's credit on it. The full-size link follows the
      // same resolved asset so preview and original never disagree.
      const fallback = image.dataset.fallbackImage;
      if (fallback && image.src !== new URL(fallback, location.href).href) {
        image.src = fallback;
        if (image.dataset.fallbackAlt) image.alt = image.dataset.fallbackAlt;
        const link = image.closest("a");
        if (link?.dataset.fallbackHref !== undefined) {
          link.href = link.dataset.fallbackHref;
          if (link.dataset.fallbackLabel)
            link.setAttribute("aria-label", link.dataset.fallbackLabel);
        }
        const credit = image.closest("figure")?.querySelector("[data-image-credit]");
        if (credit)
          credit.textContent = image.dataset.fallbackCredit ?? "Illustration by Woodhouse";
        return;
      }
      // Both the project asset and the reviewed fallback failed. Remove the
      // action rather than offering a link to a file the page knows is missing.
      const link = image.closest("a");
      if (link) {
        link.removeAttribute("href");
        link.setAttribute("aria-disabled", "true");
      }
      if (label) label.textContent = "Image unavailable";
    };
    image.addEventListener("error", unavailable);
    // An eager image may already have failed before this module attaches.
    // The completed broken request will not emit another error for us.
    if (image.complete) {
      if (image.naturalWidth) describe();
      else unavailable();
    }
  }
</script>
