---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameMedia from "../components/GameMedia.astro";
import ShareActions from "../components/ShareActions.astro";
import {
  getPublicMenu,
  listProjectRecords,
  listPublishedDispatches,
  listPublicEvidence
} from "../content/repository";
import { dispatchSocialCard } from "../data/social-cards";
import { getSiteMetadata } from "../data/site-metadata";
import { orderShareProjects, projectCaption, shareCaption, gameMedia } from "../data/share-desk";
import { loadListeningReport, projectListeningReport } from "../data/activity";
import { compositeIsPublic, cardFormats, type CardFormat } from "../data/activity-sharing";
export const prerender = false;
const [result, footer, listening, dispatches, evidence] = await Promise.all([
  listProjectRecords(),
  getPublicMenu("footer"),
  loadListeningReport(),
  listPublishedDispatches(),
  listPublicEvidence()
]);
if (result.error)
  return new Response("Share images are unavailable.", {
    status: 503,
    headers: { "cache-control": "no-store" }
  });
const projects = orderShareProjects(result.projects);
const requested = Astro.url.searchParams.get("project");
const selected = projects.find((project) => project.slug === requested);
if (requested && !selected)
  return new Response("Project not found.", {
    status: 404,
    headers: { "cache-control": "no-store" }
  });
if (!listening || dispatches.error || evidence.error)
  Astro.response.headers.set("cache-control", "private, no-store");
if (Astro.cache?.enabled) {
  for (const hint of result.cacheHints) Astro.cache.set(hint);
  Astro.cache.set(footer.cacheHint);
  Astro.cache.set(dispatches.cacheHint);
  Astro.cache.set(evidence.cacheHint);
  if (listening) Astro.cache.set({ lastModified: new Date(listening.asOf) });
}
const publicIds = new Set(projects.map((project) => project.slug));
const radio =
  listening && compositeIsPublic(publicIds) ? projectListeningReport(listening, publicIds) : null;
const radioImage = (format: CardFormat, download = false) =>
  `/api/activity-card.png?snapshot=${radio?.snapshot}&format=${format}${download ? "&download=1" : ""}`;
const nativeSharing =
  !evidence.error &&
  evidence.evidence.find(
    (entry) =>
      entry.id === "shoalshot-native-result-sharing-2026-10-12" &&
      entry.data.project_key === "shoalshot" &&
      entry.data.evidence_kind === "production verification" &&
      entry.data.evidence_state === "reviewed"
  );
const profiles = (footer.menu?.items ?? []).filter((item) => item.url.startsWith("https://"));
const stories = dispatches.dispatches.filter((story) =>
  dispatchSocialCard(story.slug).startsWith("/og/dispatches/")
);
const houseImages = [
  {
    name: "Woodhouse",
    image: "/og/woodhouse.jpg",
    link: "/",
    caption:
      "Games, music and a software factory. Fighter, SHOALSHOT, Protocol 11, Bubbles and LoftwahFM — made by Loftwah.\nhttps://woodhouse.loftwah.com/share/"
  },
  {
    name: "The factory",
    image: "/og/factory.jpg",
    link: "/factory/",
    caption: "Nine projects. One software factory.\nhttps://woodhouse.loftwah.com/factory/"
  },
  {
    name: "Dean Lofts",
    image: "/og/dean.jpg",
    link: "/dean/",
    caption:
      "Meet the human behind the Loftwah software factory.\nhttps://woodhouse.loftwah.com/dean/"
  }
];
const smallAssets = [
  { name: "Project network", image: "/images/diagrams/project-network.svg", credit: "Woodhouse" },
  { name: "Release path", image: "/images/diagrams/release-path.svg", credit: "Woodhouse" },
  { name: "Evidence ladder", image: "/images/diagrams/evidence-ladder.svg", credit: "Woodhouse" },
  { name: "Woodhouse mark", image: "/favicon.svg", credit: "Woodhouse" },
  ...(publicIds.has("shoalshot")
    ? [
        {
          name: "SHOALSHOT wordmark",
          download: "/api/share-image?project=shoalshot&asset=wordmark",
          image: "https://shoalshot.loftwah.com/ui/brand/shoalshot-wordmark-20261012.webp",
          width: 1998,
          height: 424,
          credit: "A Loftwah Game"
        },
        {
          name: "SHOALSHOT emblem",
          download: "/api/share-image?project=shoalshot&asset=emblem",
          image: "https://shoalshot.loftwah.com/ui/brand/shoalshot-emblem-20261012.webp",
          width: 1161,
          height: 1161,
          credit: "A Loftwah Game"
        }
      ]
    : [])
];
---

<BaseLayout
  title={selected ? `${selected.name} · Share gallery` : "Share gallery"}
  description="Game screenshots, playable promo clips, result cards, character art and social artwork. Download an image or copy a ready post directly from the gallery."
  path={selected ? `/share/?project=${selected.slug}` : "/share/"}
  currentPath="/share/"
  image={selected ? getSiteMetadata(selected).image : "/og/woodhouse.jpg"}
>
  <div class="container share-gallery">
    <header class="gallery-intro">
      <div>
        <h1>Share the work.</h1>
        <p>Screenshots, clips and artwork. Copy or download.</p>
      </div>
      <nav aria-label="Gallery sections">
        {projects
          .filter((p) => gameMedia.some((asset) => asset.project === p.slug))
          .map((p) => (
            <a href={`#media-${p.slug}`}>{p.name}</a>
          ))}
        <a href="#projects">Link cards</a>
        <a href="#radio">Radio cards</a>
        <a href="#stories">Factory & stories</a>
        <a href="#assets">Logos & SVGs</a>
        <a href="#game-art">Game art & covers</a>
        <a href="#social">Socials</a>
      </nav>
    </header>
    {projects
      .filter((project) =>
        gameMedia.some((asset) => asset.project === project.slug && asset.category === "gameplay")
      )
      .map((project) => (
        <section id={`media-${project.slug}`} aria-label={`${project.name} share media`}>
          <div class="section-heading">
            <h2>{project.name}</h2>
            <a href={`/share/${project.slug}/gameplay-images.zip`} download>
              Download images
            </a>
            <a href={project.siteUrl}> {project.slug === "loftwahfm" ? "Listen" : "Play"}</a>
          </div>
          <div class="gallery media-gallery">
            {gameMedia
              .filter((asset) => asset.project === project.slug && asset.category === "gameplay")
              .map((asset, index) => (
                <GameMedia
                  asset={asset}
                  destination={
                    project.siteUrl ?? `https://woodhouse.loftwah.com/projects/${project.slug}/`
                  }
                  eager={project.slug === "fighter" && index < 3}
                />
              ))}
          </div>
        </section>
      ))}
    <section aria-labelledby="link-cards-title">
      <div class="section-heading">
        <h2 id="link-cards-title">Link cards</h2>
      </div>
      <section id="projects" aria-label="Project images" class="gallery">
        {projects.map((project, index) => {
          const metadata = getSiteMetadata(project);
          const destination =
            project.siteUrl ?? `https://woodhouse.loftwah.com/projects/${project.slug}/`;
          return (
            <figure id={`project-${project.slug}`}>
              <a
                class="image-link"
                href={metadata.image}
                aria-label={`View ${project.name} image full size`}
              >
                <img
                  src={metadata.image}
                  width="1200"
                  height="630"
                  alt={project.previewAlt ?? `Woodhouse illustration for ${project.name}`}
                  loading={index < 3 ? "eager" : "lazy"}
                  data-gallery-image
                />
              </a>
              <figcaption>
                <div class="asset-title">
                  <h2>{project.name}</h2>
                  <span data-image-size>Original image</span>
                </div>
                <p class="credit">
                  {project.previewImage
                    ? `Artwork from ${project.name}`
                    : "Illustration by Woodhouse"}
                </p>
              </figcaption>
              <ShareActions
                caption={projectCaption(project)}
                image={
                  project.previewImage ? `/api/share-image?project=${project.slug}` : metadata.image
                }
                filename={`${project.slug}-social.jpg`}
                link={destination}
              />
              <div class="asset-links">
                <a href={destination}>
                  {["fighter", "shoalshot", "protocol-11", "bubbles"].includes(project.slug)
                    ? "Play"
                    : project.slug === "loftwahfm"
                      ? "Listen"
                      : "Open project"}
                </a>
                <a href={`/share/?project=${project.slug}#project-${project.slug}`}>
                  Link to this kit
                </a>
                {project.slug === "shoalshot" && nativeSharing && (
                  <a href={destination}>Play & share a dive</a>
                )}
              </div>
            </figure>
          );
        })}
      </section>
    </section>
    <section id="radio" aria-labelledby="radio-title">
      <div class="section-heading">
        <h2 id="radio-title">Games × Radio</h2>
        <a href="/activity/">Scores & listening</a>
      </div>
      {radio ? (
        <div class="gallery radio-gallery">
          {(Object.keys(cardFormats) as CardFormat[]).map((format) => (
            <figure>
              <a
                class="image-link radio-preview"
                href={radioImage(format)}
                aria-label={`View ${format} radio card full size`}
              >
                <img
                  src={radioImage(format)}
                  width={cardFormats[format].width}
                  height={cardFormats[format].height}
                  alt={`Games × Radio ${format} artwork and dated listening snapshot from LoftwahFM`}
                  loading="lazy"
                />
              </a>
              <figcaption>
                <div class="asset-title">
                  <h3>{format[0]!.toUpperCase() + format.slice(1)}</h3>
                  <span>
                    {cardFormats[format].width} × {cardFormats[format].height} PNG
                  </span>
                </div>
                <p class="credit">Official game artwork · LoftwahFM composition</p>
              </figcaption>
              <ShareActions
                caption={`The next round has a soundtrack. Fighter, SHOALSHOT, Protocol 11 and Bubbles meet LoftwahFM.\nhttps://woodhouse.loftwah.com/share/\nhttps://fm.loftwah.com/analytics/?source=games&days=30&snapshot=${radio.snapshot}`}
                image={radioImage(format, true)}
                filename={`loftwahfm-games-${format}.png`}
                link={`https://woodhouse.loftwah.com/activity/?snapshot=${radio.snapshot}`}
              />
            </figure>
          ))}
        </div>
      ) : (
        <p>Radio cards are unavailable right now.</p>
      )}
      {radio && (
        <p class="credit">
          Snapshot {radio.asOf.slice(0, 16).replace("T", " ")} UTC · Listening, not project
          popularity.
        </p>
      )}
    </section>
    <section id="stories" aria-labelledby="stories-title">
      <div class="section-heading">
        <h2 id="stories-title">Factory & stories</h2>
      </div>
      <div class="gallery">
        {houseImages.map((item) => (
          <figure>
            <a
              class="image-link"
              href={item.image}
              aria-label={`View ${item.name} artwork full size`}
            >
              <img
                src={item.image}
                width="1200"
                height="630"
                alt={`${item.name} artwork by Woodhouse`}
                loading="lazy"
              />
            </a>
            <figcaption>
              <div class="asset-title">
                <h3>{item.name}</h3>
                <span>1200 × 630 JPG</span>
              </div>
              <p class="credit">Woodhouse</p>
            </figcaption>
            <ShareActions
              caption={item.caption}
              image={item.image}
              filename={`${item.name.toLowerCase().replaceAll(" ", "-")}.jpg`}
              link={`https://woodhouse.loftwah.com${item.link}`}
            />
            <a class="story-link" href={item.link}>
              Read the story
            </a>
          </figure>
        ))}
        {stories.map((story) => (
          <figure>
            <a
              class="image-link"
              href={dispatchSocialCard(story.slug)}
              aria-label={`View ${story.title} artwork full size`}
            >
              <img
                src={dispatchSocialCard(story.slug)}
                width="1200"
                height="630"
                alt={`Woodhouse artwork for ${story.title}`}
                loading="lazy"
              />
            </a>
            <figcaption>
              <div class="asset-title">
                <h3>{story.title}</h3>
                <span>1200 × 630 JPG</span>
              </div>
              <p class="credit">Woodhouse</p>
            </figcaption>
            <ShareActions
              caption={shareCaption(
                story.title,
                story.deck,
                `https://woodhouse.loftwah.com/dispatches/${story.slug}/`
              )}
              image={dispatchSocialCard(story.slug)}
              filename={`${story.slug}.jpg`}
              link={`https://woodhouse.loftwah.com/dispatches/${story.slug}/`}
            />
            <a class="story-link" href={`/dispatches/${story.slug}/`}>
              Read the story
            </a>
          </figure>
        ))}
      </div>
    </section>
    <section id="assets" aria-labelledby="assets-title">
      <div class="section-heading">
        <h2 id="assets-title">Logos & SVGs</h2>
      </div>
      <div class="gallery small-assets">
        {smallAssets.map((item) => (
          <figure>
            <a
              class="image-link svg-preview"
              href={item.image}
              aria-label={`View ${item.name} full size`}
            >
              <img src={item.image} alt={item.name} loading="lazy" />
            </a>
            <figcaption>
              <div class="asset-title">
                <h3>{item.name}</h3>
                <span>{"width" in item ? `${item.width} × ${item.height} WebP` : "SVG"}</span>
              </div>
              <p class="credit">{item.credit}</p>
            </figcaption>
            <ShareActions
              caption={`${item.name} · ${item.credit}\nhttps://woodhouse.loftwah.com/share/`}
              image={
                "download" in item && typeof item.download === "string" ? item.download : item.image
              }
              filename={`${item.name.toLowerCase().replaceAll(" ", "-")}.${item.image.endsWith(".webp") ? "webp" : "svg"}`}
              link="https://woodhouse.loftwah.com/share/"
            />
          </figure>
        ))}
      </div>
    </section>
    <section id="game-art" aria-labelledby="game-art-title">
      <div class="section-heading">
        <h2 id="game-art-title">Game art & album covers</h2>
      </div>
      {projects
        .filter((project) =>
          gameMedia.some((asset) => asset.project === project.slug && asset.category === "art")
        )
        .map((project) => (
          <section id={`art-${project.slug}`} aria-label={`${project.name} artwork`}>
            <div class="section-heading">
              <h3>{project.name}</h3>
              <a href={`/share/${project.slug}/art-images.zip`} download>
                Download artwork
              </a>
            </div>
            <div class="gallery art-gallery">
              {gameMedia
                .filter((asset) => asset.project === project.slug && asset.category === "art")
                .map((asset) => (
                  <GameMedia
                    asset={asset}
                    destination={
                      project.siteUrl ?? `https://woodhouse.loftwah.com/projects/${project.slug}/`
                    }
                  />
                ))}
            </div>
          </section>
        ))}
    </section>
    <section id="social" class="social-links" aria-label="Official social profiles">
      <h2>Post it.</h2>
      <nav>
        {profiles.map((item) => (
          <a href={item.url}>{item.label}</a>
        ))}
      </nav>
    </section>
  </div>
</BaseLayout>
<script>
  for (const image of document.querySelectorAll<HTMLImageElement>("[data-gallery-image]")) {
    const label = image.closest("figure")?.querySelector("[data-image-size]");
    const describe = () => {
      if (label && image.naturalWidth)
        label.textContent = `${image.naturalWidth} × ${image.naturalHeight}`;
    };
    if (image.complete) describe();
    else image.addEventListener("load", describe, { once: true });
    image.addEventListener("error", () => {
      if (label) label.textContent = "Open original image";
    });
  }
</script>
<style>
  .share-gallery {
    padding-block: 2.5rem 4rem;
  }
  .gallery-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .gallery-intro h1 {
    font-family: var(--display);
    font-size: clamp(2.6rem, 4.5vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 0.75rem;
  }
  .gallery-intro p {
    margin: 0;
    color: var(--muted);
  }
  nav,
  .asset-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  nav a,
  .asset-links a,
  .story-link,
  .section-heading > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    text-underline-offset: 0.3em;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  figure {
    margin: 0;
    min-width: 0;
    scroll-margin-top: 1.5rem;
  }
  .image-link {
    display: block;
    background: var(--surface);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    padding-top: 0.85rem;
  }
  .asset-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
  }
  .asset-title h2,
  .asset-title h3 {
    font-family: var(--display);
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
  }
  .asset-title span,
  .credit {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .credit {
    margin: 0.35rem 0 0.8rem;
  }
  .asset-links {
    gap: 0.25rem 1rem;
  }
  section + section {
    border-top: 1px solid var(--line);
    margin-top: 2.5rem;
    padding-top: 2rem;
    scroll-margin-top: 1rem;
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }
  .section-heading h2,
  .social-links h2 {
    font-family: var(--display);
    font-size: 2rem;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .radio-preview {
    aspect-ratio: 1;
    display: block;
    overflow: hidden;
  }
  .radio-preview img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .svg-preview {
    height: 220px;
    display: block;
    overflow: hidden;
    padding: 1rem;
  }
  .svg-preview img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .art-gallery {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .section-heading h3 {
    font-family: var(--display);
    font-size: 1.5rem;
    margin: 0;
  }
  @media (max-width: 1100px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .art-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .gallery-intro nav {
      gap: 0 0.75rem;
    }
    .gallery {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .art-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 0.75rem;
    }
    .share-gallery {
      padding-top: 1.5rem;
    }
    .gallery-intro {
      margin-bottom: 1rem;
    }
    .radio-preview {
      aspect-ratio: auto;
      height: 320px;
    }
    .social-links {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
  }
</style>
