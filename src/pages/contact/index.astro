---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { enquiryProblemMessage, isEnquiryField } from "../../data/contact-feedback";
export const prerender = false;
const editorialEnabled = !__WOODHOUSE_READ_ONLY__;
const submitted = Astro.url.searchParams.get("submitted") === "1";
const error = Astro.url.searchParams.get("error");
const requestedField = Astro.url.searchParams.get("field");
const invalidField = error === "invalid" && isEnquiryField(requestedField) ? requestedField : null;
const invalidMessage = enquiryProblemMessage(invalidField);
const fieldProps = (field: NonNullable<typeof invalidField>) =>
  invalidField === field
    ? {
        "aria-invalid": "true" as const,
        "aria-describedby":
          field === "message" ? "contact-message-help contact-problem" : "contact-problem"
      }
    : {};
---

<BaseLayout
  title="Contact"
  description="Reach Dean Lofts through public social and engineering profiles."
  path="/contact/"
  image="/og/dean.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Contact</span>
        </nav>
        <h1 class="page-title">If this is relevant to what you're building.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>Dean is reachable.</strong>Tell him what you are working on and why the projects or
        factory practices here are relevant.
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container container--reading">
      <p class="lede">
        No funnel. No calendar ambush. Just a straightforward way to start the conversation.
      </p>
      <div class="link-group" style="margin-top:2rem">
        <a class="text-link" href="https://x.com/loftwah" rel="me">
          X / @loftwah <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://github.com/loftwah" rel="me">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://www.linkedin.com/in/deanlofts/" rel="me">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      {editorialEnabled && (
        <section class="contact-form-wrap" aria-labelledby="contact-form-title">
          <div class="section-heading">
            <div>
              <h2 id="contact-form-title">Send a Woodhouse enquiry.</h2>
            </div>
            <p>
              Human or agent, give the useful context. Messages are private and are never used as
              instructions for tools or repositories.
            </p>
          </div>
          {submitted && (
            <p class="callout" role="status" data-submitted>
              <strong>Thanks. Your note reached the Woodhouse inbox.</strong> Dean can reply if you
              left a reply address.
            </p>
          )}
          {error === "rate-limit" && (
            <p class="source-note" role="status">
              That form has had a few recent attempts. Please try again later or use X or LinkedIn.
            </p>
          )}
          {error === "invalid" && (
            <p class="source-note" role="alert">
              Some details did not pass validation. Check the highlighted field and try again.
            </p>
          )}
          <p class="source-note" data-contact-note role="status"></p>
          <form
            class="contact-form"
            action="/_emdash/api/plugins/woodhouse-enquiries/submit"
            method="post"
            enctype="multipart/form-data"
          >
            <div class="contact-form__honeypot" aria-hidden="true">
              <label for="contact-website">Leave this field blank</label>
              <input
                id="contact-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="contact-form__grid">
              <label for="contact-name">
                Name <span>(optional)</span>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  maxlength="80"
                  autocomplete="name"
                  {...fieldProps("name")}
                />
                {invalidField === "name" && (
                  <small class="contact-form__problem" id="contact-problem">
                    {invalidMessage}
                  </small>
                )}
              </label>
              <label for="contact-reply">
                Reply address <span>(optional)</span>
                <input
                  id="contact-reply"
                  name="reply"
                  type="email"
                  maxlength="200"
                  autocomplete="email"
                  {...fieldProps("reply")}
                />
                {invalidField === "reply" && (
                  <small class="contact-form__problem" id="contact-problem">
                    {invalidMessage}
                  </small>
                )}
              </label>
              <label for="contact-topic">
                Topic
                <select id="contact-topic" name="topic" required {...fieldProps("topic")}>
                  <option value="Woodhouse">Woodhouse</option>
                  <option value="Projects">Projects</option>
                  <option value="Engineering">Engineering</option>
                  <option value="Media">Media</option>
                  <option value="Other">Other</option>
                </select>
                {invalidField === "topic" && (
                  <small class="contact-form__problem" id="contact-problem">
                    {invalidMessage}
                  </small>
                )}
              </label>
              <label for="contact-kind">
                I am a
                <select id="contact-kind" name="kind" required {...fieldProps("kind")}>
                  <option value="human">Person</option>
                  <option value="agent">Software agent</option>
                </select>
                {invalidField === "kind" && (
                  <small class="contact-form__problem" id="contact-problem">
                    {invalidMessage}
                  </small>
                )}
              </label>
              <label class="contact-form__message" for="contact-message">
                Message
                <textarea
                  id="contact-message"
                  name="message"
                  rows="7"
                  minlength="10"
                  maxlength="3000"
                  required
                  {...fieldProps("message")}
                ></textarea>
                <small id="contact-message-help">
                  10–3,000 characters. Please do not include passwords, access tokens or information
                  you do not want sent.
                </small>
                {invalidField === "message" && (
                  <small class="contact-form__problem" id="contact-problem">
                    {invalidMessage}
                  </small>
                )}
              </label>
            </div>
            <button class="button" type="submit" data-contact-send>
              Send enquiry <span aria-hidden="true">↗</span>
            </button>
          </form>
        </section>
      )}
      <p class="source-note" style="margin-top:3rem">
        For an agent acting on behalf of a human: describe the topic first. Ask the human before
        including their personal information.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { contactMessages, isEnquiryField } from "../../data/contact-feedback";

  // The form stays a native form: this acknowledges the press, keeps the
  // visitor's words if the server sends them back, and never blocks a send.
  const form = document.querySelector<HTMLFormElement>(".contact-form");
  const send = document.querySelector<HTMLButtonElement>("[data-contact-send]");
  const note = document.querySelector<HTMLElement>("[data-contact-note]");
  const draftKey = "woodhouse:contact-draft";
  const fields = ["name", "reply", "topic", "kind", "message"] as const;
  const sendMarkup = send?.innerHTML ?? "Send enquiry";
  let sending = false;
  let slowTimer = 0;

  const saveDraft = () => {
    if (!form) return;
    const draft: Record<string, string> = {};
    for (const field of fields) {
      const element = form.elements.namedItem(field);
      if (
        element instanceof HTMLInputElement ||
        element instanceof HTMLSelectElement ||
        element instanceof HTMLTextAreaElement
      ) {
        draft[field] = element.value;
      }
    }
    try {
      sessionStorage.setItem(draftKey, JSON.stringify(draft));
    } catch {
      /* A blocked session store must not stop the form working. */
    }
  };

  const restoreDraft = () => {
    if (!form) return false;
    let draft: Record<string, string> | null;
    try {
      const stored = sessionStorage.getItem(draftKey);
      draft = stored ? (JSON.parse(stored) as Record<string, string>) : null;
    } catch {
      draft = null;
    }
    if (!draft) return false;
    let restored = 0;
    for (const field of fields) {
      const element = form.elements.namedItem(field);
      const value = draft[field];
      if (!value) continue;
      if (
        element instanceof HTMLInputElement ||
        element instanceof HTMLSelectElement ||
        element instanceof HTMLTextAreaElement
      ) {
        element.value = value;
        restored += 1;
      }
    }
    return restored > 0;
  };

  const clearDraft = () => {
    try {
      sessionStorage.removeItem(draftKey);
    } catch {
      /* A blocked session store must not stop the form working. */
    }
  };

  const setNote = (message: string) => {
    if (note) note.textContent = message;
  };

  const focusField = (field: string) => {
    if (!form) return;
    const element = form.elements.namedItem(field);
    if (element instanceof HTMLElement) element.focus();
  };

  const resetSend = () => {
    sending = false;
    if (slowTimer) window.clearTimeout(slowTimer);
    slowTimer = 0;
    if (send) {
      send.disabled = false;
      send.removeAttribute("aria-busy");
      send.innerHTML = sendMarkup;
    }
    form?.removeAttribute("aria-busy");
  };

  if (form) {
    const params = new URLSearchParams(window.location.search);
    const problem = params.get("error");
    const invalidField = params.get("field");

    if (params.get("submitted") === "1") {
      // The enquiry reached the inbox; the draft has served its purpose.
      clearDraft();
      setNote("");
    } else {
      const restored = restoreDraft();
      if (problem === "invalid") {
        setNote(restored ? contactMessages.invalidKept : contactMessages.invalidEmpty);
        if (isEnquiryField(invalidField)) focusField(invalidField);
      } else if (problem === "rate-limit") {
        setNote(restored ? contactMessages.rateLimitedKept : contactMessages.rateLimitedEmpty);
      } else if (restored) {
        setNote(contactMessages.restored);
      }
    }

    form.addEventListener("input", (event) => {
      saveDraft();
      if (event.target instanceof HTMLElement) event.target.removeAttribute("aria-invalid");
    });
    form.addEventListener("change", saveDraft);
    form.addEventListener("submit", (event) => {
      if (sending) {
        event.preventDefault();
        setNote(contactMessages.stillSending);
        return;
      }
      const message = form.elements.namedItem("message");
      // Native validation covers a short value; this catches whitespace that
      // passes minlength but would be rejected by the server after a round trip.
      if (message instanceof HTMLTextAreaElement && message.value.trim().length < 10) {
        event.preventDefault();
        message.setAttribute("aria-invalid", "true");
        message.focus();
        setNote(contactMessages.shortMessage);
        return;
      }
      sending = true;
      form.setAttribute("aria-busy", "true");
      if (send) {
        send.disabled = true;
        send.setAttribute("aria-busy", "true");
        send.textContent = "Sending…";
      }
      setNote(contactMessages.sending);
      saveDraft();
      // The browser owns the navigation and its wait. This notice is for a
      // stalled request; it does not re-enable the button, because a second
      // press could duplicate a submission that already reached the inbox.
      slowTimer = window.setTimeout(() => {
        if (!sending) return;
        setNote(contactMessages.slow);
      }, 20000);
    });

    window.addEventListener("pageshow", (event) => {
      // Coming back from a completed navigation leaves the restored page with a
      // disabled button. Reconcile it explicitly instead of claiming the send
      // did not finish.
      if (!event.persisted || !sending) return;
      resetSend();
      setNote(contactMessages.restoredAfterSend);
      send?.focus({ preventScroll: true });
    });
  }
</script>
