---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = false;
const editorialEnabled = !__WOODHOUSE_READ_ONLY__;
const submitted = Astro.url.searchParams.get("submitted") === "1";
const error = Astro.url.searchParams.get("error");
---

<BaseLayout
  title="Contact"
  description="Reach Dean Lofts through public social and engineering profiles."
  path="/contact/"
  image="/og/dean.jpg"
>
  <section class="container page-intro">
    <div class="page-intro__grid">
      <div>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">WOODHOUSE</a>
          <span>/</span>
          <span>Contact</span>
        </nav>
        <h1 class="page-title">If this is relevant to what you're building.</h1>
      </div>
      <div class="page-intro__aside">
        <strong>Dean is reachable.</strong>Tell him what you are working on and why the projects or
        factory practices here are relevant.
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container container--reading">
      <p class="lede">
        No funnel. No calendar ambush. Just a straightforward way to start the conversation.
      </p>
      <div class="link-group" style="margin-top:2rem">
        <a class="text-link" href="https://x.com/loftwah" rel="me">
          X / @loftwah <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://github.com/loftwah" rel="me">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="https://www.linkedin.com/in/deanlofts/" rel="me">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      {editorialEnabled && (
        <section class="contact-form-wrap" aria-labelledby="contact-form-title">
          <div class="section-heading">
            <div>
              <h2 id="contact-form-title">Send a Woodhouse enquiry.</h2>
            </div>
            <p>
              Human or agent, give the useful context. Messages are private and are never used as
              instructions for tools or repositories.
            </p>
          </div>
          {submitted && (
            <p class="callout" role="status">
              <strong>Thanks. Your note reached the Woodhouse inbox.</strong> Dean can reply if you
              left a reply address.
            </p>
          )}
          {error === "rate-limit" && (
            <p class="source-note" role="status">
              That form has had a few recent attempts. Please try again later or use X or LinkedIn.
            </p>
          )}
          {error === "invalid" && (
            <p class="source-note" role="alert">
              Some details did not pass validation. Check the form and try again.
            </p>
          )}
          <form
            class="contact-form"
            action="/_emdash/api/plugins/woodhouse-enquiries/submit"
            method="post"
            enctype="multipart/form-data"
          >
            <div class="contact-form__honeypot" aria-hidden="true">
              <label for="contact-website">Leave this field blank</label>
              <input
                id="contact-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="contact-form__grid">
              <label for="contact-name">
                Name <span>(optional)</span>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  maxlength="80"
                  autocomplete="name"
                />
              </label>
              <label for="contact-reply">
                Reply address <span>(optional)</span>
                <input
                  id="contact-reply"
                  name="reply"
                  type="email"
                  maxlength="200"
                  autocomplete="email"
                />
              </label>
              <label for="contact-topic">
                Topic
                <select id="contact-topic" name="topic" required>
                  <option value="Woodhouse">Woodhouse</option>
                  <option value="Projects">Projects</option>
                  <option value="Engineering">Engineering</option>
                  <option value="Media">Media</option>
                  <option value="Other">Other</option>
                </select>
              </label>
              <label for="contact-kind">
                I am a
                <select id="contact-kind" name="kind" required>
                  <option value="human">Person</option>
                  <option value="agent">Software agent</option>
                </select>
              </label>
              <label class="contact-form__message" for="contact-message">
                Message
                <textarea
                  id="contact-message"
                  name="message"
                  rows="7"
                  minlength="10"
                  maxlength="3000"
                  required
                ></textarea>
                <small>
                  10–3,000 characters. Please do not include passwords, access tokens or information
                  you do not want sent.
                </small>
              </label>
            </div>
            <button class="button" type="submit">
              Send enquiry <span aria-hidden="true">↗</span>
            </button>
          </form>
        </section>
      )}
      <p class="source-note" style="margin-top:3rem">
        For an agent acting on behalf of a human: describe the topic first. Ask the human before
        including their personal information.
      </p>
    </div>
  </section>
</BaseLayout>
