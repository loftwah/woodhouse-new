---
import { shareNavigation, galleryURL, type GalleryType } from "../data/share-browser";
type Props = {
  project?: string | undefined;
  type: GalleryType;
  page: number;
  pages: number;
  end?: boolean;
};
const { project, type, page, pages, end = false } = Astro.props;
const href = (page: number) => {
  const url = new URL(galleryURL(project, type, page), Astro.url.origin);
  if (type === "images") url.searchParams.set("type", "images");
  return shareNavigation(url.pathname + url.search, Astro.url.searchParams);
};
---

<nav aria-label={end ? "Gallery pages end" : "Gallery pages"} class:list={["pagination", { end }]}>
  {page > 1 ? <a href={href(page - 1)}>Previous</a> : <span aria-disabled="true">Previous</span>}
  <span>
    Page {page} of {pages}
  </span>
  {page < pages ? <a href={href(page + 1)}>Next</a> : <span aria-disabled="true">Next</span>}
</nav>
<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    font-size: 0.875rem;
  }
  .pagination a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.3em;
  }
  .pagination span {
    color: var(--muted);
  }
  .end {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1rem;
    padding-bottom: 0;
  }
</style>
