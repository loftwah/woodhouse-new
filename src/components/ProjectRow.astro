---
import StatusStamp from "./StatusStamp.astro";
const { project, compact = false } = Astro.props;
---
<a class={"project-row" + (compact ? " project-row--compact" : "")} href={"/projects/" + project.slug + "/"}>
  <span class="project-row__index">{project.index}</span>
  <span class="project-row__main">
    <span class="project-row__name">{project.name}</span>
    <span class="project-row__discipline">{project.discipline}</span>
  </span>
  <span class="project-row__summary">{project.summary}</span>
  <span class="project-row__state"><StatusStamp tone={project.stateTone} label={project.state} /></span>
  <span class="project-row__arrow" aria-hidden="true">↗</span>
</a>
