---
import StatusStamp from "./StatusStamp.astro";
import { getSiteMetadata } from "../data/site-metadata";
const { project, compact = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const domain = project.siteUrl ? new URL(project.siteUrl).hostname : "No public site or demo";
const siteMeta = project.siteUrl ? getSiteMetadata(project) : null;
const placeholder = `/og/projects/${project.slug}.svg`;
---

<article class={"project-row" + (compact ? " project-row--compact" : "")}>
  <figure class="project-row__preview" data-project-artwork>
    {siteMeta ? (
      <a
        class="project-row__image"
        href={project.siteUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open the ${project.name} site to view its artwork`}
      >
        <img
          src={siteMeta.image}
          alt={project.previewAlt ?? `Artwork from the ${project.name} site.`}
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          data-fallback-src={placeholder}
          data-fallback-alt={`Woodhouse illustration for ${project.name}.`}
        />
      </a>
    ) : (
      <div class="project-row__image project-row__image--placeholder">
        <img
          src={placeholder}
          alt={`Woodhouse illustration for ${project.name}.`}
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <figcaption>
      <span class="project-row__domainline">
        {siteMeta?.icon && (
          <img
            src={siteMeta.icon}
            width="20"
            height="20"
            alt=""
            aria-hidden="true"
            decoding="async"
            data-source-favicon
          />
        )}
        <span class="project-row__domain">
          {domain} ·{" "}
          {siteMeta ? (
            <span data-artwork-status>LAST REVIEWED SITE DETAILS</span>
          ) : (
            <span data-artwork-status>WOODHOUSE ILLUSTRATION</span>
          )}
        </span>
      </span>
      {siteMeta ? (
        <>
          <strong class="project-row__og-title">{siteMeta.title}</strong>
          <span class="project-row__og-description">{siteMeta.description}</span>
        </>
      ) : (
        <>
          <strong class="project-row__og-title">Woodhouse illustration</strong>
          <span class="project-row__og-description">Made for this dossier.</span>
        </>
      )}
    </figcaption>
  </figure>
  <div class="project-row__record">
    <span class="project-row__index">{project.index} / 08 · DOSSIER</span>
    <Heading>
      <a class="project-row__name" href={"/projects/" + project.slug + "/"}>
        {project.name}
      </a>
    </Heading>
    <span class="project-row__discipline">{project.discipline}</span>
    <StatusStamp tone={project.stateTone} label={project.state} />
    <p class="project-row__summary">{project.summary}</p>
    <p class="project-row__proof">
      <strong>Next proof</strong>
      {project.remaining}
    </p>
    <a class="project-row__dossier" href={"/projects/" + project.slug + "/"}>
      Read the Woodhouse dossier <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
