---
import StatusStamp from "./StatusStamp.astro";
import { getArtworkFallback, getSiteMetadata } from "../data/site-metadata";
import { formatReviewDate } from "../data/review-date";
import { projectAction, projectActionHref, projectActionLabel } from "../data/project-actions";
const { project, compact = false, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const domain = project.siteUrl ? new URL(project.siteUrl).hostname : "No public site or demo";
const siteMeta = project.siteUrl ? getSiteMetadata(project) : null;
const fallback = getArtworkFallback(project);
const placeholder = fallback.image;
const action = projectAction(project);
const actionHref = projectActionHref(project);
const external = Boolean(project.siteUrl);
const reviewLabel = formatReviewDate(project.reviewDate) ?? project.reviewDate;
---

<article class={"project-row" + (compact ? " project-row--compact" : "")}>
  <figure class="project-row__preview" data-project-artwork>
    {siteMeta ? (
      <a
        class="project-row__image"
        href={project.siteUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open the ${project.name} site to view its artwork`}
      >
        <img
          src={siteMeta.image}
          alt={project.previewAlt ?? `Artwork from the ${project.name} site.`}
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          data-fallback-src={placeholder}
          data-fallback-alt={fallback.alt}
          data-fallback-credit={fallback.credit}
        />
      </a>
    ) : (
      <div class="project-row__image project-row__image--placeholder">
        <img
          src={placeholder}
          alt={fallback.alt}
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <figcaption>
      <span class="project-row__domainline">
        {siteMeta?.icon && (
          <img
            src={siteMeta.icon}
            width="20"
            height="20"
            alt=""
            aria-hidden="true"
            decoding="async"
            data-source-favicon
          />
        )}
        <span class="project-row__domain">
          {domain} ·{" "}
          {siteMeta ? (
            <span data-artwork-status>LAST REVIEWED SITE DETAILS</span>
          ) : (
            <span data-artwork-status>WOODHOUSE ILLUSTRATION</span>
          )}
        </span>
      </span>
      {siteMeta ? (
        <>
          <strong class="project-row__og-title">{siteMeta.title}</strong>
          <span class="project-row__og-description">{siteMeta.description}</span>
        </>
      ) : (
        <>
          <strong class="project-row__og-title">Woodhouse illustration</strong>
          <span class="project-row__og-description">Made for this record.</span>
        </>
      )}
    </figcaption>
  </figure>
  <div class="project-row__record">
    <Heading>
      <a class="project-row__name" href={"/projects/" + project.slug + "/"}>
        {project.name}
      </a>
    </Heading>
    <span class="project-row__discipline">{project.discipline}</span>
    <p class="project-row__hook">{project.title}</p>
    <p class="project-row__summary">{project.summary}</p>
    <p class="project-row__availability">{action.availability}</p>
    <div class="project-row__state">
      <StatusStamp tone={project.stateTone} label={project.state} />
      <time datetime={project.reviewDate}>Reviewed {reviewLabel}</time>
    </div>
    <div class="project-row__actions">
      <a
        class="project-row__action"
        href={actionHref}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        {projectActionLabel(project)} <span aria-hidden="true">↗</span>
      </a>
      <a class="project-row__dossier" href={"/projects/" + project.slug + "/"}>
        See how it works <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
