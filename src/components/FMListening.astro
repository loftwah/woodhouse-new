---
import type { PublicCapability } from "../data/capabilities";
import { formatReviewDate } from "../data/review-date";
type Props = { capability: PublicCapability; projectKey?: string | undefined };
const { capability, projectKey } = Astro.props;
const listening = capability.listening;
const selected = capability.consumers.find((c) => c.project.slug === projectKey);
const stationUrl = selected?.stationHref ?? listening?.href;
const defaultStation = stationUrl ? new URL(stationUrl).searchParams.get("station") : null;
const stations = [
  { id: "night-signal", name: "Night Signal" },
  ...capability.consumers
    .filter((c) => c.stationHref)
    .map((c) => ({ id: c.record.station_id, name: c.record.station_name || c.record.station_id }))
].filter((station, index, all) => all.findIndex((s) => s.id === station.id) === index);
const embedUrl = listening && defaultStation ? new URL(listening.embed) : null;
if (embedUrl && defaultStation) embedUrl.searchParams.set("station", defaultStation);
---

{listening && embedUrl && (
  <section class="fm-listening" aria-label="Listen to LoftwahFM">
    <h2>LoftwahFM. Sound for the long session.</h2>
    <p>{listening.summary}</p>
    <div class="fm-listening__actions">
      <a class="text-link" href={stationUrl}>
        Open LoftwahFM <span aria-hidden="true">↗</span>
      </a>
      <a href="/projects/loftwahfm/">Explore the music project</a>
    </div>
    <details class="fm-listening__player" data-fm-listener>
      <summary>Listen here</summary>
      <noscript>
        <p>Open LoftwahFM using the link above to listen.</p>
      </noscript>
      <label>
        Choose a music station
        <select data-fm-station disabled>
          {stations.map((station) => (
            <option value={station.id} selected={station.id === defaultStation}>
              {station.name}
            </option>
          ))}
        </select>
      </label>
      <iframe
        hidden
        data-fm-source={embedUrl.href}
        title="LoftwahFM music station player"
        width="600"
        height="360"
        allow="autoplay"
        referrerpolicy="strict-origin-when-cross-origin"
      />
      <div class="fm-listening__state-row">
        <p class="fm-listening__state" data-fm-state role="status" hidden>
          The player loads when this panel opens.
        </p>
        <button class="fm-listening__retry" type="button" data-fm-retry hidden>
          Try loading the player again
        </button>
      </div>
      <p class="fm-listening__help">
        Press Play in the player. Closing this panel stops playback.{" "}
        <a href={stationUrl} data-fm-open>
          Open this station on FM
        </a>
        .
      </p>
    </details>
    {listening.shows.length > 0 && (
      <div class="fm-listening__shows">
        <h3>Original shows</h3>
        <ul>
          {listening.shows.map((show) => (
            <li>
              <a href={show.href}>
                {show.title} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="fm-listening__help">
          Original satire with synthetic presenters and explicit language. Reviewed{" "}
          {formatReviewDate(capability.review.reviewed_at)}.{" "}
          <a href={listening.showsEvidenceHref}>Publication evidence</a>.
        </p>
      </div>
    )}
    <p class="fm-listening__handoff">
      <a href={capability.href}>
        Follow the shared client and game adoption evidence <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
)}

<script>
  import { fmPlayerStatus, type FmPlayerStage } from "../data/fm-player";
  import { createOperationIntent } from "../data/operation-intent";

  const retryLabel = "Try loading the player again";

  for (const panel of document.querySelectorAll<HTMLDetailsElement>("[data-fm-listener]")) {
    const frame = panel.querySelector("iframe");
    const select = panel.querySelector("select");
    const link = panel.querySelector<HTMLAnchorElement>("[data-fm-open]");
    const state = panel.querySelector<HTMLElement>("[data-fm-state]");
    const retry = panel.querySelector<HTMLButtonElement>("[data-fm-retry]");
    if (!frame || !select || !link) continue;
    if (state) state.hidden = false;

    const intent = createOperationIntent();
    let timer = 0;
    let probe: AbortController | undefined;
    let stopWaiting: (() => void) | undefined;
    let frameLoaded = false;
    let probeState: "pending" | "answered" | "failed" = "pending";
    let returnFocus = false;

    const stationName = () => select.selectedOptions[0]?.textContent?.trim() || "the station";
    const say = (stage: FmPlayerStage) => {
      if (!state) return;
      state.textContent = fmPlayerStatus(stage, stationName());
      state.dataset.state = stage;
    };
    const clearTimer = () => {
      if (timer) window.clearTimeout(timer);
      timer = 0;
    };
    const setBusy = (busy: boolean) => {
      if (busy) frame.setAttribute("aria-busy", "true");
      else frame.removeAttribute("aria-busy");
    };
    const hideRetry = () => {
      if (!retry) return;
      retry.hidden = true;
      delete retry.dataset.pending;
      retry.removeAttribute("aria-busy");
      retry.textContent = retryLabel;
    };
    const showRetry = () => {
      if (retry) retry.hidden = false;
    };
    const resetRetry = () => {
      if (!retry) return;
      delete retry.dataset.pending;
      retry.removeAttribute("aria-busy");
      retry.textContent = retryLabel;
    };
    const stopProbe = () => {
      if (probe) probe.abort();
      probe = undefined;
    };
    const stopWaitingForFrame = () => {
      if (stopWaiting) stopWaiting();
      stopWaiting = undefined;
    };
    const updateLink = (source: URL) => {
      const player = new URL(source);
      player.pathname = "/radio";
      link.href = player.href;
    };
    const ready = (token: number) => {
      if (!intent.isCurrent(token) || !panel.open) return;
      clearTimer();
      setBusy(false);
      resetRetry();
      hideRetry();
      say("ready");
      if (returnFocus) {
        returnFocus = false;
        frame.focus({ preventScroll: true });
      }
    };
    const failed = (token: number) => {
      if (!intent.isCurrent(token) || !panel.open) return;
      clearTimer();
      setBusy(false);
      returnFocus = false;
      resetRetry();
      showRetry();
      say("failed");
    };
    const slow = (token: number) => {
      if (!intent.isCurrent(token) || !panel.open) return;
      setBusy(false);
      returnFocus = false;
      resetRetry();
      showRetry();
      say("slow");
    };
    // A HEAD request tells us whether the station host answered at all. The
    // frame's own load event fires for a browser error page, so a lone load is
    // not evidence that the player is usable.
    const probeStation = (source: URL, token: number) => {
      stopProbe();
      probeState = "pending";
      const controller = new AbortController();
      probe = controller;
      const timeout = window.setTimeout(() => controller.abort(), 8000);
      fetch(source.href, {
        method: "HEAD",
        mode: "no-cors",
        cache: "no-store",
        signal: controller.signal
      })
        .then(() => {
          if (!intent.isCurrent(token)) return;
          probeState = "answered";
          if (frameLoaded) ready(token);
        })
        .catch(() => {
          if (!intent.isCurrent(token)) return;
          probeState = "failed";
          failed(token);
        })
        .finally(() => window.clearTimeout(timeout));
    };
    const waitForFrame = (token: number) => {
      stopWaitingForFrame();
      const onLoad = () => {
        stopWaitingForFrame();
        if (!intent.isCurrent(token) || !panel.open) return;
        frameLoaded = true;
        if (probeState === "answered") ready(token);
        else if (probeState === "failed") failed(token);
        else say("checking");
      };
      frame.addEventListener("load", onLoad);
      stopWaiting = () => frame.removeEventListener("load", onLoad);
    };
    const loadPlayer = (token: number, keepRetry = false) => {
      clearTimer();
      stopWaitingForFrame();
      stopProbe();
      frameLoaded = false;
      setBusy(true);
      if (!keepRetry) hideRetry();
      say("loading");
      const source = new URL(frame.dataset.fmSource!);
      source.searchParams.set("station", select.value);
      updateLink(source);
      frame.hidden = false;
      frame.src = source.href;
      waitForFrame(token);
      probeStation(source, token);
      timer = window.setTimeout(() => slow(token), 12000);
    };
    const sync = () => {
      const token = intent.begin();
      returnFocus = false;
      clearTimer();
      stopWaitingForFrame();
      stopProbe();
      if (!panel.open) {
        frameLoaded = false;
        setBusy(false);
        resetRetry();
        hideRetry();
        frame.src = "about:blank";
        frame.hidden = true;
        say("closed");
        return;
      }
      select.disabled = false;
      loadPlayer(token);
    };

    panel.addEventListener("toggle", sync);
    select.addEventListener("change", sync);
    retry?.addEventListener("click", () => {
      if (!panel.open) {
        sync();
        return;
      }
      if (retry.dataset.pending === "true") {
        say("loading");
        return;
      }
      const token = intent.begin();
      returnFocus = document.activeElement === retry;
      retry.dataset.pending = "true";
      retry.setAttribute("aria-busy", "true");
      retry.textContent = "Trying again…";
      loadPlayer(token, true);
    });
    window.addEventListener("pagehide", () => {
      intent.cancel();
      clearTimer();
      stopWaitingForFrame();
      stopProbe();
      frame.src = "about:blank";
    });
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && panel.open) sync();
    });
    sync();
  }
</script>

<style>
  .fm-listening {
    border-block: 1px solid var(--line);
    padding-block: 2rem;
    margin-block: 2rem;
  }
  .fm-listening h2 {
    margin-block: 0.75rem 1rem;
  }
  .fm-listening__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin-block: 1.5rem;
  }
  .fm-listening__player {
    margin-block: 1.5rem;
  }
  .fm-listening__player summary {
    font-weight: 700;
    padding-block: 0.75rem;
    cursor: pointer;
  }
  .fm-listening__player label {
    display: block;
    margin-block: 1rem;
    font-size: 0.875rem;
  }
  .fm-listening__player select {
    display: block;
    width: 100%;
    max-width: 28rem;
    min-height: 44px;
    margin-top: 0.5rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--paper);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .fm-listening__player iframe[hidden] {
    display: none;
  }
  .fm-listening__player iframe {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
    background: #080809;
  }
  .fm-listening__state-row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.5rem 0.75rem;
    margin-block: 0.75rem 0;
  }
  .fm-listening__state {
    flex: 1 1 18rem;
    margin: 0;
    padding: 0.55rem 0.7rem;
    border-left: 2px solid var(--accent-link);
    background: rgba(121, 216, 255, 0.07);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--copy);
  }
  .fm-listening__state[hidden],
  .fm-listening__retry[hidden] {
    display: none;
  }
  .fm-listening__retry {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    color: var(--paper);
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .fm-listening__retry[aria-busy="true"] {
    opacity: 0.6;
    cursor: progress;
  }
  .fm-listening__shows h3 {
    font-size: 1rem;
    margin-block: 1.5rem 0.75rem;
  }
  .fm-listening__shows ul {
    list-style: none;
    padding: 0;
  }
  .fm-listening__shows li {
    margin-block: 0.75rem;
  }
  .fm-listening__help {
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .fm-listening__handoff {
    margin-block: 1.5rem 0;
  }
  @media (max-width: 600px) {
    .fm-listening__retry {
      width: 100%;
    }
  }
</style>
