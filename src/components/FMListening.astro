---
import type { PublicCapability } from "../data/capabilities";
import { formatReviewDate } from "../data/review-date";
type Props = { capability: PublicCapability; projectKey?: string | undefined };
const { capability, projectKey } = Astro.props;
const listening = capability.listening;
const selected = capability.consumers.find((c) => c.project.slug === projectKey);
const stationUrl = selected?.stationHref ?? listening?.href;
const defaultStation = stationUrl ? new URL(stationUrl).searchParams.get("station") : null;
const stations = [
  { id: "night-signal", name: "Night Signal" },
  ...capability.consumers
    .filter((c) => c.stationHref)
    .map((c) => ({ id: c.record.station_id, name: c.record.station_name || c.record.station_id }))
].filter((station, index, all) => all.findIndex((s) => s.id === station.id) === index);
const embedUrl = listening && defaultStation ? new URL(listening.embed) : null;
if (embedUrl && defaultStation) embedUrl.searchParams.set("station", defaultStation);
---

{listening && embedUrl && (
  <section class="fm-listening" aria-label="Listen to LoftwahFM">
    <h2>LoftwahFM. Sound for the long session.</h2>
    <p>{listening.summary}</p>
    <div class="fm-listening__actions">
      <a class="text-link" href={stationUrl}>
        Open LoftwahFM <span aria-hidden="true">↗</span>
      </a>
      <a href="/projects/loftwahfm/">Explore the music project</a>
    </div>
    <details class="fm-listening__player" data-fm-listener>
      <summary>Listen here</summary>
      <noscript>
        <p>Open LoftwahFM using the link above to listen.</p>
      </noscript>
      <label>
        Choose a music station
        <select data-fm-station disabled>
          {stations.map((station) => (
            <option value={station.id} selected={station.id === defaultStation}>
              {station.name}
            </option>
          ))}
        </select>
      </label>
      <iframe
        hidden
        data-fm-source={embedUrl.href}
        title="LoftwahFM music station player"
        width="600"
        height="360"
        allow="autoplay"
        referrerpolicy="strict-origin-when-cross-origin"
      />
      <p class="fm-listening__help">
        Press Play in the player. Closing this panel stops playback.{" "}
        <a href={stationUrl} data-fm-open>
          Open this station on FM
        </a>
        .
      </p>
    </details>
    {listening.shows.length > 0 && (
      <div class="fm-listening__shows">
        <h3>Original shows</h3>
        <ul>
          {listening.shows.map((show) => (
            <li>
              <a href={show.href}>
                {show.title} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="fm-listening__help">
          Original satire with synthetic presenters and explicit language. Reviewed{" "}
          {formatReviewDate(capability.review.reviewed_at)}.{" "}
          <a href={listening.showsEvidenceHref}>Publication evidence</a>.
        </p>
      </div>
    )}
    <p class="fm-listening__handoff">
      <a href={capability.href}>
        Follow the shared client and game adoption evidence <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
)}

<script>
  for (const panel of document.querySelectorAll<HTMLDetailsElement>("[data-fm-listener]")) {
    const frame = panel.querySelector<HTMLIFrameElement>("iframe");
    const select = panel.querySelector("select");
    const link = panel.querySelector<HTMLAnchorElement>("[data-fm-open]");
    if (!frame || !select || !link) continue;
    frame.hidden = false;
    select.disabled = false;
    const sync = () => {
      const source = new URL(frame.dataset.fmSource!);
      source.searchParams.set("station", select.value);
      const player = new URL(source);
      player.pathname = "/radio";
      link.href = player.href;
      // Loading on intent avoids a player request on every portfolio page.
      // Unloading the frame also releases FM's audio transport on close.
      frame.src = panel.open ? source.href : "about:blank";
    };
    panel.addEventListener("toggle", sync);
    select.addEventListener("change", sync);
    window.addEventListener("pagehide", () => {
      frame.src = "about:blank";
    });
    window.addEventListener("pageshow", () => {
      if (panel.open) sync();
    });
  }
</script>

<style>
  .fm-listening {
    border-block: 1px solid var(--line);
    padding-block: 2rem;
    margin-block: 2rem;
  }
  .fm-listening h2 {
    margin-block: 0.75rem 1rem;
  }
  .fm-listening__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    margin-block: 1.5rem;
  }
  .fm-listening__player {
    margin-block: 1.5rem;
  }
  .fm-listening__player summary {
    font-weight: 700;
    padding-block: 0.75rem;
    cursor: pointer;
  }
  .fm-listening__player label {
    display: block;
    margin-block: 1rem;
    font-size: 0.875rem;
  }
  .fm-listening__player select {
    display: block;
    width: 100%;
    max-width: 28rem;
    min-height: 44px;
    margin-top: 0.5rem;
    padding: 0.5rem;
    font: inherit;
    color: var(--paper);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .fm-listening__player iframe[hidden] {
    display: none;
  }
  .fm-listening__player iframe {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
    background: #080809;
  }
  .fm-listening__shows h3 {
    font-size: 1rem;
    margin-block: 1.5rem 0.75rem;
  }
  .fm-listening__shows ul {
    list-style: none;
    padding: 0;
  }
  .fm-listening__shows li {
    margin-block: 0.75rem;
  }
  .fm-listening__help {
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .fm-listening__handoff {
    margin-block: 1.5rem 0;
  }
</style>
