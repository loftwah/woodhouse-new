---
import { discoveryProjects } from "../data/portfolio-analytics";
import type { WoodhouseProject } from "../content/repository";
const { projects } = Astro.props as { projects: WoodhouseProject[] };
const destinations = projects
  .filter((p) => p.siteUrl && discoveryProjects.some((slug) => slug === p.slug))
  .map((p) => ({ slug: p.slug, origin: new URL(p.siteUrl!).origin }));
---

<script
  type="application/json"
  id="audience-destinations"
  set:html={JSON.stringify(destinations).replace(/</g, "\\u003c")}
/>
<script>
  import { parseDistributionContext, type DistributionContext } from "../data/story-distribution";
  (() => {
    if (
      location.hostname !== "woodhouse.loftwah.com" ||
      location.search.includes("_preview") ||
      navigator.webdriver ||
      navigator.doNotTrack === "1" ||
      (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl ||
      new URLSearchParams(location.search).has("qa") ||
      new URLSearchParams(location.search).get("analytics") === "off"
    )
      return;
    try {
      if (localStorage.getItem("woodhouse:analytics-opt-out") === "1") return;
    } catch {
      return;
    }
    let sessionId: string;
    let lastActivity = Date.now();
    try {
      const saved = JSON.parse(
        sessionStorage.getItem("woodhouse:engagement-session") ?? "null"
      ) as { id: string; at: number } | null;
      if (saved && Date.now() - saved.at < 1800000) lastActivity = saved.at;
      sessionId = saved && Date.now() - saved.at < 1800000 ? saved.id : crypto.randomUUID();
      sessionStorage.setItem(
        "woodhouse:engagement-session",
        JSON.stringify({ id: sessionId, at: Date.now() })
      );
    } catch {
      return;
    }
    let disabled = false;
    let browserReturnsDisabled = false;
    const tokenKey = "woodhouse:analytics-browser-token";
    const consentKey = "woodhouse:analytics-browser-consent";
    const clearToken = () => {
      try {
        localStorage.removeItem(tokenKey);
      } catch {
        /* In-memory revocation is already effective. */
      }
    };
    const excluded = () =>
      location.hostname !== "woodhouse.loftwah.com" ||
      location.search.includes("_preview") ||
      navigator.webdriver ||
      navigator.doNotTrack === "1" ||
      (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl ||
      new URLSearchParams(location.search).has("qa") ||
      new URLSearchParams(location.search).get("analytics") === "off";
    window.addEventListener("woodhouse:analytics-disable", () => {
      disabled = true;
      browserReturnsDisabled = true;
      clearToken();
    });
    window.addEventListener("woodhouse:browser-returns-disable", () => {
      browserReturnsDisabled = true;
      clearToken();
    });
    window.addEventListener("storage", (event: StorageEvent) => {
      if ((event.key === consentKey && event.newValue !== "1") || event.key === null) {
        browserReturnsDisabled = true;
        clearToken();
      }
      if (event.key === "woodhouse:analytics-opt-out" && event.newValue === "1") {
        disabled = true;
        browserReturnsDisabled = true;
        clearToken();
      }
    });
    const browserToken = () => {
      if (browserReturnsDisabled || disabled || excluded()) return undefined;
      try {
        if (
          localStorage.getItem(consentKey) !== "1" ||
          localStorage.getItem("woodhouse:analytics-opt-out") === "1"
        )
          return undefined;
        const raw = localStorage.getItem(tokenKey);
        let saved: { id: string; at: number } | null = null;
        try {
          saved = JSON.parse(raw ?? "null");
        } catch {
          /* Replace malformed storage only after explicit consent. */
        }
        if (
          saved &&
          typeof saved.id === "string" &&
          /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(saved.id) &&
          Number.isSafeInteger(saved.at) &&
          saved.at <= Date.now() &&
          Date.now() - saved.at < 90 * 86400000
        )
          return saved.id;
        const token = { id: crypto.randomUUID(), at: Date.now() };
        const encoded = JSON.stringify(token);
        localStorage.setItem(tokenKey, encoded);
        // No persistent token may leave this page unless its exact value was saved.
        if (localStorage.getItem(tokenKey) !== encoded) throw new Error("Token was not saved");
        return token.id;
      } catch {
        browserReturnsDisabled = true;
        clearToken();
        window.dispatchEvent(new Event("woodhouse:browser-returns-storage-failed"));
        return undefined;
      }
    };
    window.addEventListener("woodhouse:browser-returns-status", () => {
      if (browserReturnsDisabled)
        window.dispatchEvent(new Event("woodhouse:browser-returns-storage-failed"));
    });
    let distribution: DistributionContext | null = null;
    try {
      distribution = parseDistributionContext(
        JSON.parse(document.querySelector("#story-distribution-context")?.textContent ?? "null")
      );
    } catch {
      /* Only the resolved public page supplies story context. */
    }
    const send = (
      event: string,
      extra: Record<string, string | number | DistributionContext> = {}
    ) => {
      // This runs again when pending active time flushes; no queued payload retains a token.
      if (disabled || excluded()) return;
      try {
        if (localStorage.getItem("woodhouse:analytics-opt-out") === "1") return;
      } catch {
        return;
      }
      const token = browserToken();
      void fetch("/api/engagement", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          schema: "woodhouse.engagement/1",
          project: "woodhouse",
          eventId: crypto.randomUUID(),
          sessionId,
          event,
          mode: "site",
          ...(token ? { browserToken: token } : {}),
          ...extra
        }),
        keepalive: true,
        credentials: "omit"
      }).catch(() => {});
    };
    send("visit");
    if (distribution) send("story_arrival", { distribution });
    let previous = performance.now(),
      lastInput = -Infinity,
      active = 0,
      pending = 0,
      engaged = false;
    const input = (event: Event) => {
      if (event.isTrusted && !disabled) {
        if (Date.now() - lastActivity >= 1800000) {
          flush();
          sessionId = crypto.randomUUID();
          active = 0;
          pending = 0;
          engaged = false;
          send("visit");
          if (distribution) send("story_arrival", { distribution });
        }
        lastActivity = Date.now();
        lastInput = performance.now();
        try {
          sessionStorage.setItem(
            "woodhouse:engagement-session",
            JSON.stringify({ id: sessionId, at: Date.now() })
          );
        } catch {
          /* Storage is optional. */
        }
      }
    };
    for (const type of ["pointerdown", "keydown", "wheel", "touchstart"])
      window.addEventListener(type, input, { passive: true });
    const flush = () => {
      const seconds = Math.min(30, Math.floor(pending));
      if (seconds > 0) {
        send("active_time", { seconds });
        pending -= seconds;
      }
    };
    const tick = () => {
      const now = performance.now(),
        delta = Math.min(1, Math.max(0, (now - previous) / 1000));
      previous = now;
      if (
        disabled ||
        document.visibilityState !== "visible" ||
        !document.hasFocus() ||
        now - lastInput > 30000
      )
        return;
      active += delta;
      pending += delta;
      if (active >= 10 && !engaged) {
        engaged = true;
        send("engaged");
        if (distribution) send("story_explored", { distribution });
      }
      if (pending >= 15) flush();
    };
    let timer = window.setInterval(tick, 1000);
    document.addEventListener("visibilitychange", () => {
      previous = performance.now();
      if (document.visibilityState !== "visible") flush();
    });
    window.addEventListener("pagehide", () => {
      clearInterval(timer);
      flush();
    });
    window.addEventListener("pageshow", (event: PageTransitionEvent) => {
      if (!event.persisted) return;
      previous = performance.now();
      lastInput = -Infinity;
      timer = window.setInterval(tick, 1000);
    });
    const destinations = JSON.parse(
      document.querySelector("#audience-destinations")?.textContent ?? "[]"
    ) as { slug: string; origin: string }[];
    const projectOpening = (event: MouseEvent) => {
      if (
        !event.isTrusted ||
        event.defaultPrevented ||
        (event.type === "auxclick" && event.button !== 1)
      )
        return;
      const anchor = event.target instanceof Element ? event.target.closest("a") : null;
      if (!anchor) return;
      try {
        const origin = new URL(anchor.href).origin;
        const target = destinations.find((p) => p.origin === origin);
        // Link Check's native app is an independently hosted Composer story.
        const slug =
          target?.slug ??
          (distribution?.story === "link-check" && origin === "https://share.loftwah.com"
            ? "app-composer"
            : null);
        if (slug) send("project_open", { target: slug, ...(distribution ? { distribution } : {}) });
      } catch {
        /* Non-URL links are not project discoveries. */
      }
    };
    document.addEventListener("click", projectOpening);
    document.addEventListener("auxclick", projectOpening);
  })();
</script>
