---
import { artworkSorts, orderArtwork } from "../data/artwork-order";
import ShowcaseGallery from "./ShowcaseGallery.astro";
import { buildNotesKit } from "../data/showcase-build-notes";
import { wild25Kit } from "../data/showcase-wild-25";
import { projectStories50Kit } from "../data/showcase-project-stories-50";
import { projectStoriesKit } from "../data/showcase-project-stories";
import { galleryTypes, shareNavigation } from "../data/share-browser";
import { commissionedKits } from "../data/showcase-commissioned";
import type { CampaignItem } from "../data/showcase-campaign";

const collectionPacks = {
  "wild-25": { href: wild25Kit, label: "Download Wild 25" },
  "project-stories-50": { href: projectStories50Kit, label: "Download latest 50" },
  "project-stories": { href: projectStoriesKit, label: "Download Project stories kit" }
};
const categories = [
  ["", "All artwork"],
  ["screenshot", "Screenshots"],
  ["clip", "Clips"],
  ["commissioned", "New commissions"],
  ["game-rules", "How to play"],
  ["architecture", "Architecture"],
  ["field-guide", "Field Guide"],
  ["seasonal-library", "Seasonal & collectibles"],
  ["design-studies", "Design studies"],
  ["build-notes", "Build Notes"],
  ["wild-25", "Wild 25"],
  ["project-stories-50", "Latest 50"],
  ["project-stories", "Project stories"],
  ["banner", "Banners"],
  ["icon", "Avatars"],
  ["special", "Special icons"],
  ["sketch", "Sketches"],
  ["seasonal", "Seasonal"],
  ["feature", "Features & milestones"],
  ["comparison", "Comparisons"],
  ["art", "Illustration"],
  ["native", "Current project art"],
  ["earlier", "Earlier artwork"]
] as const;
type Props = {
  works: CampaignItem[];
  projects: { slug: string; name: string }[];
};
const { works, projects } = Astro.props;
const params = Astro.url.searchParams;
const category = categories.find(([key]) => key === params.get("artType"))?.[0] ?? "";
const series =
  category === "commissioned" ||
  category === "game-rules" ||
  category === "architecture" ||
  category === "field-guide" ||
  category === "seasonal-library" ||
  category === "design-studies" ||
  category === "build-notes" ||
  category === "wild-25" ||
  category === "project-stories-50" ||
  category === "project-stories"
    ? category
    : undefined;
const requestedProject = params.get("artProject") || params.get("project");
const project = projects.find(({ slug }) => slug === requestedProject)?.slug ?? "";
const labels = [
  ...new Set(
    works.flatMap(({ archived, formats }) =>
      archived ? [] : (formats?.map(({ label }) => label) ?? [])
    )
  )
].sort();
const requestedFormat = params.get("artFormat");
const format = requestedFormat === "Pinterest pin" ? "For Pinterest" : requestedFormat;
const placement = labels.find((label) => label === format) ?? "";
const tags = [
  ...new Set(works.flatMap(({ archived, tags }) => (archived ? [] : (tags ?? []))))
].sort();
const tag = tags.find((label) => label === params.get("artTag")) ?? "";
const featuredIds = [
  "november-woodhouse-loom",
  "november-shoalshot",
  "november-fighter",
  "november-app-composer",
  "november-bubbles",
  "november-loftwahfm",
  "november-foilbury",
  "november-protocol-11"
];
const defaultSort = !project && !category && !placement && !tag ? "featured" : "newest";
const sort =
  params.get("artSort") === "featured"
    ? defaultSort
    : (artworkSorts.find(([value]) => value === params.get("artSort"))?.[0] ?? defaultSort);
const featured = sort === "featured";
const shuffleSeed = (params.get("artSeed") ?? "").match(/^[a-z0-9]{1,24}$/i)?.[0] ?? "woodhouse";
const ordered = orderArtwork(
  works.filter(
    (item) =>
      (!project || item.project === project) &&
      (!tag || (!item.archived && item.tags?.includes(tag))) &&
      (!placement || (!item.archived && item.formats?.some(({ label }) => label === placement))) &&
      (!category ||
        (category === "earlier"
          ? !item.use || item.archived
          : series
            ? !item.archived && item.series === series
            : !item.archived && item.use === category))
  ),
  featured ? "newest" : sort,
  shuffleSeed
);
const filtered = featured
  ? [
      ...featuredIds.flatMap((id) => ordered.filter((item) => item.id === id)),
      ...ordered.filter((item) => !featuredIds.includes(item.id))
    ]
  : ordered;
const size = 24;
const requested = Number(params.get("artPage") ?? 1);
const pages = Math.max(1, Math.ceil(filtered.length / size));
const page = Number.isSafeInteger(requested) ? Math.max(1, Math.min(requested, pages)) : 1;
const current = filtered.slice((page - 1) * size, page * size);
const path = (
  number: number,
  nextCategory: string = category,
  nextSort = sort,
  nextSeed = shuffleSeed
) => {
  const query = new URLSearchParams();
  if (nextCategory) query.set("artType", nextCategory);
  if (project) query.set("artProject", project);
  if (placement) query.set("artFormat", placement);
  if (tag) query.set("artTag", tag);
  if (
    (nextSort !== "featured" && nextSort !== "newest") ||
    (nextSort === "newest" && !nextCategory && !project && !placement && !tag)
  )
    query.set("artSort", nextSort);
  if (nextSort === "shuffle") query.set("artSeed", nextSeed);
  if (number > 1) query.set("artPage", String(number));
  return shareNavigation(`/share/${query.size ? `?${query}` : ""}`, params);
};
const shuffle = path(1, category, "shuffle", crypto.randomUUID().replaceAll("-", "").slice(0, 16));
const next = page < pages ? path(page + 1) : "";
const previous = page > 1 ? path(page - 1) : "";
const seriesPack =
  series && series in collectionPacks && !project && !placement
    ? collectionPacks[series as keyof typeof collectionPacks]
    : undefined;
const projectPack =
  series === "build-notes" &&
  project &&
  works.some((item) => item.project === project && item.series === series)
    ? buildNotesKit(project)
    : project
      ? works.find(
          (item) =>
            item.project === project && (!series || item.series === series) && item.socialPack
        )?.socialPack
      : undefined;
const buildProjects =
  series === "build-notes" && !project
    ? projects.filter(({ slug }) =>
        works.some((item) => item.project === slug && item.series === series)
      )
    : [];
const artworkPages = Object.fromEntries(
  filtered.map(({ id }, i) => [id, Math.floor(i / size) + 1])
);
---

<div id="artwork" data-artwork-wall data-art-pages={JSON.stringify(artworkPages)}>
  <form class="art-filters" action="/share/" aria-label="Filter artwork">
    {params.has("qa") && <input type="hidden" name="qa" value={params.get("qa")} />}
    {params.get("analytics") === "off" && <input type="hidden" name="analytics" value="off" />}
    {sort === "shuffle" && <input type="hidden" name="artSeed" value={shuffleSeed} />}
    <label>
      <span>Collection</span>
      <select name="artType">
        {categories.map(([key, label]) => (
          <option value={key} selected={category === key}>
            {label}
          </option>
        ))}
      </select>
    </label>
    <label>
      <span>Project</span>
      <select name="artProject">
        <option value="">All projects</option>
        {projects.map(({ slug, name }) => (
          <option value={slug} selected={slug === project}>
            {name}
          </option>
        ))}
      </select>
    </label>
    <button type="submit" class="art-apply">
      Apply
    </button>
    <details class="art-filter-disclosure">
      <summary>More filters{placement || tag || sort !== defaultSort ? " · Active" : ""}</summary>
      <div class="art-filter-fields">
        <label class="art-sort">
          <span>Sort by</span>
          <select name="artSort">
            <option value="featured" selected={featured}>
              Recommended
            </option>
            {artworkSorts.map(([value, label]) => (
              <option value={value} selected={value === sort}>
                {label}
              </option>
            ))}
          </select>
        </label>
        <label>
          <span>Format</span>
          <select name="artFormat">
            <option value="">All formats</option>
            {labels.map((label) => (
              <option value={label} selected={label === placement}>
                {label}
              </option>
            ))}
          </select>
        </label>
        {tags.length > 0 && (
          <label>
            <span>Tag</span>
            <select name="artTag">
              <option value="">All tags</option>
              {tags.map((label) => (
                <option value={label} selected={label === tag}>
                  {label}
                </option>
              ))}
            </select>
          </label>
        )}
        <a class="shuffle-link" href={`${shuffle}#artwork`}>
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 6h3c4 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c1.7 0 3.2-2.3 4.5-4.8m3-4.4C15 7 16.3 6 18 6h3m-4-4 4 4-4 4" />
          </svg>
          {sort === "shuffle" ? "Reshuffle" : "Shuffle"}
        </a>
      </div>
    </details>
    <details class="media-formats">
      <summary>Media kits</summary>
      <div>
        {galleryTypes.map(([type, label]) => (
          <a
            href={shareNavigation(
              `/share/?${new URLSearchParams({ type, ...(["images", "clips", "cards", "artwork", "edition"].includes(type) && project && project !== "woodhouse" ? { project } : {}) })}`,
              params
            )}
          >
            {label}
          </a>
        ))}
      </div>
    </details>
  </form>
  {series === "game-rules" && (
    <p class="guide-intro">Learn a first move, then choose a game to find the rest of its rules.</p>
  )}
  {series === "architecture" && (
    <p class="guide-intro">See what each project is made of and where the work happens.</p>
  )}
  {buildProjects.length > 0 && (
    <details class="art-previous">
      <summary>Download project kits</summary>
      <ul class="build-kit-links">
        {buildProjects.map(({ slug, name }) => (
          <li>
            <a href={buildNotesKit(slug)} download>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
  {series === "commissioned" && !project && commissionedKits.length > 0 && (
    <details class="art-previous">
      <summary>Download project kits</summary>
      <ul class="build-kit-links">
        {commissionedKits.map(({ label, href }) => (
          <li>
            <a href={href} download>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/campaign/20261114-commissions/manifest.json" download>
        Download collection manifest
      </a>
    </details>
  )}
  {seriesPack && (
    <p class="art-previous">
      <a href={seriesPack.href} download>
        {seriesPack.label}
      </a>
    </p>
  )}
  {projectPack && (
    <p class="art-previous">
      <a href={projectPack} download>
        Download project kit
      </a>
    </p>
  )}
  {filtered.length === 0 && (
    <p class="art-empty">
      No artwork matches these filters.{" "}
      <a href={shareNavigation("/share/", params)}>Show all artwork</a>.
    </p>
  )}
  <div data-art-stream>
    <div data-art-batch data-next={next} data-progress={`Page ${page} of ${pages}`}>
      <ShowcaseGallery
        items={current}
        compact
        staggered
        eager={page === 1}
        minimal
        showPlacement={Boolean(placement)}
        placement={placement}
      />
    </div>
  </div>
  <p class="art-pagination">
    {previous && <a href={`${previous}#artwork`}>Previous page</a>}
    <a href={next || undefined} data-art-next hidden={!next}>
      More artwork
    </a>
    <span data-art-progress>
      Page {page} of {pages}
    </span>
    <span data-art-status role="status"></span>
  </p>
</div>

<script>
  for (const wall of document.querySelectorAll<HTMLElement>("[data-artwork-wall]")) {
    const stream = wall.querySelector<HTMLElement>("[data-art-stream]");
    const more = wall.querySelector<HTMLAnchorElement>("[data-art-next]");
    const status = wall.querySelector<HTMLElement>("[data-art-status]");
    const progress = wall.querySelector<HTMLElement>("[data-art-progress]");
    const artworkHash = location.hash.slice(1);
    if (artworkHash && !document.getElementById(artworkHash)) {
      const page = JSON.parse(wall.dataset.artPages ?? "{}")[artworkHash];
      if (Number.isInteger(page) && page > 1) {
        const url = new URL(location.href);
        url.searchParams.set("artPage", String(page));
        location.replace(url.href);
        continue;
      }
    }
    if (!stream || !more || !status || more.hidden) continue;
    let loading = false;
    let focusOnAppend = false;
    const observer =
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            ([entry]) => {
              if (entry?.isIntersecting) void load();
            },
            { rootMargin: "450px" }
          )
        : null;

    async function load(focus = false) {
      focusOnAppend ||= focus;
      if (!stream || !more || !status || loading || more.hidden) return;
      loading = true;
      observer?.unobserve(more);
      status.textContent = "Loading artwork…";
      try {
        const url = more.href;
        const response = await fetch(url, { signal: AbortSignal.timeout(15_000) });
        if (!response.ok) throw new Error("Artwork request failed");
        const page = new DOMParser().parseFromString(await response.text(), "text/html");
        const batch = page.querySelector<HTMLElement>("[data-art-batch]");
        if (!batch?.querySelector("figure")) throw new Error("Artwork batch was empty");
        stream.appendChild(batch);
        batch.dispatchEvent(new Event("woodhouse:artwork-added", { bubbles: true }));
        const next = batch.dataset.next;
        if (progress) progress.textContent = batch.dataset.progress ?? "";
        if (next) more.href = next;
        else more.hidden = true;
        if (focusOnAppend) batch.querySelector<HTMLElement>("figure a")?.focus();
        status.textContent = next
          ? "More artwork loaded."
          : "You’ve reached the end of the artwork.";
        if (next) observer?.observe(more);
      } catch {
        status.textContent = "Artwork couldn’t load here. Use More artwork to open the next page.";
        more.dataset.navigate = "";
      } finally {
        loading = false;
        focusOnAppend = false;
      }
    }
    more.addEventListener("click", (event) => {
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        more.dataset.navigate !== undefined
      )
        return;
      event.preventDefault();
      void load(true);
    });
    observer?.observe(more);
  }
</script>

<style>
  .guide-intro {
    margin-block: 1rem;
    max-width: 65ch;
    color: var(--muted);
  }
  .art-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: end;
    margin-block: 0.25rem 0.75rem;
  }
  .art-filter-disclosure,
  .media-formats {
    position: relative;
  }
  summary {
    min-height: 44px;
    align-content: center;
    cursor: pointer;
  }
  .art-filter-fields,
  .media-formats > div {
    position: absolute;
    z-index: 2;
    inset-block-start: 100%;
    inset-inline-end: 0;
    background: var(--ink);
    border: 1px solid var(--line);
    padding: 0.75rem;
    width: min(20rem, 84vw);
    display: grid;
    gap: 0.65rem;
  }
  .media-formats > div a {
    min-height: 32px;
    align-content: center;
  }
  .art-filters label {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .art-filters > label select {
    max-width: min(13rem, 45vw);
  }
  select,
  button {
    min-height: 44px;
    max-width: 100%;
    border: 1px solid var(--line);
    color: var(--paper);
    background: var(--ink);
    padding: 0.45rem 0.55rem;
    font: inherit;
  }
  button {
    cursor: pointer;
  }
  .shuffle-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
  }
  [data-art-batch] + [data-art-batch] {
    margin-top: 1rem;
  }
  .build-kit-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.15rem;
    padding: 0;
    list-style: none;
  }
  .art-pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    color: var(--muted);
  }
  .art-pagination a {
    padding-block: 0.75rem;
  }
  @media (max-width: 600px) {
    .art-filter-disclosure,
    .media-formats {
      position: static;
    }
    .art-filters {
      position: relative;
    }
    .art-filter-fields,
    .media-formats > div {
      inset-inline-end: auto;
      inset-inline-start: 0;
    }
  }
</style>
