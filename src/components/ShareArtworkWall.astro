---
import ShowcaseGallery from "./ShowcaseGallery.astro";
import { buildNotesKit } from "../data/showcase-build-notes";
import { wild25Kit } from "../data/showcase-wild-25";
import { projectStories50Kit } from "../data/showcase-project-stories-50";
import { projectStoriesKit } from "../data/showcase-project-stories";
import { shareNavigation } from "../data/share-browser";
import type { CampaignItem } from "../data/showcase-campaign";

const collectionPacks = {
  "wild-25": { href: wild25Kit, label: "Download Wild 25" },
  "project-stories-50": { href: projectStories50Kit, label: "Download latest 50" },
  "project-stories": { href: projectStoriesKit, label: "Download Project stories kit" }
};
const categories = [
  ["", "All"],
  ["design-studies", "Design studies"],
  ["build-notes", "Build Notes"],
  ["wild-25", "Wild 25"],
  ["project-stories-50", "Latest 50"],
  ["project-stories", "Project stories"],
  ["banner", "Banners"],
  ["icon", "Avatars"],
  ["special", "Special icons"],
  ["sketch", "Sketches"],
  ["seasonal", "Seasonal"],
  ["feature", "Features & milestones"],
  ["comparison", "Comparisons"],
  ["art", "Illustration"],
  ["native", "Current project art"],
  ["earlier", "Earlier artwork"]
] as const;
type Props = {
  works: CampaignItem[];
  sketches: CampaignItem[];
  projects: { slug: string; name: string }[];
};
const { works, sketches, projects } = Astro.props;
const params = Astro.url.searchParams;
const category = categories.find(([key]) => key === params.get("artType"))?.[0] ?? "";
const series =
  category === "design-studies" ||
  category === "build-notes" ||
  category === "wild-25" ||
  category === "project-stories-50" ||
  category === "project-stories"
    ? category
    : undefined;
const requestedProject = params.get("artProject") || params.get("project");
const project = projects.find(({ slug }) => slug === requestedProject)?.slug ?? "";
const labels = [
  ...new Set(
    works.flatMap(({ archived, formats }) =>
      archived ? [] : (formats?.map(({ label }) => label) ?? [])
    )
  )
].sort();
const requestedFormat = params.get("artFormat");
const format = requestedFormat === "Pinterest pin" ? "For Pinterest" : requestedFormat;
const placement = labels.find((label) => label === format) ?? "";
const showShelf = !category && !project && !placement;
const sketchPreview = sketches.slice(0, 4);
const shelfIds = new Set(sketchPreview.map(({ id }) => id));
const art =
  category === "sketch"
    ? [...sketches, ...works.filter(({ use }) => use === "sketch")]
    : showShelf
      ? works.filter(({ id }) => !shelfIds.has(id))
      : works;
const filtered = art.filter(
  (item) =>
    (!project || item.project === project) &&
    (!placement || (!item.archived && item.formats?.some(({ label }) => label === placement))) &&
    (!category ||
      (category === "earlier"
        ? !item.use || item.archived
        : series
          ? !item.archived && item.series === series
          : !item.archived && (category === "sketch" || item.use === category)))
);
const size = 24;
const requested = Number(params.get("artPage") ?? 1);
const pages = Math.max(1, Math.ceil(filtered.length / size));
const page = Number.isSafeInteger(requested) ? Math.max(1, Math.min(requested, pages)) : 1;
const current = filtered.slice((page - 1) * size, page * size);
const drawingShelf = showShelf && page === 1;
const path = (number: number, nextCategory: string = category) => {
  const query = new URLSearchParams();
  if (nextCategory) query.set("artType", nextCategory);
  if (project) query.set("artProject", project);
  if (placement) query.set("artFormat", placement);
  if (number > 1) query.set("artPage", String(number));
  return shareNavigation(`/share/${query.size ? `?${query}` : ""}`, params);
};
const next = page < pages ? path(page + 1) : "";
const previous = page > 1 ? path(page - 1) : "";
const seriesPack =
  series && series in collectionPacks && !project && !placement
    ? collectionPacks[series as keyof typeof collectionPacks]
    : undefined;
const projectPack =
  series === "build-notes" &&
  project &&
  works.some((item) => item.project === project && item.series === series)
    ? buildNotesKit(project)
    : project
      ? works.find((item) => item.project === project && item.socialPack)?.socialPack
      : undefined;
const buildProjects =
  series === "build-notes" && !project
    ? projects.filter(({ slug }) =>
        works.some((item) => item.project === slug && item.series === series)
      )
    : [];
const artworkPages = Object.fromEntries(
  filtered.map(({ id }, i) => [id, Math.floor(i / size) + 1])
);
---

<div id="artwork" data-artwork-wall data-art-pages={JSON.stringify(artworkPages)}>
  <form class="art-filters" action="/share/" aria-label="Filter artwork">
    {category && <input type="hidden" name="artType" value={category} />}
    {params.has("qa") && <input type="hidden" name="qa" value={params.get("qa")} />}
    {params.get("analytics") === "off" && <input type="hidden" name="analytics" value="off" />}
    <label>
      <span>Project</span>
      <select name="artProject">
        <option value="">All projects</option>
        {projects.map(({ slug, name }) => (
          <option value={slug} selected={slug === project}>
            {name}
          </option>
        ))}
      </select>
    </label>
    <label>
      <span>Format</span>
      <select name="artFormat">
        <option value="">All formats</option>
        {labels.map((label) => (
          <option value={label} selected={label === placement}>
            {label}
          </option>
        ))}
      </select>
    </label>
    <button type="submit">Apply</button>
  </form>
  <nav class="art-categories" aria-label="Artwork categories">
    {categories.map(([key, label]) => (
      <a href={path(1, key)} aria-current={category === key ? "page" : undefined}>
        {label}
      </a>
    ))}
  </nav>
  {pages > 1 && (
    <nav class="art-page-links" aria-label="Artwork pages">
      {previous && <a href={`${previous}#artwork`}>Previous page</a>}
      <span>
        Page {page} of {pages}
      </span>
      {next && <a href={`${next}#artwork`}>Next page</a>}
    </nav>
  )}
  {buildProjects.length > 0 && (
    <details class="art-previous">
      <summary>Download project kits</summary>
      <ul class="build-kit-links">
        {buildProjects.map(({ slug, name }) => (
          <li>
            <a href={buildNotesKit(slug)} download>
              {name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
  {seriesPack && (
    <p class="art-previous">
      <a href={seriesPack.href} download>
        {seriesPack.label}
      </a>
    </p>
  )}
  {projectPack && (
    <p class="art-previous">
      <a href={projectPack} download>
        Download project kit
      </a>
    </p>
  )}
  {filtered.length === 0 && (
    <p class="art-empty">
      No artwork matches these filters.{" "}
      <a href={shareNavigation("/share/", params)}>Show all artwork</a>.
    </p>
  )}
  <div data-art-stream>
    <div data-art-batch data-next={next} data-progress={`Page ${page} of ${pages}`}>
      {drawingShelf && sketchPreview.length > 0 ? (
        <>
          <ShowcaseGallery
            items={current.slice(0, 8)}
            compact
            staggered
            showPlacement
            placement={placement}
          />
          <section class="art-sketches" aria-labelledby="art-sketch-title">
            <header>
              <h2 id="art-sketch-title">Sketches &amp; drawings</h2>
              <a href={path(1, "sketch")}>Browse all sketches</a>
            </header>
            <ShowcaseGallery items={sketchPreview} compact staggered eager={false} />
          </section>
          <ShowcaseGallery
            items={current.slice(8)}
            compact
            staggered
            eager={false}
            showPlacement
            placement={placement}
          />
        </>
      ) : (
        <ShowcaseGallery
          items={current}
          compact
          staggered
          eager={page === 1}
          showPlacement
          placement={placement}
        />
      )}
    </div>
  </div>
  <p class="art-pagination">
    <a href={next || undefined} data-art-next hidden={!next}>
      More artwork
    </a>
    <span data-art-progress>
      Page {page} of {pages}
    </span>
    <span data-art-status role="status"></span>
  </p>
</div>

<script>
  for (const wall of document.querySelectorAll<HTMLElement>("[data-artwork-wall]")) {
    const stream = wall.querySelector<HTMLElement>("[data-art-stream]");
    const more = wall.querySelector<HTMLAnchorElement>("[data-art-next]");
    const status = wall.querySelector<HTMLElement>("[data-art-status]");
    const progress = wall.querySelector<HTMLElement>("[data-art-progress]");
    const artworkHash = location.hash.slice(1);
    if (artworkHash && !document.getElementById(artworkHash)) {
      const page = JSON.parse(wall.dataset.artPages ?? "{}")[artworkHash];
      if (Number.isInteger(page) && page > 1) {
        const url = new URL(location.href);
        url.searchParams.set("artPage", String(page));
        location.replace(url.href);
        continue;
      }
    }
    if (!stream || !more || !status || more.hidden) continue;
    let loading = false;
    let focusOnAppend = false;
    const observer =
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            ([entry]) => {
              if (entry?.isIntersecting) void load();
            },
            { rootMargin: "450px" }
          )
        : null;

    async function load(focus = false) {
      focusOnAppend ||= focus;
      if (!stream || !more || !status || loading || more.hidden) return;
      loading = true;
      observer?.unobserve(more);
      status.textContent = "Loading artwork…";
      try {
        const url = more.href;
        const response = await fetch(url, { signal: AbortSignal.timeout(15_000) });
        if (!response.ok) throw new Error("Artwork request failed");
        const page = new DOMParser().parseFromString(await response.text(), "text/html");
        const batch = page.querySelector<HTMLElement>("[data-art-batch]");
        if (!batch?.querySelector("figure")) throw new Error("Artwork batch was empty");
        stream.appendChild(batch);
        batch.dispatchEvent(new Event("woodhouse:artwork-added", { bubbles: true }));
        const next = batch.dataset.next;
        if (progress) progress.textContent = batch.dataset.progress ?? "";
        if (next) more.href = next;
        else more.hidden = true;
        if (focusOnAppend) batch.querySelector<HTMLElement>("figure a")?.focus();
        status.textContent = next
          ? "More artwork loaded."
          : "You’ve reached the end of the artwork.";
        if (next) observer?.observe(more);
      } catch {
        status.textContent = "Artwork couldn’t load here. Use More artwork to open the next page.";
        more.dataset.navigate = "";
      } finally {
        loading = false;
        focusOnAppend = false;
      }
    }
    more.addEventListener("click", (event) => {
      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        more.dataset.navigate !== undefined
      )
        return;
      event.preventDefault();
      void load(true);
    });
    observer?.observe(more);
  }
</script>

<style>
  .art-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: end;
    margin-block: 0.25rem 0.75rem;
  }
  .art-filters label {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  select,
  button {
    min-height: 44px;
    max-width: 100%;
    border: 1px solid var(--line);
    color: var(--paper);
    background: var(--ink);
    padding: 0.45rem 0.55rem;
    font: inherit;
  }
  button {
    cursor: pointer;
  }
  .art-categories {
    display: flex;
    align-items: center;
    gap: 0.2rem 1rem;
    overflow-x: auto;
    white-space: nowrap;
    margin-block-end: 1.1rem;
  }
  .art-categories a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-underline-offset: 0.3em;
  }
  .art-categories a[aria-current="page"] {
    color: var(--acid);
  }
  [data-art-batch] + [data-art-batch] {
    margin-top: 1rem;
  }
  .art-sketches {
    margin-block: 2.5rem;
    padding-block-start: 1rem;
    border-top: 1px solid var(--line);
  }
  .art-sketches header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-block-end: 1rem;
  }
  .art-sketches h2 {
    margin: 0;
  }
  .build-kit-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.15rem;
    list-style: none;
    padding: 0;
    margin-block: 0.65rem;
  }
  .art-page-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-block: 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .art-page-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .art-pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-block: 1.25rem;
    color: var(--muted);
  }
  .art-pagination a {
    min-height: 44px;
    padding-block: 0.75rem;
  }
  .art-empty,
  .art-previous {
    margin-block: 0.75rem 1rem;
  }
  @media (max-width: 550px) {
    .art-filters {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    }
    .art-categories {
      font-size: 0.9rem;
    }
  }
</style>
