---
import type { PublicMenuItem } from "../content/repository";

type Props = {
  links?: PublicMenuItem[];
};

const { links = [] } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div>
      <p class="footer-line">What has shipped. What still needs work.</p>
    </div>
    <a class="text-link" href="/agents/">
      Read project facts <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="site-footer__bottom">
    <a href="/" class="footer-wordmark">
      WOODHOUSE
    </a>
    <span>The Loftwah Software Factory</span>
    <nav aria-label="Footer navigation">
      {links.map((link) => (
        <a
          href={link.url}
          target={link.target}
          rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
