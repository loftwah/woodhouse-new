---
type Props = {
  caption: string;
  image: string;
  /** Bounded source used for clipboard and native-share preparation. Defaults to `image`. */
  shareSource?: string | undefined;
  /**
   * A reviewed asset that always resolves, offered when the project's own image
   * fails. A project can move or remove its published artwork; the desk must
   * still be able to download, copy and share a real file rather than offering a
   * broken one, and must say which asset it handed over.
   */
  fallbackImage?: string | undefined;
  filename?: string;
  link: string;
  label?: string;
  mediaType?: "image" | "video";
};
const {
  caption,
  image,
  shareSource,
  fallbackImage,
  filename = "loftwah-social.jpg",
  link,
  label = "Copy post",
  mediaType = "image"
} = Astro.props;
---

<div
  data-share-actions
  data-image={image}
  data-share-source={shareSource ?? image}
  data-fallback-image={fallbackImage ?? ""}
  data-media-type={mediaType}
  data-filename={filename}
  data-link={link}
>
  <div class="actions">
    <a class="download" href={image} download={filename}>
      Download
    </a>
    <button type="button" data-copy-image hidden>
      Copy image
    </button>
    <button type="button" data-copy hidden>
      {label}
    </button>
    <button type="button" data-device-share hidden>
      Share
    </button>
    <button type="button" data-retry-download hidden>
      Try the download again
    </button>
  </div>
  <p role="status" data-status></p>
  <details>
    <summary>Caption</summary>
    <textarea aria-label="Ready-to-share post" rows="4">{caption}</textarea>
  </details>
</div>
<script>
  import { createOperationIntent } from "../data/operation-intent";
  import {
    clipboardFailureMessage,
    clipboardProblem,
    downloadFailureMessage,
    downloadHandoffMessage,
    downloadReadyMessage,
    withDeadline
  } from "../data/share-feedback";

  const imageDeadline = 20_000;
  const clipboardDeadline = 12_000;
  const textDeadline = 8_000;
  const resetDelay = 4_000;

  for (const root of document.querySelectorAll<HTMLElement>("[data-share-actions]")) {
    const status = root.querySelector<HTMLElement>("[data-status]");
    const text = root.querySelector<HTMLTextAreaElement>("textarea");
    const copy = root.querySelector<HTMLButtonElement>("[data-copy]");
    const copyImage = root.querySelector<HTMLButtonElement>("[data-copy-image]");
    const share = root.querySelector<HTMLButtonElement>("[data-device-share]");
    const download = root.querySelector<HTMLAnchorElement>(".download");
    const retry = root.querySelector<HTMLButtonElement>("[data-retry-download]");
    // The status line belongs to the newest action. A slow response from an
    // older action may update its own button, but it may not replace the
    // status of the action the person is now using.
    const statusIntent = createOperationIntent();
    const say = (message: string, token?: number) => {
      if (token !== undefined && !statusIntent.isCurrent(token)) return;
      if (status) status.textContent = message;
    };
    const absolute = (url: string) => {
      try {
        return new URL(url, location.href).href;
      } catch {
        return url;
      }
    };
    const extensionOf = (url: string) => {
      const match = /\.([a-z0-9]+)(?:[?#]|$)/i.exec(url);
      return match ? `.${match[1]!.toLowerCase()}` : "";
    };
    const primaryImage = root.dataset.image ?? "";
    const primarySource = root.dataset.shareSource ?? primaryImage;
    const fallback = root.dataset.fallbackImage ?? "";
    // Nothing to do when there is no distinct fallback: the local gallery assets
    // are already verified, and probing every control would download them twice.
    const needsResolution = Boolean(fallback) && absolute(fallback) !== absolute(primaryImage);
    let resolvedImage = primaryImage;
    let resolvedSource = primarySource;
    let usedFallback = false;
    let resolution: "pending" | "ready" | "failed" = needsResolution ? "pending" : "ready";
    let settling: Promise<void> | undefined;

    const probe = (url: string) =>
      new Promise<void>((resolve, reject) => {
        const image = new Image();
        const timer = window.setTimeout(() => {
          image.onload = null;
          image.onerror = null;
          image.src = "";
          reject(new Error("Image unavailable"));
        }, 15000);
        image.onload = () => {
          window.clearTimeout(timer);
          resolve();
        };
        image.onerror = () => {
          window.clearTimeout(timer);
          reject(new Error("Image unavailable"));
        };
        image.src = url;
      });

    const showRetry = () => {
      if (retry) retry.hidden = false;
    };
    const hideRetry = () => {
      if (retry) retry.hidden = true;
    };
    const applyResolvedDownload = () => {
      if (!download || resolution !== "ready") return;
      download.href = resolvedImage;
      download.setAttribute(
        "download",
        (root.dataset.filename ?? "loftwah-social.jpg").replace(
          /\.[^.]+$/,
          extensionOf(resolvedImage) || ".jpg"
        )
      );
      download.removeAttribute("aria-disabled");
      delete download.dataset.state;
    };
    const markDownloadFailed = () => {
      if (!download) return;
      download.setAttribute("aria-disabled", "true");
      download.dataset.state = "failed";
      showRetry();
    };
    const resolveImage = () => {
      if (settling) return settling;
      if (!needsResolution) {
        resolution = "ready";
        applyResolvedDownload();
        settling = Promise.resolve();
        return settling;
      }
      settling = probe(primaryImage)
        .catch(() =>
          probe(fallback).then(() => {
            resolvedImage = fallback;
            resolvedSource = fallback;
            usedFallback = true;
          })
        )
        .then(() => {
          resolution = "ready";
        })
        .catch(() => {
          // Neither the project image nor the reviewed fallback answered. The
          // control must not claim a usable file it does not have.
          resolution = "failed";
        })
        .then(applyResolvedDownload);
      return settling;
    };

    const promises: { original?: Promise<Blob> | undefined } = {};
    const load = () =>
      (promises.original ??= resolveImage()
        .then(() => {
          if (resolution === "failed") throw new Error("Image unavailable");
          return fetch(resolvedSource, { signal: AbortSignal.timeout(15000) });
        })
        .then(async (response) => {
          if (!response.ok) throw new Error("Image unavailable");
          const blob = await response.blob();
          if (!blob.size || blob.size > 6 * 1024 * 1024 || !blob.type.startsWith("image/"))
            throw new Error("Unsupported image");
          return blob;
        })
        .catch((error) => {
          promises.original = undefined;
          throw error;
        }));

    if (download)
      download.addEventListener("click", (event) => {
        // A resolved anchor keeps its native download. Everything else is one
        // operation with one owner: a second press joins the first instead of
        // queueing another follow-up click.
        if (resolution === "ready") {
          // The synthetic follow-up click below is part of the operation that
          // already owns the status; it must not announce itself as a new one.
          if (download.dataset.followUp === "true") return;
          say(downloadHandoffMessage(usedFallback), statusIntent.begin());
          return;
        }
        event.preventDefault();
        if (resolution === "failed") {
          const token = statusIntent.begin();
          markDownloadFailed();
          say(downloadFailureMessage(Boolean(fallback)), token);
          return;
        }
        if (download.dataset.pending === "true") {
          // A repeat press acknowledges itself but does not take status away
          // from the operation that is still running.
          say("Still preparing the file. It will download once it is ready.");
          return;
        }
        const token = statusIntent.begin();
        download.dataset.pending = "true";
        download.setAttribute("aria-busy", "true");
        say("Checking the project image…", token);
        resolveImage()
          .then(() => {
            if (resolution === "failed") {
              markDownloadFailed();
              say(downloadFailureMessage(Boolean(fallback)), token);
              return;
            }
            download.dataset.followUp = "true";
            download.click();
            delete download.dataset.followUp;
            say(downloadHandoffMessage(usedFallback), token);
          })
          .finally(() => {
            delete download.dataset.pending;
            download.removeAttribute("aria-busy");
          });
      });

    if (retry)
      retry.addEventListener("click", () => {
        if (retry.dataset.pending === "true") {
          say("Still checking the image…");
          return;
        }
        const token = statusIntent.begin();
        // Retry the project image first. A failed fallback must not become the
        // new primary, or every later attempt would check the same broken file.
        resolution = needsResolution ? "pending" : "ready";
        settling = undefined;
        resolvedImage = primaryImage;
        resolvedSource = primarySource;
        usedFallback = false;
        promises.original = undefined;
        if (download) {
          download.removeAttribute("aria-disabled");
          delete download.dataset.state;
        }
        retry.dataset.pending = "true";
        retry.setAttribute("aria-busy", "true");
        retry.textContent = "Trying again…";
        say("Checking the project image again…", token);
        resolveImage()
          .then(() => {
            if (resolution === "failed") {
              markDownloadFailed();
              say(downloadFailureMessage(Boolean(fallback)), token);
              return;
            }
            const returnFocus = document.activeElement === retry;
            hideRetry();
            applyResolvedDownload();
            if (returnFocus) download?.focus({ preventScroll: true });
            say(downloadReadyMessage(usedFallback), token);
          })
          .finally(() => {
            delete retry.dataset.pending;
            retry.removeAttribute("aria-busy");
            retry.textContent = "Try the download again";
          });
      });

    if (copy && navigator.clipboard?.writeText) {
      copy.hidden = false;
      const idleLabel = copy.textContent?.trim() || "Copy post";
      const labelIntent = createOperationIntent();
      let resetTimer = 0;
      copy.addEventListener("click", async () => {
        if (copy.dataset.pending === "true") {
          say("Still copying the post.");
          return;
        }
        const token = statusIntent.begin();
        const labelToken = labelIntent.begin();
        copy.dataset.pending = "true";
        copy.setAttribute("aria-busy", "true");
        copy.setAttribute("aria-disabled", "true");
        copy.textContent = "Copying…";
        say("Copying the post and link…", token);
        window.clearTimeout(resetTimer);
        try {
          await withDeadline(navigator.clipboard.writeText(text?.value ?? ""), textDeadline);
          if (labelIntent.isCurrent(labelToken)) {
            copy.dataset.state = "copied";
            copy.textContent = "Post copied";
            resetTimer = window.setTimeout(() => {
              if (!labelIntent.isCurrent(labelToken)) return;
              if (copy.dataset.pending === "true") return;
              copy.textContent = idleLabel;
              delete copy.dataset.state;
            }, resetDelay);
          }
          say("Post copied.", token);
        } catch (error) {
          if (labelIntent.isCurrent(labelToken)) {
            copy.textContent = idleLabel;
            delete copy.dataset.state;
          }
          const details = root.querySelector("details");
          if (details) details.open = true;
          // Only take focus when the person is still at this control. A late
          // failure must not pull focus from somewhere they have moved to.
          if (document.activeElement === copy) text?.select();
          say(clipboardFailureMessage(clipboardProblem(error), "post"), token);
        } finally {
          copy.removeAttribute("aria-busy");
          copy.removeAttribute("aria-disabled");
          delete copy.dataset.pending;
        }
      });
    }

    if (
      root.dataset.mediaType !== "video" &&
      copyImage &&
      navigator.clipboard?.write &&
      typeof ClipboardItem !== "undefined"
    ) {
      const png = async () => {
        let blob = await load();
        if (blob.type === "image/png") return blob;
        if (blob.type.startsWith("image/svg+xml")) {
          const document = new DOMParser().parseFromString(await blob.text(), "image/svg+xml");
          const svg = document.documentElement;
          const viewBox = (svg.getAttribute("viewBox") ?? "")
            .trim()
            .split(/[\s,]+/)
            .map(Number);
          const width = viewBox.length === 4 ? viewBox[2]! : Number(svg.getAttribute("width"));
          const height = viewBox.length === 4 ? viewBox[3]! : Number(svg.getAttribute("height"));
          if (
            svg.localName !== "svg" ||
            !Number.isFinite(width) ||
            !Number.isFinite(height) ||
            width <= 0 ||
            height <= 0 ||
            width * height > 16 * 1024 * 1024
          )
            throw new Error("Unsupported SVG dimensions");
          // Preserve the source viewBox's resolution for diagrams with responsive sizing.
          svg.setAttribute("width", String(width));
          svg.setAttribute("height", String(height));
          blob = new Blob([new XMLSerializer().serializeToString(svg)], { type: "image/svg+xml" });
        }
        const objectURL = URL.createObjectURL(blob);
        try {
          const image = new Image();
          image.src = objectURL;
          await image.decode();
          if (!image.naturalWidth || image.naturalWidth * image.naturalHeight > 16 * 1024 * 1024)
            throw new Error("Image too large");
          const canvas = document.createElement("canvas");
          canvas.width = image.naturalWidth;
          canvas.height = image.naturalHeight;
          const context = canvas.getContext("2d");
          if (!context) throw new Error("Image unavailable");
          context.drawImage(image, 0, 0);
          return await new Promise<Blob>((resolve, reject) =>
            canvas.toBlob(
              (result) => (result ? resolve(result) : reject(new Error("Image unavailable"))),
              "image/png"
            )
          );
        } finally {
          URL.revokeObjectURL(objectURL);
        }
      };
      const pngDimensions = async (blob: Blob) => {
        const size = new DataView(await blob.slice(16, 24).arrayBuffer());
        return { width: size.getUint32(0), height: size.getUint32(4) };
      };
      copyImage.hidden = false;
      // The idle label is captured once, so a second copy inside the restore
      // window cannot leave the button reading "Image copied" for ever.
      const idleLabel = copyImage.textContent?.trim() || "Copy image";
      const labelIntent = createOperationIntent();
      let resetTimer = 0;
      copyImage.addEventListener("click", async () => {
        if (copyImage.dataset.pending === "true") {
          say("Still preparing the image. It will copy when it is ready.");
          return;
        }
        const token = statusIntent.begin();
        const labelToken = labelIntent.begin();
        copyImage.dataset.pending = "true";
        copyImage.setAttribute("aria-busy", "true");
        copyImage.setAttribute("aria-disabled", "true");
        copyImage.dataset.state = "preparing";
        copyImage.textContent = "Preparing image…";
        say("Preparing the image for the clipboard…", token);
        window.clearTimeout(resetTimer);
        // Start the clipboard handoff during the click, retaining WebKit
        // activation, then bound the wait so a permission prompt that never
        // answers cannot leave the control busy for ever.
        const imagePromise = withDeadline(png(), imageDeadline);
        imagePromise.catch(() => {});
        try {
          const [, copied] = await withDeadline(
            Promise.all([
              navigator.clipboard.write([new ClipboardItem({ "image/png": imagePromise })]),
              imagePromise
            ]),
            clipboardDeadline
          );
          let dimensions = "";
          try {
            const { width, height } = await pngDimensions(copied);
            dimensions = ` · ${width} × ${height}`;
          } catch {
            /* The copy succeeded even if the PNG header was unexpected. */
          }
          if (labelIntent.isCurrent(labelToken)) {
            copyImage.dataset.state = "copied";
            copyImage.textContent = "Image copied";
            resetTimer = window.setTimeout(() => {
              if (!labelIntent.isCurrent(labelToken)) return;
              if (copyImage.dataset.pending === "true") return;
              copyImage.textContent = idleLabel;
              delete copyImage.dataset.state;
            }, resetDelay);
          }
          say(
            `Image copied${dimensions}${usedFallback ? " · reviewed backup artwork" : ""}. Paste it into your post.`,
            token
          );
        } catch (error) {
          if (labelIntent.isCurrent(labelToken)) {
            copyImage.dataset.state = "failed";
            copyImage.textContent = idleLabel;
          }
          say(clipboardFailureMessage(clipboardProblem(error), "image"), token);
        } finally {
          copyImage.removeAttribute("aria-busy");
          copyImage.removeAttribute("aria-disabled");
          delete copyImage.dataset.pending;
          if (copyImage.dataset.state === "failed") delete copyImage.dataset.state;
        }
      });
    }

    if (
      root.dataset.mediaType !== "video" &&
      share &&
      navigator.share &&
      navigator.canShare &&
      typeof IntersectionObserver !== "undefined"
    ) {
      let prepared: File | undefined;
      let visible = false;
      let sharing = false;
      const observer = new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (!visible) {
          prepared = undefined;
          promises.original = undefined;
          share.hidden = true;
          return;
        }
        load()
          .then((blob) => {
            if (!visible) return;
            const extension = blob.type.includes("png")
              ? "png"
              : blob.type.includes("svg")
                ? "svg"
                : blob.type.includes("webp")
                  ? "webp"
                  : "jpg";
            const file = new File(
              [blob],
              root.dataset.filename!.replace(/\.[^.]+$/, `.${extension}`),
              { type: blob.type }
            );
            prepared = file;
            if (navigator.canShare({ files: [file] })) share.hidden = false;
          })
          .catch(() => {});
      });
      observer.observe(root);
      share.addEventListener("click", async () => {
        if (sharing) {
          say("The share sheet is already open.");
          return;
        }
        if (!prepared) {
          say("The image is still being prepared. Try again in a moment.");
          return;
        }
        const token = statusIntent.begin();
        sharing = true;
        share.setAttribute("aria-busy", "true");
        try {
          await navigator.share({
            files: [prepared],
            text: text?.value ?? "",
            url: root.dataset.link ?? "https://woodhouse.loftwah.com/share/"
          });
          say("Handed to your device’s share options.", token);
        } catch (error) {
          if (error instanceof Error && error.name === "AbortError") {
            say("Share cancelled.", token);
            return;
          }
          say("Sharing is unavailable here. Use Download or Copy image.", token);
        } finally {
          sharing = false;
          share.removeAttribute("aria-busy");
        }
      });
    }
  }
</script>
<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .actions a,
  .actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    font: inherit;
    font-size: 0.85rem;
    color: var(--paper);
    background: transparent;
    text-decoration: none;
    cursor: pointer;
  }
  .actions [hidden] {
    display: none;
  }
  .actions button:disabled,
  .actions [aria-disabled="true"] {
    opacity: 0.6;
    cursor: progress;
  }
  .actions .download {
    background: var(--acid);
    color: var(--ink);
    border-color: var(--acid);
    font-weight: 650;
  }
  [role="status"] {
    margin: 0.4rem 0;
    min-height: 1.3em;
    font-size: 0.85rem;
  }
  summary {
    min-height: 44px;
    padding: 0.5rem 0;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--muted);
  }
  textarea {
    width: 100%;
    resize: vertical;
    min-height: 7rem;
    padding: 0.75rem;
    font: inherit;
    background: var(--surface);
    color: var(--paper);
    border: 1px solid var(--line);
  }
</style>
