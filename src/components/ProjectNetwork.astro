---
import D2Diagram from "./D2Diagram.astro";
---

<div class="project-network-stack" aria-label="Project portfolio and its release gates">
  <D2Diagram
    title="One operator. Different products."
    description="A human operator directs bounded coding-agent work across the named projects. Each product has its own purpose and finish line."
    desktop="/images/diagrams/project-network.svg"
    mobile="/images/diagrams/project-network-mobile.svg"
    caption="The portfolio has distinct products and finish lines; this map does not mark each project's current release state."
    className="project-network-plate"
    priority={true}
  >
    <ol class="diagram-transcript">
      <li>
        <strong>Operator</strong>
        <span>Sets direction, scope and authority.</span>
      </li>
      <li>
        <strong>Coding agents</strong>
        <span>Take bounded, reviewable work across the portfolio.</span>
      </li>
      <li>
        <strong>Bubbles and Fighter</strong>
        <span>Game systems and authored play.</span>
      </li>
      <li>
        <strong>SHOALSHOT and Protocol 11</strong>
        <span>Fishing arcade play and a changing card table.</span>
      </li>
      <li>
        <strong>MAX and Pirates</strong>
        <span>Assistive technology and source-backed reconstruction.</span>
      </li>
      <li>
        <strong>LoftwahFM and Social Club</strong>
        <span>Music and hospitality products.</span>
      </li>
      <li>
        <strong>App Composer</strong>
        <span>Agent-operated environment preparation and independent app composition.</span>
      </li>
      <li>
        <strong>Asset Hunter</strong>
        <span>A public catalogue of what can be made, with rights stated per example.</span>
      </li>
    </ol>
  </D2Diagram>

  <D2Diagram
    title="Review. Qualify. Then release."
    description="One exact candidate passes its owning review and qualification gates before its live production identity is observed. A changed candidate repeats affected checks. Real use, human acceptance and device proof remain separate observations."
    desktop="/images/diagrams/release-path.svg"
    mobile="/images/diagrams/release-path-mobile.svg"
    caption="The owning release gates apply to one exact candidate. A change invalidates affected checks. Deployment and real use establish different claims."
    className="release-path-plate"
  >
    <ol class="diagram-transcript">
      <li>
        <strong>Release candidate</strong>
        <span>One exact version, with known scope.</span>
      </li>
      <li>
        <strong>Review and qualify</strong>
        <span>The owning repository’s required review, checks and reserved decisions apply.</span>
      </li>
      <li>
        <strong>Production</strong>
        <span>Only the approved version reaches people.</span>
      </li>
      <li>
        <strong>Changed candidate</strong>
        <span>Earlier checks no longer qualify the changed state; repeat the affected checks.</span>
      </li>
      <li>
        <strong>Real use</strong>
        <span>Evidence from people and devices is observed separately.</span>
      </li>
    </ol>
  </D2Diagram>
</div>
