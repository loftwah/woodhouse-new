---
import { listPublishedDispatches } from "../content/repository";
import { portfolioEdition } from "../data/portfolio-edition";
const result = await listPublishedDispatches();
const edition = result.error ? null : portfolioEdition(result.dispatches);
const href = edition ? new URL(edition.href, Astro.url.origin) : null;
if (href && Astro.url.searchParams.get("analytics") === "off")
  href.searchParams.set("analytics", "off");
---

{edition && href && (
  <nav class="edition-invitation" aria-label="Current portfolio edition">
    <a class="edition-invitation__main" href={href.pathname + href.search}>
      <strong>{edition.title}</strong>
      <span class="edition-invitation__copy">
        Find your next game, hear the music and take a story with you{"\u00a0"}
        <span aria-hidden="true">↗</span>
      </span>
    </a>
    <a class="edition-invitation__discovery" href={href.pathname + href.search + "#distribution"}>
      See recorded discovery
    </a>
  </nav>
)}
<style>
  .edition-invitation {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 1.1rem 0;
    margin-block: 1rem 2rem;
    border-block: 1px solid var(--line);
    font-size: 0.9rem;
  }
  .edition-invitation__main {
    display: grid;
    align-content: center;
    gap: 0.15rem;
    min-height: 44px;
    color: var(--paper);
    text-decoration: none;
  }
  .edition-invitation__discovery {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--copy-soft);
    border-bottom: 1px solid var(--line-dark);
    text-decoration: none;
  }
  .edition-invitation__main:hover .edition-invitation__copy {
    color: var(--brass);
  }
  .edition-invitation__copy {
    color: var(--copy-soft);
    line-height: 1.5;
  }
  .edition-invitation__copy span {
    color: var(--brass);
  }
  .edition-invitation__discovery:hover {
    color: var(--brass);
    border-color: var(--brass);
  }
  .edition-invitation strong {
    color: var(--acid);
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .edition-invitation {
      align-items: flex-start;
    }
    .edition-invitation__main {
      flex: 1 1 100%;
    }
  }
</style>
