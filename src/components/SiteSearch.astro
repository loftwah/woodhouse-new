---
import SearchResults from "./SearchResults.astro";
import { publicSearchPath } from "../data/public-search";
---

<div class="site-search">
  <a
    class="site-search__trigger"
    href={publicSearchPath}
    data-site-search-open
    aria-label="Search the Woodhouse index"
    aria-keyshortcuts="Meta+K Control+K"
  >
    <span>Search</span>
    <kbd aria-hidden="true">⌘ K</kbd>
  </a>
  <dialog
    class="site-search__dialog"
    id="woodhouse-search"
    aria-labelledby="woodhouse-search-title"
  >
    <div class="site-search__panel">
      <div class="site-search__heading">
        <div>
          <h2 id="woodhouse-search-title">Find a project or subject.</h2>
        </div>
        <button
          class="site-search__close"
          type="button"
          data-site-search-close
          aria-label="Close search"
        >
          ×
        </button>
      </div>
      <label class="site-search__label" for="woodhouse-search-input">
        Search the public record
      </label>
      <input
        id="woodhouse-search-input"
        class="site-search__input"
        type="search"
        maxlength="160"
        placeholder="Try Fighter X header or Creative resources"
        autocomplete="off"
        enterkeyhint="search"
        aria-controls="woodhouse-search-results"
      />
      <p
        class="site-search__status"
        id="woodhouse-search-status"
        role="status"
        aria-live="polite"
      ></p>
      <div class="site-search__content">
        <a href={publicSearchPath} data-search-fallback hidden>
          Open the search page
        </a>
        <SearchResults listId="woodhouse-search-results" />
      </div>
      <p class="site-search__hint">
        <kbd>Esc</kbd> closes search <span aria-hidden="true">·</span> <kbd>⌘ K</kbd> or{" "}
        <kbd>Ctrl K</kbd> opens it
      </p>
    </div>
  </dialog>
</div>

<script>
  import {
    publicSearchPath,
    publicSearchTokens,
    publicSearchWords,
    rankPublicSearch
  } from "../data/public-search";

  function bindSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("#woodhouse-search");
    const input = document.querySelector<HTMLInputElement>("#woodhouse-search-input");
    const status = document.getElementById("woodhouse-search-status");
    const list = document.getElementById("woodhouse-search-results");
    const empty = dialog?.querySelector<HTMLElement>("[data-search-empty]");
    const fallback = dialog?.querySelector<HTMLAnchorElement>("[data-search-fallback]");
    if (
      !dialog ||
      typeof dialog.showModal !== "function" ||
      !input ||
      !status ||
      !list ||
      !empty ||
      !fallback
    )
      return;

    const triggers = [...document.querySelectorAll<HTMLAnchorElement>("[data-site-search-open]")];
    for (const trigger of triggers) {
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-controls", dialog.id);
    }

    let entries: Array<ReturnType<typeof publicSearchWords> & { item: HTMLElement }> | undefined;
    let loading = false;
    let returnFocusTo: HTMLElement | null = null;

    function render() {
      if (!input || !list || !status || !empty || !fallback) return;
      const query = input.value.trim();
      const params = new URLSearchParams();
      if (query) params.set("q", query);
      const source = new URLSearchParams(location.search);
      if (source.get("analytics") === "off") params.set("analytics", "off");
      const qa = source.get("qa");
      if (qa !== null) params.set("qa", qa);
      fallback.href = params.size ? `${publicSearchPath}?${params}` : publicSearchPath;
      if (!entries) return;
      const tokens = publicSearchTokens(query);
      const ranked = rankPublicSearch(entries, tokens);
      const visible = new Set(ranked.map((row) => row.item));
      for (const entry of entries) entry.item.hidden = !visible.has(entry.item);
      for (const entry of ranked) list.appendChild(entry.item);
      empty.hidden = ranked.length !== 0;
      status.textContent = tokens.length
        ? `${ranked.length} ${ranked.length === 1 ? "match" : "matches"}`
        : `${entries.length} pages in the index`;
    }

    async function loadIndex() {
      if (!list || !status || !fallback || entries || loading) return;
      loading = true;
      status.textContent = "Loading the search index…";
      fallback.hidden = true;
      list.setAttribute("aria-busy", "true");
      try {
        const response = await fetch(publicSearchPath, {
          redirect: "error",
          signal: AbortSignal.timeout(8000)
        });
        if (!response.ok) throw new Error("Search index unavailable.");
        const page = new DOMParser().parseFromString(await response.text(), "text/html");
        const index = page.querySelector("[data-public-search-index]");
        if (!index) throw new Error("Search index missing.");
        entries = [...index.querySelectorAll<HTMLElement>("[data-search-item]")].map((item) => ({
          item,
          ...publicSearchWords(
            item.querySelector("strong")?.textContent ?? "",
            item.querySelector("small")?.textContent ?? "",
            item.querySelector("em")?.textContent ?? "",
            item.dataset.searchKeywords,
            item.dataset.searchText
          )
        }));
        list.replaceChildren(...entries.map((entry) => entry.item));
        render();
      } catch {
        status.textContent = "The search index is unavailable.";
        fallback.hidden = false;
      } finally {
        list.removeAttribute("aria-busy");
        loading = false;
      }
    }

    function open(trigger?: HTMLElement) {
      if (!dialog || !input || dialog.open) return;
      const active = document.activeElement;
      returnFocusTo =
        trigger ??
        (active instanceof HTMLElement && active !== document.body ? active : null) ??
        triggers.find((item) => item.getClientRects().length > 0) ??
        document.querySelector<HTMLElement>(".mobile-index > summary");
      dialog.showModal();
      input.value = "";
      render();
      input.focus();
      void loadIndex();
    }

    for (const trigger of triggers) {
      trigger.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.altKey ||
          event.shiftKey
        )
          return;
        event.preventDefault();
        open(trigger);
      });
    }
    dialog.addEventListener("close", () => {
      if (returnFocusTo?.isConnected) returnFocusTo.focus();
      returnFocusTo = null;
    });
    dialog
      .querySelector("[data-site-search-close]")
      ?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    input.addEventListener("input", render);
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && dialog.open) {
          event.preventDefault();
          dialog.close();
        } else if (
          (event.metaKey || event.ctrlKey) &&
          !event.altKey &&
          !event.shiftKey &&
          event.key.toLowerCase() === "k"
        ) {
          event.preventDefault();
          open();
        }
      },
      true
    );
  }

  bindSearch();
</script>

<style>
  .site-search {
    display: flex;
    align-items: center;
  }
  .site-search__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.45rem;
    padding: 0.35rem 0.55rem 0.35rem 0.8rem;
    border: 1px solid var(--line-dark);
    color: #fffaf0;
    background: transparent;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }
  .site-search__trigger:hover,
  .site-search__trigger:focus-visible {
    color: #171812;
    background: var(--acid);
  }
  .site-search__trigger kbd,
  .site-search__hint kbd {
    padding: 0.16rem 0.32rem;
    border: 1px solid currentColor;
    font: 600 0.62rem/1.3 var(--mono);
  }
  .site-search__dialog {
    width: min(46rem, calc(100vw - 2rem));
    max-width: none;
    max-height: min(84dvh, 52rem);
    padding: 0;
    overflow: hidden;
    border: 3px solid var(--paper);
    color: var(--paper);
    background: var(--ink);
    box-shadow: 0 1.5rem 4rem -1.5rem rgba(100, 125, 255, 0.72);
  }
  .site-search__dialog::backdrop {
    background: rgba(3, 6, 13, 0.78);
  }
  .site-search__panel {
    display: grid;
    grid-template-rows: auto auto auto auto minmax(0, 1fr) auto;
    max-height: min(84dvh, 52rem);
    padding: clamp(1rem, 3vw, 1.7rem);
  }
  .site-search__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .site-search__heading h2 {
    max-width: 18ch;
    margin: 0;
    font: 800 clamp(1.5rem, 4vw, 2.2rem)/1 var(--display);
    letter-spacing: -0.03em;
  }
  .site-search__close {
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--paper);
    color: var(--paper);
    background: transparent;
    font: 400 1.6rem/1 var(--sans);
    cursor: pointer;
  }
  .site-search__close:hover {
    color: var(--paper);
    background: var(--signal);
  }
  .site-search__label {
    margin-bottom: 0.35rem;
    font: 700 0.65rem/1.4 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .site-search__input {
    width: 100%;
    min-height: 3.3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line-dark);
    border-radius: 0;
    color: var(--paper);
    background: var(--surface-soft);
    font: 600 1rem/1.3 var(--sans);
  }
  .site-search__input:focus-visible {
    outline: 4px solid var(--signal);
    outline-offset: 2px;
  }
  .site-search__status {
    margin: 0.55rem 0;
    color: var(--copy-soft);
    font-size: 0.7rem;
  }
  .site-search__content {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .site-search__hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0.8rem 0 0;
    color: var(--copy-soft);
    font-size: 0.65rem;
  }
  @media (max-width: 760px) {
    .site-search__trigger {
      display: none;
    }
  }
</style>
