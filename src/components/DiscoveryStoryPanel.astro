---
import type { DiscoveryStory } from "../data/analytics-story";
type Props = {
  story: DiscoveryStory;
  variant?: "focus" | "inline";
  shareHref?: string | undefined;
};
const { story, variant = "inline", shareHref } = Astro.props;
const dateLabel = (date: string) =>
  new Date(date + "T00:00:00Z").toLocaleDateString("en-AU", {
    timeZone: "UTC",
    day: "numeric",
    month: "short",
    year: "numeric"
  });
const headingId =
  variant === "focus" ? "discovery-story-heading" : "discovery-story-inline-heading";
---

<section
  id={variant === "focus" ? "discovery-story" : undefined}
  class:list={["discovery-story", `is-${variant}`]}
  style={`--source:${story.colour}`}
  aria-labelledby={headingId}
>
  <div class="discovery-story__head">
    <p class="discovery-story__kicker">{story.kicker}</p>
    <h2 id={headingId}>
      <span class="discovery-story__name">{story.name}</span>
      {story.value === null ? (
        <span class="discovery-story__figure is-empty">No recorded count</span>
      ) : (
        <>
          <span class="discovery-story__figure">{story.valueLabel}</span>
          <span class="discovery-story__unit">recorded project opens</span>
        </>
      )}
    </h2>
    <p class="discovery-story__headline">{story.headline}</p>
    <p class="discovery-story__actions">
      <a href={`/projects/${story.slug}/`}>
        Read the {story.name} dossier <span aria-hidden="true">↗</span>
      </a>
      {story.siteUrl && (
        <a href={story.siteUrl} rel="noopener">
          Open {story.name} <span aria-hidden="true">↗</span>
        </a>
      )}
      {shareHref && (
        <a class="discovery-story__share" href={shareHref}>
          Share this story
        </a>
      )}
    </p>
  </div>
  <dl class="discovery-story__facts">
    <div>
      <dt>Reporting period</dt>
      <dd>
        {dateLabel(story.period.from)} – {dateLabel(story.period.to)}
        <small>
          UTC · {story.period.days} days ·{" "}
          {story.period.complete ? "closed calendar window" : "current UTC day is partial"}
        </small>
      </dd>
    </div>
    <div>
      <dt>Coverage</dt>
      <dd>
        {story.coverageLabel}
        <small>
          {story.coverage === "partial" && story.firstObserved
            ? `Collection began ${dateLabel(story.firstObserved)}. Earlier days are missing, not zero.`
            : story.coverage === "unavailable"
              ? "No retained referral counter for this destination in these dates."
              : "Every day in these dates has an observed referral counter."}
        </small>
      </dd>
    </div>
    <div>
      <dt>Most recent seven days</dt>
      <dd>
        {story.value === null
          ? "Not measured"
          : (story.recent.value?.toLocaleString("en-AU") ?? "—")}
        <small>
          {story.value === null
            ? "No retained referral counter for this destination"
            : `${dateLabel(story.recent.from)}–${dateLabel(story.recent.to)} · ${story.recent.observedDays} of 7 days observed`}
        </small>
      </dd>
    </div>
    <div>
      <dt>Earlier seven days</dt>
      <dd>
        {story.comparison.eligible
          ? (story.prior.value?.toLocaleString("en-AU") ?? "—")
          : "Not claimed"}
        <small>
          {story.comparison.eligible
            ? `${dateLabel(story.prior.from)}–${dateLabel(story.prior.to)} · ${story.comparison.change === 0 ? "level" : `${story.comparison.change! > 0 ? "up" : "down"} ${Math.abs(story.comparison.change!).toLocaleString("en-AU")}`} ${story.comparison.percent === null ? "clicks" : `(${Math.abs(story.comparison.percent)}%)`}`
            : story.comparison.reason}
        </small>
      </dd>
    </div>
  </dl>
  <p class="discovery-story__establishes">
    <strong>What this establishes.</strong> {story.establishes}
  </p>
  <details class="discovery-story__limits">
    <summary>What it does not establish</summary>
    <p>{story.doesNotEstablish}</p>
    {story.reason && story.coverage !== "partial" && <p>{story.reason}</p>}
    <p>
      A week-on-week comparison needs an exact counter for both complete seven-day windows inside
      the selected dates. Missing days are shown as gaps, never summed as zero.
    </p>
  </details>
</section>

<style>
  .discovery-story {
    --source: #b4c0d2;
    position: relative;
    display: grid;
    gap: 1.1rem;
    margin: 0 0 1.5rem;
    padding: 1.25rem 0 1.4rem;
    border-top: 1px solid var(--source);
    border-bottom: 1px solid var(--line);
  }
  .discovery-story.is-focus {
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border: 1px solid var(--source);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.035), transparent 42%), var(--surface, #0f182a);
  }
  .discovery-story__head {
    display: grid;
    gap: 0.35rem;
    max-width: 76ch;
  }
  .discovery-story__kicker {
    margin: 0;
    font: 600 0.68rem/1.2 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--source);
  }
  .discovery-story h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0;
    font: 700 clamp(1.7rem, 3vw, 2.6rem) / 1 var(--display);
    letter-spacing: -0.03em;
  }
  .discovery-story__name {
    color: var(--paper);
  }
  .discovery-story__figure {
    font-size: clamp(3.4rem, 7vw, 6rem);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    color: var(--source);
  }
  .discovery-story__figure.is-empty {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    letter-spacing: 0;
    color: var(--muted);
  }
  .discovery-story__unit {
    font: 600 0.7rem/1.2 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--copy-soft);
  }
  .discovery-story__headline {
    margin: 0.2rem 0 0;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--copy);
  }
  .discovery-story__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem 1.4rem;
    margin: 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .discovery-story__facts div {
    display: grid;
    gap: 0.2rem;
  }
  .discovery-story__facts dt {
    font: 600 0.61rem/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--copy-soft);
  }
  .discovery-story__facts dd {
    margin: 0;
    font: 650 1rem/1.2 var(--display);
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }
  .discovery-story__facts small {
    display: block;
    margin-top: 0.3rem;
    font: 400 0.7rem/1.45 var(--sans);
    color: var(--muted);
  }
  .discovery-story__establishes {
    margin: 0;
    max-width: 74ch;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--copy);
  }
  .discovery-story__establishes strong {
    color: var(--paper);
  }
  .discovery-story__limits {
    max-width: 74ch;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--copy-soft);
  }
  .discovery-story__limits summary {
    min-height: 44px;
    padding: 0.4rem 0;
    cursor: pointer;
    color: var(--acid);
  }
  .discovery-story__limits p {
    margin: 0.35rem 0;
  }
  .discovery-story__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin: 0;
  }
  .discovery-story__actions a {
    color: var(--acid);
    font-size: 0.83rem;
    font-weight: 600;
    text-decoration: none;
  }
  .discovery-story__actions a:hover,
  .discovery-story__actions a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .discovery-story__share {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--acid);
  }
  @media (max-width: 880px) {
    .discovery-story__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .discovery-story__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
