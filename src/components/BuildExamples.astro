---
import type { WoodhouseProject } from "../content/repository";
type Props = { projects: WoodhouseProject[]; only?: string };
const { projects, only } = Astro.props;
const visible = (slug: string) => (!only || only === slug) && projects.some((p) => p.slug === slug);
---

<div class="build-examples">
  {visible("loftwahfm") && (
    <section class="build-example" aria-labelledby="build-with-music">
      <div>
        <h2 id="build-with-music">Give your game a soundtrack.</h2>
        <p>
          Move the player, trigger a sound effect, then turn on a LoftwahFM station. The game runs
          here; the music comes from FM. Turning music off leaves the game and its effects working.
        </p>
        <p>
          For browser-game builders, the useful part is the player you don’t have to write: a
          versioned client, public stations and a short integration recipe.
        </p>
      </div>
      <div class="build-example__next">
        <figure class="build-example__image">
          <a href="/exhibits/patch-bench/" aria-label="Open the working patch bench exhibit">
            <img
              src="/images/factory-music-demo-20261018.webp"
              alt="The small playable field with separate game sound and FM music controls."
              width="1200"
              height="760"
              loading="lazy"
            />
          </a>
          <figcaption>
            FM / A game here, a soundtrack from LoftwahFM. Captured 18 October 2026.
          </figcaption>
        </figure>
        <a class="home-action" href="/exhibits/patch-bench/">
          Take the bench apart ↗
        </a>
        <a class="text-link" href="https://fm.loftwah.com/game-music">
          Use it in your game ↗
        </a>
        <a class="text-link" href="/dispatches/your-game-its-own-soundtrack/">
          Read the story ↗
        </a>
        <a class="text-link" href="/lab/game-music.html">
          Try the plain standalone demo ↗
        </a>
        <p class="source-note">
          A streaming prototype with public music. It demonstrates the connection, without claiming
          a customer adoption or redistribution rights.
        </p>
      </div>
    </section>
  )}
  {visible("app-composer") && (
    <section class="build-example" aria-labelledby="build-with-apps">
      <div>
        <h2 id="build-with-apps">Build a home from apps you own.</h2>
        <p>
          Here / there collects photos. The owner approves them. Linkarooie chooses which to feature
          and links each photo back to its original. Hide a source and its controlled feature
          disappears too.
        </p>
        <p>
          Try publication and curation with fictional content in the workbench, then open the hosted
          apps. Each keeps its own source, address and data. That’s the point: useful connections
          without turning every piece into one inseparable app.
        </p>
      </div>
      <div class="build-example__next">
        <figure class="build-example__image">
          <a
            href="https://composer.loftwah.com/demo?from=woodhouse-edition"
            aria-label="Open the connected-app example"
          >
            <img
              src="/share/app-composer/composition-workbench-20261023.png"
              alt="Composer’s public demonstration with a fictional guestbook source and a creator page, each with its own publication controls."
              width="1440"
              height="1000"
              loading="lazy"
            />
          </a>
          <figcaption>
            AC / Fictional composition workbench on this device. Captured 23 October 2026.
          </figcaption>
        </figure>
        <a class="home-action" href="https://composer.loftwah.com/demo?from=woodhouse-edition">
          Try the connected apps ↗
        </a>
        <a
          class="text-link"
          href="https://composer.loftwah.com/init?start=composition#starting-point"
        >
          Start your collection ↗
        </a>
        <a class="text-link" href="https://composer.loftwah.com/release">
          See the running versions ↗
        </a>
        <a class="text-link" href="https://composer.loftwah.com/building">
          Read the build story ↗
        </a>
        <a class="text-link" href="/exhibits/source-plate/#contribution-flow">
          Walk the contribution states ↗
        </a>
        <a class="text-link" href="/dispatches/your-apps-should-get-along/">
          Follow the example ↗
        </a>
        <p class="source-note">
          Local workbench actions and hosted records remain separate. Fresh-user setup and WordPress
          migration demonstrations remain unfinished. Downloaded copies of a photo cannot be
          recalled.
        </p>
      </div>
    </section>
  )}
</div>

<style>
  .build-example {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
  }
  .build-example h2 {
    margin: 0 0 1rem;
    font: 700 clamp(1.8rem, 3vw, 2.5rem)/1.1 var(--display);
    letter-spacing: -0.025em;
  }
  .build-example p {
    max-width: 65ch;
    line-height: 1.7;
  }
  .build-example__next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .build-example__next .source-note {
    margin: 0;
  }
  .build-example__image {
    width: 100%;
    margin: 0 0 0.5rem;
  }
  .build-example__image img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .build-example__image figcaption {
    margin-top: 0.6rem;
    color: var(--copy-soft);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .build-example {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 2rem;
    }
  }
</style>
