---
import ShareActions from "./ShareActions.astro";
import CampaignFormats from "./CampaignFormats.astro";
import { socialPlacements } from "../data/social-placements";
import { shareNavigation } from "../data/share-browser";
import type { campaignItems } from "../data/showcase-campaign";
import { campaignResponsiveImage } from "../data/showcase-public";
type Props = {
  items: ReadonlyArray<(typeof campaignItems)[number]>;
  compact?: boolean;
  minimal?: boolean;
  staggered?: boolean;
  eager?: boolean;
  showPlacement?: boolean;
  placement?: string;
};
const {
  items,
  compact = false,
  minimal = false,
  staggered = false,
  eager = true,
  showPlacement = false,
  placement
} = Astro.props;
const containerWidth = "min(calc(100vw - clamp(2.5rem, 8vw, 9rem)), 1440px)";
const imageSizes = (item: (typeof items)[number], index: number) => {
  if (staggered) {
    return `(max-width: 700px) calc((${containerWidth} - .75rem) / 2), (max-width: 999px) calc((${containerWidth} - 2rem) / 3), calc((${containerWidth} - 3rem) / 4)`;
  }
  const single = items.length === 1;
  const mobile =
    single || (compact ? item.width / item.height > 1.3 : index % 4 >= 2)
      ? containerWidth
      : `calc((${containerWidth} - .75rem) / 2)`;
  const desktop = single
    ? item.width / item.height > 1.3
      ? containerWidth
      : `min(${containerWidth}, 44rem)`
    : compact
      ? item.width / item.height > 1.3
        ? `calc((${containerWidth} - 1rem) / 2)`
        : `calc((${containerWidth} - 3rem) / 4)`
      : item.width / item.height > 1.3
        ? `calc((2 * ${containerWidth} - 1.25rem) / 3)`
        : `calc((${containerWidth} - 2.5rem) / 3)`;
  const tablet =
    item.width / item.height > 1.3
      ? `calc((2 * ${containerWidth} - 1.25rem) / 3)`
      : `calc((${containerWidth} - 2.5rem) / 3)`;
  return compact
    ? `(max-width: 700px) ${mobile}, (max-width: 999px) ${tablet}, ${desktop}`
    : `(max-width: 700px) ${mobile}, ${desktop}`;
};
const imageSources = (item: (typeof items)[number]) => {
  if (item.original.startsWith("/share/") || item.video || item.image.startsWith("/share/"))
    return undefined;
  const image = campaignResponsiveImage(item);
  return `${image.thumbnail} ${image.thumbnailWidth}w, ${item.image} ${image.fullWidth}w`;
};
const formatFor = (item: (typeof items)[number]) =>
  item.formats?.find(({ label }) => label === placement) ?? item.formats?.[0];
const downloadFor = (item: (typeof items)[number]) =>
  placement ? (formatFor(item)?.image ?? item.original) : item.original;
const productName = (slug: string) =>
  ({
    bubbles: "Bubbles",
    fighter: "Fighter",
    shoalshot: "SHOALSHOT",
    "protocol-11": "Protocol 11",
    loftwahfm: "LoftwahFM",
    "app-composer": "App Composer",
    woodhouse: "Woodhouse",
    "social-club": "Plans With You",
    "asset-hunter": "Asset Hunter",
    max: "MAX",
    foilbury: "Foilbury",
    liferaft: "Liferaft"
  })[slug] ?? slug;
---

<div
  class:list={["showcase-wall", { "single-work": items.length === 1, compact, staggered }]}
  data-staggered-wall={staggered ? "" : undefined}
>
  {items.map((item, index) => (
    <figure
      id={item.id}
      class:list={["showcase-work", { landscape: item.width / item.height > 1.3 }]}
    >
      <a
        href={item.original}
        class="showcase-image"
        data-open-art={`viewer-${item.id}`}
        aria-label={item.video ? `Play ${item.title}` : `View ${item.title} full size`}
      >
        <img
          src={item.image}
          srcset={imageSources(item)}
          sizes={imageSizes(item, index)}
          width={item.width}
          height={item.height}
          alt={item.alt}
          loading={eager && index < (staggered ? 4 : 3) ? "eager" : "lazy"}
          fetchpriority={eager && index === 0 ? "high" : "auto"}
          decoding="async"
        />
        <span class="view-affordance" aria-hidden="true">
          {item.video ? "Play clip" : "View"}
        </span>
      </a>
      <figcaption class:list={{ "minimal-caption": minimal }}>
        <div class="work-identity">
          <h2>{item.title}</h2>
          <a class="product-action" href={shareNavigation(item.href, Astro.url.searchParams)}>
            {item.action}{" "}
            <span class="action-name">{item.subject ?? productName(item.project)}</span>
          </a>
        </div>
        {!minimal && Boolean(item.versions?.length) && (
          <p class="work-placement">Updated · {1 + (item.versions?.length ?? 0)} versions</p>
        )}
        {showPlacement && formatFor(item) && (
          <p class="work-placement">
            {formatFor(item)?.label} · {formatFor(item)?.width} × {formatFor(item)?.height}
          </p>
        )}
        {!minimal && item.stage && (
          <p class="process-note">
            <strong>{item.stage}</strong> {item.caption.split("\n")[0]}
            {item.issue && (
              <>
                {" "}
                <a href={item.issue}>Planning issue</a>
              </>
            )}
          </p>
        )}
        {!minimal && (
          <ShareActions
            caption={item.caption}
            image={downloadFor(item)}
            shareSource={item.formats ? downloadFor(item) : item.image}
            fallbackImage={item.image}
            filename={downloadFor(item).split("/").pop() ?? `${item.id}.jpg`}
            link={item.href}
            mediaType={item.video ? "video" : "image"}
            presentation="gallery"
          >
            <p class="work-credit">
              {item.kind} · {item.credit} · {item.reviewedAt}
            </p>
            {item.formats && <CampaignFormats formats={item.formats} source={item.source} />}
            {!item.formats && <a href={item.source}>Source</a>}
            {item.socialPack && (
              <a class="collection-link" href={item.socialPack} download>
                Download social pack
              </a>
            )}
            {item.landscapeImage && (
              <a class="collection-link" href={item.landscapeImage} download>
                Download landscape poster
              </a>
            )}
            <a
              class="collection-link"
              href={shareNavigation(`/share/${item.project}/`, Astro.url.searchParams)}
            >
              More {productName(item.project)}
            </a>
          </ShareActions>
        )}
      </figcaption>
      <dialog
        id={`viewer-${item.id}`}
        aria-labelledby={`viewer-title-${item.id}`}
        class="art-viewer"
      >
        <div class="viewer-toolbar">
          <h2 id={`viewer-title-${item.id}`}>{item.title}</h2>
          <div class="viewer-tools">
            <nav aria-label="Browse artwork" data-viewer-navigation hidden>
              <button type="button" data-viewer-step="-1" aria-label="Previous artwork">
                ‹
              </button>
              <button type="button" data-viewer-step="1" aria-label="Next artwork">
                ›
              </button>
            </nav>
            {Boolean(item.versions?.length) && (
              <button type="button" data-viewer-compare>
                Compare
              </button>
            )}
            <form method="dialog">
              <button aria-label="Close image viewer">Close</button>
            </form>
          </div>
        </div>
        {item.video ? (
          <video
            controls
            playsinline
            preload="none"
            poster={item.image}
            width={item.width}
            height={item.height}
            aria-label={item.title}
          >
            <source src={item.video} type="video/mp4" />
            <track
              kind="captions"
              src={item.video.replace(/\.mp4$/, ".vtt")}
              srclang="en"
              label="Sound captions"
            />
            <a href={item.video}>Download clip</a>
          </video>
        ) : (
          <img
            src={item.image}
            data-viewer-original={item.original}
            data-viewer-preview={item.image}
            loading="lazy"
            alt={item.alt}
            width={item.width}
            height={item.height}
          />
        )}
        <div class="viewer-caption">
          <p role="status" data-viewer-status></p>
          <p>
            {item.stage && <strong>{item.stage} · </strong>}
            {item.issue ? item.caption.split("\n")[0] : item.caption}
          </p>
          {item.issue && (
            <p>
              <a href={item.issue}>Planning issue</a>
            </p>
          )}
          <p class="work-credit">
            {item.kind} · {item.credit} · {item.reviewedAt}
          </p>
          {item.formats && <CampaignFormats formats={item.formats} source={item.source} />}
          {!item.formats && <a href={item.source}>Source</a>}
          {item.formats &&
            socialPlacements.some(({ format }) =>
              item.formats?.some(({ label }) => label === format)
            ) && (
              <a
                href={shareNavigation(
                  `/share/preview/?${new URLSearchParams({
                    art: item.id,
                    platform: socialPlacements.find(({ format }) =>
                      item.formats?.some(({ label }) => label === format)
                    )!.id
                  })}`,
                  Astro.url.searchParams
                )}
              >
                Preview social placement
              </a>
            )}
          {item.versions?.map((version) => (
            <details class="viewer-comparison">
              <summary>Compare with {version.label.toLowerCase()}</summary>
              <div class="comparison-pair">
                <figure>
                  <img
                    src={item.image}
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                  />
                  <figcaption>
                    Original ·{" "}
                    <a href={item.original} download>
                      Download
                    </a>
                  </figcaption>
                </figure>
                <figure>
                  <img
                    src={version.image}
                    alt={`${item.title} — ${version.label}`}
                    width={version.width}
                    height={version.height}
                    loading="lazy"
                  />
                  <figcaption>
                    {version.label} ·{" "}
                    <a href={version.image} download>
                      Download
                    </a>
                  </figcaption>
                </figure>
              </div>
              <p>
                {version.note} · {version.width} × {version.height} ·{" "}
                <a href={version.source}>Source notes</a>
              </p>
            </details>
          ))}
          <div class="viewer-actions">
            <a class="product-action" href={shareNavigation(item.href, Astro.url.searchParams)}>
              {item.action} {item.subject ?? productName(item.project)}
            </a>
            <a href={item.original} data-viewer-download download>
              {item.video ? "Download clip" : "Download original"}
            </a>
            <ShareActions
              caption={item.caption}
              image={item.original}
              shareSource={item.formats ? item.original : item.image}
              fallbackImage={item.image}
              filename={item.original.split("/").pop() ?? `${item.id}.jpg`}
              link={item.href}
              mediaType={item.video ? "video" : "image"}
              presentation="copy"
            />
            <a href={shareNavigation(`/share/${item.project}/`, Astro.url.searchParams)}>
              Project gallery
            </a>
          </div>
        </div>
      </dialog>
    </figure>
  ))}
</div>
<script>
  function bindGallery(scope: Document | HTMLElement) {
    if ("ResizeObserver" in window) {
      for (const wall of scope.querySelectorAll<HTMLElement>("[data-staggered-wall]")) {
        const works = [...wall.querySelectorAll<HTMLElement>(":scope > figure")];
        const fit = (work: HTMLElement) => {
          const rows = Math.ceil((work.offsetHeight + 24) / 8);
          work.style.setProperty("--work-rows", String(rows));
        };
        for (const work of works) fit(work);
        wall.dataset.staggeredReady = "";
        const observer = new ResizeObserver((entries) => {
          for (const { target } of entries) {
            if (target instanceof HTMLElement) fit(target);
          }
        });
        for (const work of works) observer.observe(work);
      }
    }
    for (const link of scope.querySelectorAll<HTMLAnchorElement>("[data-open-art]")) {
      const dialog = document.getElementById(link.dataset.openArt ?? "");
      if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== "function")
        continue;
      const navigation = dialog.querySelector<HTMLElement>("[data-viewer-navigation]");
      const buttons = [...dialog.querySelectorAll<HTMLButtonElement>("[data-viewer-step]")];
      const adjacent = (step: number) => {
        const collection = link.closest("[data-art-stream]") ?? link.closest(".showcase-wall");
        const works = [
          ...(collection?.querySelectorAll<HTMLAnchorElement>("[data-open-art]") ?? [])
        ];
        return works[works.indexOf(link) + step];
      };
      const browse = (step: number) => {
        const next = adjacent(step);
        if (!next) return;
        dialog.close();
        next.click();
      };
      for (const button of buttons) {
        button.addEventListener("click", () => browse(Number(button.dataset.viewerStep)));
      }
      dialog.querySelector("[data-viewer-compare]")?.addEventListener("click", () => {
        const comparison = dialog.querySelector<HTMLDetailsElement>(".viewer-comparison");
        if (!comparison) return;
        comparison.open = true;
        comparison.querySelector<HTMLElement>("summary")?.focus();
        comparison.scrollIntoView({ block: "center" });
      });
      dialog.addEventListener("keydown", (event) => {
        if (
          event.defaultPrevented ||
          (event.target instanceof Element &&
            event.target.closest("video, input, select, textarea, [contenteditable]")) ||
          event.altKey ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey
        )
          return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        browse(event.key === "ArrowLeft" ? -1 : 1);
      });
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0)
          return;
        event.preventDefault();
        for (const button of buttons) {
          button.disabled = !adjacent(Number(button.dataset.viewerStep));
        }
        if (navigation) navigation.hidden = buttons.every((button) => button.disabled);
        dialog.showModal();
        dialog.querySelector<HTMLElement>('[aria-label="Close image viewer"]')?.focus();
        const image = dialog.querySelector<HTMLImageElement>("[data-viewer-original]");
        const status = dialog.querySelector<HTMLElement>("[data-viewer-status]");
        if (image?.dataset.viewerOriginal && image.dataset.originalLoaded !== "true") {
          if (status) status.textContent = "Loading original image…";
          image.onload = () => {
            image.dataset.originalLoaded = "true";
            if (status) status.textContent = "Original image loaded.";
          };
          image.onerror = () => {
            image.onload = null;
            image.onerror = null;
            if (image.dataset.viewerPreview) image.src = image.dataset.viewerPreview;
            const download = dialog.querySelector<HTMLAnchorElement>("[data-viewer-download]");
            if (download && image.dataset.viewerPreview) {
              download.href = image.dataset.viewerPreview;
              download.textContent = "Download gallery preview";
            }
            if (status)
              status.textContent =
                "The original image is unavailable. Showing the gallery preview.";
          };
          image.src = image.dataset.viewerOriginal;
        }
      });
      let gesture: { x: number; y: number } | undefined;
      dialog.addEventListener("pointerdown", (event) => {
        if (
          event.pointerType === "touch" &&
          event.target instanceof Element &&
          event.target.matches("img[data-viewer-original]")
        )
          gesture = { x: event.clientX, y: event.clientY };
      });
      dialog.addEventListener("pointercancel", () => {
        gesture = undefined;
      });
      dialog.addEventListener("pointerup", (event) => {
        if (!gesture || event.pointerType !== "touch") return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        gesture = undefined;
        if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.5) browse(dx > 0 ? -1 : 1);
      });
      dialog.addEventListener("close", () => {
        dialog.querySelector("video")?.pause();
        if (!document.querySelector(".art-viewer[open]")) {
          link.focus({ preventScroll: true });
          link.scrollIntoView({ block: "nearest", inline: "nearest" });
        }
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          dialog.close();
      });
    }
  }
  bindGallery(document);
  document.addEventListener("woodhouse:artwork-added", ({ target }) => {
    if (target instanceof HTMLElement) bindGallery(target);
  });
</script>
<style>
  .minimal-caption .product-action {
    display: none;
  }
  .minimal-caption h2 {
    font-size: clamp(0.85rem, 1.3vw, 1.05rem);
  }

  .art-viewer video {
    display: block;
    object-fit: contain;
    width: 100%;
    height: auto;
    max-height: 70dvh;
    background: var(--ink);
  }
  .viewer-comparison {
    border-block-start: 1px solid var(--line);
    margin-block: 0.75rem;
  }
  .viewer-comparison summary,
  .viewer-comparison a {
    align-content: center;
    min-height: 44px;
  }
  .viewer-comparison summary {
    cursor: pointer;
  }
  .comparison-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .comparison-pair figure {
    min-width: 0;
    margin: 0;
  }
  .art-viewer .comparison-pair img {
    width: 100%;
    height: clamp(7rem, 28vw, 20rem);
    object-fit: contain;
  }
  .art-viewer .comparison-pair a {
    display: inline-block;
  }

  .showcase-wall {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
    align-items: start;
  }
  @media (min-width: 1000px) {
    .showcase-wall.compact {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }
  }
  .showcase-work {
    grid-column: span 2;
    min-width: 0;
    margin: 0;
    scroll-margin-top: 1rem;
  }
  .showcase-work.landscape {
    grid-column: span 4;
  }
  .single-work .showcase-work {
    grid-column: 1 / -1;
  }
  .single-work .showcase-work:not(.landscape) {
    max-width: 44rem;
    width: 100%;
    margin-inline: auto;
  }
  .showcase-image {
    display: block;
    position: relative;
    background: var(--surface);
  }
  .showcase-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .view-affordance {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.2rem 0.65rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
  }
  figcaption {
    padding-top: 0.65rem;
  }
  .work-identity {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.35rem 1rem;
  }
  .work-identity h2 {
    font: 600 clamp(1.05rem, 1.6vw, 1.5rem)/1.15 var(--display);
    letter-spacing: -0.025em;
    margin: 0;
  }
  .product-action {
    gap: 0.25em;
    min-width: 44px;
    color: var(--acid);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 650;
  }
  .work-placement {
    margin: 0.25rem 0 0.45rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .work-credit {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .collection-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 0.85rem;
  }
  .art-viewer {
    width: min(1200px, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--line);
    color: var(--paper);
    background: var(--ink);
    overflow: auto;
  }
  .art-viewer::backdrop {
    background: rgb(0 0 0 / 88%);
  }
  .art-viewer > img {
    touch-action: pan-y pinch-zoom;
    display: block;
    width: 100%;
    height: auto;
    max-height: 72dvh;
    object-fit: contain;
  }
  .viewer-toolbar {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    background: var(--ink);
    border-block-end: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
  }
  .viewer-toolbar h2 {
    font: 600 1.25rem/1.2 var(--display);
    margin: 0;
  }
  .viewer-tools,
  [data-viewer-navigation]:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  [data-viewer-step] {
    min-width: 44px;
    font-size: 1.25rem;
  }
  .viewer-toolbar button:disabled {
    color: var(--muted);
    opacity: 0.45;
    cursor: default;
  }
  .viewer-toolbar button {
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--paper);
    cursor: pointer;
  }
  .viewer-caption {
    padding: 0 1rem 1rem;
  }
  .viewer-caption p {
    margin-block: 0.5rem;
    max-width: 75ch;
  }
  .viewer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.5rem;
    align-items: center;
  }
  .viewer-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 700px) {
    .showcase-wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.4rem 0.75rem;
    }
    .showcase-work,
    .showcase-work.landscape {
      grid-column: span 1;
    }
    .showcase-work:nth-child(4n),
    .showcase-work:nth-child(4n - 1) {
      grid-column: 1 / -1;
    }
    .showcase-wall.compact .showcase-work {
      grid-column: span 1;
    }
    .showcase-wall.compact .showcase-work.landscape {
      grid-column: 1 / -1;
    }
    .showcase-wall.compact .action-name {
      display: inline;
    }
    .work-identity {
      display: block;
    }
    .work-identity h2 {
      font-size: 1.1rem;
    }
    .product-action {
      font-size: 0.8rem;
    }
    .action-name {
      display: none;
    }
    .view-affordance {
      right: 0.35rem;
      bottom: 0.35rem;
      font-size: 0.7rem;
      padding: 0.15rem 0.4rem;
    }
    .art-viewer {
      width: calc(100% - 1rem);
      max-height: calc(100dvh - 1rem);
    }
    .viewer-toolbar {
      gap: 0.5rem;
      padding-inline: 0.6rem;
    }
    .viewer-toolbar h2 {
      font-size: 1.05rem;
    }
    .viewer-toolbar {
      flex-wrap: wrap;
    }
  }
  .showcase-wall.staggered {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0.75rem;
  }
  .showcase-wall.staggered > .showcase-work,
