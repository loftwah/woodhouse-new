---
type Props = { compact?: boolean; availablePack?: boolean };
const { compact = false, availablePack = true } = Astro.props;
---

<section class:list={["edition-share-kit", { compact }]} aria-labelledby="edition-kit-title">
  <div class="kit-heading">
    <h2 id="edition-kit-title">Take a round with you.</h2>
    {!compact && (
      <p>
        A film to watch, artwork to post and the edition’s original frozen observations. Each file
        comes with its matching caption and a useful way back.
      </p>
    )}
    <div class="kit-links">
      {availablePack && (
        <a href="/share/one-more-round/one-more-round-edition-pack.zip" download>
          Download the edition pack
        </a>
      )}
      {!compact && <a href="/share/?type=edition">Browse images & films</a>}
    </div>
    <p class="kit-note">
      Campaign artwork and films make an invitation. Frozen report cards retain their 12–18 October
      2026 UTC source limits.
    </p>
  </div>
  {!compact && (
    <figure>
      <video
        controls
        playsinline
        preload="none"
        poster="/share/one-more-round/film-landscape.jpg"
        width="1920"
        height="1080"
        aria-label="One more round: edition film"
      >
        <source src="/share/one-more-round/one-more-round-landscape.mp4" type="video/mp4" />
        <track
          kind="captions"
          src="/share/one-more-round/one-more-round.vtt"
          srclang="en"
          label="English descriptions"
        />
        <a href="/share/one-more-round/one-more-round-landscape.mp4">Download the film</a>
      </video>
      <figcaption>
        Real product moments, with the source dates visible. Music: Pixel Box Theory by Loftwah.{" "}
        <a href="/share/one-more-round/credits.txt">Credits & transcript</a>
      </figcaption>
    </figure>
  )}
</section>
<style>
  .edition-share-kit {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    margin-block: 2rem;
  }
  .edition-share-kit.compact {
    display: block;
    border: 0;
    padding-top: 0;
    margin-top: 0;
  }
  .compact .kit-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
  }
  .compact h2 {
    font-size: 1.65rem;
    margin: 0;
  }
  .compact .kit-note {
    grid-column: 1 / -1;
    margin: 0.3rem 0 0;
    max-width: none;
  }
  h2 {
    font-family: var(--display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    margin: 0 0 1rem;
  }
  p {
    max-width: 55ch;
  }
  .kit-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .kit-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .kit-links a:first-child {
    background: var(--acid);
    color: var(--ink);
    padding: 0.65rem 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .kit-note,
  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    background: var(--ink);
  }
  figcaption {
    margin-top: 0.75rem;
  }
  @media (max-width: 760px) {
    .compact .kit-heading {
      grid-template-columns: 1fr;
    }
    .compact .kit-note {
      font-size: 0.8rem;
    }
    .edition-share-kit {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
