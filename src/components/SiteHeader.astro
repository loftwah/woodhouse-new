---
import type { PublicMenuItem } from "../content/repository";
import {
  isCurrentDestination,
  withActivityNavigation,
  withDestinationLabels
} from "../data/navigation";

type Props = {
  currentPath?: string;
  links?: PublicMenuItem[];
  houseIndexLinks?: PublicMenuItem[];
};

const { currentPath = "/", links = [], houseIndexLinks = [] } = Astro.props;
const shareUrl = "/share/";
const primary = withDestinationLabels(links);
const houseIndex = withDestinationLabels(houseIndexLinks);

function withShareFallback(items: PublicMenuItem[], label: string): PublicMenuItem[] {
  return items.some((item) => isCurrentDestination(item.url, shareUrl))
    ? items
    : [{ label, url: shareUrl }, ...items];
}

const desktopLinks = withShareFallback(withActivityNavigation(primary), "Share");
// The phone Index is primary plus the secondary CMS group. Normalising the
// combined list keeps one Leaderboards entry beside Analytics and removes a
// destination that an editor has added to both menus.
const mobileLinks = withShareFallback(
  withActivityNavigation([...primary, ...houseIndex]),
  "Share desk"
);
---

<a class="skip-link" href="#main-content">
  Skip to the work
</a>
<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__brand">
      <slot name="brand" />
    </div>
    <div class="site-header__tools">
      <nav class="desktop-nav" aria-label="Main navigation">
        {desktopLinks.map((link) => (
          <a
            href={link.url}
            target={link.target}
            rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
            aria-current={isCurrentDestination(currentPath, link.url) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <slot />
      <details class="mobile-index">
        <summary aria-label="Open the navigation">
          <span class="navigation-more">More</span>
          <span class="navigation-menu">Menu</span>
          <span class="mobile-index__glyph" aria-hidden="true">
            ＋
          </span>
        </summary>
        <nav aria-label="More Woodhouse pages">
          <button
            class="mobile-index__search"
            type="button"
            data-site-search-open
            aria-haspopup="dialog"
            aria-controls="woodhouse-search"
            aria-keyshortcuts="Meta+K Control+K"
          >
            Search Woodhouse <kbd>⌘ K</kbd>
          </button>
          {mobileLinks.map((link) => (
            <a
              href={link.url}
              target={link.target}
              rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
              aria-current={isCurrentDestination(currentPath, link.url) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .navigation-menu {
    display: none;
  }
  .mobile-index__search {
    display: none;
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.8rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: #fffaf0;
    background: transparent;
    font: 700 0.75rem/1.3 var(--sans);
    text-align: left;
    cursor: pointer;
  }
  .mobile-index__search kbd {
    float: right;
    font: 600 0.62rem/1.3 var(--mono);
  }
  .mobile-index__search:hover,
  .mobile-index__search:focus-visible {
    color: #171812;
    background: var(--acid);
  }
  @media (max-width: 760px) {
    .navigation-more {
      display: none;
    }
    .navigation-menu {
      display: inline;
    }
    .mobile-index__search {
      display: block;
    }
  }
</style>
