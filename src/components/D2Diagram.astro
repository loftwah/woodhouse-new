---
import diagramSizes from "../data/diagram-sizes.json";

const sizes: Record<string, { width: number; height: number }> = diagramSizes;

type Props = {
  title: string;
  description: string;
  desktop: string;
  mobile: string;
  id?: string;
  caption?: string;
  className?: string;
  priority?: boolean;
};

const {
  title,
  description,
  desktop,
  mobile,
  id,
  caption,
  className = "",
  priority = false
} = Astro.props;
const hasTranscript = Astro.slots.has("default");
const sizeOf = (src: string) => sizes[src.replace(/^.*\//, "").replace(/\.svg$/, "")];
const desktopSize = sizeOf(desktop);
const mobileSize = sizeOf(mobile);
const style =
  desktopSize && mobileSize
    ? `--d2-ratio:${desktopSize.width}/${desktopSize.height};--d2-mobile-ratio:${mobileSize.width}/${mobileSize.height};`
    : undefined;
---

<figure id={id} class={`d2-diagram ${className}`} style={style}>
  <picture>
    <source media="(max-width: 760px)" srcset={mobile} />
    <img
      src={desktop}
      alt={description}
      width={desktopSize?.width}
      height={desktopSize?.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
  <figcaption>
    <div class="d2-diagram__caption">
      <strong>{title}</strong>
      {caption && <span>{caption}</span>}
      <a
        class="d2-diagram__source"
        href={desktop.replace("/images/diagrams/", "/diagrams/").replace(".svg", ".d2")}
      >
        View the diagram source <span aria-hidden="true">↗</span>
      </a>
    </div>
    {hasTranscript && (
      <details class="d2-diagram__transcript">
        <summary>Read the diagram in text</summary>
        <slot />
      </details>
    )}
  </figcaption>
</figure>
