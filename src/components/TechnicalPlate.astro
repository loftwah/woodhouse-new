---
import D2Diagram from "./D2Diagram.astro";

type Step = { label: string; title: string; detail: string };
type Props = {
  id: string;
  number: string;
  title: string;
  note: string;
  variant: "flow" | "loop" | "ladder";
  diagram?: string;
  steps: Step[];
};

const { id, number, title, note, variant, diagram, steps } = Astro.props;
const source = diagram ?? (variant === "loop" ? "failure-loop" : variant === "ladder" ? "evidence-ladder" : "factory-flow");
const base = `/images/diagrams/${source}`;
---
<D2Diagram
  title={title}
  description={note}
  desktop={`${base}.svg`}
  mobile={`${base}-mobile.svg`}
  caption={note}
  className={`technical-plate technical-plate--${variant}`}
>
  <ol class="technical-plate__steps" aria-label={`Diagram ${number}: ${title}`}>
    {steps.map((step) => <li><strong>{step.label} · {step.title}</strong><span>{step.detail}</span></li>)}
  </ol>
</D2Diagram>
