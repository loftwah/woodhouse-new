---
type Step = { label: string; title: string; detail: string };
type Props = {
  id: string;
  number: string;
  title: string;
  note: string;
  variant: "flow" | "loop" | "ladder";
  steps: Step[];
};

const { id, number, title, note, variant, steps } = Astro.props;
const ladder = variant === "ladder";
const cardWidth = 205;
const gap = 30;
const startX = (1200 - (steps.length * cardWidth + (steps.length - 1) * gap)) / 2;
const positions = steps.map((_, index) => ({
  x: startX + index * (cardWidth + gap),
  y: ladder ? 76 + index * 76 : 156
}));
const viewHeight = ladder ? 590 : 440;
---
<figure class={`technical-plate technical-plate--${variant}`} aria-labelledby={`${id}-heading`}>
  <header class="technical-plate__header">
    <span>PLATE {number}</span>
    <h2 id={`${id}-heading`}>{title}</h2>
    <span>28.09.26</span>
  </header>
  <svg class="technical-plate__canvas" viewBox={`0 0 1200 ${viewHeight}`} role="img" aria-labelledby={`${id}-title ${id}-description`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-description`}>{note}</desc>
    <defs>
      <pattern id={`${id}-grid`} width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0V24" fill="none" stroke="#58635a" stroke-opacity=".26" stroke-width=".55" />
      </pattern>
      <marker id={`${id}-arrow`} markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M0 0L8 4.5 0 9" fill="none" stroke="#c6a96a" stroke-width="1.2" />
      </marker>
    </defs>
    <rect x="1" y="1" width="1198" height={viewHeight - 2} fill={`url(#${id}-grid)`} stroke="#5d655d" stroke-width="1" />
    <text x="42" y="48" class="technical-plate__eyebrow">LOFTWAH SOFTWARE FACTORY · {title.toUpperCase()}</text>

    {ladder ? (
      <>
        <path d={`M82 ${positions[0].y + 18}V${positions[positions.length - 1].y + 37}`} fill="none" stroke="#c6a96a" stroke-width="1.5" marker-end={`url(#${id}-arrow)`} />
        {steps.map((step, index) => {
          const position = positions[index];
          return (
            <g class="technical-plate__node technical-plate__node--ladder">
              <rect x="112" y={position.y} width="1046" height="54" rx="2" />
              <text x="136" y={position.y + 23} class="technical-plate__step-label">{step.label.toUpperCase()}</text>
              <text x="410" y={position.y + 23} class="technical-plate__ladder-title">{step.title}</text>
              <text x="750" y={position.y + 23} class="technical-plate__detail">{step.detail}</text>
              <text x="1138" y={position.y + 23} class="technical-plate__step-no" text-anchor="end">0{index + 1}</text>
            </g>
          );
        })}
        <text x="112" y={viewHeight - 33} class="technical-plate__footer">NOT EVERY OUTCOME REACHES EVERY STATE</text>
      </>
    ) : (
      <>
        {steps.slice(0, -1).map((_, index) => {
          const current = positions[index];
          const next = positions[index + 1];
          return <path d={`M${current.x + cardWidth + 5} 228H${next.x - 8}`} fill="none" stroke="#c6a96a" stroke-width="2" marker-end={`url(#${id}-arrow)`} />;
        })}
        {steps.map((step, index) => {
          const position = positions[index];
          return (
            <g class="technical-plate__node">
              <rect x={position.x} y={position.y} width={cardWidth} height="144" rx="2" />
              <text x={position.x + 17} y={position.y + 24} class="technical-plate__step-label">{step.label.toUpperCase()}</text>
              <text x={position.x + 17} y={position.y + 70} class="technical-plate__title">{step.title}</text>
              <text x={position.x + 17} y={position.y + 104} class="technical-plate__detail">{step.detail}</text>
            </g>
          );
        })}
        {variant === "loop" ? (
          <>
            <path d={`M${positions[positions.length - 1].x + cardWidth / 2} 330C${positions[positions.length - 1].x + cardWidth / 2} 418 ${positions[0].x + cardWidth / 2} 418 ${positions[0].x + cardWidth / 2} 330`} fill="none" stroke="#9c5b4c" stroke-width="1.8" stroke-dasharray="6 5" marker-end={`url(#${id}-arrow)`} />
            <text x="600" y="380" class="technical-plate__footer" text-anchor="middle">THE CONTROL TRAVELS WITH THE LESSON</text>
          </>
        ) : <text x="42" y="385" class="technical-plate__footer">A HANDOFF CHANGES WHO WORKS, NOT WHO OWNS THE OUTCOME.</text>}
      </>
    )}
  </svg>
  <ol class="technical-plate__steps">
    {steps.map((step) => <li><strong>{step.label} · {step.title}</strong><span>{step.detail}</span></li>)}
  </ol>
  <figcaption>{note}</figcaption>
</figure>
