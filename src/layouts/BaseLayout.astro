---
import "../styles/global.css";
import MeasurementNavigation from "../components/MeasurementNavigation.astro";
import AudienceTelemetry from "../components/AudienceTelemetry.astro";
import BrandMark from "../components/BrandMark.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteSearch from "../components/SiteSearch.astro";
import { getSeoMeta, getSiteSettings } from "emdash";
import type { SeoContentInput } from "emdash/seo";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import { getPublicMenu, listProjectRecords, listPublicSearchItems } from "../content/repository";
import { portfolioReadout } from "../data/portfolio";
import { formatReviewDate } from "../data/review-date";

type Props = {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  fallbackImage?: string | undefined;
  currentPath?: string;
  type?: "website" | "article";
  pageType?: string;
  publishedAt?: string | undefined;
  modifiedAt?: string | undefined;
  authorName?: string;
  contentRef?: { collection: string; id: string; slug?: string | null };
  contentSeo?: SeoContentInput<unknown> | undefined;
  ogTitle?: string;
  robots?: string;
  noindex?: boolean;
  analyticsWorkbench?: boolean;
};

const {
  title,
  description,
  path,
  image = "/og/woodhouse-workshop-20261018.jpg",
  imageAlt: suppliedImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  fallbackImage,
  currentPath: suppliedCurrentPath,
  type = "website",
  pageType,
  publishedAt,
  modifiedAt,
  authorName = "Dean Lofts",
  contentRef,
  contentSeo: contentSeoInput,
  ogTitle,
  robots,
  noindex = false
} = Astro.props;
// Use the real pathname rather than the canonical `path`; a leaderboard or
// saved report carries a query string that would defeat aria-current matching.
const currentPath = suppliedCurrentPath ?? Astro.url.pathname;
const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || "WOODHOUSE";
const titleSeparator = siteSettings.seo?.titleSeparator || " — ";
const templateTitle =
  title === siteTitle
    ? `${siteTitle}${titleSeparator}The Loftwah Software Factory`
    : `${title}${titleSeparator}${siteTitle}`;
const siteUrl = Astro.site ?? new URL("https://woodhouse.loftwah.com");
const previewEnvironment = siteUrl.hostname.endsWith(".workers.dev");
if (previewEnvironment) Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
const contentSeo = contentSeoInput
  ? getSeoMeta(contentSeoInput, {
      siteTitle,
      titleSeparator,
      defaultTitle: title,
      defaultDescription: description,
      siteUrl: siteUrl.origin,
      path
    })
  : null;
const fullTitle = contentSeo?.title || templateTitle;
const pageDescription = contentSeo?.description || description;
const canonical = contentSeo?.canonical ?? new URL(path, siteUrl).toString();
const imageUrl = new URL(contentSeo?.ogImage ?? image, siteUrl).toString();
const imageAlt =
  suppliedImageAlt ??
  (imageUrl.includes("workshop-20261018.jpg")
    ? "An illustrated maker at a workbench connects a miniature underwater world, game arena and record player. Woodhouse: one human, many worlds."
    : title + " social preview for Woodhouse and the Loftwah Software Factory");
const socialTitle = ogTitle ?? contentSeo?.ogTitle ?? fullTitle;
const socialDescription = contentSeo?.ogDescription ?? pageDescription;
const structuredSiteName = path === "/" || type === "article" ? siteTitle : undefined;
const editMode = Astro.cookies.get("emdash-edit-mode")?.value === "true";
const previewRequest = Astro.url.searchParams.has("_preview");
const privateView = previewEnvironment || editMode || previewRequest || noindex;
if (privateView) {
  Astro.cache?.set(false);
  Astro.response.headers.set("cache-control", "private, no-store, max-age=0");
  Astro.response.headers.set("pragma", "no-cache");
  Astro.response.headers.set("x-robots-tag", "noindex, nofollow, noarchive");
}
const page = createPublicPageContext({
  Astro: { url: Astro.url },
  kind: contentRef ? "content" : "custom",
  pageType: pageType ?? type,
  title: fullTitle,
  pageTitle: socialTitle,
  description: pageDescription,
  canonical,
  image: imageUrl,
  ...(contentRef ? { content: contentRef } : {}),
  ...(structuredSiteName !== undefined ? { siteName: structuredSiteName } : {}),
  siteUrl: siteUrl.origin,
  seo: {
    ogTitle: socialTitle,
    ogDescription: socialDescription,
    ogImage: imageUrl,
    ...((noindex ? "noindex, nofollow, noarchive" : (contentSeo?.robots ?? robots))
      ? { robots: noindex ? "noindex, nofollow, noarchive" : (contentSeo?.robots ?? robots) }
      : {})
  },
  ...(type === "article"
    ? {
        articleMeta: {
          ...(publishedAt ? { publishedTime: publishedAt } : {}),
          ...(modifiedAt ? { modifiedTime: modifiedAt } : {}),
          author: authorName
        }
      }
    : {})
});
const [primaryResult, footerResult, houseIndexResult, searchResult, projectResult] =
  await Promise.all([
    getPublicMenu("primary"),
    getPublicMenu("footer"),
    getPublicMenu("house_index"),
    listPublicSearchItems(),
    listProjectRecords()
  ]);
// Keep a route's explicit failure/private policy through layout data reads.
// Applying any hint after set(false) would re-enable Astro's cache provider.
if (privateView || /private|no-store/i.test(Astro.response.headers.get("cache-control") ?? "")) {
  Astro.cache?.set(false);
} else if (Astro.cache?.enabled) {
  for (const result of [primaryResult, footerResult, houseIndexResult])
    Astro.cache.set(result.cacheHint);
  for (const hint of searchResult.cacheHints) Astro.cache.set(hint);
  for (const hint of projectResult.cacheHints) Astro.cache.set(hint);
}
const primaryLinks = primaryResult.menu?.items ?? [];
const footerLinks = footerResult.menu?.items ?? [];
const houseIndexLinks = houseIndexResult.menu?.items ?? [];
// The newest review in the portfolio, not the first project's. Projects are
// reviewed separately and sorted by dossier order, so `projects[0]` is Bubbles
// and carries the launch date — printing it in the footer of every page claims
// the whole site was last reviewed on 28 September, which stopped being true as
// soon as a second project was re-reviewed.
const footerReadout = portfolioReadout(projectResult.projects);
const footerReviewDate = formatReviewDate(footerReadout.reviewDate ?? "") ?? undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080d19" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Woodhouse dispatches" href="/rss.xml" />
    <EmDashHead page={page} />
    {structuredSiteName === undefined && <meta property="og:site_name" content={siteTitle} />}
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {fallbackImage && (
      <>
        <meta property="og:image" content={new URL(fallbackImage, siteUrl).toString()} />
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
        <meta property="og:image:alt" content={`Woodhouse project illustration for ${title}`} />
      </>
    )}
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content={authorName} />
    {authorName && <link rel="author" href="/dean/" />}
    <title>{fullTitle}</title>
    <slot name="head" />
    <script is:inline>
      window.addEventListener(
        "error",
        (event) => {
          const image = event.target;
          if (!(image instanceof HTMLImageElement)) return;
          const fallback = image.dataset.fallbackSrc;
          if (fallback && image.dataset.fallbackApplied !== "true") {
            image.dataset.fallbackApplied = "true";
            image.src = fallback;
            if (image.dataset.fallbackAlt) image.alt = image.dataset.fallbackAlt;
            const artwork = image.closest("[data-project-artwork]");
            const status = artwork?.querySelector("[data-artwork-status]");
            artwork?.querySelectorAll("[data-artwork-source-metadata]").forEach((node) => {
              node.hidden = true;
            });
            if (status)
              status.textContent = image.dataset.fallbackCredit ?? "ILLUSTRATION BY WOODHOUSE";
          }
          if (image.hasAttribute("data-source-favicon")) image.hidden = true;
        },
        true
      );
    </script>
    <MeasurementNavigation />
  </head>
  <body>
    {Astro.props.analyticsWorkbench && (
      <Fragment
        set:html={
          "<!-- THESIS: Explore measured product activity in a chart-centred workbench; refuse a ledger masquerading as insight. OWN-WORLD: Woodhouse ink navy, porcelain, acid actions, cyan/coral data; Bricolage headings, precise native controls and one-pixel seams. STORY: Choose dates and a measure, inspect daily evidence, understand coverage and missing business proof, share a frozen report. FIRST VIEWPORT: Narrow project rail, compact heading/date toolbar, source totals, dominant chart with zoom, right interpretation column; share action in context. FORM: Analytical research workbench, grounded candidate 6, surface seed 626f0487. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->"
        }
      />
    )}
    {currentPath === "/share/" && (
      <Fragment set:html="<!-- THESIS: browse shareable game media in bounded collections, with original files beside each preview. OWN-WORLD: canonical game pixels on Woodhouse ink; Bricolage headings, open figures and lime downloads. STORY: choose a project and asset type, preview six resources, then copy, download or move to the next page. FIRST VIEWPORT: compact project and type navigation, then a mixed game-image row on desktop or one preview on phone. FORM: the established open gallery, with native URL views and six-item pagination; seed established-share-gallery. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->" />
    )}
    <SiteHeader currentPath={currentPath} links={primaryLinks} houseIndexLinks={houseIndexLinks}>
      <BrandMark slot="brand" />
      <SiteSearch pages={searchResult.pages} />
    </SiteHeader>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter links={footerLinks} reviewDateLabel={footerReviewDate} />
    {!privateView && <AudienceTelemetry projects={projectResult.projects} />}
  </body>
</html>
